#!/usr/bin/env bash
# Show or set the location used by evo.weather.
#
# State lives in $EVOSHELL_STATE/weather/location.json as
# {"name": ..., "latitude": ..., "longitude": ...}. A missing file means the
# location is auto-detected from the IP address. Coordinates make the panel
# exact; a hand-written {"name": "Malibu"} alone works too.
#
#   (no args)               the stored name, or the IP-detected city
#   --set <name> [lat,lon]  store a location
#   --clear                 return to IP auto-detect
#   --path                  print the state file path
set -euo pipefail

_evo_paths_lib="${EVOSHELL_LIB:-$HOME/.local/lib/evoshell/bin}/evo-paths-lib"
[[ -r "$_evo_paths_lib" ]] || _evo_paths_lib="${EVOSHELL_BIN:-}/evo-paths-lib"
# shellcheck source=/dev/null
[[ -r "$_evo_paths_lib" ]] && source "$_evo_paths_lib"
EVOSHELL_STATE="${EVOSHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/evoshell}"

LOC_FILE="${EVOSHELL_STATE}/weather/location.json"
COORDS_PATTERN='^(-?[0-9]+(\.[0-9]+)?),(-?[0-9]+(\.[0-9]+)?)$'

usage() {
  echo "Usage: weather-location [--set <name> [lat,lon]|--clear|--path|settings get|set <query>|search <query>]" >&2
  exit 1
}

geocode_location() {
  local query="$1"
  local raw name lat lon
  raw="$(curl -fsS --max-time 12 \
    "https://geocoding-api.open-meteo.com/v1/search?name=$(jq -rn --arg q "$query" '$q|@uri')&count=1&language=en&format=json" \
    2>/dev/null)" || raw=""
  [[ -n "$raw" ]] || return 1
  name="$(jq -r '.results[0].name // empty' <<<"$raw")"
  lat="$(jq -r '.results[0].latitude // empty' <<<"$raw")"
  lon="$(jq -r '.results[0].longitude // empty' <<<"$raw")"
  [[ -n "$name" && -n "$lat" && -n "$lon" ]] || return 1
  jq -cn --arg name "$name" --argjson latitude "$lat" --argjson longitude "$lon" \
    '{$name, $latitude, $longitude}'
}

search_locations() {
  local query="$1"
  local raw
  if [[ ${#query} -lt 2 ]]; then
    jq -n '{ok: true, results: []}'
    return 0
  fi
  raw="$(curl -fsS --max-time 12 \
    "https://geocoding-api.open-meteo.com/v1/search?name=$(jq -rn --arg q "$query" '$q|@uri')&count=10&language=en&format=json" \
    2>/dev/null)" || raw=""
  if [[ -z "$raw" ]]; then
    jq -n '{ok: true, results: []}'
    return 0
  fi
  jq -cn --argjson raw "$raw" '
    def place_label(r):
      (r.name // "")
      + (if (r.admin1 // "") != "" then ", " + r.admin1 else "" end)
      + (if (r.country // "") != "" then ", " + r.country else "" end);
    {
      ok: true,
      results: [($raw.results // [])[]? | {
        name: .name,
        country: (.country // ""),
        admin1: (.admin1 // ""),
        label: place_label(.),
        query: .name
      }]
    }'
}

cmd_settings_get() {
  local name=""
  if [[ -f $LOC_FILE ]]; then
    name=$(jq -r '.name // "" | if type == "string" then . else "" end' "$LOC_FILE" 2>/dev/null || true)
  fi
  if [[ -n $name ]]; then
    jq -cn --arg name "$name" '{ok: true, name: $name}'
  else
    jq -n '{ok: false, name: ""}'
  fi
}

cmd_settings_set() {
  local query="${1:-}"
  local resolved
  [[ -n "$query" ]] || { jq -n '{ok: false, error: "location required"}'; return 0; }
  resolved="$(geocode_location "$query")" || {
    jq -cn --arg query "$query" '{ok: false, error: ("Could not find location: " + $query)}'
    return 0
  }
  write_location "$resolved"
  jq -c '{ok: true, name}' <<<"$resolved"
}

cmd_settings_search() {
  search_locations "${1:-}"
}

write_location() {
  local dir tmp
  dir="$(dirname "$LOC_FILE")"
  mkdir -p -m 700 -- "$dir"
  [[ ! -L "$dir" && ! -L "$LOC_FILE" ]] || { echo "Refusing symlinked weather state" >&2; exit 1; }
  umask 077
  tmp="$(mktemp -p "$dir" .location.XXXXXXXXXX)"
  printf '%s\n' "$1" >"$tmp"
  mv -f -T -- "$tmp" "$LOC_FILE"
}

# Settings used to store lat/lon in $EVOSHELL_CONFIG/weather.json. The panel
# reads latitude/longitude from state. Copy once so an existing city is kept.
migrate_legacy_location() {
  [[ -f $LOC_FILE ]] && return 0
  local legacy="${EVOSHELL_CONFIG}/weather.json"
  local name lat lon json
  [[ -f $legacy ]] || return 0
  name="$(jq -r '.name // "" | if type == "string" then . else "" end' "$legacy" 2>/dev/null || true)"
  lat="$(jq -r '.latitude // .lat // empty' "$legacy" 2>/dev/null || true)"
  lon="$(jq -r '.longitude // .lon // empty' "$legacy" 2>/dev/null || true)"
  [[ -n $name && -n $lat && -n $lon ]] || return 0
  json="$(jq -cn --arg name "$name" --argjson latitude "$lat" --argjson longitude "$lon" '{$name, $latitude, $longitude}')"
  write_location "$json"
}

migrate_legacy_location

case "${1:-}" in
"")
  name=""
  [[ -f $LOC_FILE ]] && name=$(jq -r '.name // "" | if type == "string" then . else "" end' "$LOC_FILE" 2>/dev/null || true)
  if [[ -z $name ]]; then
    name=$(curl -fsS --max-time 4 "https://wttr.in/?format=%l" 2>/dev/null || true)
    name=${name%%,*}
  fi
  [[ -n $name ]] && echo "$name"
  ;;
--set)
  [[ -n ${2:-} ]] || usage
  if [[ -n ${3:-} ]]; then
    [[ ${3} =~ $COORDS_PATTERN ]] || { echo "Invalid coordinates: $3 (expected lat,lon)" >&2; exit 1; }
    location=$(jq -n --arg name "$2" --argjson latitude "${3%,*}" --argjson longitude "${3#*,}" '{$name, $latitude, $longitude}')
  else
    location=$(jq -n --arg name "$2" '{$name}')
  fi
  write_location "$location"
  ;;
--clear)
  rm -f -- "$LOC_FILE"
  ;;
--path)
  echo "$LOC_FILE"
  ;;
settings)
  case "${2:-}" in
  get) cmd_settings_get ;;
  set) cmd_settings_set "${3:-}" ;;
  search) cmd_settings_search "${3:-}" ;;
  *) usage ;;
  esac
  ;;
*)
  usage
  ;;
esac
