#!/usr/bin/env bash
# secmon summary for the evo.secmon bar widget, fetched from the engine host over SSH.
set -euo pipefail

_paths_lib="${EVOSHELL_LIB:-$HOME/.local/lib/evoshell/bin}/evo-paths-lib"
# shellcheck source=/dev/null
[[ -r $_paths_lib ]] && source "$_paths_lib"
EVOSHELL_CACHE="${EVOSHELL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/evoshell}"
SECMON_CACHE="${SECMON_CACHE:-${EVOSHELL_CACHE}/secmon/status.json}"

cmd_status() {
  local host=${1:-zotac} out
  if out="$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'secmon status --json' 2>/dev/null)" \
    && jq -e '.ok == true' <<<"$out" >/dev/null 2>&1; then
    mkdir -p -m 700 "$(dirname "$SECMON_CACHE")"
    printf '%s\n' "$out" >"$SECMON_CACHE.tmp"
    mv -f "$SECMON_CACHE.tmp" "$SECMON_CACHE"
    printf '%s\n' "$out"
    return
  fi
  jq -nc --arg host "$host" '{ok:false, error:("Can'\''t reach secmon on " + $host)}'
}

# Accept the latest snapshot as the baseline for each named target.
cmd_accept() {
  local host=${1:-zotac} t failed=()
  shift || true
  [[ $host =~ ^[A-Za-z0-9._-]+$ ]] || { jq -nc '{ok:false, error:"Invalid secmon host"}'; return 1; }
  for t in "$@"; do
    if [[ ! $t =~ ^[A-Za-z0-9_-]{1,64}$ ]] \
      || ! timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "secmon baseline accept $t" >/dev/null 2>&1; then
      failed+=("$t")
    fi
  done
  if ((${#failed[@]})); then
    jq -nc --arg t "${failed[*]}" '{ok:false, error:("Couldn'\''t accept changes for " + $t)}'
    return 1
  fi
  jq -nc '{ok:true}'
}

cmd_cache() {
  [[ -f $SECMON_CACHE ]] || return 1
  cat "$SECMON_CACHE"
}

# Hide this occurrence on the engine. A later firstSeen for the same fingerprint shows again.
cmd_hide() {
  local host=${1:-zotac} fp=${2:-} first=${3:-} payload
  [[ $host =~ ^[A-Za-z0-9._-]+$ ]] || { jq -nc '{ok:false, error:"Invalid secmon host"}'; return 1; }
  if [[ -z $fp || ${#fp} -gt 500 || $fp == *$'\n'* ]]; then
    jq -nc '{ok:false, error:"Invalid finding"}'
    return 1
  fi
  if [[ ! $first =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,3})?Z$ ]]; then
    jq -nc '{ok:false, error:"Invalid finding"}'
    return 1
  fi
  payload=$(jq -nc --arg fp "$fp" --arg first "$first" '{items:[{fingerprint:$fp, firstSeen:$first}]}')
  if ! printf '%s' "$payload" | timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'secmon hide' >/dev/null 2>&1; then
    jq -nc '{ok:false, error:"Couldn'\''t hide that finding"}'
    return 1
  fi
  jq -nc '{ok:true}'
}

case "${1:-}" in
status)
  cmd_status "${2:-}"
  ;;
accept)
  shift
  cmd_accept "$@"
  ;;
hide)
  shift
  cmd_hide "$@"
  ;;
cache)
  cmd_cache
  ;;
*)
  echo "usage: $0 status [host]|accept host target...|hide host fingerprint firstSeen|cache" >&2
  exit 1
  ;;
esac
