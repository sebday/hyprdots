#!/usr/bin/env bash
# Background warm-up for menu preview thumbnails and orphan cache pruning.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/evo-storage-lib"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/evo-theme-lib"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/evo-config-lib"
thumb="$SCRIPT_DIR/evo-menu-thumb"
cache_root="${MENU_CACHE_DIR}"

thumb_one() {
    local src="$1"
    local key="$2"
    [[ -f "$src" ]] || return 0
    "$thumb" "$src" "$key" >/dev/null 2>&1 || true
}

valid_keys=()

while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    valid_keys+=("themes/${name}.png")
    thumb_one "$THEME_DIR/$name/preview.png" "themes/${name}.png"

    wp_dir="$THEME_DIR/$name/wallpapers"
    if [[ -d "$wp_dir" ]]; then
        while IFS= read -r file; do
            [[ -n "$file" ]] || continue
            bn="${file##*/}"
            valid_keys+=("wallpapers/${name}/${bn}")
            thumb_one "$file" "wallpapers/${name}/${bn}"
        done < <(find "$wp_dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
    fi
done < <(find "$THEME_DIR" -mindepth 1 -maxdepth 1 -type d ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort)

personal_dir="$(wallpaper_personal_dir)"
if [[ -n "$personal_dir" ]]; then
    [[ "$personal_dir" == ~* ]] && personal_dir="${HOME}${personal_dir#\~}"
    if [[ -d "$personal_dir" ]]; then
        while IFS= read -r file; do
            [[ -n "$file" ]] || continue
            bn="${file##*/}"
            valid_keys+=("wallpapers/personal/${bn}")
            thumb_one "$file" "wallpapers/personal/${bn}"
        done < <(find "$personal_dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
    fi
fi

if [[ -d "$cache_root" ]]; then
    while IFS= read -r cached; do
        [[ -n "$cached" ]] || continue
        key="${cached#"$cache_root"/}"
        keep=0
        for valid in "${valid_keys[@]}"; do
            if [[ "$key" == "$valid" ]]; then
                keep=1
                break
            fi
        done
        [[ "$keep" -eq 1 ]] || rm -f "$cached"
    done < <(find "$cache_root" -type f 2>/dev/null)
fi
