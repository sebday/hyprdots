#!/usr/bin/env bash
# Load evoshell secrets from pass (per-service entries under evoshell/).

EVOSHELL_PASS_PREFIX="${EVOSHELL_PASS_PREFIX:-evoshell}"

declare -gA EVO_PASS_SECRET_PATHS=(
    [GITHUB_TOKEN]="github/token"
    [HOME_ASSISTANT_URL]="home-assistant/url"
    [HOME_ASSISTANT_TOKEN]="home-assistant/token"
    [KRAKEN_API_KEY]="kraken/api-key"
    [KRAKEN_SECRET]="kraken/secret"
    [T212_API_KEY]="trading212/api-key"
    [T212_API_SECRET]="trading212/api-secret"
    [CURSOR_ACCESS_TOKEN]="cursor/access-token"
    [CLOUDFLARE_API_TOKEN]="cloudflare/token"
    [LASTFM_API_KEY]="lastfm/api-key"
    [LASTFM_API_SECRET]="lastfm/api-secret"
    [LASTFM_SESSION_KEY]="lastfm/session-key"
)

evo_secrets_pass_path() {
    local key="$1"
    local rel="${EVO_PASS_SECRET_PATHS[$key]:-}"
    [[ -n "$rel" ]] || return 1
    printf '%s/%s' "$EVOSHELL_PASS_PREFIX" "$rel"
}

evo_secrets_available() {
    command -v pass >/dev/null 2>&1 || return 1
    pass ls "$EVOSHELL_PASS_PREFIX" >/dev/null 2>&1
}

evo_secrets_get() {
    local key="$1"
    local pass_path
    pass_path="$(evo_secrets_pass_path "$key")" || return 1
    pass show "$pass_path" 2>/dev/null
}

evo_secrets_set() {
    local key="$1"
    local value="$2"
    local pass_path
    pass_path="$(evo_secrets_pass_path "$key")" || return 1
    [[ -n "$value" ]] || return 1
    printf '%s' "$value" | pass insert -m "$pass_path" >/dev/null
}

evo_secrets_load() {
    local key pass_path value
    command -v pass >/dev/null 2>&1 || return 0
    if (($# > 0)); then
        for key in "$@"; do
            pass_path="$(evo_secrets_pass_path "$key")" || continue
            value="$(pass show "$pass_path" 2>/dev/null || true)"
            [[ -n "$value" ]] || continue
            export "$key=$value"
        done
        return 0
    fi
    for key in "${!EVO_PASS_SECRET_PATHS[@]}"; do
        pass_path="$(evo_secrets_pass_path "$key")" || continue
        value="$(pass show "$pass_path" 2>/dev/null || true)"
        [[ -n "$value" ]] || continue
        export "$key=$value"
    done
}
