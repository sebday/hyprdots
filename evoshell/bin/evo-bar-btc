#!/bin/bash
# Evo stats panel: Kraken BTC/USD price + unrealized P/L % on XXBT holdings.
# Persists daily closes (seeded from Kraken OHLC) for stats-panel charts.
#
# Credentials: pass entries evoshell/kraken/api-key and evoshell/kraken/secret

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${_bin_dir}/evo-bar-common"
# shellcheck source=/dev/null
source "${_bin_dir}/evo-storage-lib"

HISTORY_FILE="$(evo_bar_history_path btc)"
HISTORY_KEEP=90

CHART_DAYS="${1:-30}"
if ! [[ "$CHART_DAYS" =~ ^[0-9]+$ ]] || (( CHART_DAYS < 1 )); then
    CHART_DAYS=30
fi
if (( CHART_DAYS > 90 )); then
    CHART_DAYS=90
fi

CACHE_KEY="btc-${CHART_DAYS}"
if cached=$(evo_bar_cache_read "$CACHE_KEY" 60 2>/dev/null); then
    printf '%s\n' "$cached"
    exit 0
fi

evo_bar_load_secrets KRAKEN_API_KEY KRAKEN_SECRET

fmt_price() {
  awk -v p="$1" '
    function comma(n, s, i, out, len) {
      s = sprintf("%.0f", n)
      len = length(s)
      for (i = 1; i <= len; i++) {
        if (i > 1 && (len - i + 1) % 3 == 0)
          out = out ","
        out = out substr(s, i, 1)
      }
      return out
    }
    BEGIN {
      if (p >= 10000)
        printf "$%s", comma(p)
      else
        printf "$%.2f", p
    }'
}

json_out() {
    local text="$1" tooltip="$2" detail="${3:-}" bars="${4:-[]}"
    local source="${5:-Kraken}" quote="$6" period="$7" position="$8"
    [[ -n "$quote" ]] || quote='{}'
    [[ -n "$period" ]] || period='{}'
    [[ -n "$position" ]] || position='{}'
    jq -cn \
        --arg text "$text" \
        --arg tooltip "$tooltip" \
        --arg detail "$detail" \
        --argjson bars "$bars" \
        --arg source "$source" \
        --argjson quote "$quote" \
        --argjson period "$period" \
        --argjson position "$position" \
        '{
            text: $text,
            tooltip: $tooltip,
            detail: $detail,
            bars: $bars,
            source: $source,
            quote: $quote,
            period: $period,
            position: $position
        }'
}

fetch_ohlc_rows() {
    local ohlc
    ohlc=$(curl -sf --max-time 10 \
        'https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=1440' 2>/dev/null) || ohlc=""
    if [[ -z "$ohlc" ]]; then
        return 0
    fi
    echo "$ohlc" | jq -r '
        (.result | to_entries[0].value) // []
        | .[-90:]
        | .[]
        | ((.[0] | tonumber | strftime("%Y-%m-%d"))
            + "|" + (.[1] | tonumber | tostring)
            + "|" + (.[2] | tonumber | tostring)
            + "|" + (.[3] | tonumber | tostring)
            + "|" + (.[4] | tonumber | tostring))
    ' 2>/dev/null || true
}

build_bars() {
    local price="$1"
    local today rows=() period_rows=()
    today=$(date -u +%Y-%m-%d)
    evo_bar_load_heatmap_colors || true

    mapfile -t rows < <({
        fetch_ohlc_rows
        printf '%s|%s|%s|%s|%s\n' "$today" "$OPEN24" "$HIGH24" "$LOW24" "$price"
    } | evo_bar_merge_history "$HISTORY_FILE" "$HISTORY_KEEP")

    period_rows=("${rows[@]}")
    if ((${#rows[@]} > CHART_DAYS)); then
        rows=("${rows[@]: -CHART_DAYS}")
    fi
    PERIOD_ROWS=("${period_rows[@]: -CHART_DAYS}")
    if ((${#rows[@]} == 0)); then
        BARS_JSON='[]'
        PERIOD_JSON='{}'
        return
    fi
    BARS_JSON=$(evo_bar_build_candles_json "${rows[@]}")
    PERIOD_JSON=$(evo_bar_period_stats_json "${PERIOD_ROWS[@]}")
}

kraken_private() {
    local api_path="$1"
    local extra_data="${2:-}"
    local nonce postdata sha256_file message sig secret_hex resp
    nonce=$(date +%s%3N)
    postdata="nonce=${nonce}"
    [[ -n "$extra_data" ]] && postdata="${postdata}&${extra_data}"
    secret_hex=$(kraken_secret_hex "$KRAKEN_SECRET") || return 1
    [[ -n "$secret_hex" ]] || return 1
    sha256_file=$(mktemp)
    printf '%s%s' "$nonce" "$postdata" | openssl dgst -sha256 -binary >"$sha256_file"
    message=$(printf '%s' "$api_path"; cat "$sha256_file")
    rm -f "$sha256_file"
    sig=$(printf '%s' "$message" | openssl dgst -sha512 -mac HMAC -macopt "hexkey:${secret_hex}" -binary | base64 -w0 2>/dev/null \
        || printf '%s' "$message" | openssl dgst -sha512 -mac HMAC -macopt "hexkey:${secret_hex}" -binary | base64)
    resp=$(curl -sf --max-time 15 -X POST "https://api.kraken.com${api_path}" \
        -d "$postdata" \
        -H "API-Key: ${KRAKEN_API_KEY}" \
        -H "API-Sign: ${sig}") || return 1
    if [[ -n "$(kraken_api_errors "$resp")" ]]; then
        return 1
    fi
    printf '%s' "$resp"
}

kraken_btc_balance() {
    local bal_resp="$1"
    jq -r '
        .result as $r |
        (($r.XXBT // "0") | tonumber) +
        (($r."XXBT.F" // "0") | tonumber) +
        (($r."XXBT.S" // "0") | tonumber) +
        (($r.BTC // "0") | tonumber) +
        (($r."BTC.F" // "0") | tonumber)
    ' <<<"$bal_resp"
}

kraken_position_json() {
    local usd_price="$1"
    local gbp_price="$2"
    local bal_resp bal trades_resp buy_vol buy_cost upnl_pct value_gbp
    [[ -n "$usd_price" && "$usd_price" != "null" ]] || return 1

    bal_resp=$(kraken_private "/0/private/Balance") || return 1
    bal=$(kraken_btc_balance "$bal_resp")
    awk -v b="$bal" 'BEGIN { exit (b > 0) ? 0 : 1 }' || {
        jq -cn --argjson balance 0 --argjson value 0 --arg currency "GBP" \
            --argjson upnlPct 0 --argjson averagePrice 0 \
            '{balance: $balance, value: $value, currency: $currency, upnlPct: $upnlPct, averagePrice: $averagePrice}'
        return 0
    }

    if [[ -n "$gbp_price" && "$gbp_price" != "null" ]]; then
        value_gbp=$(awk -v b="$bal" -v p="$gbp_price" 'BEGIN { printf "%.2f", b * p }')
    else
        value_gbp=0
    fi
    trades_resp=$(kraken_private "/0/private/TradesHistory" "trades=true" 2>/dev/null) || trades_resp=""
    buy_vol=0
    buy_cost=0
    if [[ -n "$trades_resp" ]]; then
        buy_vol=$(jq -r '
            [.result.trades // {} | to_entries[].value
             | select((.pair | test("XBT|BTC")) and (.pair | test("USD|ZUSD")))
             | select(.type == "buy")
             | .vol | tonumber] | add // 0
        ' <<<"$trades_resp")
        buy_cost=$(jq -r '
            [.result.trades // {} | to_entries[].value
             | select((.pair | test("XBT|BTC")) and (.pair | test("USD|ZUSD")))
             | select(.type == "buy")
             | .cost | tonumber] | add // 0
        ' <<<"$trades_resp")
    fi

    upnl_pct=0
    avg_price=0
    if awk -v v="$buy_vol" 'BEGIN { exit (v > 0) ? 0 : 1 }'; then
        avg_price=$(awk -v buy_cost="$buy_cost" -v buy_vol="$buy_vol" 'BEGIN { printf "%.2f", buy_cost / buy_vol }')
        upnl_pct=$(awk -v price="$usd_price" -v buy_cost="$buy_cost" -v buy_vol="$buy_vol" 'BEGIN {
            avg = buy_cost / buy_vol
            printf "%.4f", (price - avg) / avg * 100
        }')
    fi

    jq -cn \
        --argjson balance "$(awk -v b="$bal" 'BEGIN { printf "%.8f", b + 0 }')" \
        --argjson value "$value_gbp" \
        --arg currency "GBP" \
        --argjson upnlPct "$upnl_pct" \
        --argjson averagePrice "$avg_price" \
        '{balance: $balance, value: $value, currency: $currency, upnlPct: $upnlPct, averagePrice: $averagePrice}'
}

# --- Kraken public ticker ---
TICKER=$(curl -sf --max-time 8 'https://api.kraken.com/0/public/Ticker?pair=XBTUSD' 2>/dev/null) || TICKER=""

if [[ -z "$TICKER" ]] || ! echo "$TICKER" | jq -e '.result | length > 0' >/dev/null 2>&1; then
    evo_bar_load_heatmap_colors || true
    if [[ -f "$HISTORY_FILE" ]]; then
        mapfile -t rows < <(jq -r '
            .[]
            | if (.open != null and .high != null and .low != null and .close != null) then
                "\(.date)|\(.open)|\(.high)|\(.low)|\(.close)"
              else
                "\(.date)|\(.value)"
              end
        ' "$HISTORY_FILE" 2>/dev/null | tail -n "$CHART_DAYS")
        if ((${#rows[@]} > 0)); then
            BARS_JSON=$(evo_bar_build_candles_json "${rows[@]}")
            PERIOD_JSON=$(evo_bar_period_stats_json "${rows[@]}")
            json_out "₿ —" "Kraken ticker unavailable" "" "$BARS_JSON" "Kraken" '{}' "$PERIOD_JSON" '{}'
            exit 0
        fi
    fi
    json_out "₿ —" "Kraken ticker unavailable" "" "[]" "Kraken" '{}' '{}' '{}'
    exit 0
fi

TICKER_ENTRY=$(echo "$TICKER" | jq -c '.result | to_entries[0].value')
LAST=$(echo "$TICKER_ENTRY" | jq -r '.c[0]')
OPEN24=$(echo "$TICKER_ENTRY" | jq -r '.o // .c[0]')
HIGH24=$(echo "$TICKER_ENTRY" | jq -r '.h[0] // .c[0]')
LOW24=$(echo "$TICKER_ENTRY" | jq -r '.l[0] // .c[0]')
VOL24=$(echo "$TICKER_ENTRY" | jq -r '.v[0] // 0')
CHANGE24=$(awk -v last="$LAST" -v open="$OPEN24" 'BEGIN {
    if (open + 0 == 0) print "0"
    else printf "%.4f", (last - open) / open * 100
}')

QUOTE_JSON=$(jq -cn \
    --argjson price "$(awk -v p="$LAST" 'BEGIN { printf "%.2f", p + 0 }')" \
    --argjson open24h "$(awk -v p="$OPEN24" 'BEGIN { printf "%.2f", p + 0 }')" \
    --argjson high24h "$(awk -v p="$HIGH24" 'BEGIN { printf "%.2f", p + 0 }')" \
    --argjson low24h "$(awk -v p="$LOW24" 'BEGIN { printf "%.2f", p + 0 }')" \
    --argjson volume24h "$(awk -v p="$VOL24" 'BEGIN { printf "%.4f", p + 0 }')" \
    --argjson changePct "$CHANGE24" \
    --arg pair "BTC/USD" \
    '{price: $price, open24h: $open24h, high24h: $high24h, low24h: $low24h, volume24h: $volume24h, changePct: $changePct, pair: $pair}')

build_bars "$LAST"
PRICE_S=$(fmt_price "$LAST")

GBP_TICKER=$(curl -sf --max-time 8 'https://api.kraken.com/0/public/Ticker?pair=XBTGBP' 2>/dev/null) || GBP_TICKER=""
GBP_LAST=""
if [[ -n "$GBP_TICKER" ]] && echo "$GBP_TICKER" | jq -e '.result | length > 0' >/dev/null 2>&1; then
    GBP_LAST=$(echo "$GBP_TICKER" | jq -r '.result | to_entries[0].value | .c[0]')
fi

# --- Unrealized P/L % (Kraken private API) ---
POSITION_JSON='{}'
KRAKEN_ERR=""
if [[ -z "${KRAKEN_API_KEY:-}" || -z "${KRAKEN_SECRET:-}" ]]; then
    KRAKEN_ERR="set KRAKEN_API_KEY and KRAKEN_SECRET in pass (evoshell/kraken/*)"
else
    export KRAKEN_API_KEY KRAKEN_SECRET
    POSITION_JSON=$(kraken_position_json "$LAST" "$GBP_LAST" 2>/dev/null) || {
        KRAKEN_ERR="kraken api request failed"
        POSITION_JSON='{}'
    }
fi

UPNL_PCT=$(echo "$POSITION_JSON" | jq -r '.upnlPct // empty')

if [[ -n "${UPNL_PCT:-}" && "$UPNL_PCT" =~ ^-?[0-9]+\.?[0-9]*$ ]]; then
    PCT_S=$(awk -v p="$UPNL_PCT" 'BEGIN { printf "%+.2f", p }')
    CHANGE_S=$(awk -v p="$CHANGE24" 'BEGIN { printf "%+.2f", p }')
    TEXT="₿ ${PRICE_S}"
    DETAIL="${PRICE_S} · ${CHANGE_S}% · ${PCT_S}%"
    TIP="BTC/USD · Kraken
Price: $(fmt_price "$LAST")
24h: ${CHANGE_S}%
Unrealized P/L: ${PCT_S}%"
elif [[ -n "$KRAKEN_ERR" ]]; then
    CHANGE_S=$(awk -v p="$CHANGE24" 'BEGIN { printf "%+.2f", p }')
    TEXT="₿ ${PRICE_S}"
    DETAIL="${PRICE_S} · ${CHANGE_S}% · —"
    TIP="BTC/USD · Kraken
Price: $(fmt_price "$LAST")
24h: ${CHANGE_S}%
Unrealized P/L: unavailable (${KRAKEN_ERR})"
else
    CHANGE_S=$(awk -v p="$CHANGE24" 'BEGIN { printf "%+.2f", p }')
    TEXT="₿ ${PRICE_S}"
    DETAIL="${PRICE_S} · ${CHANGE_S}% · —"
    TIP="BTC/USD · Kraken
Price: $(fmt_price "$LAST")
24h: ${CHANGE_S}%
Unrealized P/L: unavailable"
fi

output=$(json_out "$TEXT" "$TIP" "$DETAIL" "$BARS_JSON" "Kraken" "$QUOTE_JSON" "$PERIOD_JSON" "$POSITION_JSON")
printf '%s\n' "$output" | evo_bar_cache_write "$CACHE_KEY"
printf '%s\n' "$output"
