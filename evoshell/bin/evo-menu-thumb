#!/usr/bin/env bash
# Create or refresh a menu preview thumbnail and print its path.
# Prints the source path instead when no resizer can write a thumb, so the
# cache never fills up with full-size copies.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$script_dir/evo-storage-lib"

src="${1:-}"
key="${2:-}"

[[ -n "$src" && -n "$key" ]] || exit 1
[[ -f "$src" ]] || exit 1

cache_root="${MENU_CACHE_DIR}"
dst="$cache_root/$key"
# 4x the 156x100 wallpaper tile, so a hidpi grid stays sharp.
thumb_w="${3:-624}"
thumb_h="${4:-400}"

mkdir -p "$(dirname "$dst")"

needs_refresh() {
    [[ ! -f "$dst" ]] && return 0
    [[ "$src" -nt "$dst" ]] && return 0
    local bytes
    bytes=$(stat -c '%s' "$dst" 2>/dev/null || echo 0)
    [[ "${bytes:-0}" -gt "$MENU_THUMB_MAX_BYTES" ]] && return 0
    return 1
}

write_thumb() {
    local out="$1"
    rm -f "$out"
    if command -v vipsthumbnail >/dev/null 2>&1; then
        vipsthumbnail "$src" -s "${thumb_w}x${thumb_h}" -m centre --path "$out" >/dev/null 2>&1 || return 1
    elif command -v ffmpeg >/dev/null 2>&1; then
        ffmpeg -y -loglevel error -i "$src" \
            -vf "scale=${thumb_w}:${thumb_h}:force_original_aspect_ratio=increase,crop=${thumb_w}:${thumb_h}" \
            -frames:v 1 -q:v 4 "$out" >/dev/null 2>&1 || return 1
    else
        return 1
    fi
    [[ -s "$out" ]] || return 1
    local bytes
    bytes=$(stat -c '%s' "$out" 2>/dev/null || echo 0)
    [[ "${bytes:-0}" -le "$MENU_THUMB_MAX_BYTES" ]]
}

if needs_refresh; then
    tmp="$(dirname "$dst")/.$(basename "$dst").part.jpg"
    if write_thumb "$tmp"; then
        mv -f "$tmp" "$dst"
    else
        rm -f "$tmp"
        printf '%s' "$src"
        exit 0
    fi
fi

printf '%s' "$dst"
