#!/usr/bin/env bash
# Open configured evo dashboard windows. They tile on the current workspace.

set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${_bin_dir}/evo-paths-lib"
# shellcheck source=/dev/null
source "${_bin_dir}/evo-config-lib"

IPC="${EVOSHELL_BIN}/_ipc"

usage() {
  cat >&2 <<'EOF'
usage: evo-panel-hypr restore-dashboards [dashboard-id ...]
EOF
  exit 1
}

# Dashboard ids and window titles differ for the player: the IPC id is
# evo.panels.player, the Hyprland title is evo.player.
dashboard_window_title() {
  local id="$1"
  if [[ "$id" == "evo.panels.player" ]]; then
    printf '%s\n' "evo.player"
    return 0
  fi
  printf '%s\n' "$id"
}

find_dashboard_address() {
  local title
  title="$(dashboard_window_title "$1")"
  hyprctl clients -j 2>/dev/null | jq -r --arg t "$title" '
    .[] | select(.class == "org.quickshell" and .title == $t) | .address' | head -1
}

open_dashboard_if_needed() {
  local id="$1"
  [[ -n "$id" ]] || return 0
  if [[ -n "$(find_dashboard_address "$id")" ]]; then
    return 0
  fi
  "$IPC" shell openDashboard "$id" >/dev/null 2>&1 || true
  local tries=0
  while (( tries < 30 )); do
    [[ -n "$(find_dashboard_address "$id")" ]] && return 0
    sleep 0.05
    tries=$((tries + 1))
  done
  return 1
}

open_dashboards() {
  local ids others player id
  others=()
  player=""
  if (($# > 0)); then
    while (($# > 0)); do
      id="$1"
      shift
      [[ -n "$id" ]] || continue
      if [[ "$id" == "evo.panels.player" ]]; then
        player="$id"
      else
        others+=("$id")
      fi
    done
  else
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      if [[ "$id" == "evo.panels.player" ]]; then
        player="$id"
      else
        others+=("$id")
      fi
    done < <(merged_config | jq -r '.dashboards.openOnStart[]? // empty')
  fi
  local ordered=("${others[@]}")
  [[ -n "$player" ]] && ordered+=("$player")
  for id in "${ordered[@]}"; do
    open_dashboard_if_needed "$id" || true
  done
}

restore_dashboards() {
  open_dashboards "$@"
}

cmd="${1:-}"
case "$cmd" in
restore-dashboards)
  shift
  restore_dashboards "$@"
  ;;
-h | --help | help | "") usage ;;
*)
  echo "evo-panel-hypr: unknown command: $cmd" >&2
  usage
  ;;
esac
