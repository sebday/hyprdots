#!/usr/bin/env bash
# Shared layout helpers for evoshell bar and panel.

set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${_bin_dir}/evo-config-lib"

read_bar_state() {
    merged_config | jq -c '{output: (.bar.output // ""), position: (.bar.position // "bottom")}'
}

write_bar_layout_toggle() {
    local current_position
    current_position="$(merged_config | jq -r '.bar.position // "bottom"')"
    if [[ "$current_position" == "top" ]]; then
        patch_overrides '.bar.position = "bottom"'
    else
        patch_overrides '.bar.position = "top"'
    fi
}

write_bar_layout_reset() {
    patch_overrides 'del(.bar.output, .bar.position)'
}

set_bar_layout() {
    local output="$1"
    local position="$2"
    patch_overrides --arg output "$output" --arg position "$position" \
        '.bar.output = $output | .bar.position = $position'
}

read_panel_state() {
    merged_config | jq -c '{panelOnRight: ((.panel.side // "left") == "right")}'
}

read_notifications_state() {
    merged_config | jq -c '{output: (.notifications.output // ""), position: (.notifications.position // "bottom")}'
}

write_notifications_layout_toggle() {
    local current_position
    current_position="$(merged_config | jq -r '.notifications.position // "bottom"')"
    if [[ "$current_position" == "top" ]]; then
        patch_overrides '.notifications.position = "bottom"'
    else
        patch_overrides '.notifications.position = "top"'
    fi
}

set_notifications_layout() {
    local output="$1"
    local position="$2"
    patch_overrides --arg output "$output" --arg position "$position" \
        '.notifications.output = $output | .notifications.position = $position'
}

write_panel_side() {
    local on_right="$1"
    if [[ "$on_right" == "true" ]]; then
        "${_bin_dir}/evo-config" panel set right >/dev/null
    else
        "${_bin_dir}/evo-config" panel set left >/dev/null
    fi
}

read_ui_state() {
    jq -c '{fieldsetRounding: (.fieldsetRounding != false)}' <<<"$(read_ui_config_json)"
}

write_ui_state() {
    local fieldset_rounding="$1"
    merge_ui_config_json --argjson fieldsetRounding "$fieldset_rounding" '.fieldsetRounding = $fieldsetRounding'
}

read_side_state() {
    jq -c '{
        open: (.sidePanel.open // false),
        module: (.sidePanel.module // "calc"),
        focus: (.sidePanel.focus // "")
    }' <<<"$(read_session_json)"
}

set_side_state() {
    local json="$1"
    if ! jq -e 'type == "object"' <<<"$json" >/dev/null 2>&1; then
        echo "invalid side state json" >&2
        exit 1
    fi
    merge_session_json --argjson sp "$json" '.sidePanel = {
        open: ($sp.open // false),
        module: ($sp.module // "calc"),
        focus: ($sp.focus // "")
    }'
}

toggle_fieldset_rounding() {
    local current on
    current="$(read_ui_state)"
    on="$(jq -r 'if .fieldsetRounding then "true" else "false" end' <<<"$current")"
    if [[ "$on" == "true" ]]; then
        write_ui_state false
    else
        write_ui_state true
    fi
    read_ui_state
}

usage() {
    cat >&2 <<'EOF'
usage:
  evo-layout bar get|set <output> <top|bottom>|toggle|reset
  evo-layout panel get|toggle
  evo-layout notifications get|set <output> <top|bottom>|toggle
  evo-layout ui get|toggle fieldsetRounding
  evo-layout side get|set <json>
EOF
    exit 1
}

target="${1:-}"
action="${2:-}"

case "$target" in
bar)
    case "$action" in
    get)
        read_bar_state
        ;;
    set)
        output="${3:-}"
        position="${4:-}"
        if [[ -z "$output" || -z "$position" ]]; then
            usage
        fi
        case "$position" in
        top | bottom) ;;
        *)
            usage
            ;;
        esac
        set_bar_layout "$output" "$position"
        reload_shell_config
        read_bar_state
        ;;
    toggle)
        write_bar_layout_toggle
        reload_shell_config
        read_bar_state
        ;;
    reset)
        write_bar_layout_reset
        reload_shell_config
        read_bar_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
panel)
    case "$action" in
    get)
        read_panel_state
        ;;
    toggle | toggle-side)
        current="$(read_panel_state)"
        on="$(jq -r 'if .panelOnRight then "true" else "false" end' <<<"$current")"
        if [[ "$on" == "true" ]]; then
            write_panel_side false
        else
            write_panel_side true
        fi
        reload_shell_config
        read_panel_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
notifications)
    case "$action" in
    get)
        read_notifications_state
        ;;
    set)
        output="${3:-}"
        position="${4:-}"
        if [[ -z "$output" || -z "$position" ]]; then
            usage
        fi
        case "$position" in
        top | bottom) ;;
        *)
            usage
            ;;
        esac
        set_notifications_layout "$output" "$position"
        reload_shell_config
        read_notifications_state
        ;;
    toggle)
        write_notifications_layout_toggle
        reload_shell_config
        read_notifications_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
ui)
    case "$action" in
    get)
        read_ui_state
        ;;
    toggle)
        key="${3:-}"
        case "$key" in
        fieldsetRounding)
            toggle_fieldset_rounding
            ;;
        *)
            usage
            ;;
        esac
        ;;
    *)
        usage
        ;;
    esac
    ;;
side)
    case "$action" in
    get)
        read_side_state
        ;;
    set)
        json="${3:-}"
        if [[ -z "$json" ]]; then
            usage
        fi
        set_side_state "$json"
        read_side_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
*)
    usage
    ;;
esac
