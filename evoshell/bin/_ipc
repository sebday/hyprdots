#!/usr/bin/env bash
# IPC wrapper for the running evoshell Quickshell instance.

set -euo pipefail

EVOSHELL_ROOT="${EVOSHELL_ROOT:-$HOME/projects/evoshell}"

if ! command -v quickshell >/dev/null 2>&1; then
    echo "quickshell is not installed. Install with: sudo pacman -S quickshell" >&2
    exit 1
fi

target="${1:-shell}"
method="${2:-ping}"
arg1="${3:-}"
arg2="${4:-}"

ipc_args=(--any-display -p "$EVOSHELL_ROOT")

# Direct plugin IPC (e.g. evo.sys.media.audio stepUp)
if [[ "$target" != "shell" ]]; then
    if [[ -n "$arg2" ]]; then
        quickshell ipc "${ipc_args[@]}" call "$target" "$method" "$arg1" "$arg2"
    elif [[ -n "$arg1" ]]; then
        quickshell ipc "${ipc_args[@]}" call "$target" "$method" "$arg1"
    else
        quickshell ipc "${ipc_args[@]}" call "$target" "$method"
    fi
    exit 0
fi

# toggle/summon always need a payloadJson argument (use "" when omitted)
if [[ "$method" == "toggle" || "$method" == "summon" ]]; then
    quickshell ipc "${ipc_args[@]}" call "$target" "$method" "$arg1" "${arg2:-}"
    exit 0
fi

if [[ -n "$arg2" ]]; then
    quickshell ipc "${ipc_args[@]}" call "$target" "$method" "$arg1" "$arg2"
elif [[ -n "$arg1" ]]; then
    quickshell ipc "${ipc_args[@]}" call "$target" "$method" "$arg1"
else
    quickshell ipc "${ipc_args[@]}" call "$target" "$method"
fi
