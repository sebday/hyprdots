:root {
    --bg-primary: {{ background }};
    --bg-secondary: {{ lighter_background }};
    --bg-deep: {{ dark_background }};
    --text-primary: {{ foreground }};
    --text-muted: {{ dark_foreground }};
    --text-bright: {{ bright_foreground }};
    --text-accent: {{ accent }};
    --border: {{ muted }};
    --border-subtle: {{ selection }};
    --blue: {{ color4 }};
    --cyan: {{ color6 }};
    --purple: {{ color5 }};
    --pink: {{ color13 }};
    --green: {{ color2 }};
    --orange: {{ color3 }};
    --red: {{ color1 }};
}
