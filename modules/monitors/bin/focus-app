#!/usr/bin/env bash
# Focus the first Hyprland window whose class matches <app-name> (case-insensitive).

set -euo pipefail

app=${1:-}
[[ -n $app ]] || { echo "usage: focus-app <app-name>" >&2; exit 1; }
command -v hyprctl >/dev/null && command -v jq >/dev/null || exit 1

address=$(
  hyprctl clients -j 2>/dev/null |
    jq -r --arg pattern "$app" \
      'first(.[] | select((.class // "") | test($pattern; "i"))).address // empty' 2>/dev/null
)

[[ -n $address ]] || exit 1

hyprctl dispatch focuswindow "address:$address" >/dev/null
