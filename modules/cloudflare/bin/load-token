#!/usr/bin/env bash
# Load the Cloudflare read token from pass.
# Store name is evoshell/cloudflare/read-all; cloudflare/token is the alias.
set -euo pipefail

command -v pass >/dev/null 2>&1 || exit 0
lib="${EVOSHELL_ROOT:-}/bin/evo-secrets-lib"
[[ -r "$lib" ]] || lib="${EVOSHELL_LIB:-$HOME/.local/lib/evoshell/bin}/evo-secrets-lib"
if [[ -r "$lib" ]]; then
  # shellcheck source=/dev/null
  source "$lib"
  value="$(evo_secrets_get CLOUDFLARE_API_TOKEN 2>/dev/null || true)"
else
  value="$(pass show evoshell/cloudflare/read-all 2>/dev/null || true)"
fi
if [[ -n "$value" ]]; then
  printf '%s' "$value"
fi
