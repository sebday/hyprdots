#!/usr/bin/env python3
"""Recent evoplayer scrobbles plus an all-time tally. Local files only."""

import json
import os
import re
import stat
import sys

MAX_BYTES = 16 * 1024 * 1024
RECENT_LIMIT = 4
TEXT_MAX = 180
PATH_MAX = 1024

_ROOT_RE = re.compile(r'^root\s*=\s*"(.*)"\s*$')


def fail(message):
    sys.stderr.write(message + "\n")
    raise SystemExit(1)


def open_home():
    home = os.environ.get("HOME", "")
    if not home.startswith("/") or any(c in home for c in "\n\r\0"):
        fail("HOME is not a usable directory")
    parts = [part for part in home.split("/") if part]
    if not parts or any(part in (".", "..") for part in parts):
        fail("HOME is not a usable directory")
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        os.close(fd)
        fail("HOME is not a usable directory")
    return home, fd


def open_chain(start_fd, parts):
    fd = os.dup(start_fd)
    try:
        for name in parts:
            if not name or name in (".", "..") or "/" in name or "\0" in name:
                raise PermissionError(name)
            nxt = os.open(
                name,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=fd,
            )
            os.close(fd)
            fd = nxt
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
                raise PermissionError(name)
        return fd
    except BaseException:
        os.close(fd)
        raise


def xdg_parts(home, env_name, default):
    raw = os.environ.get(env_name, "").strip()
    if not raw:
        return list(default)
    prefix = home + "/"
    if not raw.startswith(prefix) or any(c in raw for c in "\n\r\0"):
        fail(env_name + " is outside HOME")
    parts = raw[len(prefix):].split("/")
    if not parts or any(part in ("", ".", "..") for part in parts):
        fail(env_name + " is outside HOME")
    return parts


def read_file(dirfd, name):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    try:
        st = os.fstat(fd)
        if (
            not stat.S_ISREG(st.st_mode)
            or st.st_uid != os.geteuid()
            or st.st_nlink != 1
            or st.st_mode & 0o022
            or st.st_size > MAX_BYTES
        ):
            raise PermissionError(name)
        os.set_blocking(fd, True)
        data = bytearray()
        while len(data) <= MAX_BYTES:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) > MAX_BYTES:
            raise PermissionError(name)
        return bytes(data)
    finally:
        os.close(fd)


def art_ready(dirfd, name):
    if not name or "/" in name or "\\" in name or name.startswith(".") or ".." in name:
        return False
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        return stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_size > 0
    finally:
        os.close(fd)


def clean_text(value):
    text = str(value or "")
    out = []
    for ch in text:
        code = ord(ch)
        if code < 32 or code == 127:
            continue
        if len(out) >= TEXT_MAX:
            break
        out.append(ch)
    return "".join(out).strip()


def clean_path(value):
    text = str(value or "")
    if not text.startswith("/") or len(text) > PATH_MAX:
        return ""
    if any(c in text for c in "\n\r\0"):
        return ""
    return text


def slug(text):
    out = []
    for ch in text:
        if ch.isalnum() or ch in "&_-":
            out.append(ch)
        else:
            out.append("_")
    return "".join(out)


def rel_under_root(root, path):
    root = os.path.normpath(root)
    full = os.path.normpath(path if os.path.isabs(path) else os.path.join(root, path))
    try:
        rel = os.path.relpath(full, root)
    except ValueError:
        return os.path.basename(full)
    if rel == ".." or rel.startswith("../") or rel.startswith("..\\"):
        return os.path.basename(full)
    return rel.replace(os.sep, "/")


def art_names(root, path):
    rel = rel_under_root(root, path).strip("/")
    names = []
    track = slug(rel) + ".jpg"
    if track != ".jpg":
        names.append(track)
    parts = rel.split("/") if rel else []
    if len(parts) == 2:
        folder_rel = rel
    else:
        folder_rel = rel.rsplit("/", 1)[0] if "/" in rel else rel
    folder = slug(folder_rel) + ".jpg"
    if folder != ".jpg" and folder not in names:
        names.append(folder)
    return names


def open_library_state(music):
    """Scrobbles sit in <library>/.evoplayer. The library root may be a symlink."""
    parts = [part for part in music.split("/") if part]
    if (
        not music.startswith("/")
        or len(music) > PATH_MAX
        or any(c in music for c in "\n\r\0")
        or not parts
        or any(part in (".", "..") for part in parts)
    ):
        raise PermissionError("music root")
    root_fd = os.open(music, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        st = os.fstat(root_fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            raise PermissionError("music root")
        return open_chain(root_fd, [".evoplayer"])
    finally:
        os.close(root_fd)


def music_root(text, fallback):
    section = ""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1].strip()
            continue
        if section != "paths":
            continue
        match = _ROOT_RE.match(stripped)
        if not match:
            continue
        root = match.group(1)
        if root.startswith("/") and not any(c in root for c in "\n\r\0") and ".." not in root.split("/"):
            return root
    return fallback


def tally_and_recent(raw, root, art_fd):
    artists = set()
    albums = set()
    tracks = set()
    scrobbles = 0
    rows = []
    for line in raw.splitlines():
        if not line or len(line) > 8192:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict):
            continue
        event = row.get("event")
        if event not in ("submit", "scrobble"):
            continue
        rows.append(row)
        artist = clean_text(row.get("artist"))
        title = clean_text(row.get("title"))
        album = clean_text(row.get("album"))
        if not artist or not title:
            continue
        scrobbles += 1
        artists.add(artist)
        tracks.add((artist, title))
        if album:
            albums.add((artist, album))

    seen = set()
    recent = []
    for row in reversed(rows):
        path = clean_path(row.get("path"))
        artist = clean_text(row.get("artist"))
        title = clean_text(row.get("title"))
        if path:
            key = path
        elif artist or title:
            key = artist + "\n" + title
        else:
            continue
        if key in seen:
            continue
        seen.add(key)
        art = ""
        if art_fd is not None and path:
            for name in art_names(root, path):
                if art_ready(art_fd, name):
                    art = name
                    break
        recent.append({
            "artist": artist,
            "title": title,
            "album": clean_text(row.get("album")),
            "at": clean_text(row.get("at"))[:32],
            "path": path,
            "art": art,
        })
        if len(recent) >= RECENT_LIMIT:
            break

    return {
        "scrobbles": scrobbles,
        "artists": len(artists),
        "albums": len(albums),
        "tracks": len(tracks),
    }, recent


def main():
    home, home_fd = open_home()
    state_fd = None
    library_fd = None
    config_fd = None
    art_fd = None
    try:
        state_parts = xdg_parts(home, "XDG_STATE_HOME", [".local", "state"])
        cache_parts = xdg_parts(home, "XDG_CACHE_HOME", [".cache"])
        config_parts = xdg_parts(home, "XDG_CONFIG_HOME", [".config"])
        art_dir = home + "/" + "/".join(cache_parts + ["evoplayer", "art"])
        music = home + "/music"

        try:
            state_fd = open_chain(home_fd, state_parts + ["evoplayer"])
        except OSError:
            state_fd = None
        try:
            config_fd = open_chain(home_fd, config_parts + ["evoplayer"])
        except OSError:
            config_fd = None
        try:
            art_fd = open_chain(home_fd, cache_parts + ["evoplayer", "art"])
        except OSError:
            art_fd = None
            art_dir = ""

        if config_fd is not None:
            try:
                music = music_root(read_file(config_fd, "music.toml").decode("utf-8", "replace"), music)
            except OSError:
                pass

        raw = b""
        try:
            library_fd = open_library_state(music)
            raw = read_file(library_fd, "scrobble.jsonl")
        except OSError:
            raw = b""
        if not raw and state_fd is not None:
            try:
                raw = read_file(state_fd, "scrobble.jsonl")
            except OSError:
                raw = b""

        totals, recent = tally_and_recent(raw, music, art_fd)
        sys.stdout.write(json.dumps({
            "artDir": art_dir,
            "totals": totals,
            "recent": recent,
        }, ensure_ascii=True))
    finally:
        for fd in (art_fd, config_fd, library_fd, state_fd, home_fd):
            if fd is not None:
                os.close(fd)


if __name__ == "__main__":
    main()
