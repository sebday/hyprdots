#!/usr/bin/env bash
# GitHub contribution stats for the evo.github bar widget.
set -euo pipefail

_paths_lib="${EVOSHELL_LIB:-$HOME/.local/lib/evoshell/bin}/evo-paths-lib"
# shellcheck source=/dev/null
[[ -r $_paths_lib ]] && source "$_paths_lib"
EVOSHELL_CACHE="${EVOSHELL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/evoshell}"

CACHE_DIR="${EVOSHELL_CACHE}/github"
CACHE_PATH="${CACHE_DIR}/github.json"
CACHE_TTL="${GITHUB_CACHE_TTL:-300}"
HEATMAP_DAYS=30
FORCE_REFRESH=false
[[ "${1:-}" == "--refresh" ]] && FORCE_REFRESH=true
TOKEN=""

declare -a GITHUB_COLORS=("#45475a" "#89b4fa" "#74c7ec" "#89dceb" "#cba6f7")

json_github() {
  jq -cn \
    --arg text "$1" \
    --argjson today "$2" \
    --argjson cells "$3" \
    --arg class "$4" \
    --arg username "$5" \
    --argjson total30 "$6" \
    --argjson streak "$7" \
    --argjson best "$8" \
    --arg profileUrl "$9" \
    '{
      text: $text,
      today: $today,
      cells: $cells,
      class: $class,
      username: $username,
      total30: $total30,
      streak: $streak,
      best: $best,
      profileUrl: $profileUrl
    }'
}

json_error() {
  local text="$1"
  local tooltip="${2:-}"
  jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip, class: "error"}'
}

cache_read() {
  [[ -e "$CACHE_PATH" ]] || return 1
  local now mtime age content
  now=$(date +%s)
  mtime=$(stat -c %Y "$CACHE_PATH" 2>/dev/null || echo 0)
  age=$((now - mtime))
  (( age < CACHE_TTL )) || return 1
  content=$(/usr/bin/dd if="$CACHE_PATH" iflag=nofollow,nonblock,count_bytes,fullblock bs=1 count=65537 status=none) || return 1
  [ ${#content} -le 65536 ] || return 1
  printf '%s' "$content"
}

cache_write() {
  local dir="$CACHE_DIR"
  mkdir -p -m 700 "$dir" || return 1
  [[ ! -L "$dir" && -d "$dir" ]] || return 1
  [[ "$(stat -c %u "$dir")" == "$(id -u)" ]] || return 1
  umask 077
  local tmp
  tmp="$(/usr/bin/mktemp -p "$dir" .github.XXXXXXXXXX)" || return 1
  cat >"$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -T -- "$tmp" "$CACHE_PATH"
}

load_token() {
  local value
  if command -v gh >/dev/null 2>&1; then
    value="$(gh auth token 2>/dev/null || true)"
    if [[ -n "$value" ]]; then
      TOKEN="$value"
      return 0
    fi
  fi
  command -v pass >/dev/null 2>&1 || return 1
  local lib="${EVOSHELL_ROOT:-}/bin/evo-secrets-lib"
  [[ -r "$lib" ]] || lib="${EVOSHELL_LIB:-$HOME/.local/lib/evoshell/bin}/evo-secrets-lib"
  if [[ -r "$lib" ]]; then
    # shellcheck source=/dev/null
    source "$lib"
    value="$(evo_secrets_get GITHUB_TOKEN 2>/dev/null || true)"
  else
    value="$(pass show omarchy/github/token 2>/dev/null || true)"
  fi
  if [[ -n "$value" ]]; then
    TOKEN="$value"
    return 0
  fi
  return 1
}

contribution_level() {
  local count="${1:-0}"
  if [[ "$count" -ge 30 ]]; then echo 4; return
  elif [[ "$count" -ge 18 ]]; then echo 3; return
  elif [[ "$count" -ge 10 ]]; then echo 2; return
  elif [[ "$count" -ge 1 ]]; then echo 1; return
  fi
  echo 0
}

build_heatmap_json() {
  local -a counts=("$@")
  local level color count line
  local lines=""

  for count in "${counts[@]}"; do
    level=$(contribution_level "$count")
    color="${GITHUB_COLORS[$level]}"
    line=$(jq -cn --argjson level "$level" --argjson count "$count" --arg color "$color" \
      '{level: $level, count: $count, color: $color}')
    lines+="$line"$'\n'
  done

  printf '%s' "$lines" | jq -s '.'
}

if [[ "$FORCE_REFRESH" != true ]] && cached=$(cache_read 2>/dev/null); then
  printf '%s\n' "$cached"
  exit 0
fi

if ! load_token; then
  json_error " Token Err" "Run gh auth login or pass insert evoshell/github/token"
  exit 1
fi
case "$TOKEN" in *'"'*|*\\*|$'\n'*)
  json_error " Token Err" "GitHub token contains unsupported characters."
  exit 1
  ;;
esac

GRAPHQL_QUERY_RAW='
query GetViewerContributionCalendar {
  viewer {
    login
    contributionsCollection {
      contributionCalendar {
        weeks {
          contributionDays {
            contributionCount
            date
          }
        }
      }
    }
  }
}
'
GRAPHQL_QUERY_ESCAPED=$(echo "$GRAPHQL_QUERY_RAW" | tr '\n' ' ' | sed 's/"/\\"/g')
JSON_PAYLOAD=$(printf '{ "query": "%s" }' "$GRAPHQL_QUERY_ESCAPED")

set -o pipefail
MAX_BYTES=1048576
RESPONSE=$(
  printf '%s\n' \
    "header = \"Authorization: bearer ${TOKEN}\"" \
    'header = "Content-Type: application/json"' \
    | /usr/bin/curl -q -sS --fail --config - \
        --proto '=https' --proto-redir '=https' \
        --max-time 20 --connect-timeout 5 --max-filesize "$MAX_BYTES" --noproxy '*' \
        -X POST --data-binary "${JSON_PAYLOAD}" -- "https://api.github.com/graphql" \
    | /usr/bin/head -c $((MAX_BYTES + 1))
) || RESPONSE=""
if [ ${#RESPONSE} -gt "$MAX_BYTES" ]; then
  json_error " Curl Err" "GraphQL response exceeded limit."
  exit 1
fi

if [[ -z "$RESPONSE" ]]; then
  json_error " Curl Err" "GraphQL request returned empty."
  exit 1
fi

if echo "$RESPONSE" | jq -e '.errors' > /dev/null 2>&1; then
  ERROR_MESSAGE=$(echo "$RESPONSE" | jq -r '.errors[0].message // "Unknown GraphQL error"')
  json_error " GQL Err" "GraphQL error: ${ERROR_MESSAGE}"
  exit 1
fi

declare -A contribs_by_date=()
ALL_DAYS_DATA=$(echo "$RESPONSE" | jq -r '
  .data.viewer.contributionsCollection.contributionCalendar.weeks[]?.contributionDays[]? |
  select(.date != null and .contributionCount != null) |
  "\(.date)_\(.contributionCount)"
')

USERNAME="$(echo "$RESPONSE" | jq -r '.data.viewer.login // empty')"
if [[ -z "$USERNAME" ]]; then
  json_error " Auth Err" "GitHub token did not return a viewer login."
  exit 1
fi

LOCAL_TODAY_ISO=$(date +'%Y-%m-%d')
declare -a day_counts=()
declare -a heatmap_chars=()

if [[ -z "$ALL_DAYS_DATA" ]]; then
  TODAY_CONTRIBUTION_COUNT=0
  for ((i = 1; i <= HEATMAP_DAYS; i++)); do
    day_counts+=(0)
    heatmap_chars+=("<span foreground='${GITHUB_COLORS[0]}'>■</span>")
  done
else
  while IFS=_ read -r date_val count_val; do
    contribs_by_date["$date_val"]=$count_val
  done <<< "$ALL_DAYS_DATA"

  for ((i = HEATMAP_DAYS - 1; i >= 0; i--)); do
    DAY_ISO=$(date -d "${LOCAL_TODAY_ISO} - ${i} days" +'%Y-%m-%d')
    COUNT_FOR_DAY=${contribs_by_date["$DAY_ISO"]:-0}
    LEVEL=$(contribution_level "$COUNT_FOR_DAY")
    day_counts+=("$COUNT_FOR_DAY")
    heatmap_chars+=("<span foreground='${GITHUB_COLORS[$LEVEL]}'>■</span>")
  done

  TODAY_CONTRIBUTION_COUNT=${contribs_by_date["$LOCAL_TODAY_ISO"]:-0}
fi

TODAY_LEVEL=$(contribution_level "$TODAY_CONTRIBUTION_COUNT")
HEATMAP_JSON=$(build_heatmap_json "${day_counts[@]}")
ACTIVITY_BOXES_STRING_FOR_JSON=$(printf '%s' "${heatmap_chars[@]}")

TOTAL30=0
BEST_COUNT=0
for count in "${day_counts[@]}"; do
  TOTAL30=$((TOTAL30 + count))
  if [[ "$count" -gt "$BEST_COUNT" ]]; then
    BEST_COUNT=$count
  fi
done

STREAK=0
DAY_ISO="$LOCAL_TODAY_ISO"
for ((i = 0; i < 400; i++)); do
  COUNT_FOR_DAY=${contribs_by_date["$DAY_ISO"]:-0}
  if [[ "$COUNT_FOR_DAY" -gt 0 ]]; then
    STREAK=$((STREAK + 1))
    DAY_ISO=$(date -d "${DAY_ISO} - 1 day" +'%Y-%m-%d')
  else
    break
  fi
done

TEXT_OUTPUT="  ${TODAY_CONTRIBUTION_COUNT} ${ACTIVITY_BOXES_STRING_FOR_JSON}"
CLASS="github-level-${TODAY_LEVEL}"
PROFILE_URL="https://github.com/${USERNAME}"

output=$(json_github "$TEXT_OUTPUT" "$TODAY_CONTRIBUTION_COUNT" "$HEATMAP_JSON" "$CLASS" \
  "$USERNAME" "$TOTAL30" "$STREAK" "$BEST_COUNT" "$PROFILE_URL")
printf '%s\n' "$output" | cache_write
printf '%s\n' "$output"
