# File system
alias ls='eza -l --icons'
alias ll='eza -al --icons'
alias lt='eza -alr --sort=mod --tree --level=1 --icons'
alias df='df -hT -xtmpfs -xdevtmpfs -xefivarfs'
alias lock='fusermount -u /mnt/secure'
alias unlock='gocryptfs /mnt/external/.crypt /mnt/secure'

# Tools
alias ff='fastfetch'
alias vim='nvim'
alias lg='lazygit'

# Git
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gs='git status'
alias tgs="git checkout store-tgs"
alias diy="git checkout store-diy"
alias master="git checkout master"
