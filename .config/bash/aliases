# File system
alias ls='eza -l --icons'
alias ll='eza -al --icons'
alias lt='eza -alr --sort=mod --tree --level=1 --icons'
alias df='/usr/bin/df -hT -xtmpfs -xdevtmpfs -xefivarfs'
alias lock='fusermount3 -u /mnt/secure'
alias unlock='gocryptfs /mnt/external/.crypt /mnt/secure'

# Tools
alias ff='fastfetch'
alias lg='lazygit'

# Projects
alias pub='(cd /home/seb/projects/client-docs && npm run publish)'
alias reports='(cd /home/seb/projects/ecommerce-reports && ruby bin/generate-reports weekly)'

# Git
alias gcm='git commit -m'
alias gcam='git add -A && git commit -m'
alias gs='git status'
alias master="git checkout master"
