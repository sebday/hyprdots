# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

# Prompt with user, host, path and caret
if [[ "$HOSTNAME" == "shed" ]]; then
  PROMPT_COLOR='\[\e[0;32m\]' # Green for local machine
elif [[ "$HOSTNAME" == "prod" ]]; then
  PROMPT_COLOR='\[\e[0;31m\]' # Red for prod
else
  PROMPT_COLOR='\[\e[0;36m\]' # Cyan for other servers
fi
PS1="${PROMPT_COLOR}\u@\h\[\e[0m\]:\[\e[0;34m\]\w\[\e[0m\] "$'\uf0a9  '
