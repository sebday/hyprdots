# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/\* \(.*\)/ (\1)/'
}

# Prompt with user, host, path and caret — red over SSH, green locally
if [[ -n "$SSH_CONNECTION" ]]; then
  PROMPT_COLOR='\[\e[0;31m\]'
else
  PROMPT_COLOR='\[\e[0;32m\]'
fi
PS1="${PROMPT_COLOR}\u@\h\[\e[0m\]:\[\e[0;34m\]\w\[\e[0;35m\]\$(parse_git_branch)\[\e[0m\] "$'\uf0a9  '
