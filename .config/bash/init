if command -v fzf &> /dev/null; then
  if [[ -f /usr/share/fzf/completion.bash ]]; then
    source /usr/share/fzf/completion.bash
  fi
  if [[ -f /usr/share/fzf/key-bindings.bash ]]; then
    source /usr/share/fzf/key-bindings.bash
  fi
fi

# Lazy-load NVM to speed up shell startup and fix init errors.
export NVM_DIR="$HOME/.nvm"
[ -d "$NVM_DIR" ] || mkdir -p "$NVM_DIR"

nvm() {
  # Unset this function so the real nvm command is found next time
  unset -f nvm
  # Source nvm scripts
  [ -s "/usr/share/nvm/nvm.sh" ] && \. "/usr/share/nvm/nvm.sh"
  [ -s "/usr/share/nvm/bash_completion" ] && \. "/usr/share/nvm/bash_completion"
  # Call the real nvm command
  nvm "$@"
}
