        },
        {
          "id": "evo.stocks"
        },
        {
          "id": "evo.cursor"
        },
        {
          "id": "evo.cloudflare"
        },
        {
          "id": "evo.homeassistant"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "evo.monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "evo.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omarchy.weather"
        }
      ]
    }
  },
  "notifications": {
    "position": "top",
    "placements": [
      {
        "output": "DP-1",
        "position": "top",
        "align": "center"
      }
    ],
    "align": "center"
  },
  "disabledPlugins": [
    "omarchy.bar",
    "omarchy.monitor",
    "omarchy.notifications",
    "omarchy.media"
  ],
  "shopify": {
    "dataPath": "zotac:~/Projects/data-store",
    "timezone": "Europe/London"
