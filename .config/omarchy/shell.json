{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "id": "evo.monitors",
    "position": "bottom",
    "placements": [
      {
        "output": "HDMI-A-1",
        "position": "bottom"
      }
    ],
    "transparent": false,
    "centerAnchor": "evo.steam",
    "layout": {
      "left": [
        {
          "id": "evo.stocks"
        },
        {
          "id": "evo.trading"
        }
      ],
      "center": [
        {
          "id": "evo.tray"
        },
        {
          "id": "evo.cursor"
        },
        {
          "id": "evo.steam"
        },
        {
          "id": "evo.insync"
        },
        {
          "id": "evo.github",
          "repoRoots": [
            {
              "path": "/home/seb/projects",
              "label": "projects"
            },
            {
              "path": "/home/seb/work",
              "label": "work"
            }
          ]
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "evo.cloudflare"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "evo.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "evo.weather"
        },
        {
          "id": "seb.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    }
  },
  "notifications": {
    "position": "top",
    "placements": [
      {
        "output": "DP-1",
        "position": "top",
        "align": "center"
      }
    ],
    "align": "center"
  },
  "disabledPlugins": [
    "omarchy.bar",
    "omarchy.monitor",
    "omarchy.notifications",
    "omarchy.media",
    "omarchy.lock"
  ],
  "shopify": {
    "apiUrl": "https://data.day.marketing",
    "pollIntervalMinutes": 5,
    "timezone": "Europe/London",
    "stores": [
      {
        "key": "DIY",
        "title": "DIY",
        "iconKey": "diy"
      },
      {
        "key": "TGS",
        "title": "TGS",
        "iconKey": "tgs"
      }
    ]
  },
  "media": {
    "filmsRoot": "/mnt/external/Films",
    "tvRoot": "/mnt/external/TV"
  },
  "plugins": [
    {
      "id": "evo.shopify"
    },
    {
      "id": "evo.github"
    },
    {
      "id": "evo.weather"
    },
    {
      "id": "evo.stocks"
    },
    {
      "id": "evo.trading"
    },
    {
      "id": "evo.steam"
    },
    {
      "id": "evo.insync"
    },
    {
      "id": "evo.cursor"
    },
    {
      "id": "evo.cloudflare"
    },
    {
      "id": "evo.media"
    },
    {
      "id": "evo.webtheme"
    },
    {
      "id": "seb.lock"
    }
  ],
  "cloneSourceRestores": [
    "seb.lock"
  ]
}
