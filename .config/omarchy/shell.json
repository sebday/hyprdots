    "centerAnchor": "evo.cursor",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "evo.tray"
        },
        {
          "id": "evo.steam"
        },
        {
          "id": "evo.insync"
        },
        {
