/* Generated from colors.toml – literal hex beats bundled site CSS (Starlight / AstroPaper). */

:root[data-theme="dark"],
html[data-theme="dark"] {
    --bg-primary: {{ background }} !important;
    --bg-secondary: {{ color0 }} !important;
    --text-primary: {{ foreground }} !important;
    --text-accent: {{ accent }} !important;
    --sl-color-accent: {{ accent }} !important;
    --sl-color-accent-low: {{ color0 }} !important;
    --sl-color-accent-high: {{ accent }} !important;
    --sl-color-black: {{ background }} !important;
    --sl-color-gray-1: {{ foreground }} !important;
    --sl-color-gray-2: {{ foreground }} !important;
    --sl-color-gray-3: {{ foreground }} !important;
    --sl-color-gray-4: {{ color0 }} !important;
    --sl-color-gray-5: {{ color0 }} !important;
    --sl-color-gray-6: {{ background }} !important;
    --sl-color-gray-7: {{ background }} !important;
    --sl-color-white: {{ foreground }} !important;
    --sl-color-bg: {{ background }} !important;
    --sl-color-bg-nav: {{ background }} !important;
    --sl-color-bg-sidebar: {{ background }} !important;
    --sl-color-text: {{ foreground }} !important;
    --sl-color-text-accent: {{ accent }} !important;
}
