#!/bin/bash
# Chromium/Brave file dialogs use GTK3 and only honour
# gtk-application-prefer-dark-theme from settings.ini, not gsettings
# color-scheme. Keep that boolean (and user gtk.css) in sync with the
# active Omarchy theme so open/save pickers are not stuck on Adwaita light.

set -euo pipefail

THEME_DIR="${HOME}/.local/state/omarchy/current/theme"
COLORS_FILE="$THEME_DIR/colors.toml"
GTK_CSS="$THEME_DIR/libadwaita-gtk.css"

mode="dark"
if [[ -f $COLORS_FILE ]] && command -v omarchy-theme-color >/dev/null 2>&1; then
	mode=$(omarchy-theme-color --file "$COLORS_FILE" mode)
fi

if [[ $mode == "light" ]]; then
	gtk_theme="Adwaita"
	prefer_dark=0
else
	gtk_theme="Adwaita-dark"
	prefer_dark=1
fi

write_settings() {
	local dir="$1"
	mkdir -p "$dir"
	cat >"$dir/settings.ini" <<EOF
[Settings]
gtk-theme-name=${gtk_theme}
gtk-application-prefer-dark-theme=${prefer_dark}
EOF
}

write_settings "${HOME}/.config/gtk-3.0"
write_settings "${HOME}/.config/gtk-4.0"

# libadwaita-gtk.css is GTK4/libadwaita (color-mix, :root). GTK3 file
# choosers — including Chromium/Brave — only need settings.ini.
gtk3_css="${HOME}/.config/gtk-3.0/gtk.css"
[[ -L $gtk3_css ]] && rm -f "$gtk3_css"

gtk4_css="${HOME}/.config/gtk-4.0/gtk.css"
mkdir -p "${HOME}/.config/gtk-4.0"
if [[ -f $GTK_CSS ]]; then
	ln -sfn "$GTK_CSS" "$gtk4_css"
elif [[ -L $gtk4_css ]]; then
	rm -f "$gtk4_css"
fi
