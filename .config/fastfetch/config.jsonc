{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "green" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC ",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├ ",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "│ ├󱄄 ",
      "keyColor": "green",
      "text": "fastfetch-hyprdots monitors"
    },
    {
      "type": "command",
      "key": "│ ├/        ",
      "keyColor": "green",
      "text": "fastfetch-hyprdots disk root"
    },
    {
      "type": "command",
      "key": "│ ├/home    ",
      "keyColor": "green",
      "text": "fastfetch-hyprdots disk home"
    },
    {
      "type": "command",
      "key": "│ ├/onedrive",
      "keyColor": "green",
      "text": "fastfetch-hyprdots disk onedrive"
    },
    {
      "type": "command",
      "key": "│ ├/external",
      "keyColor": "green",
      "text": "fastfetch-hyprdots disk external"
    },
    {
      "type": "command",
      "key": "└ └mem      ",
      "keyColor": "green",
      "text": "fastfetch-hyprdots memswap"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS ",
      "keyColor": "blue",
      "text": "version=$(omarchy-version) && echo \"Omarchy $version ($(omarchy-version-channel))\""
    },
    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰏖 ",
      "keyColor": "blue",
      "text": "fastfetch-hyprdots packages"
    },
    {
      "type": "command",
      "key": "└ └󰸌 ",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
