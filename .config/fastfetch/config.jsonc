{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "position": "left",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " 󰑃  "
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": " DISTRO",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├󰹢",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ └󰏖",
            "text": "pac=$(pacman -Qq 2>/dev/null | wc -l); if command -v mise >/dev/null 2>&1; then mise=$(mise ls --json 2>/dev/null | jq '[to_entries[] | .value[]] | length' 2>/dev/null || echo 0); echo \"$pac (pacman), $mise (mise)\"; else echo \"$pac (pacman)\"; fi",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ ├",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days old",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ ├󰅐",
            "text": "s=$(cut -d. -f1 /proc/uptime); d=$((s/86400)); h=$(((s%86400)/3600)); m=$(((s%3600)/60)); if ((d>0)); then echo Up for $d days; elif ((h>0)); then echo Up for $h hours; else echo Up for $m mins; fi",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "host",
            "key": "󰌢 SYSTEM",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰻑",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "│ ├󰍹",
            "keyColor": "green",
            "compactType": "original"
        },
        {
            "type": "memory",
            "key": "│ └󰾆",
            "keyColor": "green"
        },
        "break",
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "│ ├󰣇",
            "text": "quickshell --version 2>/dev/null | cut -d' ' -f1-2",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "command",
            "key": "  AUDIO",
            "text": "default=$(pactl get-default-sink); pactl list sinks | awk -v d=\"$default\" '/Sink #/{block=0} $0 ~ \"Name: \" d {block=1} block && /Description:/ {match($0, /\\(([^)]+)\\)/, a); print a[1]; exit}'",
            "keyColor": "magenta"
        },
        {
            "type": "player",
            "key": "│ ├󰥠",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "│ └󰝚",
            "format": "{?artist}{artist} - {?}{title:-40}",
            "keyColor": "magenta"
        }
    ]
}
