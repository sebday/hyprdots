{
    "editor.fontFamily": "'CaskaydiaMono Nerd Font', 'monospace', monospace",
    "editor.fontLigatures": true,
    "editor.fontVariations": false,
    "git.openRepositoryInParentFolders": "never",
    "npm.autoDetect": "off",
    "typescript.tsc.autoDetect": "off",
    "gulp.autoDetect": "off",
    "grunt.autoDetect": "off",
    "jake.autoDetect": "off",
    "npm.exclude": [
        "**/.cache/**",
        "**/node_modules/**",
        "**/.git/**"
    ],
    "files.watcherExclude": {
        "**/.cache/**": true,
        "**/.config/BraveSoftware/**": true,
        "**/.steam/**": true,
        "**/node_modules/**": true
    },
    "search.exclude": {
        "**/.cache": true,
        "**/.config/BraveSoftware": true,
        "**/.steam": true,
        "**/node_modules": true
    },
    "files.exclude": {
        "**/.cache": true
    },
    "workbench.colorCustomizations": {
        "[Dracula Theme]": {
            "sideBar.background": "#0a0e19",
            "tab.activeBackground": "#282a36",
            "tab.inactiveBackground": "#0a0e19",
        }        
    },
    "workbench.settings.applyToAllProfiles": [],
    "javascript.updateImportsOnFileMove.enabled": "never",
    "explorer.confirmDelete": false,
    "html.autoClosingTags": false,
    "workbench.editor.enablePreview": false,
    "github.branchProtection": false,
    "github.gitAuthentication": false,
    "cursor.general.gitGraphIndexing": "disabled",
    "cursor.general.enableShadowWorkspace": false,
    "chat.editor.fontSize": 16,
    "editor.fontSize": 18,
    "files.autoSave": "afterDelay",
    "cursor.composer.agentLoopOnLints": false,
    "git.confirmSync": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "files.associations": {
        "*.ds": "java"
    },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "workbench.colorTheme": "Catppuccin",
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    },
    "diffEditor.maxComputationTime": 0,
    "window.menuBarVisibility": "toggle",
    "workbench.layoutControl.enabled": false,
    "window.titleBarStyle": "native",
    "cursor.composer.textSizeScale": 1.15,
    "remote.SSH.remotePlatform": {
        "192.168.2.200": "linux",
        "192.168.1.199": "linux"
    },
    "workbench.tree.enableStickyScroll": false,
    "editor.stickyScroll.enabled": false,
    "editor.detectIndentation": false,
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingComments": "never",
    "editor.autoClosingDelete": "never",
    "editor.autoClosingQuotes": "never",
    "editor.codeLensFontFamily": "'CaskaydiaMono Nerd Font', 'monospace', monospace",
    "editor.inlayHints.fontFamily": "'CaskaydiaMono Nerd Font', 'monospace', monospace",
    "explorer.confirmDragAndDrop": false,
    "window.autoDetectColorScheme": false,
    "workbench.agentsWindowButton.enabled": false,
}
