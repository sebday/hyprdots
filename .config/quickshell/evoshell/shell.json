{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 900
  },
  "notifications": {
    "output": "DP-1",
    "position": "top"
  },
  "bar": {
    "id": "evo.bar",
    "position": "bottom",
    "output": "HDMI-A-1",
    "layout": {
      "left": [
        {
          "id": "evo.system",
          "interval": 5,
          "onHover": "evo.system",
          "onClick": "ghostty --class=TUI.main -e btop"
        }
      ],
      "center": [
        {
          "id": "evo.tray",
          "weather": {
            "type": "command",
            "exec": "~/.local/bin/evo-bar-weather",
            "interval": 1800,
            "onHover": "evo.weather",
            "onClick": "~/.local/bin/evo-weather open",
            "onClickRight": "~/.local/bin/evo-weather open"
          },
          "cursor": {
            "type": "command",
            "exec": "~/.local/bin/evo-bar-cursor",
            "interval": 300,
            "onHover": "evo.cursor",
            "onClick": "~/.local/bin/evo-cursor open"
          },
          "github": {
            "interval": 300,
            "onHover": "evo.github",
            "onClick": "brave --class=brave-github --new-window https://github.com/sebday"
          },
          "stocks": {
            "onHover": "evo.stocks"
          },
          "cloudflare": {
            "interval": 60,
            "onHover": "evo.cloudflare",
            "refreshIntervalSec": 60,
            "analyticsIntervalSec": 900
          },
          "audio": {
            "onHover": "evo.volume",
            "mediaOnHover": "evo.media",
            "onClick": "ghostty --class=TUI.main -e alsamixer",
            "onClickRight": "ghostty --class=TUI.main -e wiremix"
          },
          "network": {
            "interval": 2,
            "transmissionInterval": 3,
            "onHover": "evo.network",
            "onClick": "~/.local/bin/evo-ipc shell summon evo.transmission.add \"\"",
            "iconOnly": true
          }
        }
      ],
      "right": [
        {
          "id": "evo.clock",
          "format": "%a %d %H:%M"
        }
      ]
    }
  },
  "panel": {
    "side": "right"
  }
}
