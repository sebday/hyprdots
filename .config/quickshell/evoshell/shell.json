{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 900
  },
  "notifications": {
    "output": "HDMI-A-1"
  },
  "bar": {
    "id": "evo.bar",
    "position": "top",
    "output": "DP-1",
    "layout": {
      "left": [
        {
          "id": "evo.shopify",
          "store": "DIY",
          "interval": 300,
          "onHover": "evo.stats_diy"
        },
        {
          "id": "evo.shopify",
          "store": "TGS",
          "interval": 300,
          "onHover": "evo.stats_tgs"
        }
      ],
      "center": [
        {
          "id": "evo.tray",
          "weather": {
            "type": "command",
            "exec": "~/.local/bin/evo-weather",
            "interval": 1800,
            "onHover": "evo.weather",
            "onClickRight": "xdg-open https://weather.metoffice.gov.uk/forecast/gcqvn6pq4",
            "locations": [
              {
                "name": "Derby",
                "lat": 52.9219,
                "lon": -1.4746
              },
              {
                "name": "Edinburgh",
                "lat": 55.9533,
                "lon": -3.1883
              },
              {
                "name": "Cardiff",
                "lat": 51.4816,
                "lon": -3.1791
              },
              {
                "name": "Belfast",
                "lat": 54.5973,
                "lon": -5.9301
              },
              {
                "name": "Reykjavik",
                "lat": 64.1466,
                "lon": -21.9426
              },
              {
                "name": "Tokyo",
                "lat": 35.6762,
                "lon": 139.6503
              },
              {
                "name": "Singapore",
                "lat": 1.3521,
                "lon": 103.8198
              },
              {
                "name": "Buenos Aires",
                "lat": -34.6037,
                "lon": -58.3816
              },
              {
                "name": "Honolulu",
                "lat": 21.3069,
                "lon": -157.8583
              }
            ]
          },
          "cursor": {
            "type": "command",
            "exec": "~/.local/bin/evo-bar-cursor",
            "interval": 300,
            "onHover": "evo.cursor"
          },
          "github": {
            "interval": 300,
            "onHover": "evo.github",
            "onClick": "xdg-open https://github.com/sebday"
          },
          "stocks": {
            "onHover": "evo.stocks"
          },
          "audio": {
            "onHover": "evo.sound",
            "onClick": "ghostty --class=TUI.main -e wiremix",
            "onClickRight": "ghostty --class=TUI.main -e alsamixer"
          },
          "network": {
            "interval": 2,
            "onHover": "evo.network",
            "iconOnly": true
          }
        }
      ],
      "right": [
        {
          "id": "evo.clock",
          "format": "%a %d %H:%M"
        }
      ]
    }
  },
  "panel": {
    "side": "left"
  }
}
