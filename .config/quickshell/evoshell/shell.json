{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 900
  },
  "notifications": {
    "output": "DP-1",
    "position": "top"
  },
  "bar": {
    "id": "evo.bar",
    "position": "bottom",
    "output": "HDMI-A-1",
    "layout": {
      "left": [
        {
          "id": "evo.bar.popups.system-stats",
          "interval": 5,
          "onHover": "evo.bar.popups.system-stats",
          "onClick": "ghostty --class=TUI.main -e btop"
        }
      ],
      "center": [
        {
          "id": "evo.bar.tray",
          "weather": {
            "type": "command",
            "exec": "~/.local/bin/evo-bar-weather-bar",
            "interval": 1800,
            "onHover": "evo.bar.popups.weather",
            "onClick": "~/.local/bin/evo-bar-weather open",
            "onClickRight": "~/.local/bin/evo-bar-weather open",
            "indoorTemperatureEntity": "climate.downstairs_downstairs",
            "indoorTemperatureRefreshSec": 60
          },
          "cursor": {
            "type": "command",
            "exec": "~/.local/bin/evo-bar-cursor-usage-bar",
            "interval": 300,
            "onHover": "evo.bar.popups.cursor-usage",
            "onClick": "~/.local/bin/evo-bar-cursor-usage open"
          },
          "github": {
            "interval": 300,
            "onHover": "evo.bar.popups.github",
            "onClick": "~/.local/bin/evo-bar-brave open brave-github https://github.com/sebday"
          },
          "notifications": {
            "onHover": "evo.bar.popups.notifications"
          },
          "stocks": {
            "onHover": "evo.bar.popups.stocks"
          },
          "cloudflare": {
            "interval": 60,
            "onHover": "evo.bar.popups.cloudflare",
            "refreshIntervalSec": 60,
            "analyticsIntervalSec": 900
          },
          "homeAssistant": {
            "interval": 30,
            "onHover": "evo.bar.popups.home-assistant",
            "refreshIntervalSec": 30,
            "snapshotIntervalSec": 20,
            "cameraEntities": [],
            "lightEntities": [],
            "lightAreas": [
              "Bathroom",
              "Hallway",
              "Bedroom",
              "Living Room",
              "Shed"
            ],
            "lightGroupsOnly": true,
            "lightBrightnessEntities": [
              "light.shed_shed",
              "light.bathroom_bathroom",
              "light.bedroom_bedroom_2",
              "light.living_room_living_room",
              "light.hallway_hallway"
            ],
            "lightColorEntities": [
              "light.shed_shed",
              "light.bathroom_bathroom",
              "light.bedroom_bedroom_2",
              "light.living_room_living_room",
              "light.hallway_hallway"
            ],
            "climateEntities": [
              "climate.downstairs_downstairs"
            ],
            "temperatureEntities": [],
            "temperatureExclude": [
              "climate.downstairs_downstairs",
              "sensor.downstairs_downstairs_temperature"
            ]
          },
          "audio": {
            "onHover": "evo.bar.media.volume",
            "mediaOnHover": "evo.bar.media.now-playing",
            "onClick": "ghostty --class=TUI.main -e alsamixer",
            "onClickRight": "ghostty --class=TUI.main -e wiremix"
          },
          "network": {
            "interval": 2,
            "transmissionInterval": 3,
            "onHover": "evo.bar.network.stats",
            "onClick": "~/.local/bin/evo-ipc shell summon evo.bar.network.transmission \"\"",
            "iconOnly": true
          }
        }
      ],
      "right": [
        {
          "id": "evo.bar.clock",
          "format": "%a %d %H:%M"
        }
      ]
    }
  },
  "panel": {
    "side": "left"
  },
  "dashboards": {
    "openOnStart": [
      "evo.panel.shopify",
      "evo.panel.player"
    ]
  }
}
