{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 900
  },
  "bar": {
    "id": "evo.bar",
    "position": "bottom",
    "output": "HDMI-A-1",
    "layout": {
      "left": [
        {
          "id": "evo.shopify",
          "store": "DIY",
          "interval": 300,
          "onClick": "~/.local/bin/evo-shell-ipc shell toggle evo.stats"
        },
        {
          "id": "evo.shopify",
          "store": "TGS",
          "interval": 300,
          "onClick": "~/.local/bin/evo-shell-ipc shell toggle evo.stats"
        }
      ],
      "center": [
        {
          "id": "weather",
          "type": "command",
          "exec": "~/.local/bin/evo-bar-weather.sh",
          "interval": 1800,
          "onClick": "~/.local/bin/evo-shell-ipc shell toggle evo.weather",
          "onClickRight": "xdg-open https://weather.metoffice.gov.uk/forecast/gcqvn6pq4"
        },
        {
          "id": "evo.clock",
          "format": "%a %d %H:%M"
        },
        {
          "id": "cursor",
          "type": "command",
          "exec": "~/.local/bin/evo-bar-cursor.sh",
          "interval": 300,
          "onClick": "~/.local/bin/evo-shell-ipc shell toggle evo.cursor"
        }
      ],
      "right": [
        {
          "id": "evo.github",
          "interval": 300,
          "onClick": "xdg-open https://github.com/sebday"
        },
        {
          "id": "evo.cava",
          "onClick": "ghostty --class=TUI.main -e wiremix",
          "onClickRight": "ghostty --class=TUI.main -e alsamixer"
        },
        {
          "id": "evo.audio"
        },
        {
          "id": "evo.tray"
        }
      ]
    }
  },
  "panel": {
    "side": "right"
  }
}
