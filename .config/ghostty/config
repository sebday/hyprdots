# This is the configuration file for Ghostty.

config-file = ~/.themes/current/ghostty.conf

copy-on-select = clipboard
confirm-close-surface = false
window-padding-x = 12
window-padding-y = 12
app-notifications = false

font-family = CaskaydiaMono Nerd Font
font-size = 13

# cap per-tab memory so a runaway cursor agent cannot take down the whole system
# 8 GiB in bytes (ghostty sets memory.high, a soft throttle limit)
linux-cgroup-memory-limit = 8589934592
scrollback-limit = 100000

