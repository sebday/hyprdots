{
  "version": 1,
  "idle": {
    "lock": 1200
  },
  "notifications": {
    "durationMs": 3000,
    "position": "top",
    "output": "DP-1",
    "align": "center"
  },
  "bar": {
    "id": "evo.bar",
    "position": "bottom",
    "layout": {
      "left": [
        {
          "id": "evo.stocks",
          "market": "btc"
        },
        {
          "id": "evo.stocks",
          "market": "spcx"
        },
        {
          "id": "evo.trading"
        }
      ],
      "center": [
        {
          "id": "evo.tray"
        },
        {
          "id": "evo.insync"
        },
        {
          "id": "evo.steam"
        },
        {
          "id": "evo.cursor"
        },
        {
          "id": "evo.github",
          "repoRoots": [
            {
              "path": "/home/seb/projects",
              "label": "projects"
            },
            {
              "path": "/home/seb/work",
              "label": "work"
            }
          ]
        },
        {
          "id": "evo.cloudflare",
          "analyticsIntervalSec": 900
        },
        {
          "id": "evo.panels.notifications",
          "trayMode": true,
          "onHover": "evo.panels.notifications"
        },
        {
          "id": "evo.panels.network.stats",
          "trayMode": true,
          "onHover": "evo.panels.network.stats",
          "iconOnly": true
        },
        {
          "id": "evo.monitors"
        },
        {
          "id": "evo.now-playing"
        }
      ],
      "right": [
        {
          "id": "evo.weather"
        },
        {
          "id": "evo.clock",
          "format": "ddd d HH:mm",
          "effect": false
        }
      ]
    },
    "trayWidgetOrder": [
      "volume",
      "media",
      "workspaces",
      "notifications",
      "network"
    ],
    "output": "HDMI-A-1",
    "trayWidgets": {
      "audio": {},
      "media": {}
    },
    "barWidgets": {
      "workspaces": {
        "enabled": true
      }
    },
    "barWidgetOrder": [
      "volume",
      "media",
      "workspaces",
      "notifications",
      "network"
    ],
    "barChromeOrder": [
      "workspaces"
    ],
    "notificationPlacements": [
      {
        "output": "DP-1",
        "position": "top",
        "align": "center"
      }
    ],
    "placements": [
      {
        "output": "HDMI-A-1",
        "position": "bottom"
      }
    ]
  },
  "dashboards": {
    "openOnStart": [
      "evo.shopify",
      "evo.panels.player"
    ]
  },
  "shopify": {
    "timezone": "Europe/London",
    "apiUrl": "https://data.day.marketing",
    "stores": [
      {
        "key": "DIY",
        "title": "DIY",
        "adminSlug": "diy-buildingsupplies",
        "barPrefix": "D ",
        "sqliteKey": "diy"
      },
      {
        "key": "TGS",
        "title": "TGS",
        "adminSlug": "thegoodsheet-uk",
        "barPrefix": "T ",
        "sqliteKey": "tgs"
      }
    ]
  },
  "wallpaper": {
    "activeDefault": "active://yuruyurau-wave"
  }
}
