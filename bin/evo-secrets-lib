#!/usr/bin/env bash
# Load secrets from pass.
# Entries live under evoshell/. Relative names match that store, with older
# names kept as aliases.

EVOSHELL_PASS_PREFIX="${EVOSHELL_PASS_PREFIX:-evoshell}"

declare -gA EVO_PASS_SECRET_PATHS=(
    [GITHUB_TOKEN]="github/token"
    [KRAKEN_API_KEY]="kraken/api-key"
    [KRAKEN_SECRET]="kraken/api-secret"
    [T212_API_KEY]="trading212/api-key"
    [T212_API_SECRET]="trading212/api-secret"
    [CURSOR_ACCESS_TOKEN]="cursor/token"
    [CLOUDFLARE_API_TOKEN]="cloudflare/read-all"
    [ECOMMERCE_API_TOKEN]="ecommerce-data/api-token"
    [LASTFM_API_KEY]="lastfm/api-key"
    [LASTFM_API_SECRET]="lastfm/api-secret"
    [LASTFM_SESSION_KEY]="lastfm/session-key"
)

declare -gA EVO_PASS_SECRET_ALIASES=(
    [KRAKEN_SECRET]="kraken/secret"
    [CURSOR_ACCESS_TOKEN]="cursor/access-token"
    [CLOUDFLARE_API_TOKEN]="cloudflare/token"
)

evo_pass_prefixes() {
    printf '%s\n' "${EVOSHELL_PASS_PREFIX:-evoshell}"
}

evo_secrets_candidates() {
    local key="$1"
    local rel="${EVO_PASS_SECRET_PATHS[$key]:-}"
    local alias="${EVO_PASS_SECRET_ALIASES[$key]:-}"
    local prefix
    [[ -n "$rel" || -n "$alias" ]] || return 1
    while IFS= read -r prefix; do
        [[ -n "$prefix" ]] || continue
        [[ -n "$rel" ]] && printf '%s/%s\n' "$prefix" "$rel"
        [[ -n "$alias" ]] && printf '%s/%s\n' "$prefix" "$alias"
    done < <(evo_pass_prefixes)
}

evo_pass_show_rel() {
    local rel="$1" prefix value
    command -v pass >/dev/null 2>&1 || return 1
    [[ -n "$rel" ]] || return 1
    while IFS= read -r prefix; do
        [[ -n "$prefix" ]] || continue
        value="$(pass show "${prefix}/${rel}" 2>/dev/null || true)"
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return 0
        fi
    done < <(evo_pass_prefixes)
    return 1
}

# Prints the first existing path. On a miss, prints the preferred path and
# returns 1 so callers can show "missing (path)" without a second decrypt.
evo_secrets_pass_path() {
    local key="$1" path preferred=""
    command -v pass >/dev/null 2>&1 || return 1
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        [[ -n "$preferred" ]] || preferred="$path"
        if pass show "$path" >/dev/null 2>&1; then
            printf '%s' "$path"
            return 0
        fi
    done < <(evo_secrets_candidates "$key")
    printf '%s' "$preferred"
    [[ -n "$preferred" ]] || return 1
    return 1
}

evo_secrets_available() {
    local prefix
    command -v pass >/dev/null 2>&1 || return 1
    while IFS= read -r prefix; do
        [[ -n "$prefix" ]] || continue
        pass ls "$prefix" >/dev/null 2>&1 && return 0
    done < <(evo_pass_prefixes)
    return 1
}

evo_secrets_get() {
    local key="$1" path value
    command -v pass >/dev/null 2>&1 || return 1
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        value="$(pass show "$path" 2>/dev/null || true)"
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return 0
        fi
    done < <(evo_secrets_candidates "$key")
    return 1
}

evo_secrets_set() {
    local key="$1"
    local value="$2"
    local path prefix rel
    [[ -n "$value" ]] || return 1
    if path="$(evo_secrets_pass_path "$key" 2>/dev/null)"; then
        printf '%s' "$value" | pass insert -m -f "$path" >/dev/null
        return 0
    fi
    rel="${EVO_PASS_SECRET_PATHS[$key]:-}"
    [[ -n "$rel" ]] || return 1
    prefix="${EVOSHELL_PASS_PREFIX:-evoshell}"
    printf '%s' "$value" | pass insert -m "$prefix/$rel" >/dev/null
}

evo_secrets_load() {
    local key value
    command -v pass >/dev/null 2>&1 || return 0
    if (($# > 0)); then
        for key in "$@"; do
            value="$(evo_secrets_get "$key" 2>/dev/null || true)"
            [[ -n "$value" ]] || continue
            export "$key=$value"
        done
        return 0
    fi
    for key in "${!EVO_PASS_SECRET_PATHS[@]}"; do
        value="$(evo_secrets_get "$key" 2>/dev/null || true)"
        [[ -n "$value" ]] || continue
        export "$key=$value"
    done
}
