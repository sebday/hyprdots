#!/usr/bin/env bash
# Tasks storage for evoshell — JSON fallback or Obsidian vault tasks.md.

set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${_bin_dir}/evo-storage-lib"

TASKS_JSON="${EVOSHELL_STATE}/apps/tasks.json"

usage() {
    cat >&2 <<'EOF'
usage:
  evo-tasks settings get
  evo-tasks load
  evo-tasks save <json>
  evo-tasks copy <json-text>
EOF
    exit 1
}

ensure_state_dir() {
    mkdir -p "${EVOSHELL_STATE}/apps"
}

tasks_vault() {
    local path
    while IFS= read -r path; do
        [[ -n "$path" && -d "$path" && -f "${path%/}/tasks.md" ]] || continue
        printf '%s' "${path%/}"
        return 0
    done < <(obsidian_vault_paths)
    return 1
}

tasks_file() {
    local vault
    vault="$(tasks_vault || true)"
    if [[ -n "$vault" ]]; then
        printf '%s/tasks.md' "$vault"
    else
        printf '%s' "$TASKS_JSON"
    fi
}

tasks_format() {
    local file
    file="$(tasks_file)"
    if [[ "$file" == *.md ]]; then
        printf 'markdown'
    else
        printf 'json'
    fi
}

is_task_line() {
    local line="$1"
    [[ "$line" =~ ^-[[:space:]]*\[[[:space:]]*[xX]?[[:space:]]*\][[:space:]] ]]
}

parse_task_line() {
    local line="$1"
    local text done=false
    if [[ "$line" =~ ^-[[:space:]]*\[[[:space:]]*([xX])[[:space:]]*\][[:space:]]*(.*)$ ]]; then
        done=true
        text="${BASH_REMATCH[2]}"
    elif [[ "$line" =~ ^-[[:space:]]*\[[[:space:]]*\][[:space:]]*(.*)$ ]]; then
        text="${BASH_REMATCH[1]}"
    else
        return 1
    fi
    jq -n --arg text "$text" --argjson done "$done" '{text: $text, done: $done}'
}

load_json_tasks() {
    local file="$1"
    [[ -f "$file" ]] || {
        echo '[]'
        return 0
    }
    jq -c '
        if type == "object" and (.tasks | type) == "array" then .tasks
        elif type == "array" then .
        else [] end
        | map(select(type == "object"))
        | map({text: (.text // ""), done: (.done == true)})
    ' "$file" 2>/dev/null || echo '[]'
}

load_markdown_tasks() {
    local file="$1"
    local -a tasks=()
    local line task_json
    [[ -f "$file" ]] || {
        echo '[]'
        return 0
    }
    while IFS= read -r line || [[ -n "$line" ]]; do
        if is_task_line "$line"; then
            task_json="$(parse_task_line "$line")"
            tasks+=("$task_json")
        fi
    done <"$file"
    if ((${#tasks[@]} == 0)); then
        echo '[]'
        return 0
    fi
    printf '%s\n' "${tasks[@]}" | jq -s '.'
}

count_markdown_tasks() {
    local file="$1" count=0 line
    [[ -f "$file" ]] || {
        echo 0
        return 0
    }
    while IFS= read -r line || [[ -n "$line" ]]; do
        if is_task_line "$line"; then
            count=$((count + 1))
        fi
    done <"$file"
    echo "$count"
}

save_json_tasks() {
    local file="$1" tasks_json="$2"
    local tmp
    tmp="$(mktemp)"
    jq -n --argjson tasks "$tasks_json" '{tasks: $tasks}' >"$tmp"
    mv "$tmp" "$file"
}

save_markdown_tasks() {
    local file="$1" tasks_json="$2"
    local tmp preamble_tmp
    tmp="$(mktemp)"
    preamble_tmp="$(mktemp)"

    if [[ -f "$file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if is_task_line "$line"; then
                break
            fi
            printf '%s\n' "$line"
        done <"$file" >"$preamble_tmp"
    fi

    if [[ ! -s "$preamble_tmp" ]]; then
        printf '# Tasks\n\n' >"$preamble_tmp"
    else
        sed -i -E '${/^[[:space:]]*$/d;}' "$preamble_tmp" 2>/dev/null || true
        printf '\n' >>"$preamble_tmp"
    fi

    cat "$preamble_tmp" >"$tmp"
    jq -r '.[] | if .done then "- [x] " + (.text // "") else "- [ ] " + (.text // "") end' <<<"$tasks_json" >>"$tmp"
    mv "$tmp" "$file"
    rm -f "$preamble_tmp"
}

cmd_settings_get() {
    local file
    file="$(tasks_file)"
    jq -n \
        --arg tasksFile "$file" \
        --arg format "$(tasks_format)" \
        '{
            ok: true,
            tasksFile: $tasksFile,
            format: $format
        }'
}

cmd_load() {
    local file format tasks
    file="$(tasks_file)"
    format="$(tasks_format)"
    if [[ "$format" == "markdown" ]]; then
        tasks="$(load_markdown_tasks "$file")"
    else
        tasks="$(load_json_tasks "$file")"
    fi
    jq -n \
        --arg tasksFile "$file" \
        --arg format "$format" \
        --argjson tasks "$tasks" \
        '{tasksFile: $tasksFile, format: $format, tasks: $tasks}'
}

cmd_save() {
    local payload="${1:-}"
    [[ -n "$payload" ]] || payload="$(cat)"
    jq -e '.tasks | type == "array"' <<<"$payload" >/dev/null 2>&1 || usage
    local file format tasks
    file="$(tasks_file)"
    format="$(tasks_format)"
    tasks="$(jq -c '.tasks' <<<"$payload")"
    ensure_state_dir
    if [[ "$format" == "markdown" ]]; then
        save_markdown_tasks "$file" "$tasks"
    else
        save_json_tasks "$file" "$tasks"
    fi
    jq -n --arg tasksFile "$file" --arg format "$format" '{ok: true, tasksFile: $tasksFile, format: $format}'
}

cmd_copy() {
    local json="${1:-}"
    [[ -n "$json" ]] || return 0
    local text
    text="$(jq -r . <<<"$json")"
    [[ -n "$text" && "$text" != "null" ]] || return 0
    printf '%s' "$text" | wl-copy
}

target="${1:-}"
action="${2:-}"

case "$target" in
settings)
    case "$action" in
    get)
        cmd_settings_get
        ;;
    *)
        usage
        ;;
    esac
    ;;
load)
    cmd_load
    ;;
save)
    json="${2:-}"
    [[ -n "$json" ]] || json="$(cat)"
    cmd_save "$json"
    ;;
copy)
    json="${2:-}"
    [[ -n "$json" ]] || json="$(cat)"
    cmd_copy "$json"
    ;;
*)
    usage
    ;;
esac
