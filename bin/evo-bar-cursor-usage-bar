#!/bin/bash
# Cursor usage for the bar widget — GET https://cursor.com/api/usage-summary
# Cursor Models = autoPercentUsed · Other Models = apiPercentUsed
#
# Auth: CURSOR_ACCESS_TOKEN in pass (evoshell/cursor/access-token)
_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${_bin_dir}/evo-bar-common"

CURSOR_CACHE_KEY="cursor"
CURSOR_CACHE_SEC="${EVO_CURSOR_CACHE_SEC:-300}"

if cached=$(evo_bar_cache_read "$CURSOR_CACHE_KEY" "$CURSOR_CACHE_SEC" 2>/dev/null); then
    printf '%s\n' "$cached"
    exit 0
fi

evo_bar_load_secrets CURSOR_ACCESS_TOKEN

json_error() {
    jq -cn --arg text "$1" --arg message "${2:-}" \
        '{text: $text, class: "error", message: $message, chips: [], cursorPercent: 0, otherPercent: 0, cycleDaysUsed: 0, cycleDaysTotal: 0, cycleProgress: 0, detail: null}'
}

jwt_sub() {
    local token="$1"
    local payload b64
    payload=$(printf '%s' "$token" | cut -d. -f2)
    [[ -n "$payload" ]] || return 1
    b64="$payload"
    local pad=$(( (4 - ${#b64} % 4) % 4 ))
    b64="${b64}$(printf '%0.s=' $(seq 1 "$pad" 2>/dev/null || true))"
    b64="${b64//-/+}"
    b64="${b64//_/\/}"
    printf '%s' "$b64" | base64 -d 2>/dev/null | jq -r '.sub // empty' 2>/dev/null
}

workos_user_from_sub() {
    local sub="$1"
    if [[ "$sub" == *"|"* ]]; then
        printf '%s' "${sub#*|}"
        return 0
    fi
    printf '%s' "$sub"
}

read_local_access_token() {
    if [[ -n "${CURSOR_ACCESS_TOKEN:-}" ]]; then
        printf '%s' "$CURSOR_ACCESS_TOKEN"
        return 0
    fi
    return 1
}

build_session_cookie() {
    local token="$1"
    local user_id sub

    [[ -n "$token" ]] || return 1
    sub=$(jwt_sub "$token")
    user_id=$(workos_user_from_sub "$sub")
    [[ -n "$user_id" ]] || return 1
    printf '%s::%s' "$user_id" "$token"
}

round_pct() {
    awk -v n="${1:-0}" 'BEGIN { if (n < 0) n = 0; if (n > 100) n = 100; printf "%d", int(n + 0.5) }'
}

iso_to_ms() {
    date -d "$1" +%s%3N 2>/dev/null || echo 0
}

fetch_aggregated() {
    local start_ms="$1" end_ms="$2" body resp
    [[ -n "$start_ms" && -n "$end_ms" && "$start_ms" -gt 0 && "$end_ms" -gt 0 ]] || return 1
    body=$(jq -cn --arg start "$start_ms" --arg end "$end_ms" '{startDate: $start, endDate: $end}')
    resp=$(curl -fsS --max-time 20 \
        "https://cursor.com/api/dashboard/get-aggregated-usage-events" \
        -H "Cookie: WorkosCursorSessionToken=${session_cookie}" \
        -H "Content-Type: application/json" \
        -H "Origin: https://cursor.com" \
        -d "$body" 2>/dev/null) || resp=""
    [[ -n "$resp" ]] || return 1
    printf '%s' "$resp"
}

sum_aggregated_tokens() {
    jq -r '
      ((.totalInputTokens // 0) | tonumber) +
      ((.totalOutputTokens // 0) | tonumber) +
      ((.totalCacheReadTokens // 0) | tonumber) +
      ((.totalCacheWriteTokens // 0) | tonumber)
    ' 2>/dev/null <<< "${1:-{}}"
}

token=$(read_local_access_token || true)
session_cookie=$(build_session_cookie "$token") || session_cookie=""

if [[ -z "$session_cookie" ]]; then
    json_error "󰆧 …" "Run agent login or set CURSOR_ACCESS_TOKEN: pass insert evoshell/cursor/access-token"
    exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
    json_error "󰆧 …" "curl required"
    exit 0
fi

response=$(curl -fsS --max-time 20 \
    "https://cursor.com/api/usage-summary" \
    -H "Cookie: WorkosCursorSessionToken=${session_cookie}" 2>/dev/null) || response=""

if [[ -z "$response" ]]; then
    json_error "󰆧 …" "Could not reach cursor.com/api/usage-summary"
    exit 0
fi

if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    msg=$(echo "$response" | jq -r '.description // .error // "not authenticated"')
    json_error "󰆧 auth" "$msg — run agent login again"
    exit 0
fi

plan_json=$(echo "$response" | jq -c '.individualUsage.plan // empty')
if [[ -z "$plan_json" || "$plan_json" == "null" ]]; then
    json_error "󰆧 —" "No plan usage in API response"
    exit 0
fi

cursor_pct=$(round_pct "$(echo "$plan_json" | jq -r '.autoPercentUsed // 0')")
other_pct=$(round_pct "$(echo "$plan_json" | jq -r '.apiPercentUsed // 0')")

billing_start_iso=$(echo "$response" | jq -r '.billingCycleStart // ""')
billing_end_iso=$(echo "$response" | jq -r '.billingCycleEnd // ""')
cycle_days_used=0
cycle_days_total=0
cycle_progress=0

if [[ -n "$billing_start_iso" && -n "$billing_end_iso" ]]; then
    start_epoch=$(date -d "$(date -d "$billing_start_iso" +%Y-%m-%d 2>/dev/null)" +%s 2>/dev/null || echo 0)
    end_epoch=$(date -d "$(date -d "$billing_end_iso" +%Y-%m-%d 2>/dev/null)" +%s 2>/dev/null || echo 0)
    today_epoch=$(date -d "today 00:00:00" +%s 2>/dev/null || echo 0)
    if (( start_epoch > 0 && end_epoch > start_epoch && today_epoch > 0 )); then
        cycle_days_total=$(( (end_epoch - start_epoch) / 86400 ))
        cycle_days_used=$(( (today_epoch - start_epoch) / 86400 ))
        if (( cycle_days_used < 0 )); then cycle_days_used=0; fi
        if (( cycle_days_total > 0 )); then
            if (( cycle_days_used > cycle_days_total )); then cycle_days_used=$cycle_days_total; fi
            cycle_progress=$(awk -v u="$cycle_days_used" -v t="$cycle_days_total" 'BEGIN { p = u / t; if (p > 1) p = 1; printf "%.4f", p }')
        fi
    fi
fi

now_ms=$(date +%s%3N)
billing_start_ms=$(iso_to_ms "$billing_start_iso")
today_start_ms=$(date -d "today 00:00:00" +%s%3N 2>/dev/null || echo 0)
aggregated_cycle=$(fetch_aggregated "$billing_start_ms" "$now_ms" || echo "{}")
aggregated_today=$(fetch_aggregated "$today_start_ms" "$now_ms" || echo "{}")
tokens_total=$(sum_aggregated_tokens "$aggregated_cycle")
tokens_today=$(sum_aggregated_tokens "$aggregated_today")

evo_bar_load_heatmap_colors
cursor_color="${GITHUB_COLORS[2]:-#74c7ec}"
other_color="${GITHUB_COLORS[4]:-#cba6f7}"
heatmap_json=$(printf '%s\n' "${GITHUB_COLORS[@]}" | jq -R . | jq -s .)

model_split_json=$(jq -c --argjson colors "$heatmap_json" '
  [.aggregations[]?
    | {
        model: .modelIntent,
        tokens: ((.inputTokens // "0") | tonumber)
          + ((.outputTokens // "0") | tonumber)
          + ((.cacheReadTokens // "0") | tonumber)
          + ((.cacheWriteTokens // "0") | tonumber)
      }
  ]
  | sort_by(-.tokens)
  | .[0:6]
  | (map(.tokens) | add // 0) as $total
  | to_entries
  | map({
      model: .value.model,
      tokens: .value.tokens,
      percent: (if $total > 0 then (.value.tokens / $total * 100) else 0 end),
      color: $colors[.key % ($colors | length)]
    })
' <<< "${aggregated_cycle:-{}}")

chips_json=$(jq -cn \
    --argjson cursor "$cursor_pct" \
    --argjson other "$other_pct" \
    --arg cursorColor "$cursor_color" \
    --arg otherColor "$other_color" \
    '[
      {label: "Cursor", percent: $cursor, color: $cursorColor, group: "cursor"},
      {label: "Other", percent: $other, color: $otherColor, group: "other"}
    ]')

detail_json=$(echo "$response" | jq -c \
    --argjson cursorPct "$cursor_pct" \
    --argjson otherPct "$other_pct" \
    --argjson tokensTotal "$tokens_total" \
    --argjson tokensToday "$tokens_today" \
    --argjson modelSplit "$model_split_json" \
    --argjson cycleDaysUsed "$cycle_days_used" \
    --argjson cycleDaysTotal "$cycle_days_total" \
    --argjson cycleProgress "$cycle_progress" \
    --arg cursorColor "$cursor_color" \
    --arg otherColor "$other_color" \
    '{
      membership: (.membershipType // "unknown"),
      billingCycleStart: (.billingCycleStart // ""),
      billingCycleEnd: (.billingCycleEnd // ""),
      autoMessage: (.autoModelSelectedDisplayMessage // ""),
      apiMessage: (.namedModelSelectedDisplayMessage // ""),
      onDemand: (.individualUsage.onDemand.enabled // false),
      onDemandUsed: (.individualUsage.onDemand.used // 0),
      cursorPercent: $cursorPct,
      otherPercent: $otherPct,
      tokensTotal: $tokensTotal,
      tokensToday: $tokensToday,
      modelSplit: $modelSplit,
      cycleDaysUsed: $cycleDaysUsed,
      cycleDaysTotal: $cycleDaysTotal,
      cycleProgress: $cycleProgress,
      cursorColor: $cursorColor,
      otherColor: $otherColor
    }')

output=$(jq -cn \
    --arg text "󰆧 ${cursor_pct}% / ${other_pct}%" \
    --argjson chips "$chips_json" \
    --argjson cursorPercent "$cursor_pct" \
    --argjson otherPercent "$other_pct" \
    --argjson cycleDaysUsed "$cycle_days_used" \
    --argjson cycleDaysTotal "$cycle_days_total" \
    --argjson cycleProgress "$cycle_progress" \
    --argjson detail "$detail_json" \
    '{text: $text, class: "cursor-usage", chips: $chips, cursorPercent: $cursorPercent, otherPercent: $otherPercent, cycleDaysUsed: $cycleDaysUsed, cycleDaysTotal: $cycleDaysTotal, cycleProgress: $cycleProgress, detail: $detail}')

printf '%s\n' "$output" | evo_bar_cache_write "$CURSOR_CACHE_KEY"
printf '%s\n' "$output"
