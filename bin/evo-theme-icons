#!/bin/bash
set -euo pipefail
# Generate Papirus-Dark icon themes recoloured from colors.toml (icon_text, icon_highlight).
#
# USAGE:
#   evo-sys-themes-icons ensure-base
#   evo-sys-themes-icons build <theme-slug>
#   evo-sys-themes-icons activate <theme-slug>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/evo-theme-lib"

ICON_THEME_NAME="evo-current"
PAPIRUS_BASE="/usr/share/icons/Papirus-Dark"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/evo-icons"
ICON_LINK="${XDG_DATA_HOME:-$HOME/.local/share}/icons/$ICON_THEME_NAME"
ICON_ACTIVATE_LOCK="${CACHE_ROOT}/.activate.lock"

DEFAULT_ICON_HIGHLIGHT="#5294e2"
DEFAULT_ICON_BUTTON_BG="#d3dae3"

TEXT_SOURCE_HEXES=(dfdfdf 5c616c 6e6e6e)
HIGHLIGHT_SOURCE_HEXES=(5294e2 4285f4)
BUTTON_BG_SOURCE_HEX=(d3dae3)

hex_strip() {
    local value="$1"
    printf '%s' "${value#\#}" | tr '[:upper:]' '[:lower:]'
}

ensure_base() {
    if [[ ! -f "$PAPIRUS_BASE/index.theme" ]]; then
        echo "evo-sys-themes-icons: install papirus-icon-theme (sudo pacman -S papirus-icon-theme)" >&2
        return 1
    fi
}

read_icon_colors() {
    local toml="$1"
    ICON_TEXT=$(toml_val icon_text "$toml")
    ICON_HIGHLIGHT=$(toml_val icon_highlight "$toml" || true)
    ICON_BUTTON_BG=$(toml_val icon_button_background "$toml" || true)

    [[ -n "$ICON_TEXT" ]] || {
        echo "evo-sys-themes-icons: missing icon_text in $toml" >&2
        return 1
    }

    [[ -n "$ICON_HIGHLIGHT" ]] || ICON_HIGHLIGHT="$DEFAULT_ICON_HIGHLIGHT"
    [[ -n "$ICON_BUTTON_BG" ]] || ICON_BUTTON_BG="$DEFAULT_ICON_BUTTON_BG"

    ICON_TEXT_HEX=$(hex_strip "$ICON_TEXT")
    ICON_HIGHLIGHT_HEX=$(hex_strip "$ICON_HIGHLIGHT")
    ICON_BUTTON_BG_HEX=$(hex_strip "$ICON_BUTTON_BG")
}

stamp_for_theme() {
    local slug="$1"
    local toml="$THEME_DIR/$slug/colors.toml"
    local pkg_ver

    read_icon_colors "$toml"
    pkg_ver=$(pacman -Q papirus-icon-theme 2>/dev/null || echo "unknown")
    printf '%s|%s|%s|%s' "$ICON_TEXT_HEX" "$ICON_HIGHLIGHT_HEX" "$ICON_BUTTON_BG_HEX" "$pkg_ver" \
        | sha256sum | awk '{print $1}'
}

cache_dir_for() {
    printf '%s/%s' "$CACHE_ROOT" "$1"
}

is_current_theme_slug() {
    local slug="$1"
    local current

    current=$(current_theme_name) || return 1
    [[ "$current" == "$slug" ]]
}

recolor_svgs() {
    local target_dir="$1"
    local sed_script hex

    sed_script=$(mktemp)
    for hex in "${TEXT_SOURCE_HEXES[@]}"; do
        printf 's/#%s/#%s/gi\n' "$hex" "$ICON_TEXT_HEX" >>"$sed_script"
    done
    for hex in "${HIGHLIGHT_SOURCE_HEXES[@]}"; do
        printf 's/#%s/#%s/gi\n' "$hex" "$ICON_HIGHLIGHT_HEX" >>"$sed_script"
    done
    printf 's/#%s/#%s/gi\n' "$BUTTON_BG_SOURCE_HEX" "$ICON_BUTTON_BG_HEX" >>"$sed_script"
    find "$target_dir" -name '*.svg' -type f -exec sed -i -f "$sed_script" {} +
    rm -f "$sed_script"
}

build_theme_icons() {
    local slug="$1"
    local toml="$THEME_DIR/$slug/colors.toml"
    local cache_dir stamp expected_stamp

    ensure_base
    [[ -f "$toml" ]] || {
        echo "evo-sys-themes-icons: theme not found: $slug" >&2
        return 1
    }

    read_icon_colors "$toml"
    cache_dir=$(cache_dir_for "$slug")
    stamp="$cache_dir/.stamp"
    expected_stamp=$(stamp_for_theme "$slug")

    mkdir -p "$cache_dir"
    exec 8>"$cache_dir/.lock"
    flock 8

    if [[ -f "$stamp" && "$(cat "$stamp")" == "$expected_stamp" && -f "$cache_dir/index.theme" ]]; then
        return 0
    fi

    mkdir -p "$CACHE_ROOT"
    rsync -aL --delete "$PAPIRUS_BASE/" "$cache_dir/"
    sed -i "s/^Name=.*/Name=$ICON_THEME_NAME/" "$cache_dir/index.theme"
    recolor_svgs "$cache_dir"
    printf '%s' "$expected_stamp" >"$stamp"
}

link_active_theme() {
    local slug="$1"
    local cache_dir

    cache_dir=$(cache_dir_for "$slug")
    mkdir -p "$(dirname "$ICON_LINK")"
    ln -sfn "$cache_dir" "$ICON_LINK"
    ln -sfn "$cache_dir" "$CACHE_ROOT/$ICON_THEME_NAME"
    gtk-update-icon-cache -f "$ICON_LINK"
}

activate_theme_icons() {
    local slug="$1"
    [[ -n "$slug" ]] || {
        echo "evo-sys-themes-icons: theme slug required" >&2
        return 1
    }

    build_theme_icons "$slug"

    mkdir -p "$CACHE_ROOT"
    exec 7>"$ICON_ACTIVATE_LOCK"
    flock 7

    if ! is_current_theme_slug "$slug"; then
        return 0
    fi

    link_active_theme "$slug"
}

usage() {
    cat >&2 <<EOF
usage: evo-sys-themes-icons ensure-base
       evo-sys-themes-icons build <theme-slug>
       evo-sys-themes-icons activate <theme-slug>
EOF
}

COMMAND="${1:-}"
ARG="${2:-}"

case "$COMMAND" in
    ensure-base)
        ensure_base
        ;;
    build)
        [[ -n "$ARG" ]] || {
            usage
            exit 1
        }
        build_theme_icons "$ARG"
        ;;
    activate)
        [[ -n "$ARG" ]] || {
            usage
            exit 1
        }
        activate_theme_icons "$ARG"
        ;;
    *)
        usage
        exit 1
        ;;
esac
