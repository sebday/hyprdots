#!/usr/bin/env bash
# Shared helpers for evo-menu-list (bindings, shell, icons modes).
set -euo pipefail

_menu_list_shorten_path() {
    local home="$1" p="$2"
    if [[ "$p" == "$home/"* || "$p" == "$home" ]]; then
        printf '~%s' "${p#$home}"
    else
        printf '%s' "$p"
    fi
}

_menu_list_join_files() {
    local home="$1"
    shift
    local -A seen=()
    local out=() short
    for p in "$@"; do
        [[ -n "$p" ]] || continue
        short="$(_menu_list_shorten_path "$home" "$p")"
        [[ -n "$short" && -z "${seen[$short]+x}" ]] || continue
        seen["$short"]=1
        out+=("$short")
    done
    local IFS='|'
    printf '%s' "${out[*]}"
}

# Returns plugin id lines: id<TAB>path<TAB>servicePath (from shell.qml, matching python)
_menu_list_plugin_table_tsv() {
    local evoshell="$1"
    local shell_qml="$evoshell/shell.qml"
    [[ -f "$shell_qml" ]] || return 0
    awk '
    {
        pos = 1
        while (match(substr($0, pos), /"([^"]+)":\s*\{([^}]+)\}/, m)) {
            block = m[2]
            path = ""
            service = ""
            if (match(block, /path:[[:space:]]*"([^"]+)"/, pm))
                path = pm[1]
            if (match(block, /servicePath:[[:space:]]*"([^"]+)"/, sm))
                service = sm[1]
            print m[1] "\t" path "\t" service
            pos += RSTART + RLENGTH - 1
        }
    }
    ' "$shell_qml" 2>/dev/null || true
}

_menu_list_plugin_paths() {
    local evoshell="$1" plugin_id="$2"
    local table
    table="$(_menu_list_plugin_table_tsv "$evoshell")"
    [[ -n "$table" ]] || return 0
    local id path service
    while IFS=$'\t' read -r id path service; do
        [[ "$id" == "$plugin_id" ]] || continue
        [[ -n "$path" ]] && printf '%s/%s\n' "$evoshell" "$path"
        [[ -n "$service" ]] && printf '%s/%s\n' "$evoshell" "$service"
        return 0
    done <<< "$table"
}

_menu_list_bindings_awk() {
    awk -v home="$1" -v evoshell_bindings_path="$2" -v personal_bindings_path="$3" -v evoshell="$4" -f - <<'AWK'
BEGIN {
    bin = home "/.local/lib/evoshell/bin"
    if (evoshell != "") {
        bin = evoshell
    }
    shell_ipc = bin "/_ipc"
    vars["bin"] = bin
    vars["shell_ipc"] = shell_ipc
    OFS = "\t"
}

function load_plugin_table(    line, pos, m, block) {
    plugin_n = 0
    while ((getline line < (evoshell "/shell.qml")) > 0) {
        pos = 1
        while (match(substr(line, pos), /"([^"]+)":\s*\{([^}]+)\}/, m)) {
            block = m[2]
            plugin_n++
            ptbl_id[plugin_n] = m[1]
            ptbl_path[plugin_n] = ""
            ptbl_service[plugin_n] = ""
            if (match(block, /path:[[:space:]]*"([^"]+)"/, pm))
                ptbl_path[plugin_n] = pm[1]
            if (match(block, /servicePath:[[:space:]]*"([^"]+)"/, sm))
                ptbl_service[plugin_n] = sm[1]
            pos += RSTART + RLENGTH - 1
        }
    }
    close(evoshell "/shell.qml")
}

function join_paths(arr, n,    i, seen, out, k, short) {
    delete seen
    delete out
    k = 0
    for (i = 1; i <= n; i++) {
        short = shorten(arr[i])
        if (short != "" && !(short in seen)) {
            seen[short] = 1
            out[++k] = short
        }
    }
    result = out[1]
    for (i = 2; i <= k; i++)
        result = result "|" out[i]
    return result
}

function shorten(p) {
    if (substr(p, 1, length(home)) == home)
        return "~" substr(p, length(home) + 1)
    return p
}

function parse_lua_locals(source,    n, lines, line) {
    n = split(source, lines, "\n")
    for (i = 1; i <= n; i++) {
        line = lines[i]
        if (match(line, /^[[:space:]]*(local[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*"([^"]*)"[[:space:]]*$/, m))
            vars[m[2]] = m[3]
        else if (match(line, /^[[:space:]]*(local[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\.\.[[:space:]]*"([^"]*)"[[:space:]]*$/, m)) {
            base = (m[3] in vars) ? vars[m[3]] : m[3]
            vars[m[2]] = base m[4]
        } else if (match(line, /^[[:space:]]*(local[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*\(os\.getenv\("HOME"\)[[:space:]]+or[[:space:]]*""\)[[:space:]]*\.\.[[:space:]]*"([^"]*)"[[:space:]]*$/, m))
            vars[m[2]] = home m[3]
    }
}

function skip_ws_comma(s, i) {
    while (i <= length(s) && index(" \t\n\r,", substr(s, i, 1)))
        i++
    return i
}

function parse_lua_string(s, i,    quote, out, ch) {
    i = skip_ws_comma(s, i)
    if (i > length(s))
        return ""
    quote = substr(s, i, 1)
    if (quote != "\"" && quote != "'")
        return ""
    i++
    out = ""
    while (i <= length(s)) {
        ch = substr(s, i, 1)
        if (ch == "\\" && i + 1 <= length(s)) {
            out = out substr(s, i + 1, 1)
            i += 2
            continue
        }
        if (ch == quote)
            return out
        out = out ch
        i++
    }
    return ""
}

function parse_lua_string_pos(s, i, ret,    quote, out, ch, start) {
    start = i
    i = skip_ws_comma(s, i)
    if (i > length(s)) {
        ret[1] = ""
        ret[2] = start
        return
    }
    quote = substr(s, i, 1)
    if (quote != "\"" && quote != "'") {
        ret[1] = ""
        ret[2] = start
        return
    }
    i++
    out = ""
    while (i <= length(s)) {
        ch = substr(s, i, 1)
        if (ch == "\\" && i + 1 <= length(s)) {
            out = out substr(s, i + 1, 1)
            i += 2
            continue
        }
        if (ch == quote) {
            ret[1] = out
            ret[2] = i + 1
            return
        }
        out = out ch
        i++
    }
    ret[1] = ""
    ret[2] = start
}

function parse_bindd_arg(s, i, ret,    start, depth_paren, depth_brace, ch, parsed) {
    i = skip_ws_comma(s, i)
    start = i
    depth_paren = 0
    depth_brace = 0
    while (i <= length(s)) {
        ch = substr(s, i, 1)
        if (ch == "\"" || ch == "'") {
            parse_lua_string_pos(s, i, parsed)
            if (parsed[2] > i)
                i = parsed[2]
            else
                i++
            continue
        }
        if (ch == "(")
            depth_paren++
        else if (ch == ")") {
            if (depth_paren == 0 && depth_brace == 0)
                break
            depth_paren--
        } else if (ch == "{")
            depth_brace++
        else if (ch == "}")
            depth_brace--
        else if (ch == "," && depth_paren == 0 && depth_brace == 0)
            break
        i++
    }
    ret[1] = trim(substr(s, start, i - start))
    ret[2] = i
}

function trim(s) {
    sub(/^[ \t\n\r]+/, "", s)
    sub(/[ \t\n\r]+$/, "", s)
    return s
}

function collapse_ws(s) {
    gsub(/[ \t\n\r]+/, " ", s)
    sub(/^ /, "", s)
    sub(/ $/, "", s)
    return s
}

function expand_lua_expr(expr,    m, left, right, bare) {
    expr = collapse_ws(expr)
    if (match(expr, /^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\.\.[[:space:]]*(.+)$/, m)) {
        left = (m[1] in vars) ? vars[m[1]] : m[1]
        right = parse_lua_string(m[2], 1)
        if (right != "")
            return left right
    }
    bare = parse_lua_string(expr, 1)
    if (bare != "" && (substr(expr, 1, 1) == "\"" || substr(expr, 1, 1) == "'"))
        return bare
    if (match(expr, /^[A-Za-z_][A-Za-z0-9_]*$/))
        return (expr in vars) ? vars[expr] : expr
    return expr
}

function simplify_cmd(cmd,    expanded) {
    cmd = expand_lua_expr(cmd)
    cmd = collapse_ws(cmd)
    if (match(cmd, /_ipc[[:space:]]+(.+)$/, m))
        return "evo ipc " trim(m[1])
    return cmd
}

function humanize_flags(flags) {
    if (flags == "")
        return ""
    hints = ""
    nh = 0
    if (match(flags, /repeating[[:space:]]*=[[:space:]]*true/))
        hint[++nh] = "repeating"
    if (match(flags, /locked[[:space:]]*=[[:space:]]*true/))
        hint[++nh] = "active when screen locked"
    if (match(flags, /mouse[[:space:]]*=[[:space:]]*true/))
        hint[++nh] = "mouse binding"
    if (nh == 0)
        return ""
    result = hint[1]
    for (i = 2; i <= nh; i++)
        result = result ", " hint[i]
    return " · " result
}

function humanize_dispatcher(d,    cmd) {
    d = collapse_ws(d)
    if (substr(d, 1, 8) == "function")
        return "Custom Lua handler in bindings.lua"
    if (match(d, /hl\.dsp\.exec_cmd\((.+)\)[[:space:]]*$/, m)) {
        cmd = simplify_cmd(m[1])
        if (substr(cmd, 1, 8) == "evo ipc ")
            return "Runs evo ipc: " substr(cmd, 9)
        return "Runs: " cmd
    }
    if (match(d, /hl\.dsp\.global\([[:space:]]*"([^"]+)"[[:space:]]*\)/, m))
        return "Hyprland global event: " m[1]
    if (match(d, /hl\.dsp\.window\.close\(\)/))
        return "Hyprland: close active window"
    if (match(d, /hl\.dsp\.window\.drag\(\)/))
        return "Hyprland: drag window with mouse"
    if (match(d, /hl\.dsp\.window\.resize\(\)/) && !match(d, /hl\.dsp\.window\.resize\([[:space:]]*\{/))
        return "Hyprland: resize window with mouse"
    if (match(d, /hl\.dsp\.layout\([[:space:]]*"([^"]+)"[[:space:]]*\)/, m))
        return "Hyprland layout: " m[1]
    if (match(d, /hl\.dsp\.workspace\.toggle_special\([[:space:]]*"([^"]+)"[[:space:]]*\)/, m))
        return "Hyprland: toggle special workspace " m[1]
    if (match(d, /hl\.dsp\.focus\([[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*([0-9]+)[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: focus workspace " m[1]
    if (match(d, /hl\.dsp\.focus\([[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: focus workspace " m[1]
    if (match(d, /hl\.dsp\.focus\([[:space:]]*\{[[:space:]]*direction[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: move focus " m[1]
    if (match(d, /hl\.dsp\.window\.move\([[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*([0-9]+)/, m))
        return "Hyprland: move window to workspace " m[1]
    if (match(d, /hl\.dsp\.window\.move\([[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: move window to " m[1]
    if (match(d, /hl\.dsp\.window\.move\([[:space:]]*\{[[:space:]]*direction[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: move window " m[1]
    if (match(d, /hl\.dsp\.window\.float\([[:space:]]*\{[[:space:]]*action[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*\}[[:space:]]*\)/, m))
        return "Hyprland: " m[1] " floating"
    if (match(d, /hl\.dsp\.window\.fullscreen\(/))
        return "Hyprland: set window fullscreen"
    if (match(d, /hl\.dsp\.window\.resize\([[:space:]]*\{[[:space:]]*x[[:space:]]*=[[:space:]]*(-?[0-9]+)/, m))
        return "Hyprland: resize window width by " m[1] " px"
    if (match(d, /hl\.dsp\.window\.set_prop\(/))
        return "Hyprland: toggle window opacity"
    if (match(d, /hl\.dsp\.pass\(/))
        return "Hyprland: pass key to window"
    return d
}

function related_files_for_binding(dispatcher, source_path,    files, n, d, m, expanded, cmd, token, paths, i, pp) {
    delete files
    n = 1
    files[1] = source_path != "" ? source_path : bindings_path
    d = collapse_ws(dispatcher)
    if (index(d, "evoshell:"))
        files[++n] = evoshell "/shell.qml"
    if (match(d, /hl\.dsp\.exec_cmd\((.+)\)[[:space:]]*$/, m)) {
        expanded = expand_lua_expr(trim(m[1]))
        cmd = simplify_cmd(m[1])
        if (index(expanded, "evo ipc") || index(cmd, "evo ipc")) {
            files[++n] = bin "/_ipc"
            files[++n] = evoshell "/shell.qml"
            if (index(cmd, "toggleSystemMenu")) {
                split(plugin_paths("evo.sys.menu"), pp, "|")
                for (i in pp)
                    if (pp[i] != "")
                        files[++n] = unshorten(pp[i])
            }
            if (match(cmd, /shell toggle evo\.panel/)) {
                split(plugin_paths("evo.side"), pp, "|")
                for (i in pp)
                    if (pp[i] != "")
                        files[++n] = unshorten(pp[i])
            }
            if (match(cmd, /shell toggle (evo\.[^[:space:]]+)/, pm)) {
                split(plugin_paths(pm[1]), pp, "|")
                for (i in pp)
                    if (pp[i] != "")
                        files[++n] = unshorten(pp[i])
            }
        }
        if (expanded != "") {
            split(expanded, parts, /[[:space:]]+/)
            token = parts[1]
            home_prefix = home "/"
            if (substr(token, 1, length(home_prefix)) == home_prefix ||
                (substr(token, 1, 1) == "/" && (index(token, "/evo-") || match(token, /\.lua$/))))
                files[++n] = token
        }
    }
    return join_paths(files, n)
}

function unshorten(s) {
    if (substr(s, 1, 1) == "~")
        return home substr(s, 2)
    return s
}

function plugin_paths(want_id,    i, arr, n) {
    n = 0
    for (i = 1; i <= plugin_n; i++) {
        if (ptbl_id[i] == want_id) {
            if (ptbl_path[i] != "")
                arr[++n] = shorten(evoshell "/" ptbl_path[i])
            if (ptbl_service[i] != "")
                arr[++n] = shorten(evoshell "/" ptbl_service[i])
            break
        }
    }
    return join_paths(arr, n)
}

function seen_pair(keys, desc) {
    key = keys SUBSEP desc
    if (key in seen)
        return 1
    seen[key] = 1
    return 0
}

END {
    text = ""
    evoshell_text_len = 0
    if (evoshell_bindings_path != "" && evoshell_bindings_path != "-") {
        while ((getline line < evoshell_bindings_path) > 0)
            text = text line "\n"
        close(evoshell_bindings_path)
        evoshell_text_len = length(text)
    }
    if (personal_bindings_path != "" && personal_bindings_path != "-") {
        while ((getline line < personal_bindings_path) > 0)
            text = text line "\n"
        close(personal_bindings_path)
    }
    load_plugin_table()
    parse_lua_locals(text)
    i = 1
    parsed[0] = 0
    while (1) {
        start = index(substr(text, i), "bindd(")
        if (start == 0)
            break
        start = i + start - 1
        pos = start + length("bindd(")
        parse_lua_string_pos(text, pos, parsed)
        keys = parsed[1]
        pos = parsed[2]
        if (keys == "")
            { i = start + 1; continue }
        parse_lua_string_pos(text, pos, parsed)
        desc = parsed[1]
        pos = parsed[2]
        if (desc == "")
            { i = start + 1; continue }
        parse_bindd_arg(text, pos, parsed)
        dispatcher = parsed[1]
        pos = parsed[2]
        parse_bindd_arg(text, pos, parsed)
        flags = parsed[1]
        pos = parsed[2]
        pos = skip_ws_comma(text, pos)
        if (pos <= length(text) && substr(text, pos, 1) == ")")
            pos++
        keys = trim(keys)
        desc = trim(desc)
        if (keys == "" || desc == "")
            { i = pos; continue }
        if (seen_pair(keys, desc))
            { i = pos; continue }
        source_path = personal_bindings_path
        if (start <= evoshell_text_len && evoshell_bindings_path != "" && evoshell_bindings_path != "-")
            source_path = evoshell_bindings_path
        detail = humanize_dispatcher(dispatcher) humanize_flags(flags)
        files = related_files_for_binding(dispatcher, source_path)
        print desc, keys, detail, files
        i = pos
    }
}
AWK
}

menu_list_bindings() {
    local personal_file="${1:-}"
    local home="$2"
    local evoshell="${EVOSHELL_ROOT:-$home/projects/evoshell}"
    local evoshell_bindings="$evoshell/hypr/bindings.lua"
    local personal_path="-"
    [[ -n "$personal_file" && -f "$personal_file" ]] && personal_path="$personal_file"
    [[ -f "$evoshell_bindings" ]] || evoshell_bindings="-"
    _menu_list_bindings_awk "$home" "$evoshell_bindings" "$personal_path" "$evoshell"
}

menu_list_shell() {
    local home="$1" script_dir="$2"
    local ipc="evo ipc"
    local evoshell="${EVOSHELL_ROOT:-$home/projects/evoshell}"
local bin="${EVOSHELL_BIN:-${EVOSHELL_ROOT:-$HOME/projects/evoshell}/bin}"
    local ipc_bin="${bin}/_ipc"
    local corpus="" chunk path bn

    _menu_list_read_text() {
        [[ -f "$1" ]] && cat "$1" || true
    }

    corpus="$(_menu_list_read_text "$home/.config/hypr/bindings.lua")"
    corpus+=$'\n'"$(_menu_list_read_text "$evoshell/evosys/menu/MenuEntries.js")"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        corpus+=$'\n'"$(_menu_list_read_text "$path")"
    done < <(find "$evoshell/evobar/widgets" -maxdepth 1 -name '*.qml' 2>/dev/null | sort)
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        bn="$(basename "$path")"
        [[ "$bn" == "evo-menu-list" || "$bn" == "evo-menu-list-lib" || "$bn" == "_ipc" ]] && continue
        corpus+=$'\n'"$(_menu_list_read_text "$path")"
    done < <(find "$script_dir" -maxdepth 1 -name 'evo-*' 2>/dev/null | sort)

    local shell_qml="$(_menu_list_read_text "$evoshell/shell.qml")"
    for marker in toggleSystemMenu \
        'openDashboardOnly("evo.panels.player"'; do
        [[ "$shell_qml" == *"$marker"* ]] && corpus+=$'\n'"$marker"
    done

    _menu_list_used() {
        local needle
        for needle in "$@"; do
            [[ "$corpus" == *"$needle"* ]] && return 0
        done
        return 1
    }

    _menu_list_plugin_used() {
        local plugin="$1"
        if [[ "$plugin" == "evo.sys.menu" ]]; then
            _menu_list_used toggleSystemMenu 'toggle("evo.sys.menu"' "toggle evo.sys.menu"
            return
        fi
        _menu_list_used \
            "shell toggle $plugin" \
            "toggle $plugin" \
            "toggle(\"$plugin\"" \
            "toggle('$plugin'" \
            "summon $plugin" \
            "hide $plugin"
    }

    _menu_list_dashboard_used() {
        local plugin="$1"
        _menu_list_used "openDashboard $plugin" "openDashboardOnly(\"$plugin\""
    }

    _menu_list_related_files_for_shell() {
        local command="$1"
        local -a files=("$ipc_bin")
        local cmd="${command#"${command%%[![:space:]]*}"}"
        cmd="${cmd%"${cmd##*[![:space:]]}"}"

        if [[ "$cmd" =~ ^evo[[:space:]]+ipc[[:space:]]+(evo\.[^[:space:]]+) ]]; then
            while IFS= read -r p; do
                [[ -n "$p" ]] && files+=("$p")
            done < <(_menu_list_plugin_paths "$evoshell" "${BASH_REMATCH[1]}")
        fi

        if [[ "$cmd" =~ [[:space:]]shell[[:space:]] ]] || [[ "$cmd" == shell* ]]; then
            files+=("$evoshell/shell.qml")
        fi

        if [[ "$cmd" == *toggleSystemMenu* ]]; then
            while IFS= read -r p; do
                [[ -n "$p" ]] && files+=("$p")
            done < <(_menu_list_plugin_paths "$evoshell" "evo.sys.menu")
        elif [[ "$cmd" =~ shell[[:space:]]toggle[[:space:]]evo\.panel ]]; then
            while IFS= read -r p; do
                [[ -n "$p" ]] && files+=("$p")
            done < <(_menu_list_plugin_paths "$evoshell" "evo.side")
        else
            local pat plugin
            for pat in \
                'shell toggle[[:space:]]+([^[:space:]]+)' \
                'shell summon[[:space:]]+([^[:space:]]+)' \
                'shell hide[[:space:]]+([^[:space:]]+)' \
                'shell openDashboard[[:space:]]+([^[:space:]]+)' \
                'shell call[[:space:]]+([^[:space:]]+)'; do
                if [[ "$cmd" =~ $pat ]]; then
                    plugin="${BASH_REMATCH[1]}"
                    while IFS= read -r p; do
                        [[ -n "$p" ]] && files+=("$p")
                    done < <(_menu_list_plugin_paths "$evoshell" "$plugin")
                    break
                fi
            done
        fi

        _menu_list_join_files "$home" "${files[@]}"
    }

    _menu_list_emit() {
        local name="$1" command="$2" internal="$3" detail="${4:-}"
        local files
        files="$(_menu_list_related_files_for_shell "$command")"
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$command" "$detail" "$files" "$([[ "$internal" == true ]] && echo 1 || echo 0)"
    }

    _menu_list_plugin_detail() {
        case "$1" in
        evo.sys.menu) echo "Shows or hides the system menu overlay." ;;
        evo.side) echo "Shows or hides a side panel (calc, tasks)." ;;
        evo.sys.settings) echo "Shows or hides the evoshell settings overlay." ;;
        evo.panels.calendar) echo "Shows or hides the calendar overlay." ;;
        evo.panels.cursor) echo "Shows or hides the Cursor agent overlay." ;;
        evo.panels.weather) echo "Shows or hides the weather overlay." ;;
        evo.panels.network.stats) echo "Shows or hides the network status overlay." ;;
        evo.panels.media.volume) echo "Shows or hides the volume overlay." ;;
        evo.panels.media.now-playing) echo "Shows or hides the media player overlay." ;;
        evo.panels.github) echo "Shows or hides the GitHub activity overlay." ;;
        evo.panels.system) echo "Shows or hides the system status overlay." ;;
        evo.panels.stocks) echo "Shows or hides the stocks overlay." ;;
        evo.panels.cloudflare) echo "Shows or hides the Cloudflare overlay." ;;
        evo.panels.network.transmission) echo "Shows or hides the Transmission overlay." ;;
        evo.panels.insync) echo "Shows or hides the Insync overlay." ;;
        evo.panels.steam) echo "Shows or hides the Steam overlay." ;;
        evo.panels.media.library) echo "Shows or hides the music library overlay." ;;
        evo.sys.themes) echo "Shows or hides the theme switcher overlay." ;;
        evo.sys.wallpaper) echo "Shows or hides the wallpaper switcher overlay." ;;
        evo.side.clipboard) echo "Shows or hides the clipboard history overlay." ;;
        *) echo "Shows or hides the $1 overlay via shell IPC." ;;
        esac
    }

    _menu_list_dashboard_detail() {
        case "$1" in
        evo.panels.player) echo "Opens the music player dashboard in full-screen dashboard mode." ;;
        *) echo "Opens the $1 dashboard." ;;
        esac
    }

    local plugins=(
        evo.sys.menu evo.side evo.sys.settings evo.panels.calendar evo.panels.cursor
        evo.panels.weather evo.panels.network.stats evo.panels.media.volume
        evo.panels.media.now-playing evo.panels.github evo.panels.system evo.panels.stocks
        evo.panels.cloudflare evo.panels.network.transmission evo.panels.insync evo.panels.steam
        evo.panels.media.library evo.sys.themes evo.sys.wallpaper evo.side.clipboard
    )
    local dashboards=(evo.panels.player)
    if [[ -f "${EVOSHELL_CONFIG}/plugins/manifest.json" ]]; then
        while IFS= read -r dash_id; do
            [[ -n "$dash_id" && "$dash_id" != "evo.panels.player" ]] || continue
            dashboards+=("$dash_id")
        done < <(jq -r '.dashboardIds[]?' "${EVOSHELL_CONFIG}/plugins/manifest.json" 2>/dev/null || true)
    fi

    _menu_list_emit "Ping shell" "$ipc shell ping" "$(_menu_list_used 'shell ping' && echo true || echo false)" \
        "Checks whether evo ipc can reach the running Quickshell process."
    _menu_list_emit "Reload shell config" "$ipc shell reloadConfig" "$(_menu_list_used 'shell reloadConfig' && echo true || echo false)" \
        "Reloads evoshell Quickshell configuration without restarting the session."
    _menu_list_emit "List plugins" "$ipc shell listPlugins" false \
        "Lists registered evoshell plugin ids available over IPC."
    _menu_list_emit "Toggle system menu" "$ipc shell toggleSystemMenu" "$(_menu_list_used toggleSystemMenu && echo true || echo false)" \
        "Opens or closes this system menu overlay."
    _menu_list_emit "Summon overlay" "$ipc shell summon <plugin> [json]" false \
        "Shows a plugin overlay without toggling it off if already visible."
    _menu_list_emit "Toggle overlay" "$ipc shell toggle <plugin> [json]" false \
        "Shows or hides a plugin overlay; optional JSON passes launch payload."
    _menu_list_emit "Hide overlay" "$ipc shell hide <plugin>" false \
        "Hides a plugin overlay if it is currently visible."
    _menu_list_emit "Open dashboard" "$ipc shell openDashboard <plugin>" false \
        "Opens a plugin in full-screen dashboard mode."
    _menu_list_emit "Call plugin method" "$ipc shell call <plugin> <method> [arg]" false \
        "Invokes a plugin RPC method with an optional JSON argument."
    _menu_list_emit "Volume up" "$ipc evo.sys.media.audio stepUp" "$(_menu_list_used 'evo.sys.media.audio stepUp' '.stepUp()' && echo true || echo false)" \
        "Increases system volume by one step via PipeWire."
    _menu_list_emit "Volume down" "$ipc evo.sys.media.audio stepDown" "$(_menu_list_used 'evo.sys.media.audio stepDown' '.stepDown()' && echo true || echo false)" \
        "Decreases system volume by one step via PipeWire."
    _menu_list_emit "Toggle mute" "$ipc evo.sys.media.audio toggleMute" "$(_menu_list_used 'evo.sys.media.audio toggleMute' '.toggleMute()' && echo true || echo false)" \
        "Toggles system audio mute state."
    _menu_list_emit "Lock screen" "$ipc evo.sys.lock-screen.lock lock" "$(_menu_list_used 'evo.sys.lock-screen.lock lock' '_system lock' && echo true || echo false)" \
        "Locks the screen immediately."
    _menu_list_emit "Lock status" "$ipc evo.sys.lock-screen.lock isLocked" "$(_menu_list_used 'evo.sys.lock-screen.lock isLocked' && echo true || echo false)" \
        "Reports whether the screen is currently locked."
    _menu_list_emit "Idle status" "$ipc evo.sys.lock-screen.idle status" "$(_menu_list_used 'evo.sys.lock-screen.idle status' && echo true || echo false)" \
        "Reports idle inhibitor and lock timer state."
    _menu_list_emit "Next wallpaper" "$ipc evo.sys.wallpaper next" "$(_menu_list_used 'evo.sys.wallpaper next' 'evo.sys.wallpaper "$cmd"' && echo true || echo false)" \
        "Advances to the next wallpaper in the current theme rotation."
    _menu_list_emit "Previous wallpaper" "$ipc evo.sys.wallpaper prev" "$(_menu_list_used 'evo.sys.wallpaper prev' 'evo.sys.wallpaper "$cmd"' && echo true || echo false)" \
        "Goes back to the previous wallpaper in the current theme rotation."
    _menu_list_emit "Refresh wallpaper" "$ipc evo.sys.wallpaper refresh" "$(_menu_list_used 'evo.sys.wallpaper refresh' && echo true || echo false)" \
        "Re-applies the current wallpaper (useful after theme or monitor changes)."

    local plugin
    for plugin in "${plugins[@]}"; do
        _menu_list_emit "Toggle $plugin" "$ipc shell toggle $plugin" "$(_menu_list_plugin_used "$plugin" && echo true || echo false)" \
            "$(_menu_list_plugin_detail "$plugin")"
    done

    for plugin in "${dashboards[@]}"; do
        _menu_list_emit "Open $plugin dashboard" "$ipc shell openDashboard $plugin" \
            "$(_menu_list_dashboard_used "$plugin" && echo true || echo false)" \
            "$(_menu_list_dashboard_detail "$plugin")"
    done
}

menu_list_icons() {
    local home="$1" theme="$2"
    local -a roots=(
        "$home/.local/share/icons/$theme"
        "/usr/share/icons/Papirus-Dark"
        "/usr/share/icons/Papirus"
        "$home/.local/share/icons/hicolor"
    )
    local -a sizes=(48x48 64x64 scalable 32x32 128x128 256x256)
    local -a categories=(apps devices status places mimetypes)
    local -a exts=(.svg .png)
    local -a app_dirs=(
        "$home/.local/share/applications"
        "/usr/share/applications"
        "/var/lib/flatpak/exports/share/applications"
        "$home/.local/share/flatpak/exports/share/applications"
    )
    declare -A seen_ids=()
    declare -A icon_cache=()

    _menu_list_resolve_icon() {
        local icon="$1"
        icon="${icon#"${icon%%[![:space:]]*}"}"
        icon="${icon%"${icon##*[![:space:]]}"}"
        [[ -n "$icon" ]] || { printf ''; return; }
        [[ -n "${icon_cache[$icon]+x}" ]] && { printf '%s' "${icon_cache[$icon]}"; return; }

        local base size category ext path candidate
        if [[ "$icon" == /* ]]; then
            path="$icon"
            [[ -f "$path" ]] || path="$home/${icon#/}"
            if [[ -f "$path" ]]; then
                icon_cache[$icon]="file://$path"
                printf '%s' "${icon_cache[$icon]}"
                return
            fi
            icon_cache[$icon]=""
            printf ''
            return
        fi

        for base in "${roots[@]}"; do
            [[ -d "$base" ]] || continue
            for size in "${sizes[@]}"; do
                for category in "${categories[@]}"; do
                    for ext in "${exts[@]}"; do
                        candidate="$base/$size/$category/$icon$ext"
                        if [[ -f "$candidate" ]]; then
                            icon_cache[$icon]="file://$candidate"
                            printf '%s' "${icon_cache[$icon]}"
                            return
                        fi
                    done
                done
            done
        done
        icon_cache[$icon]=""
        printf ''
    }

    _menu_list_parse_desktop() {
        local file="$1"
        local type="" nodisplay="" hidden="" icon="" key value
        [[ -f "$file" ]] || return 1
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -n "$line" && "$line" != \#* && "$line" != '[Desktop Entry]' ]] || continue
            [[ "$line" == *"="* ]] || continue
            key="${line%%=*}"
            value="${line#*=}"
            case "$key" in
            Type) type="$value" ;;
            NoDisplay) nodisplay="$value" ;;
            Hidden) hidden="$value" ;;
            Icon) icon="$value" ;;
            esac
        done < "$file"
        [[ "$type" == Application ]] || return 1
        [[ "${nodisplay,,}" == true ]] && return 1
        [[ "${hidden,,}" == true ]] && return 1
        _menu_list_resolve_icon "$icon"
    }

    local app_dir name desktop_id icon_url data
    for app_dir in "${app_dirs[@]}"; do
        [[ -d "$app_dir" ]] || continue
        while IFS= read -r name; do
            [[ "$name" == *.desktop ]] || continue
            desktop_id="${name%.desktop}"
            [[ -z "${seen_ids[$desktop_id]+x}" ]] || continue
            icon_url="$(_menu_list_parse_desktop "$app_dir/$name")" || continue
            [[ -n "$icon_url" ]] || continue
            seen_ids[$desktop_id]=1
            printf '%s\t%s\n' "$desktop_id" "$icon_url"
        done < <(find "$app_dir" -maxdepth 1 -name '*.desktop' -printf '%f\n' 2>/dev/null | LC_ALL=C sort)
    done
}

# Convert bindings TSV lines to JSON array (Menu.qml parseDynamicLines shape).
menu_list_bindings_to_json() {
    jq -Rn '
        [inputs
         | select(length > 0)
         | split("\t")
         | {
             name: .[0],
             keys: .[1],
             detail: (.[2] // ""),
             files: (.[3] // "")
           }]
    '
}
