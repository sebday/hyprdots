#!/bin/bash
# Shared helpers for evo theme scripts (source from other scripts).

# shellcheck source=/dev/null
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/evo-storage-lib"

THEME_DIR="${THEME_DIR:-$HOME/.themes}"
TEMPLATES_DIR="${TEMPLATES_DIR:-$THEME_DIR/shared/templates}"
CURRENT_THEME="${CURRENT_THEME:-$THEME_DIR/current}"
EVO_ICON_THEME="${EVO_ICON_THEME:-evo-current}"

theme_wallpapers_dir() {
    local theme_path="${1:-$CURRENT_THEME}"
    local dir="$theme_path/wallpapers"
    [ -d "$dir" ] || return 1
    printf '%s' "$dir"
}

current_theme_name() {
    local name
    if [ -f "$CURRENT_THEME/.theme-name" ]; then
        name=$(tr -d '\n' < "$CURRENT_THEME/.theme-name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$name" ] && printf '%s' "$name" && return 0
    fi
    return 1
}

theme_name_from_wallpaper_path() {
    local path="$1" resolved parent theme_name
    [ -n "$path" ] || return 1
    resolved=$(cd "$(dirname "$path")" 2>/dev/null && pwd -P) || return 1
    case "$resolved" in
        */wallpapers)
            parent=$(dirname "$resolved")
            theme_name=$(basename "$parent")
            ;;
        *)
            return 1
            ;;
    esac
    case "$theme_name" in
        current)
            current_theme_name
            return 0
        ;;
        shared|next|"")
            return 1
        ;;
    esac
    if [ -d "$THEME_DIR/$theme_name" ]; then
        printf '%s' "$theme_name"
        return 0
    fi
    return 1
}

toml_val() {
    local key="$1" toml="$2"
    grep "^$key " "$toml" 2>/dev/null | sed 's/.*= *"//;s/".*//' | tr -d '\n'
}

# Mix two #rrggbb colours. t=0 keeps $1, t=1 is $2.
mix_hex() {
    local a="${1#\#}" b="${2#\#}" t="$3"
    local ar=$((16#${a:0:2})) ag=$((16#${a:2:2})) ab=$((16#${a:4:2}))
    local br=$((16#${b:0:2})) bg=$((16#${b:2:2})) bb=$((16#${b:4:2}))
    awk -v ar="$ar" -v ag="$ag" -v ab="$ab" -v br="$br" -v bg="$bg" -v bb="$bb" -v t="$t" '
    BEGIN {
        r = int(ar + (br - ar) * t + 0.5)
        g = int(ag + (bg - ag) * t + 0.5)
        b = int(ab + (bb - ab) * t + 0.5)
        printf "#%02x%02x%02x\n", r, g, b
    }'
}

# e.g. tokyo-night -> Tokyo Night
theme_display_name() {
    local slug="$1" word display_name=""
    for word in $(echo "$slug" | tr '-' ' '); do
        display_name="${display_name}${word^} "
    done
    printf '%s' "${display_name% }"
}

# Default wallpaper: first lexicographically sorted image in the active theme wallpapers/ dir.
themes_default_wallpaper() {
    local dir candidate
    dir=$(theme_wallpapers_dir "$CURRENT_THEME") || return 1
    candidate=$(find "$dir" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        2>/dev/null | sort | head -n1)
    [ -n "$candidate" ] || return 1
    printf '%s' "$candidate"
}

paths_resolved_equal() {
    local a b
    a=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    b=$(cd "$2" 2>/dev/null && pwd -P) || return 1
    [ "$a" = "$b" ]
}

# Build sed substitution script from colors.toml into the given file.
_theme_build_sed_script() {
    local toml="$1"
    local sed_script="$2"
    local key value hex

    : >"$sed_script"
    while IFS='=' read -r key value; do
        key="${key//[\"\' ]/}"
        [[ $key && $key != \#* ]] || continue
        value="${value#*[\"\']}"
        value="${value%%[\"\']*}"
        printf 's|{{ %s }}|%s|g\n' "$key" "$value" >>"$sed_script"
        printf 's|{{ %s_strip }}|%s|g\n' "$key" "${value#\#}" >>"$sed_script"
        if [[ $value =~ ^# ]]; then
            hex="${value#\#}"
            printf 's|{{ %s_rgb }}|%d,%d,%d|g\n' "$key" "$(( 0x${hex:0:2} ))" "$(( 0x${hex:2:2} ))" "$(( 0x${hex:4:2} ))" >>"$sed_script"
        fi
    done <"$toml"
}

# Expand one .tpl into theme_dir. skip_existing=1 skips when output already exists.
_expand_theme_template() {
    local theme_dir="$1"
    local basename="$2"
    local skip_existing="${3:-0}"
    local toml="$theme_dir/colors.toml"
    local tpl="$TEMPLATES_DIR/${basename}.tpl"
    local output="$theme_dir/$basename"
    local sed_script

    [ -f "$toml" ] || return 1
    [ -f "$tpl" ] || return 1
    if [[ "$skip_existing" == 1 && -f "$output" ]]; then
        return 0
    fi

    sed_script=$(mktemp)
    _theme_build_sed_script "$toml" "$sed_script"
    sed -f "$sed_script" "$tpl" >"$output"
    rm -f "$sed_script"
}

# Expand shared/templates/*.tpl into theme_dir from colors.toml.
# Skips existing outputs except named templates regenerated via process_theme_template.
process_theme_templates() {
    local theme_dir="$1"
    local filename tpl

    [ -n "$theme_dir" ] || return 1
    [ -f "$theme_dir/colors.toml" ] || return 0

    for tpl in "$TEMPLATES_DIR"/*.tpl; do
        [ -f "$tpl" ] || continue
        filename=$(basename "$tpl" .tpl)
        case "$filename" in
        obsidian.css | colors.css | shoelace-hex.css | nvim-icons.lua) continue ;;
        esac
        _expand_theme_template "$theme_dir" "$filename" 1
    done
}

# Generate a single template output (always overwrites).
process_theme_template() {
    local theme_dir="$1"
    local basename="$2"
    _expand_theme_template "$theme_dir" "$basename" 0
}

# Copy theme files from current/ into ~/.config (hypr theme, btop).
install_theme_manifest() {
    local current="${CURRENT_PATH:-$THEME_DIR/current}"
    local config="${HOME}/.config"

    if [ -f "$current/colors.toml" ]; then
        local accent accent_strip
        mkdir -p "$config/hypr"
        accent=$(toml_val accent "$current/colors.toml")
        accent_strip="${accent#\#}"
        cat > "$config/hypr/theme.lua" <<EOF
hl.config({
    general = {
        col = {
            active_border = "rgb(${accent_strip})",
        },
    },
    group = {
        col = {
            border_active = "rgb(${accent_strip})",
        },
    },
})
EOF
    fi
    if [ -f "$current/btop.theme" ]; then
        mkdir -p "$config/btop/themes"
        cp "$current/btop.theme" "$config/btop/themes/current.theme"
        [ -f "$config/btop/btop.conf" ] && sed -i 's|^color_theme =.*|color_theme = "current"|' "$config/btop/btop.conf"
    fi
    if [ -f "$current/nvim-icons.lua" ]; then
        mkdir -p "$config/nvim/lua"
        cp "$current/nvim-icons.lua" "$config/nvim/lua/theme-icons.lua"
    else
        rm -f "$config/nvim/lua/theme-icons.lua"
    fi
}

# Write $EVOSHELL_STATE/theme.json from colors.toml for Quickshell Theme.qml.
# Preserves fontFamily / fontPixelSize from an existing theme.json or evo-font state.
themes_sync_evo_shell() {
    local current="${CURRENT_PATH:-$THEME_DIR/current}"
    local toml="$current/colors.toml"
    local out="${EVOSHELL_STATE}/theme.json"
    local font_state="${FONT_CONFIG_JSON}"
    [ -f "$toml" ] || return 0

    local fg bg accent mantle urgent
    fg=$(toml_val foreground "$toml")
    bg=$(toml_val background "$toml")
    accent=$(toml_val accent "$toml")
    mantle=$(toml_val mantle "$toml")
    urgent=$(toml_val color1 "$toml")

    local prev_json='{}'
    local fonts_json='{}'
    [ -f "$out" ] && prev_json=$(cat "$out" 2>/dev/null || echo '{}')
    [ -f "$font_state" ] && fonts_json=$(cat "$font_state" 2>/dev/null || echo '{}')

    mkdir -p "$(dirname "$out")"
    jq -n \
        --arg foreground "$fg" \
        --arg background "$bg" \
        --arg accent "$accent" \
        --arg mantle "$mantle" \
        --arg urgent "$urgent" \
        --arg iconTheme "$EVO_ICON_THEME" \
        --argjson prev "$prev_json" \
        --argjson fonts "$fonts_json" \
        '
        {
          foreground: $foreground,
          background: $background,
          accent: $accent,
          mantle: $mantle,
          urgent: $urgent,
          iconTheme: $iconTheme
        }
        + (if (($prev.fontFamily // $fonts.family // "") | length) > 0 then
            {fontFamily: ($prev.fontFamily // $fonts.family)}
          else {} end)
        + (if ($prev.fontPixelSize // $fonts.evoSize // null) != null then
            {fontPixelSize: ($prev.fontPixelSize // $fonts.evoSize)}
          else {} end)
        ' \
        > "$out"
}

themes_sync_icon_theme_gsettings() {
    gsettings set org.gnome.desktop.interface icon-theme "$EVO_ICON_THEME" 2>/dev/null || true
}

_themes_sync_obsidian_modular_vault() {
    local vault="$1"
    local theme_css="$2"
    local shared_css="$3"
    local shared_manifest="$4"
    local modular_dir appearance updated_json

    [ -n "$vault" ] && [ -d "$vault" ] || return 0

    modular_dir="$vault/.obsidian/themes/Modular"
    appearance="$vault/.obsidian/appearance.json"

    mkdir -p "$modular_dir"
    if [ ! -f "$modular_dir/manifest.json" ] && [ -f "$shared_manifest" ]; then
        cp "$shared_manifest" "$modular_dir/manifest.json"
    fi
    if [ -f "$shared_css" ] && [ -f "$theme_css" ]; then
        cat "$shared_css" "$theme_css" > "$modular_dir/theme.css"
    fi

    mkdir -p "$(dirname "$appearance")"
    if [ -f "$appearance" ]; then
        updated_json=$(cat "$appearance")
    else
        updated_json='{}'
    fi
    updated_json=$(echo "$updated_json" | jq --arg theme "obsidian" '.theme = $theme' | jq --arg cssTheme "Modular" '.cssTheme = $cssTheme')
    echo "$updated_json" > "$appearance"
}

themes_sync_obsidian_modular() {
    local theme_css="${THEME_DIR}/current/obsidian.css"
    local shared_css="${THEME_DIR}/shared/css/obsidian.css"
    local shared_manifest="${THEME_DIR}/shared/obsidian.conf"
    local vault

    [ -f "$theme_css" ] || return 0

    while IFS= read -r vault; do
        _themes_sync_obsidian_modular_vault "$vault" "$theme_css" "$shared_css" "$shared_manifest"
    done < <(obsidian_vault_paths)
}

