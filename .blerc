# ANSI 16-color palette:
# 0=dark gray   1=red           2=green             3=yellow            4=blue          5=magenta           6=cyan          7=light gray
# 8=gray        9=bright red    10=bright green     11=bright yellow    12=bright blue  13=bright magenta   14=bright cyan  15=white
#
# Usable names:
# black, red, green, yellow, blue, magenta, cyan, white, teal, gray, brown, navy, purple, orange, lime

# use ble-face to list all colours

ble-face -s argument_error fg=0,bg=1
ble-face -s cmdinfo_cd_cdpath fg=0,bg=10
ble-face -s auto_complete fg=7
ble-face -s command_directory fg=12,underline
ble-face -s command_function fg=12
ble-face -s command_suffix fg=7,bg=2
ble-face -s command_suffix_new fg=15,bg=9
ble-face -s disabled fg=8
ble-face -s filename_character fg=7,bg=0
ble-face -s filename_directory fg=7,underline
ble-face -s filename_directory_sticky fg=15,bg=4
ble-face -s filename_orphan fg=7,bg=1
ble-face -s menu_filter_input fg=0,bg=11
ble-face -s overwrite_mode fg=0,bg=14
ble-face -s prompt_status_line fg=7,bg=8
ble-face -s region fg=7,bg=8
ble-face -s region_insert fg=8,bg=7
ble-face -s region_target fg=black,bg=12
ble-face -s syntax_brace fg=14
ble-face -s syntax_document fg=11
ble-face -s syntax_document_begin fg=11,bold
ble-face -s syntax_expr fg=12
ble-face -s syntax_function_name fg=13,bold
ble-face -s syntax_glob fg=9
ble-face -s syntax_varname fg=6
ble-face -s syntax_quoted fg=6
ble-face -s syntax_quotation fg=teal,bold
ble-face -s varname_array fg=11,bold
ble-face -s vbell_erase fg=9,bold,reverse
ble-face -s syntax_error fg=203