#!/usr/bin/env bash
# Generate evoshell/modules/menu/emoji.json from Unicode emoji-test.txt.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/evoshell/modules/menu/emoji.json"
src="${1:-}"

python3 - "$src" "$out" <<'PY'
import json, pathlib, re, sys, urllib.request

src, out = sys.argv[1], sys.argv[2]
url = "https://unicode.org/Public/emoji/latest/emoji-test.txt"
if src:
    text = pathlib.Path(src).read_text(encoding="utf-8")
else:
    with urllib.request.urlopen(url, timeout=60) as response:
        text = response.read().decode("utf-8")

items = []
seen = set()
pattern = re.compile(
    r"^([0-9A-F ]+)\s*;\s*fully-qualified\s*#\s*(\S+)\s+E[0-9.]+\s+(.+)$"
)
for line in text.splitlines():
    if line.startswith("#") or "; fully-qualified" not in line:
        continue
    match = pattern.match(line.strip())
    if not match:
        continue
    char, name = match.group(2), match.group(3).strip()
    if char in seen:
        continue
    seen.add(char)
    words = []
    for word in re.split(r"[^a-z0-9]+", name.lower()):
        if word and word not in ("and", "with", "the") and word not in words:
            words.append(word)
    items.append({"c": char, "n": name, "k": words})

by_name = {item["n"].lower(): item for item in items}
drop = set()
for item in items:
    name = item["n"].lower()
    if name.startswith("black ") and ("white " + name[len("black "):]) in by_name:
        drop.add(item["c"])
items = [item for item in items if item["c"] not in drop]

path = pathlib.Path(out)
path.write_text(json.dumps(items, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
print(f"wrote {len(items)} emoji to {path}")
PY
