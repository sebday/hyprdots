#!/usr/bin/env bash
# Remove the Wayland desktop override. Steam's CEF build turns each UI
# surface into its own window when --ozone-platform=wayland is forced, then
# closes them again. The system shortcut is the one to use.
set -euo pipefail

script="$(readlink -f "${BASH_SOURCE[0]}")"
marker="hyprdots-wayland"

usage() {
    cat <<EOF
usage: steam-wayland [--patch] [steam args...]

  --patch    delete the Wayland applications override, then exit
  (default)  do that, then exec /usr/bin/steam with the remaining arguments
EOF
}

remove_override() {
    local dst="${HOME}/.local/share/applications/steam.desktop"
    if [[ -f "$dst" ]] && grep -q "$marker" "$dst"; then
        rm -f "$dst"
    fi
    local link="${HOME}/.local/bin/steam"
    if [[ -L "$link" ]] && [[ "$(readlink -f "$link")" == "$script" ]]; then
        rm -f "$link"
    fi
}

case "${1:-}" in
    -h|--help|help)
        usage
        exit 0
        ;;
    --patch)
        remove_override
        exit 0
        ;;
esac

remove_override
exec /usr/bin/steam "$@"
