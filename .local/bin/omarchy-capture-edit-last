#!/bin/bash

# omarchy:summary=Annotate the most recent screenshot with tensaku
# omarchy:group=capture

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
SCREENSHOT_EDITOR="${OMARCHY_SCREENSHOT_EDITOR:-tensaku-edit}"

latest=$(ls -t "$OUTPUT_DIR"/screenshot-*.png 2>/dev/null | head -1)

if [[ -z "$latest" || ! -f "$latest" ]]; then
  omarchy-notification-send "No screenshot to edit" "Capture first with Print or Alt+Print" -t 4000
  exit 1
fi

exec "$SCREENSHOT_EDITOR" "$latest"
