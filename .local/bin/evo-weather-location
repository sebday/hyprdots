#!/usr/bin/env bash
# Persisted weather city name for evoshell.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/evoshell"
STATE_FILE="${STATE_DIR}/weather-location.json"
CACHE_DIR="${HOME}/.cache/evoshell/bar"

DEFAULT_NAME="Derby"

mkdir -p "$STATE_DIR"

weather_cache_slug() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g' | sed 's/_\+/_/g' | sed 's/^_\|_$//g'
}

current_json() {
    if [[ -f "$STATE_FILE" ]]; then
        local name
        name=$(jq -r '.name // empty' "$STATE_FILE" 2>/dev/null || true)
        if [[ -n "$name" ]]; then
            jq -cn --arg name "$name" '{name:$name}'
            return 0
        fi
    fi
    jq -cn --arg name "$DEFAULT_NAME" '{name:$name}'
}

clear_weather_cache() {
    rm -f "${CACHE_DIR}/weather-$(weather_cache_slug "$1").json"
}

cmd="${1:-get}"

case "$cmd" in
    get)
        current_json
        ;;
    set)
        name="${2:-}"
        if [[ -z "$name" ]]; then
            echo "usage: evo-weather-location set <city>" >&2
            exit 1
        fi
        old_name="$(current_json | jq -r '.name')"
        clear_weather_cache "$old_name"
        jq -cn --arg name "$name" '{name:$name}' >"$STATE_FILE"
        clear_weather_cache "$name"
        current_json
        ;;
    *)
        echo "usage: evo-weather-location {get|set}" >&2
        exit 1
        ;;
esac
