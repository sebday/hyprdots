#!/usr/bin/env bash
# Media keys: evo-player when its mpv socket exists, else playerctl.

set -euo pipefail

BIN="${HOME}/.local/bin"
EVO_PLAYER="${BIN}/evo-player"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
MPV_SOCKET="${RUNTIME}/evo-player.sock"

usage() {
    cat <<'EOF'
usage: evo-media-keys play-pause|next|prev
EOF
}

evo_socket_ready() {
    [[ -S "$MPV_SOCKET" ]]
}

run_evo() {
    local cmd="$1"
    case "$cmd" in
        play-pause) "$EVO_PLAYER" toggle ;;
        next) "$EVO_PLAYER" next ;;
        prev) "$EVO_PLAYER" prev ;;
        *) return 1 ;;
    esac
}

run_playerctl() {
    local cmd="$1"
    if ! command -v playerctl >/dev/null 2>&1; then
        echo "evo-media-keys: no evo-player socket and playerctl not installed" >&2
        return 1
    fi
    case "$cmd" in
        play-pause) playerctl play-pause ;;
        next) playerctl next ;;
        prev) playerctl previous ;;
        *) return 1 ;;
    esac
}

cmd="${1:-}"
case "$cmd" in
    play-pause|next|prev)
        if evo_socket_ready; then
            run_evo "$cmd"
        else
            run_playerctl "$cmd"
        fi
        ;;
    -h|--help|help|"") usage ;;
    *)
        echo "evo-media-keys: unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
