#!/usr/bin/env bash
# Fast TSV listing for Evo menu theme/wallpaper previews.
set -euo pipefail

mode="${1:-}"
cache_root="${XDG_STATE_HOME:-$HOME/.local/state}/evoshell/menu-cache"
home="${HOME:?}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
thumb="${script_dir}/evo-menu-thumb"
# shellcheck source=/dev/null
source "$script_dir/evo-theme-lib"

preview_path() {
    local src="$1" key="$2"
    local cached="$cache_root/$key"
    if [[ -f "$cached" ]]; then
        printf '%s' "$cached"
        return
    fi
    if [[ -x "$thumb" ]]; then
        "$thumb" "$src" "$key"
        return
    fi
    printf '%s' "$src"
}

case "$mode" in
themes)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            src="$home/.themes/$name/preview.png"
            [[ -f "$src" ]] || continue
            p=$(preview_path "$src" "themes/${name}.png")
            printf '%s\t%s/.local/bin/evo-theme %s\t%s\n' "$name" "$home" "$name" "$p"
        done
    ;;
wallpapers)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r theme_name; do
            [[ -n "$theme_name" ]] || continue
            wp_dir="$home/.themes/$theme_name/wallpapers"
            [[ -d "$wp_dir" ]] || continue
            find "$wp_dir" -maxdepth 1 -type f \
                \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
                2>/dev/null | sort |
                while IFS= read -r file; do
                    [[ -n "$file" ]] || continue
                    bn="${file##*/}"
                    label="${theme_name}/${bn}"
                    p=$(preview_path "$file" "wallpapers/${theme_name}/${bn}")
                    printf '%s\t%s/.local/bin/evo-wallpaper set %q\t%s\n' "$label" "$home" "$file" "$p"
                done
        done
    ;;
bindings)
    bindings_file="$home/.config/hypr/bindings.lua"
    [[ -f "$bindings_file" ]] || exit 0
    python3 - "$bindings_file" <<'PY'
import re, sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
pattern = re.compile(r'bindd\(\s*"([^"]+)"\s*,\s*"([^"]+)"', re.S)
seen = set()
for keys, desc in pattern.findall(text):
    keys = keys.strip()
    desc = desc.strip()
    if not keys or not desc:
        continue
    pair = (keys, desc)
    if pair in seen:
        continue
    seen.add(pair)
    print(f"{desc}\t{keys}")
PY
    ;;
icons)
    # shellcheck source=/dev/null
    source "$script_dir/evo-theme-lib"
    python3 - "$home" "${EVO_ICON_THEME:-evo-current}" <<'PY'
import os, sys

home, theme = sys.argv[1], sys.argv[2]
roots = [
    os.path.join(home, ".local/share/icons", theme),
    "/usr/share/icons/Papirus-Dark",
    "/usr/share/icons/Papirus",
    os.path.join(home, ".local/share/icons/hicolor"),
]
sizes = ("48x48", "64x64", "scalable", "32x32", "128x128", "256x256")
exts = (".svg", ".png")
categories = ("apps", "devices", "status", "places", "mimetypes")
app_dirs = [
    os.path.join(home, ".local/share/applications"),
    "/usr/share/applications",
    "/var/lib/flatpak/exports/share/applications",
    os.path.join(home, ".local/share/flatpak/exports/share/applications"),
]
seen_ids = set()
icon_cache = {}

def resolve_icon(icon):
    icon = (icon or "").strip()
    if not icon:
        return ""
    if icon in icon_cache:
        return icon_cache[icon]
    if icon.startswith("/"):
        path = icon if os.path.isabs(icon) else os.path.join(home, icon.lstrip("/"))
        if os.path.isfile(path):
            icon_cache[icon] = "file://" + path
            return icon_cache[icon]
        icon_cache[icon] = ""
        return ""
    for base in roots:
        for size in sizes:
            for category in categories:
                for ext in exts:
                    path = os.path.join(base, size, category, icon + ext)
                    if os.path.isfile(path):
                        icon_cache[icon] = "file://" + path
                        return icon_cache[icon]
    icon_cache[icon] = ""
    return ""

def parse_desktop(path):
    data = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line == "[Desktop Entry]":
                    continue
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                data[key] = value
    except OSError:
        return None
    if data.get("Type") != "Application":
        return None
    if data.get("NoDisplay", "").lower() == "true":
        return None
    if data.get("Hidden", "").lower() == "true":
        return None
    return data

for app_dir in app_dirs:
    if not os.path.isdir(app_dir):
        continue
    for name in sorted(os.listdir(app_dir)):
        if not name.endswith(".desktop"):
            continue
        desktop_id = name[:-8]
        if desktop_id in seen_ids:
            continue
        data = parse_desktop(os.path.join(app_dir, name))
        if not data:
            continue
        seen_ids.add(desktop_id)
        icon_url = resolve_icon(data.get("Icon", ""))
        if icon_url:
            print(f"{desktop_id}\t{icon_url}")
PY
    ;;
*)
    echo "usage: $0 themes|wallpapers|bindings|icons" >&2
    exit 1
    ;;
esac
