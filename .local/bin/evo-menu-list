#!/usr/bin/env bash
# Fast TSV listing for Evo menu theme/wallpaper previews.
set -euo pipefail

mode="${1:-}"
cache_root="${XDG_STATE_HOME:-$HOME/.local/state}/evoshell/menu-cache"
home="${HOME:?}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
thumb="${script_dir}/evo-menu-thumb"
# shellcheck source=/dev/null
source "$script_dir/evo-theme-lib"

preview_path() {
    local src="$1" key="$2"
    local cached="$cache_root/$key"
    if [[ -f "$cached" ]]; then
        printf '%s' "$cached"
        return
    fi
    if [[ -x "$thumb" ]]; then
        "$thumb" "$src" "$key"
        return
    fi
    printf '%s' "$src"
}

case "$mode" in
themes)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            src="$home/.themes/$name/preview.png"
            [[ -f "$src" ]] || continue
            p=$(preview_path "$src" "themes/${name}.png")
            printf '%s\t%s/.local/bin/evo-theme %s\t%s\n' "$name" "$home" "$name" "$p"
        done
    ;;
wallpapers)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r theme_name; do
            [[ -n "$theme_name" ]] || continue
            wp_dir="$home/.themes/$theme_name/wallpapers"
            [[ -d "$wp_dir" ]] || continue
            find "$wp_dir" -maxdepth 1 -type f \
                \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
                2>/dev/null | sort |
                while IFS= read -r file; do
                    [[ -n "$file" ]] || continue
                    bn="${file##*/}"
                    label="${theme_name}/${bn}"
                    p=$(preview_path "$file" "wallpapers/${theme_name}/${bn}")
                    printf '%s\t%s/.local/bin/evo-wallpaper set %q\t%s\n' "$label" "$home" "$file" "$p"
                done
        done
    ;;
bindings)
    bindings_file="$home/.config/hypr/bindings.lua"
    [[ -f "$bindings_file" ]] || exit 0
    python3 - "$bindings_file" <<'PY'
import re, sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
pattern = re.compile(r'bindd\(\s*"([^"]+)"\s*,\s*"([^"]+)"', re.S)
seen = set()
for keys, desc in pattern.findall(text):
    keys = keys.strip()
    desc = desc.strip()
    if not keys or not desc:
        continue
    pair = (keys, desc)
    if pair in seen:
        continue
    seen.add(pair)
    print(f"{desc}\t{keys}")
PY
    ;;
shell)
    python3 - "$home" "$script_dir" <<'PY'
import glob
import os
import sys

home, script_dir = sys.argv[1], sys.argv[2]
ipc = "evo-ipc"

plugins = [
    "evo.menu",
    "evo.panel",
    "evo.calendar",
    "evo.shopify_diy",
    "evo.shopify_tgs",
    "evo.cursor",
    "evo.weather",
    "evo.network",
    "evo.volume",
    "evo.media",
    "evo.github",
    "evo.system",
    "evo.stocks",
    "evo.cloudflare",
    "evo.transmission",
    "evo.transmission.add",
    "evo.insync",
    "evo.steam",
    "evo.library",
    "evo.theme",
    "evo.wallpaper",
    "evo.clipboard",
]
dashboards = ["evo.shopify", "evo.player"]


def read_text(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def build_corpus() -> str:
    chunks = [
        read_text(os.path.join(home, ".config/hypr/bindings.lua")),
        read_text(os.path.join(home, ".config/quickshell/evoshell/plugins/menu/MenuEntries.js")),
    ]
    for path in sorted(glob.glob(os.path.join(home, ".config/quickshell/evoshell/plugins/bar/widgets/*.qml"))):
        chunks.append(read_text(path))
    for path in sorted(glob.glob(os.path.join(script_dir, "evo-*"))):
        if os.path.basename(path) in {"evo-menu-list", "evo-ipc"}:
            continue
        chunks.append(read_text(path))

    shell_qml = read_text(os.path.join(home, ".config/quickshell/evoshell/shell.qml"))
    for marker in (
        "toggleSystemMenu",
        "toggleAppLauncher",
        'openDashboardOnly("evo.shopify"',
        'openDashboardOnly("evo.player"',
    ):
        if marker in shell_qml:
            chunks.append(marker)

    return "\n".join(chunks)


corpus = build_corpus()


def used(*needles: str) -> bool:
    return any(needle in corpus for needle in needles)


def plugin_used(plugin: str) -> bool:
    if plugin == "evo.menu":
        return used("toggleSystemMenu", 'toggle("evo.menu"', "toggle evo.menu")
    return used(
        f"shell toggle {plugin}",
        f"toggle {plugin}",
        f'toggle("{plugin}"',
        f"toggle('{plugin}'",
        f"summon {plugin}",
        f"hide {plugin}",
    )


def dashboard_used(plugin: str) -> bool:
    return used(f"openDashboard {plugin}", f'openDashboardOnly("{plugin}"')


def emit(name: str, command: str, internal: bool) -> None:
    print(f"{name}\t{command}\t{1 if internal else 0}")


emit("Ping shell", f"{ipc} shell ping", used("shell ping"))
emit("Reload shell config", f"{ipc} shell reloadConfig", used("shell reloadConfig"))
emit("List plugins", f"{ipc} shell listPlugins", used("shell listPlugins"))
emit("Toggle system menu", f"{ipc} shell toggleSystemMenu", used("toggleSystemMenu"))
emit("Toggle app launcher", f"{ipc} shell toggleAppLauncher", used("toggleAppLauncher"))
emit("Summon overlay", f"{ipc} shell summon <plugin> [json]", False)
emit("Toggle overlay", f"{ipc} shell toggle <plugin> [json]", False)
emit("Hide overlay", f"{ipc} shell hide <plugin>", False)
emit("Open dashboard", f"{ipc} shell openDashboard <plugin>", False)
emit("Call plugin method", f"{ipc} shell call <plugin> <method> [arg]", False)
emit("Volume up", f"{ipc} evo.audio stepUp", used("evo.audio stepUp", ".stepUp()"))
emit("Volume down", f"{ipc} evo.audio stepDown", used("evo.audio stepDown", ".stepDown()"))
emit("Toggle mute", f"{ipc} evo.audio toggleMute", used("evo.audio toggleMute", ".toggleMute()"))
emit("Lock screen", f"{ipc} evo.lock lock", used("evo.lock lock", "evo-system lock"))
emit("Lock status", f"{ipc} evo.lock isLocked", used("evo.lock isLocked"))
emit("Idle status", f"{ipc} evo.idle status", used("evo.idle status"))
emit("Next wallpaper", f"{ipc} evo.wallpaper next", used("evo.wallpaper next", 'evo.wallpaper "$cmd"'))
emit("Previous wallpaper", f"{ipc} evo.wallpaper prev", used("evo.wallpaper prev", 'evo.wallpaper "$cmd"'))
emit("Refresh wallpaper", f"{ipc} evo.wallpaper refresh", used("evo.wallpaper refresh"))

for plugin in plugins:
    emit(f"Toggle {plugin}", f"{ipc} shell toggle {plugin}", plugin_used(plugin))

for plugin in dashboards:
    emit(f"Open {plugin} dashboard", f"{ipc} shell openDashboard {plugin}", dashboard_used(plugin))
PY
    ;;
icons)
    # shellcheck source=/dev/null
    source "$script_dir/evo-theme-lib"
    python3 - "$home" "${EVO_ICON_THEME:-evo-current}" <<'PY'
import os, sys

home, theme = sys.argv[1], sys.argv[2]
roots = [
    os.path.join(home, ".local/share/icons", theme),
    "/usr/share/icons/Papirus-Dark",
    "/usr/share/icons/Papirus",
    os.path.join(home, ".local/share/icons/hicolor"),
]
sizes = ("48x48", "64x64", "scalable", "32x32", "128x128", "256x256")
exts = (".svg", ".png")
categories = ("apps", "devices", "status", "places", "mimetypes")
app_dirs = [
    os.path.join(home, ".local/share/applications"),
    "/usr/share/applications",
    "/var/lib/flatpak/exports/share/applications",
    os.path.join(home, ".local/share/flatpak/exports/share/applications"),
]
seen_ids = set()
icon_cache = {}

def resolve_icon(icon):
    icon = (icon or "").strip()
    if not icon:
        return ""
    if icon in icon_cache:
        return icon_cache[icon]
    if icon.startswith("/"):
        path = icon if os.path.isabs(icon) else os.path.join(home, icon.lstrip("/"))
        if os.path.isfile(path):
            icon_cache[icon] = "file://" + path
            return icon_cache[icon]
        icon_cache[icon] = ""
        return ""
    for base in roots:
        for size in sizes:
            for category in categories:
                for ext in exts:
                    path = os.path.join(base, size, category, icon + ext)
                    if os.path.isfile(path):
                        icon_cache[icon] = "file://" + path
                        return icon_cache[icon]
    icon_cache[icon] = ""
    return ""

def parse_desktop(path):
    data = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line == "[Desktop Entry]":
                    continue
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                data[key] = value
    except OSError:
        return None
    if data.get("Type") != "Application":
        return None
    if data.get("NoDisplay", "").lower() == "true":
        return None
    if data.get("Hidden", "").lower() == "true":
        return None
    return data

for app_dir in app_dirs:
    if not os.path.isdir(app_dir):
        continue
    for name in sorted(os.listdir(app_dir)):
        if not name.endswith(".desktop"):
            continue
        desktop_id = name[:-8]
        if desktop_id in seen_ids:
            continue
        data = parse_desktop(os.path.join(app_dir, name))
        if not data:
            continue
        seen_ids.add(desktop_id)
        icon_url = resolve_icon(data.get("Icon", ""))
        if icon_url:
            print(f"{desktop_id}\t{icon_url}")
PY
    ;;
*)
    echo "usage: $0 themes|wallpapers|bindings|shell|icons" >&2
    exit 1
    ;;
esac
