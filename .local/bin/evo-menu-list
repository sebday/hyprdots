#!/usr/bin/env bash
# Fast TSV listing for Evo menu theme/wallpaper previews.
set -euo pipefail

mode="${1:-}"
cache_root="${XDG_STATE_HOME:-$HOME/.local/state}/evoshell/menu-cache"
home="${HOME:?}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
thumb="${script_dir}/evo-menu-thumb"
# shellcheck source=/dev/null
source "$script_dir/evo-theme-lib"

preview_path() {
    local src="$1" key="$2"
    local cached="$cache_root/$key"
    if [[ -f "$cached" ]]; then
        printf '%s' "$cached"
        return
    fi
    if [[ -x "$thumb" ]]; then
        "$thumb" "$src" "$key"
        return
    fi
    printf '%s' "$src"
}

case "$mode" in
themes)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            src="$home/.themes/$name/preview.png"
            [[ -f "$src" ]] || continue
            p=$(preview_path "$src" "themes/${name}.png")
            printf '%s\t%s/.local/bin/evo-theme %s\t%s\n' "$name" "$home" "$name" "$p"
        done
    ;;
wallpapers)
    find "$home/.themes" -mindepth 1 -maxdepth 1 -type d \
        ! -name current ! -name shared ! -name next -printf '%f\n' 2>/dev/null | sort |
        while IFS= read -r theme_name; do
            [[ -n "$theme_name" ]] || continue
            wp_dir="$home/.themes/$theme_name/wallpapers"
            [[ -d "$wp_dir" ]] || continue
            find "$wp_dir" -maxdepth 1 -type f \
                \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
                2>/dev/null | sort |
                while IFS= read -r file; do
                    [[ -n "$file" ]] || continue
                    bn="${file##*/}"
                    label="${theme_name}/${bn}"
                    p=$(preview_path "$file" "wallpapers/${theme_name}/${bn}")
                    printf '%s\t%s/.local/bin/evo-wallpaper set %q\t%s\n' "$label" "$home" "$file" "$p"
                done
        done
    ;;
bindings)
    bindings_file="$home/.config/hypr/bindings.lua"
    [[ -f "$bindings_file" ]] || exit 0
    python3 - "$bindings_file" "${home}" <<'PY'
import os
import re
import sys

path = sys.argv[1]
home = sys.argv[2]
text = open(path, encoding="utf-8").read()


def parse_lua_locals(source: str) -> dict[str, str]:
    vars: dict[str, str] = {
        "bin": os.path.join(home, ".local/bin"),
        "shell_ipc": os.path.join(home, ".local/bin/evo-ipc"),
    }
    for m in re.finditer(r"^(?:local\s+)?(\w+)\s*=\s*\"([^\"]*)\"", source, re.M):
        vars[m.group(1)] = m.group(2)
    for m in re.finditer(
        r"^(?:local\s+)?(\w+)\s*=\s*(\w+)\s*\.\.\s*\"([^\"]*)\"",
        source,
        re.M,
    ):
        base = vars.get(m.group(2), m.group(2))
        vars[m.group(1)] = base + m.group(3)
    for m in re.finditer(
        r"^(?:local\s+)?(\w+)\s*=\s*\(os\.getenv\(\"HOME\"\)\s+or\s+\"\"\)\s*\.\.\s*\"([^\"]*)\"",
        source,
        re.M,
    ):
        vars[m.group(1)] = home + m.group(2)
    return vars


VARS = parse_lua_locals(text)


def skip_ws_comma(s: str, i: int) -> int:
    while i < len(s) and s[i] in " \t\n\r,":
        i += 1
    return i


def parse_lua_string(s: str, i: int) -> tuple[str, int] | tuple[None, int]:
    i = skip_ws_comma(s, i)
    if i >= len(s):
        return None, i
    quote = s[i]
    if quote not in ('"', "'"):
        return None, i
    i += 1
    out: list[str] = []
    while i < len(s):
        ch = s[i]
        if ch == "\\" and i + 1 < len(s):
            out.append(s[i + 1])
            i += 2
            continue
        if ch == quote:
            return "".join(out), i + 1
        out.append(ch)
        i += 1
    return None, i


def parse_bindd_arg(s: str, i: int) -> tuple[str, int]:
    i = skip_ws_comma(s, i)
    start = i
    depth_paren = 0
    depth_brace = 0
    while i < len(s):
        ch = s[i]
        if ch in ('"', "'"):
            _, i = parse_lua_string(s, i)
            continue
        if ch == "(":
            depth_paren += 1
        elif ch == ")":
            if depth_paren == 0 and depth_brace == 0:
                break
            depth_paren -= 1
        elif ch == "{":
            depth_brace += 1
        elif ch == "}":
            depth_brace -= 1
        elif ch == "," and depth_paren == 0 and depth_brace == 0:
            break
        i += 1
    return s[start:i].strip(), i


def expand_lua_expr(expr: str) -> str:
    expr = re.sub(r"\s+", " ", expr.strip())
    concat = re.match(r"^(\w+)\s*\.\.\s*(.+)$", expr)
    if concat:
        left = VARS.get(concat.group(1), concat.group(1))
        right, _ = parse_lua_string(concat.group(2), 0)
        if right is not None:
            return left + right
    bare, _ = parse_lua_string(expr, 0)
    if bare is not None and expr.lstrip().startswith(('"', "'")):
        return bare
    if re.fullmatch(r"\w+", expr):
        return VARS.get(expr, expr)
    return expr


def simplify_cmd(cmd: str) -> str:
    cmd = expand_lua_expr(cmd)
    cmd = re.sub(r"\s+", " ", cmd.strip())
    ipc_suffix = re.search(r"evo-ipc\s+(.+)$", cmd)
    if ipc_suffix:
        return f"evo-ipc {ipc_suffix.group(1).strip()}"
    return cmd


def humanize_flags(flags: str) -> str:
    if not flags:
        return ""
    hints: list[str] = []
    if re.search(r"repeating\s*=\s*true", flags):
        hints.append("repeating")
    if re.search(r"locked\s*=\s*true", flags):
        hints.append("active when screen locked")
    if re.search(r"mouse\s*=\s*true", flags):
        hints.append("mouse binding")
    if not hints:
        return ""
    return " · " + ", ".join(hints)


def humanize_dispatcher(dispatcher: str) -> str:
    d = re.sub(r"\s+", " ", dispatcher.strip())
    if d.startswith("function"):
        return "Custom Lua handler in bindings.lua"

    m = re.search(r"hl\.dsp\.exec_cmd\((.+)\)\s*$", d)
    if m:
        cmd = simplify_cmd(m.group(1))
        if cmd.startswith("evo-ipc "):
            return f"Runs evo-ipc: {cmd[8:]}"
        return f"Runs: {cmd}"

    m = re.search(r"hl\.dsp\.global\(\s*\"([^\"]+)\"\s*\)", d)
    if m:
        return f"Hyprland global event: {m.group(1)}"

    patterns = [
        (r"hl\.dsp\.window\.close\(\)", "Hyprland: close active window"),
        (r"hl\.dsp\.window\.drag\(\)", "Hyprland: drag window with mouse"),
        (r"hl\.dsp\.window\.resize\(\)", "Hyprland: resize window with mouse"),
        (r"hl\.dsp\.layout\(\s*\"([^\"]+)\"\s*\)", lambda m: f"Hyprland layout: {m.group(1)}"),
        (r"hl\.dsp\.workspace\.toggle_special\(\s*\"([^\"]+)\"\s*\)", lambda m: f"Hyprland: toggle special workspace {m.group(1)}"),
        (r"hl\.dsp\.focus\(\s*\{\s*workspace\s*=\s*(\d+)\s*\}\s*\)", lambda m: f"Hyprland: focus workspace {m.group(1)}"),
        (r"hl\.dsp\.focus\(\s*\{\s*workspace\s*=\s*\"([^\"]+)\"\s*\}\s*\)", lambda m: f"Hyprland: focus workspace {m.group(1)}"),
        (r"hl\.dsp\.focus\(\s*\{\s*direction\s*=\s*\"([^\"]+)\"\s*\}\s*\)", lambda m: f"Hyprland: move focus {m.group(1)}"),
        (r"hl\.dsp\.window\.move\(\s*\{\s*workspace\s*=\s*(\d+)", lambda m: f"Hyprland: move window to workspace {m.group(1)}"),
        (r"hl\.dsp\.window\.move\(\s*\{\s*workspace\s*=\s*\"([^\"]+)\"\s*\}\s*\)", lambda m: f"Hyprland: move window to {m.group(1)}"),
        (r"hl\.dsp\.window\.move\(\s*\{\s*direction\s*=\s*\"([^\"]+)\"\s*\}\s*\)", lambda m: f"Hyprland: move window {m.group(1)}"),
        (r"hl\.dsp\.window\.float\(\s*\{\s*action\s*=\s*\"([^\"]+)\"\s*\}\s*\)", lambda m: f"Hyprland: {m.group(1)} floating"),
        (r"hl\.dsp\.window\.fullscreen\(", "Hyprland: set window fullscreen"),
        (r"hl\.dsp\.window\.resize\(\s*\{\s*x\s*=\s*(-?\d+)", lambda m: f"Hyprland: resize window width by {m.group(1)} px"),
        (r"hl\.dsp\.window\.set_prop\(", "Hyprland: toggle window opacity"),
        (r"hl\.dsp\.pass\(", "Hyprland: pass key to window"),
    ]
    for pattern, label in patterns:
        m = re.search(pattern, d)
        if m:
            return label(m) if callable(label) else label

    return d


def shorten_path(p: str) -> str:
    if p.startswith(home + "/"):
        return "~" + p[len(home):]
    return p


def join_files(files: list[str]) -> str:
    seen: set[str] = set()
    out: list[str] = []
    for path in files:
        short = shorten_path(path)
        if short and short not in seen:
            seen.add(short)
            out.append(short)
    return "|".join(out)


def load_plugin_table(evoshell_root: str) -> dict[str, dict[str, str]]:
    try:
        with open(os.path.join(evoshell_root, "shell.qml"), encoding="utf-8") as fh:
            shell_text = fh.read()
    except OSError:
        return {}
    plugins: dict[str, dict[str, str]] = {}
    for m in re.finditer(r'"([^"]+)":\s*\{([^}]+)\}', shell_text, re.S):
        block = m.group(2)
        path_m = re.search(r'path:\s*"([^"]+)"', block)
        service_m = re.search(r'servicePath:\s*"([^"]+)"', block)
        plugins[m.group(1)] = {
            "path": path_m.group(1) if path_m else "",
            "servicePath": service_m.group(1) if service_m else "",
        }
    return plugins


EVOSHELL = os.path.join(home, ".config/quickshell/evoshell")
IPC_BIN = os.path.join(home, ".local/bin/evo-ipc")
PLUGIN_TABLE = load_plugin_table(EVOSHELL)


def plugin_file_paths(plugin_id: str) -> list[str]:
    info = PLUGIN_TABLE.get(plugin_id, {})
    out: list[str] = []
    if info.get("path"):
        out.append(os.path.join(EVOSHELL, info["path"]))
    if info.get("servicePath"):
        out.append(os.path.join(EVOSHELL, info["servicePath"]))
    return out


def related_files_for_binding(dispatcher: str, bindings_path: str) -> list[str]:
    files = [bindings_path]
    d = re.sub(r"\s+", " ", dispatcher.strip())

    if "evoshell:" in d:
        files.append(os.path.join(EVOSHELL, "shell.qml"))

    m = re.search(r"hl\.dsp\.exec_cmd\((.+)\)\s*$", d, re.S)
    if m:
        expanded = expand_lua_expr(m.group(1).strip())
        cmd = simplify_cmd(m.group(1))
        if "evo-ipc" in expanded or "evo-ipc" in cmd:
            files.append(IPC_BIN)
            files.append(os.path.join(EVOSHELL, "shell.qml"))
            if "toggleAppLauncher" in cmd or "toggleSystemMenu" in cmd:
                files.extend(plugin_file_paths("evo.menu"))
            toggle_m = re.search(r"shell toggle evo\.panel", cmd)
            if toggle_m:
                files.extend(plugin_file_paths("evo.panel"))
            plugin_m = re.search(r"shell toggle (evo\.[^\s]+)", cmd)
            if plugin_m:
                files.extend(plugin_file_paths(plugin_m.group(1)))
        token = expanded.split()[0] if expanded else ""
        if token.startswith(home + "/") or (
            token.startswith("/") and ("/evo-" in token or token.endswith(".lua"))
        ):
            files.append(token)

    return files


def iter_bindd_calls(s: str):
    i = 0
    while True:
        start = s.find("bindd(", i)
        if start == -1:
            break
        pos = start + len("bindd(")
        keys, pos = parse_lua_string(s, pos)
        if keys is None:
            i = start + 1
            continue
        desc, pos = parse_lua_string(s, pos)
        if desc is None:
            i = start + 1
            continue
        dispatcher, pos = parse_bindd_arg(s, pos)
        flags, pos = parse_bindd_arg(s, pos)
        pos = skip_ws_comma(s, pos)
        if pos < len(s) and s[pos] == ")":
            pos += 1
        yield keys.strip(), desc.strip(), dispatcher, flags.strip()
        i = pos


seen: set[tuple[str, str]] = set()
for keys, desc, dispatcher, flags in iter_bindd_calls(text):
    if not keys or not desc:
        continue
    pair = (keys, desc)
    if pair in seen:
        continue
    seen.add(pair)
    detail = humanize_dispatcher(dispatcher) + humanize_flags(flags)
    files = join_files(related_files_for_binding(dispatcher, path))
    print(f"{desc}\t{keys}\t{detail}\t{files}")
PY
    ;;
shell)
    python3 - "$home" "$script_dir" <<'PY'
import glob
import os
import re
import sys

home, script_dir = sys.argv[1], sys.argv[2]
ipc = "evo-ipc"

plugins = [
    "evo.menu",
    "evo.panel",
    "evo.calendar",
    "evo.shopify_diy",
    "evo.shopify_tgs",
    "evo.cursor",
    "evo.weather",
    "evo.network",
    "evo.volume",
    "evo.media",
    "evo.github",
    "evo.system",
    "evo.stocks",
    "evo.cloudflare",
    "evo.transmission",
    "evo.insync",
    "evo.steam",
    "evo.library",
    "evo.theme",
    "evo.wallpaper",
    "evo.clipboard",
]
dashboards = ["evo.shopify", "evo.player"]


def read_text(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def build_corpus() -> str:
    chunks = [
        read_text(os.path.join(home, ".config/hypr/bindings.lua")),
        read_text(os.path.join(home, ".config/quickshell/evoshell/plugins/menu/MenuEntries.js")),
    ]
    for path in sorted(glob.glob(os.path.join(home, ".config/quickshell/evoshell/plugins/bar/widgets/*.qml"))):
        chunks.append(read_text(path))
    for path in sorted(glob.glob(os.path.join(script_dir, "evo-*"))):
        if os.path.basename(path) in {"evo-menu-list", "evo-ipc"}:
            continue
        chunks.append(read_text(path))

    shell_qml = read_text(os.path.join(home, ".config/quickshell/evoshell/shell.qml"))
    for marker in (
        "toggleSystemMenu",
        "toggleAppLauncher",
        'openDashboardOnly("evo.shopify"',
        'openDashboardOnly("evo.player"',
    ):
        if marker in shell_qml:
            chunks.append(marker)

    return "\n".join(chunks)


corpus = build_corpus()
EVOSHELL = os.path.join(home, ".config/quickshell/evoshell")
IPC_BIN = os.path.join(home, ".local/bin/evo-ipc")


def shorten_path(p: str) -> str:
    if p.startswith(home + "/"):
        return "~" + p[len(home):]
    return p


def join_files(files: list[str]) -> str:
    seen: set[str] = set()
    out: list[str] = []
    for path in files:
        short = shorten_path(path)
        if short and short not in seen:
            seen.add(short)
            out.append(short)
    return "|".join(out)


def load_plugin_table() -> dict[str, dict[str, str]]:
    shell_text = read_text(os.path.join(EVOSHELL, "shell.qml"))
    plugins: dict[str, dict[str, str]] = {}
    for m in re.finditer(r'"([^"]+)":\s*\{([^}]+)\}', shell_text, re.S):
        block = m.group(2)
        path_m = re.search(r'path:\s*"([^"]+)"', block)
        service_m = re.search(r'servicePath:\s*"([^"]+)"', block)
        plugins[m.group(1)] = {
            "path": path_m.group(1) if path_m else "",
            "servicePath": service_m.group(1) if service_m else "",
        }
    return plugins


PLUGIN_TABLE = load_plugin_table()


def plugin_file_paths(plugin_id: str) -> list[str]:
    info = PLUGIN_TABLE.get(plugin_id, {})
    out: list[str] = []
    if info.get("path"):
        out.append(os.path.join(EVOSHELL, info["path"]))
    if info.get("servicePath"):
        out.append(os.path.join(EVOSHELL, info["servicePath"]))
    return out


def related_files_for_shell(command: str) -> list[str]:
    files = [IPC_BIN]
    cmd = command.strip()

    plugin_m = re.match(r"evo-ipc\s+(evo\.[^\s]+)", cmd)
    if plugin_m:
        files.extend(plugin_file_paths(plugin_m.group(1)))

    if re.search(r"\bshell\b", cmd):
        files.append(os.path.join(EVOSHELL, "shell.qml"))

    if "toggleSystemMenu" in cmd or "toggleAppLauncher" in cmd:
        files.extend(plugin_file_paths("evo.menu"))
    elif re.search(r"shell toggle evo\.panel", cmd):
        files.extend(plugin_file_paths("evo.panel"))
    else:
        for pattern in (
            r"shell toggle\s+(\S+)",
            r"shell summon\s+(\S+)",
            r"shell hide\s+(\S+)",
            r"shell openDashboard\s+(\S+)",
            r"shell call\s+(\S+)",
        ):
            m = re.search(pattern, cmd)
            if m:
                files.extend(plugin_file_paths(m.group(1)))
                break

    return files


def used(*needles: str) -> bool:
    return any(needle in corpus for needle in needles)


def plugin_used(plugin: str) -> bool:
    if plugin == "evo.menu":
        return used("toggleSystemMenu", 'toggle("evo.menu"', "toggle evo.menu")
    return used(
        f"shell toggle {plugin}",
        f"toggle {plugin}",
        f'toggle("{plugin}"',
        f"toggle('{plugin}'",
        f"summon {plugin}",
        f"hide {plugin}",
    )


def dashboard_used(plugin: str) -> bool:
    return used(f"openDashboard {plugin}", f'openDashboardOnly("{plugin}"')


def emit(name: str, command: str, internal: bool, detail: str = "") -> None:
    files = join_files(related_files_for_shell(command))
    print(f"{name}\t{command}\t{detail}\t{files}\t{1 if internal else 0}")


PLUGIN_DETAILS = {
