#!/usr/bin/env bash
# Shared layout helpers for evoshell bar and panel.

set -euo pipefail

SHELL_JSON="${HOME}/.config/quickshell/evoshell/shell.json"
SHELL_IPC="${HOME}/.local/bin/evo-ipc"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/evoshell"
UI_STATE="${STATE_DIR}/ui.json"

read_bar_state() {
    jq -c '{output: (.bar.output // ""), position: (.bar.position // "bottom")}' "$SHELL_JSON"
}

bar_on_dp1_top() {
    jq -e '(.bar.output // "") == "DP-1" and (.bar.position // "") == "top"' "$SHELL_JSON" >/dev/null
}

write_bar_layout() {
    local on_dp1_top="$1"
    local tmp
    tmp="$(mktemp)"
    if [[ "$on_dp1_top" == "true" ]]; then
        jq '.bar.output = "DP-1" | .bar.position = "top"' "$SHELL_JSON" >"$tmp"
    else
        jq '.bar.output = "HDMI-A-1" | .bar.position = "bottom"' "$SHELL_JSON" >"$tmp"
    fi
    mv "$tmp" "$SHELL_JSON"
}

set_bar_layout() {
    local output="$1"
    local position="$2"
    local tmp
    tmp="$(mktemp)"
    jq --arg output "$output" --arg position "$position" \
        '.bar.output = $output | .bar.position = $position' "$SHELL_JSON" >"$tmp"
    mv "$tmp" "$SHELL_JSON"
}

read_panel_state() {
    jq -c '{panelOnRight: ((.panel.side // "left") == "right")}' "$SHELL_JSON"
}

read_notifications_state() {
    jq -c '{output: (.notifications.output // ""), position: (.notifications.position // "bottom")}' "$SHELL_JSON"
}

notifications_on_hdmi_bottom() {
    jq -e '(.notifications.output // "") == "HDMI-A-1" and ((.notifications.position // "bottom") == "bottom")' "$SHELL_JSON" >/dev/null
}

write_notifications_layout() {
    local on_hdmi_bottom="$1"
    local tmp
    tmp="$(mktemp)"
    if [[ "$on_hdmi_bottom" == "true" ]]; then
        jq '.notifications.output = "HDMI-A-1" | .notifications.position = "bottom"' "$SHELL_JSON" >"$tmp"
    else
        jq '.notifications.output = "DP-1" | .notifications.position = "top"' "$SHELL_JSON" >"$tmp"
    fi
    mv "$tmp" "$SHELL_JSON"
}

set_notifications_layout() {
    local output="$1"
    local position="$2"
    local tmp
    tmp="$(mktemp)"
    jq --arg output "$output" --arg position "$position" \
        '.notifications.output = $output | .notifications.position = $position' "$SHELL_JSON" >"$tmp"
    mv "$tmp" "$SHELL_JSON"
}

write_panel_side() {
    local on_right="$1"
    local tmp
    tmp="$(mktemp)"
    if [[ "$on_right" == "true" ]]; then
        jq '.panel.side = "right" | del(.panel.pinned)' "$SHELL_JSON" >"$tmp"
    else
        jq '.panel.side = "left" | del(.panel.pinned)' "$SHELL_JSON" >"$tmp"
    fi
    mv "$tmp" "$SHELL_JSON"
}

reload_shell_config() {
    "$SHELL_IPC" shell reloadConfig >/dev/null
}

read_ui_state() {
    mkdir -p "$STATE_DIR"
    if [[ -f "$UI_STATE" ]] && jq -e 'type == "object"' "$UI_STATE" >/dev/null 2>&1; then
        jq -c '{fieldsetRounding: (.fieldsetRounding != false)}' "$UI_STATE"
    else
        echo '{"fieldsetRounding":true}'
    fi
}

write_ui_state() {
    local fieldset_rounding="$1"
    mkdir -p "$STATE_DIR"
    jq -n --argjson fieldsetRounding "$fieldset_rounding" '{fieldsetRounding: $fieldsetRounding}' >"$UI_STATE"
}

toggle_fieldset_rounding() {
    local current on
    current="$(read_ui_state)"
    on="$(jq -r 'if .fieldsetRounding then "true" else "false" end' <<<"$current")"
    if [[ "$on" == "true" ]]; then
        write_ui_state false
    else
        write_ui_state true
    fi
    read_ui_state
}

usage() {
    cat >&2 <<'EOF'
usage:
  evo-layout bar get|set <output> <top|bottom>|toggle|reset
  evo-layout panel get|toggle
  evo-layout notifications get|set <output> <top|bottom>|toggle
  evo-layout ui get|toggle fieldsetRounding
EOF
    exit 1
}

target="${1:-}"
action="${2:-}"

case "$target" in
bar)
    case "$action" in
    get)
        read_bar_state
        ;;
    set)
        output="${3:-}"
        position="${4:-}"
        if [[ -z "$output" || -z "$position" ]]; then
            usage
        fi
        case "$position" in
        top | bottom) ;;
        *)
            usage
            ;;
        esac
        set_bar_layout "$output" "$position"
        reload_shell_config
        read_bar_state
        ;;
    toggle)
        if bar_on_dp1_top; then
            write_bar_layout false
        else
            write_bar_layout true
        fi
        reload_shell_config
        read_bar_state
        ;;
    reset)
        write_bar_layout false
        reload_shell_config
        read_bar_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
panel)
    case "$action" in
    get)
        read_panel_state
        ;;
    toggle | toggle-side)
        current="$(read_panel_state)"
        on="$(jq -r 'if .panelOnRight then "true" else "false" end' <<<"$current")"
        if [[ "$on" == "true" ]]; then
            write_panel_side false
        else
            write_panel_side true
        fi
        reload_shell_config
        read_panel_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
notifications)
    case "$action" in
    get)
        read_notifications_state
        ;;
    set)
        output="${3:-}"
        position="${4:-}"
        if [[ -z "$output" || -z "$position" ]]; then
            usage
        fi
        case "$position" in
        top | bottom) ;;
        *)
            usage
            ;;
        esac
        set_notifications_layout "$output" "$position"
        reload_shell_config
        read_notifications_state
        ;;
    toggle)
        if notifications_on_hdmi_bottom; then
            write_notifications_layout false
        else
            write_notifications_layout true
        fi
        reload_shell_config
        read_notifications_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
ui)
    case "$action" in
    get)
        read_ui_state
        ;;
    toggle)
        key="${3:-}"
        case "$key" in
        fieldsetRounding)
            toggle_fieldset_rounding
            ;;
        *)
            usage
            ;;
        esac
        ;;
    *)
        usage
        ;;
    esac
    ;;
*)
    usage
    ;;
esac
