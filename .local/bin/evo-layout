#!/usr/bin/env bash
# Shared layout helpers for evoshell bar and panel.

set -euo pipefail

SHELL_JSON="${HOME}/.config/quickshell/evoshell/shell.json"
SHELL_IPC="${HOME}/.local/bin/evo-ipc"

read_bar_state() {
    jq -c '{barOnDp1Top: ((.bar.output // "") == "DP-1" and (.bar.position // "") == "top")}' "$SHELL_JSON"
}

write_bar_layout() {
    local on_dp1_top="$1"
    local tmp
    tmp="$(mktemp)"
    if [[ "$on_dp1_top" == "true" ]]; then
        jq '.bar.output = "DP-1" | .bar.position = "top"' "$SHELL_JSON" >"$tmp"
    else
        jq '.bar.output = "HDMI-A-1" | .bar.position = "bottom"' "$SHELL_JSON" >"$tmp"
    fi
    mv "$tmp" "$SHELL_JSON"
}

read_panel_state() {
    jq -c '{panelOnRight: ((.panel.side // "left") == "right")}' "$SHELL_JSON"
}

write_panel_side() {
    local on_right="$1"
    local tmp
    tmp="$(mktemp)"
    if [[ "$on_right" == "true" ]]; then
        jq '.panel.side = "right" | del(.panel.pinned)' "$SHELL_JSON" >"$tmp"
    else
        jq '.panel.side = "left" | del(.panel.pinned)' "$SHELL_JSON" >"$tmp"
    fi
    mv "$tmp" "$SHELL_JSON"
}

reload_shell_config() {
    "$SHELL_IPC" shell reloadConfig >/dev/null
}

usage() {
    cat >&2 <<'EOF'
usage:
  evo-layout bar get|toggle|reset
  evo-layout panel get|toggle
EOF
    exit 1
}

target="${1:-}"
action="${2:-}"

case "$target" in
bar)
    case "$action" in
    get)
        read_bar_state
        ;;
    toggle)
        current="$(read_bar_state)"
        on="$(jq -r 'if .barOnDp1Top then "true" else "false" end' <<<"$current")"
        if [[ "$on" == "true" ]]; then
            write_bar_layout false
        else
            write_bar_layout true
        fi
        reload_shell_config
        read_bar_state
        ;;
    reset)
        write_bar_layout false
        reload_shell_config
        read_bar_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
panel)
    case "$action" in
    get)
        read_panel_state
        ;;
    toggle | toggle-side)
        current="$(read_panel_state)"
        on="$(jq -r 'if .panelOnRight then "true" else "false" end' <<<"$current")"
        if [[ "$on" == "true" ]]; then
            write_panel_side false
        else
            write_panel_side true
        fi
        reload_shell_config
        read_panel_state
        ;;
    *)
        usage
        ;;
    esac
    ;;
*)
    usage
    ;;
esac
