#!/usr/bin/env bash
# Weather location settings + Met Office launcher for evoshell.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/evoshell"
LOCATION_FILE="${STATE_DIR}/weather-location.json"
DEFAULT_NAME="Derby"
DEFAULT_LAT="52.9219"
DEFAULT_LON="-1.4746"
DEFAULT_MET_URL="https://weather.metoffice.gov.uk/forecast/gcqvn6pq4"
usage() {
    cat >&2 <<'EOF'
usage:
  evo-weather settings get
  evo-weather settings set <location>
  evo-weather open
EOF
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

met_office_url_for() {
    local name="$1"
    case "${name,,}" in
        derby) printf '%s' "$DEFAULT_MET_URL" ;;
        *)
            python3 - "$name" <<'PY'
import sys, urllib.parse
print("https://weather.metoffice.gov.uk/forecast/find?q=" + urllib.parse.quote(sys.argv[1]))
PY
            ;;
    esac
}

geocode_location() {
    local query="$1"
    local raw name lat lon country
    raw="$(curl -fsS --max-time 12 \
        "https://geocoding-api.open-meteo.com/v1/search?name=$(python3 -c "import urllib.parse; print(urllib.parse.quote('${query//\'/}'))")&count=1&language=en&format=json" \
        2>/dev/null)" || raw=""
    [[ -n "$raw" ]] || return 1
    name="$(jq -r '.results[0].name // empty' <<<"$raw")"
    lat="$(jq -r '.results[0].latitude // empty' <<<"$raw")"
    lon="$(jq -r '.results[0].longitude // empty' <<<"$raw")"
    country="$(jq -r '.results[0].country // empty' <<<"$raw")"
    [[ -n "$name" && -n "$lat" && -n "$lon" ]] || return 1
    jq -cn \
        --arg name "$name" \
        --argjson lat "$lat" \
        --argjson lon "$lon" \
        --arg country "$country" \
        --arg metOfficeUrl "$(met_office_url_for "$name")" \
        '{name: $name, lat: $lat, lon: $lon, country: $country, metOfficeUrl: $metOfficeUrl}'
}

default_location_json() {
    jq -cn \
        --arg name "$DEFAULT_NAME" \
        --argjson lat "$DEFAULT_LAT" \
        --argjson lon "$DEFAULT_LON" \
        --arg metOfficeUrl "$DEFAULT_MET_URL" \
        '{name: $name, lat: $lat, lon: $lon, country: "United Kingdom", metOfficeUrl: $metOfficeUrl}'
}

read_location_json() {
    ensure_state_dir
    if [[ -f "$LOCATION_FILE" ]] && jq -e 'type == "object"' "$LOCATION_FILE" >/dev/null 2>&1; then
        local name lat lon country met_url resolved
        name="$(jq -r '.name // empty' "$LOCATION_FILE")"
        lat="$(jq -r '.lat // empty' "$LOCATION_FILE")"
        lon="$(jq -r '.lon // empty' "$LOCATION_FILE")"
        country="$(jq -r '.country // empty' "$LOCATION_FILE")"
        met_url="$(jq -r '.metOfficeUrl // empty' "$LOCATION_FILE")"
        if [[ -n "$name" && -n "$lat" && -n "$lon" && -n "$met_url" ]]; then
            jq -cn \
                --arg name "$name" \
                --argjson lat "$lat" \
                --argjson lon "$lon" \
                --arg country "$country" \
                --arg metOfficeUrl "$met_url" \
                '{ok: true, name: $name, lat: $lat, lon: $lon, country: $country, metOfficeUrl: $metOfficeUrl}'
            return 0
        fi
        if [[ -n "$name" ]]; then
            resolved="$(geocode_location "$name" 2>/dev/null || true)"
            if [[ -n "$resolved" ]]; then
                write_location_json "$resolved"
                jq -c '. + {ok: true}' <<<"$resolved"
                return 0
            fi
        fi
    fi
    default_location_json | jq -c '. + {ok: true}'
}

write_location_json() {
    local json="$1"
    ensure_state_dir
    printf '%s\n' "$json" | jq -c '{name, lat, lon, country, metOfficeUrl}' >"$LOCATION_FILE"
}

cmd_settings_get() {
    read_location_json
}

cmd_settings_set() {
    local query="${1:-}"
    [[ -n "$query" ]] || {
        jq -n '{ok: false, error: "location required"}'
        return 0
    }
    local resolved
    resolved="$(geocode_location "$query")" || {
        jq -cn --arg query "$query" '{ok: false, error: ("Could not find location: " + $query)}'
        return 0
    }
    write_location_json "$resolved"
    jq -c '. + {ok: true}' <<<"$resolved"
}

cmd_open() {
    local url
    url="$(read_location_json | jq -r '.metOfficeUrl // empty')"
    [[ -n "$url" ]] || url="$DEFAULT_MET_URL"
    exec "${HOME}/.local/bin/evo-bar-brave" open brave-weather "$url"
}

cmd="${1:-}"
sub="${2:-}"
case "$cmd" in
settings)
    case "$sub" in
    get) cmd_settings_get ;;
    set) cmd_settings_set "${3:-}" ;;
    *) usage; exit 1 ;;
    esac
    ;;
open) cmd_open ;;
""|-h|--help) usage; exit 0 ;;
*) usage; exit 1 ;;
esac
