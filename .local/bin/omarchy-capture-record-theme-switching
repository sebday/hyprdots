#!/usr/bin/env bash

# omarchy:summary=Record each Omarchy theme on the current monitor (no audio)
# omarchy:group=capture

set -euo pipefail

INTERVAL="${OMARCHY_THEME_RECORD_INTERVAL:-0.5}"

if pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
	omarchy-notification-send "Already recording" "Stop the current recording first" -t 4000
	exit 1
fi

mapfile -t themes < <(omarchy-theme-list 2>/dev/null | sed '/^[[:space:]]*$/d')
total=${#themes[@]}

if ((total == 0)); then
	omarchy-notification-send "No themes found" -t 3000
	exit 1
fi

start_theme="$(omarchy theme current 2>/dev/null || true)"
start_index=-1
for i in "${!themes[@]}"; do
	if [[ ${themes[$i]} == "$start_theme" ]]; then
		start_index=$i
		break
	fi
done
if ((start_index == -1)); then
	start_index=0
fi

RECORDING_FILE="/tmp/omarchy-screenrecord-filename"

finalize_recording() {
	local latest=$1
	local video_codec=(-c:v copy)

	if ffprobe -v error -select_streams v:0 -read_intervals %+0.2 -show_entries packet=flags -of csv=p=0 "$latest" 2>/dev/null | grep -q D; then
		video_codec=(-c:v libx264 -preset veryfast -crf 20)
	fi

	local args=(-y -ss 0.1 -i "$latest" "${video_codec[@]}")
	if ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$latest" 2>/dev/null | grep -q audio; then
		args+=(-af "volume=enable='lt(t,0.4)':volume=0,afade=t=in:st=0.4:d=0.05,loudnorm=I=-14:TP=-1.5:LRA=11")
	fi

	local processed="${latest%.mp4}-processed.mp4"
	if ffmpeg "${args[@]}" "$processed" -loglevel quiet 2>/dev/null; then
		mv "$processed" "$latest"
	else
		rm -f "$processed"
	fi
}

stop_recording() {
	pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1 || return 0

	pkill -SIGINT -f '^gpu-screen-recorder'

	local count=0
	while pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1 && ((count < 50)); do
		sleep 0.1
		count=$((count + 1))
	done

	if pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
		pkill -9 -f '^gpu-screen-recorder'
	fi

	omarchy-shell -q omarchy.indicators refresh 2>/dev/null || true

	local latest
	latest=$(cat "$RECORDING_FILE" 2>/dev/null || true)
	if [[ -n $latest && -f $latest ]]; then
		finalize_recording "$latest"
	fi
	rm -f "$RECORDING_FILE"
}

on_interrupt() {
	stop_recording || true
	if [[ -n $start_theme ]]; then
		omarchy theme set "$start_theme" || true
	fi
	exit 130
}

trap on_interrupt INT TERM

omarchy-capture-screenrecording --fullscreen

for _ in $(seq 1 50); do
	pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1 && break
	sleep 0.1
done

if ! pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
	omarchy-notification-send -u critical "Recording did not start" -t 5000
	exit 1
fi

sleep "$INTERVAL"

for ((i = 1; i <= total; i++)); do
	next_index=$(((start_index + i) % total))
	omarchy theme set "${themes[$next_index]}"
	sleep "$INTERVAL"
done

stop_recording
