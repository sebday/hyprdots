#!/bin/bash
# Toggle evo.music player window (Shopify-style quickshell FloatingWindow).

set -euo pipefail

IPC="quickshell ipc -c evoshell call shell"

usage() {
  cat >&2 <<'EOF'
usage: evo-bar-music show|hide|toggle|visible
EOF
  exit 1
}

find_windows() {
  hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.title == "evo.music") | .address'
}

has_window() {
  [[ -n "$(find_windows | head -1)" ]]
}

cmd_show() {
  $IPC musicOpen >/dev/null 2>&1 || true
}

cmd_hide() {
  $IPC musicClose >/dev/null 2>&1 || true
}

cmd_toggle() {
  $IPC musicToggle >/dev/null 2>&1 || true
}

cmd_visible() {
  if has_window; then
    exit 0
  fi
  exit 1
}

cmd="${1:-}"
case "$cmd" in
  show) cmd_show ;;
  hide) cmd_hide ;;
  toggle) cmd_toggle ;;
  visible) cmd_visible ;;
  -h|--help|help|"") usage ;;
  *)
    echo "evo-bar-music: unknown command: $cmd" >&2
    usage
    ;;
esac
