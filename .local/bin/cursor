#!/bin/sh
# Launch Cursor through Hyprland so it gets the same session environment as
# running `cursor` from a terminal. Walker/Elephant otherwise starts apps in a
# new session (setsid), which can make Cursor open a separate window with
# default zoom/fonts instead of your saved profile.
set -eu

CURSOR_BIN=/usr/bin/cursor
if [ ! -x "$CURSOR_BIN" ]; then
	CURSOR_BIN=/usr/share/cursor/cursor
fi

if [ ! -x "$CURSOR_BIN" ]; then
	if [ "${1:-}" = "agent" ]; then
		exec "$HOME/.local/bin/agent" "$@"
	fi
	echo "Error: No Cursor IDE installation found. Use 'cursor agent' or 'agent' to run the agent." 1>&2
	echo "Or, install Cursor at https://cursor.com/download" 1>&2
	exit 1
fi

# Subcommands that must run in the current shell, not via hyprctl.
case "${1:-}" in
agent|tunnel|serve-web)
	exec "$CURSOR_BIN" "$@"
	;;
esac

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	cmd="$CURSOR_BIN --reuse-window"
	for arg in "$@"; do
		cmd="$cmd $(printf '%q' "$arg")"
	done
	exec hyprctl dispatch exec "$cmd"
fi

exec "$CURSOR_BIN" --reuse-window "$@"
