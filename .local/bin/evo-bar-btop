#!/usr/bin/env bash
# Tiled btop for the evoshell system bar widget (workspace 10, TUI.tiled).
# Click the system bar widget to swap with the Shopify panel.

set -euo pipefail

BTOP_CLASS="TUI.tiled"

usage() {
    cat <<'EOF'
usage: evo-bar-btop show|hide|toggle|swap|visible
EOF
}

find_windows() {
    hyprctl clients -j 2>/dev/null | jq -r --arg c "$BTOP_CLASS" '
        .[] | select(.class == $c or (.class == "com.mitchellh.ghostty" and .title == "btop"))
            | .address
    '
}

has_window() {
    [[ -n "$(find_windows | head -1)" ]]
}

hypr_eval() {
    hyprctl eval "$1" >/dev/null 2>&1 || true
}

btop_cmd() {
    printf 'ghostty --class=%s --window-padding-x=0 --window-padding-y=0 -e btop' "$BTOP_CLASS"
}

cmd_show() {
    has_window && return 0
    hypr_eval "return hl.dispatch(hl.dsp.exec_cmd(\"$(btop_cmd)\", { workspace = '10 silent' }))"
}

cmd_hide() {
    while read -r addr; do
        [[ -n "$addr" ]] || continue
        hypr_eval "return hl.dispatch(hl.dsp.window.close({ window = \"address:${addr}\" }))"
    done < <(find_windows)
}

cmd_toggle() {
    if has_window; then
        cmd_hide
    else
        cmd_show
    fi
}

cmd_swap() {
    if has_window; then
        cmd_hide
        "${HOME}/.local/bin/evo-ipc" shell summon evo.shopify >/dev/null 2>&1 || true
    else
        "${HOME}/.local/bin/evo-ipc" shell hide evo.shopify >/dev/null 2>&1 || true
        cmd_show
    fi
}

cmd_visible() {
    if has_window; then
        exit 0
    fi
    exit 1
}

cmd="${1:-}"
case "$cmd" in
show) cmd_show ;;
hide) cmd_hide ;;
toggle) cmd_toggle ;;
swap) cmd_swap ;;
visible) cmd_visible ;;
-h|--help|help|"") usage ;;
*)
    echo "evo-bar-btop: unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
