#!/usr/bin/env bash
# Incognito uses its own data directory. A second Brave only SIGKILLs the
# running one when both launches share that profile.

set -euo pipefail

dir="${XDG_DATA_HOME:-$HOME/.local/share}/brave-incognito"
mkdir -p "$dir"

exec uwsm-app -- brave \
  --user-data-dir="$dir" \
  --incognito \
  --no-first-run \
  --no-default-browser-check
