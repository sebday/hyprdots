#!/bin/bash
# Local music library: sync, tags, playlists, browse for evoshell.

set -euo pipefail

EVOSHELL_BIN="${EVOSHELL_BIN:-$HOME/.local/bin}"
# shellcheck source=evo-music-lib.sh
source "${EVOSHELL_BIN}/evo-music-lib.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  evo-music sync
  evo-music import
  evo-music playlists [--force]
  evo-music rebuild
  evo-music build [--genre <name>] [--json]
  evo-music warm [--tags] [--art] [--waveforms] [--genre <name>] [--json]
  evo-music cache [--force] [--json] [genre]
  evo-music job status [--json]
  evo-music genres [--json]
  evo-music tracks <genre> [--json]
  evo-music browse [path] [--json]
  evo-music playlist [--json]
  evo-music playlist <name> [--json]
  evo-music playlist star toggle <name> [--json]
  evo-music retag <path> <genre> [--json]
  evo-music favorite toggle <path> [--json]
  evo-music status [--json]
  evo-music player ...   # deprecated — use evo-player
EOF
  exit 1
}

cmd_sync() {
  ensure_dirs
  local cookies user url
  cookies="$(config_val cookies_from brave)"
  user="$(config_val user seb-day)"
  url="$(config_val likes_url "https://soundcloud.com/${user}/likes")"
  yt-dlp \
    --cookies-from-browser "$cookies" \
    --download-archive "$SYNC_ARCHIVE" \
    -x --audio-format mp3 --embed-metadata --embed-thumbnail \
    -o "${MUSIC_ROOT}/incoming/%(uploader)s - %(title)s.%(ext)s" \
    "$url"
}

cmd_import_impl() {
  if ! command -v beet >/dev/null 2>&1; then
    echo "evo-music: beet not found (run: uv tool install beets)" >&2
    return 1
  fi
  local incoming="${MUSIC_ROOT}/incoming"
  [[ -d "$incoming" ]] || mkdir -p "$incoming"
  local count
  count="$(find "$incoming" -maxdepth 1 -type f | wc -l)"
  if [[ "$count" -eq 0 ]]; then
    echo "evo-music: nothing in incoming/" >&2
    return 0
  fi
  beet import -q "$incoming"
}

cmd_import() {
  run_exclusive_job import "import incoming" cmd_import_impl
}

write_likes_m3u() {
  local out="$1"
  likes_init
  local tmp
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  mv "$tmp" "$out"
}

write_playlist() {
  local genre="${1%-fav}"
  local out="${PLAYLIST_DIR}/${genre}-fav.m3u"
  likes_init
  local tmp count line
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      [[ "$(genre_from_path "$f")" == "$genre" ]] || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    count=$((count + 1))
  done <"$tmp"
  if [[ "$count" -eq 0 ]]; then
    rm -f "$out" "$tmp"
    return 0
  fi
  mv "$tmp" "$out"
}

cmd_playlists() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  likes_init
  echo "evo-music: rebuilding liked-track playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  write_likes_m3u "${PLAYLIST_DIR}/favorites.m3u"
  echo "evo-music: rebuilding track tag caches..." >&2
  if [[ "$force" -eq 1 ]]; then
    cmd_cache --force
  else
    cmd_cache
  fi
}

cmd_rebuild_impl() {
  echo "evo-music: rebuild started at $(date -Iseconds)" >&2
  echo "evo-music: rebuilding playlists and track caches..." >&2
  cmd_playlists --force
  echo "evo-music: rebuild complete at $(date -Iseconds)" >&2
}

cmd_rebuild() {
  run_exclusive_job rebuild "rebuild library" cmd_rebuild_impl
}

warm_collect_paths() {
  local genre="${1:-}"
  local cache g f
  if [[ -n "$genre" ]]; then
    cache="$(tracks_cache_path "$genre")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
      return 0
    fi
    while IFS= read -r -d '' f; do
      is_audio "$f" && printf '%s\n' "$f"
    done < <(find "${MUSIC_ROOT}/${genre}" -type f -print0 2>/dev/null)
    return 0
  fi
  while IFS= read -r g; do
    cache="$(tracks_cache_path "$g")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
    else
      while IFS= read -r -d '' f; do
        is_audio "$f" && printf '%s\n' "$f"
      done < <(find "${MUSIC_ROOT}/${g}" -type f -print0 2>/dev/null)
    fi
  done < <(list_genres)
}

warm_paths_ordered() {
  local genre="${1:-}"
  local tmp liked rest path
  tmp="$(mktemp)"
  liked="$(mktemp)"
  rest="$(mktemp)"
  likes_init
  jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    is_audio "$path" || continue
    if [[ -n "$genre" && "$(genre_from_path "$path")" != "$genre" ]]; then
      continue
    fi
    printf '%s\n' "$path"
  done | sort -u >"$liked"
  warm_collect_paths "$genre" | sort -u >"$rest"
  awk 'FNR==NR {seen[$0]=1; print; next} !seen[$0]' "$liked" "$rest" >"$tmp"
  cat "$liked" "$tmp"
  rm -f "$liked" "$rest" "$tmp"
}

warm_asset_needed() {
  local path="$1"
  local kind="$2"
  case "$kind" in
    art)
      [[ -n "$(art_path_cached "$path")" ]] && return 1
      return 0
      ;;
    waveforms)
      [[ -n "$(waveform_cache_find "$path" 2>/dev/null || true)" ]] && return 1
      return 0
      ;;
  esac
  return 1
}

cmd_warm() {
  local do_art=0 do_wf=0 do_tags=0 json=0 genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --art) do_art=1 ;;
      --waveforms) do_wf=1 ;;
      --tags) do_tags=1 ;;
      --json) json=1 ;;
      --genre) genre="${2:-}"; shift ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  [[ "$do_art" -eq 1 || "$do_wf" -eq 1 || "$do_tags" -eq 1 ]] || {
    do_art=1
    do_wf=1
  }
  ensure_dirs
  if [[ "$do_tags" -eq 1 ]]; then
    if [[ -n "$genre" ]]; then
      cmd_cache "$genre"
    else
      cmd_cache
    fi
  fi

  local -a paths=()
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    paths+=("$path")
  done < <(warm_paths_ordered "$genre")

  local total=${#paths[@]} done=0 art_built=0 wf_built=0 art_skipped=0 wf_skipped=0
  local wf_limit=2 art_limit=4 wf_running=0 art_running=0

  for path in "${paths[@]}"; do
    if [[ "$do_art" -eq 1 ]]; then
      if warm_asset_needed "$path" art; then
        while (( art_running >= art_limit )); do
          wait -n 2>/dev/null || wait
          art_running=$((art_running - 1))
        done
        art_running=$((art_running + 1))
        (
          art_path_for "$path" >/dev/null 2>&1
          exit 0
        ) &
        art_built=$((art_built + 1))
      else
        art_skipped=$((art_skipped + 1))
      fi
    fi
    if [[ "$do_wf" -eq 1 ]]; then
      if warm_asset_needed "$path" waveforms; then
        while (( wf_running >= wf_limit )); do
          wait -n 2>/dev/null || wait
          wf_running=$((wf_running - 1))
        done
        wf_running=$((wf_running + 1))
        (
          waveform_build "$path" >/dev/null 2>&1
          exit 0
        ) &
        wf_built=$((wf_built + 1))
      else
        wf_skipped=$((wf_skipped + 1))
      fi
    fi
    done=$((done + 1))
    if (( done % 25 == 0 || done == total )); then
      echo "evo-music: warming ${done}/${total} (art +${art_built}/-${art_skipped}, waveforms +${wf_built}/-${wf_skipped})" >&2
    fi
  done
  wait

  echo "evo-music: warm complete ${done}/${total}" >&2
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --argjson total "$total" \
      --argjson done "$done" \
      --argjson art_built "$art_built" \
      --argjson wf_built "$wf_built" \
      --argjson art_skipped "$art_skipped" \
      --argjson wf_skipped "$wf_skipped" \
      '{total:$total,done:$done,art_built:$art_built,waveform_built:$wf_built,art_skipped:$art_skipped,waveform_skipped:$wf_skipped}'
  fi
}

cmd_build_impl() {
  local genre="${1:-}"
  echo "evo-music: build library started at $(date -Iseconds)" >&2
  ensure_dirs
  likes_init
  echo "evo-music: refreshing playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  write_likes_m3u "${PLAYLIST_DIR}/favorites.m3u"
  echo "evo-music: indexing track tags..." >&2
  if [[ -n "$genre" ]]; then
    cmd_cache "$genre"
  else
    cmd_cache
  fi
  echo "evo-music: warming art and waveforms..." >&2
  if [[ -n "$genre" ]]; then
    cmd_warm --art --waveforms --genre "$genre"
  else
    cmd_warm --art --waveforms
  fi
  echo "evo-music: build library complete at $(date -Iseconds)" >&2
}

cmd_build() {
  local genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      --genre) genre="${2:-}"; shift ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  run_exclusive_job build "build library" cmd_build_impl "$genre"
}

cmd_soundcloud_impl() {
  cmd_sync
  cmd_import_impl
  cmd_playlists
}

cmd_soundcloud() {
  run_exclusive_job soundcloud "sync soundcloud" cmd_soundcloud_impl
}

cmd_cache() {
  local force=0 json=0 genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      --json) json=1 ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  ensure_dirs
  local g cache built=0 skipped=0 total=0 count
  cache_one() {
    local name="$1"
    [[ -d "${MUSIC_ROOT}/${name}" ]] || {
      echo "evo-music: unknown genre: ${name}" >&2
      return 1
    }
    total=$((total + 1))
    cache="$(tracks_cache_path "$name")"
    if [[ "$force" -eq 1 ]] || tracks_cache_stale "$name" "$cache"; then
      echo "evo-music: caching ${name}..." >&2
      build_tracks_json "$name" "$force" >/dev/null
      count="$(jq 'length' "$cache" 2>/dev/null || echo 0)"
      [[ -n "$count" ]] || count=0
      echo "evo-music: cached ${name} (${count} tracks)" >&2
      built=$((built + 1))
    else
      echo "evo-music: ${name} cache already fresh" >&2
      skipped=$((skipped + 1))
    fi
  }
  if [[ -n "$genre" ]]; then
    cache_one "$genre"
  else
    while IFS= read -r g; do
      cache_one "$g"
    done < <(list_genres)
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n --argjson built "$built" --argjson skipped "$skipped" --argjson total "$total" \
      '{built:$built,skipped:$skipped,total:$total}'
  else
    echo "evo-music: cached ${built} genre(s), ${skipped} already fresh (${total} total)" >&2
  fi
}

cmd_genres() {
  local json="${1:-}"
  if [[ "$json" == --json ]]; then
    printf '['
    local first=1 g count
    while IFS= read -r g; do
      count="$(genre_track_count_cached "$g")"
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '{"name":"%s","count":%s}' "$(json_escape "$g")" "$count"
    done < <(list_genres)
    printf ']\n'
  else
    list_genres
  fi
}

cmd_tracks() {
  local genre="$1"
  local json="${2:-}"
  local dir="$MUSIC_ROOT/$genre"
  local cache
  [[ -d "$dir" ]] || { echo "evo-music: unknown genre: $genre" >&2; return 1; }
  if [[ "$json" == --json ]]; then
    cache="$(tracks_cache_path "$genre")"
    if tracks_cache_stale "$genre" "$cache"; then
      build_tracks_json "$genre"
    else
      cat "$cache"
    fi
  else
    find "$dir" -maxdepth 1 -type f | sort
  fi
}

browse_resolve() {
  local rel="${1:-}"
  rel="${rel#/}"
  rel="${rel%/}"
  local dir root real_root real_dir
  root="$(realpath -m "$MUSIC_ROOT")"
  if [[ -z "$rel" ]]; then
    dir="$MUSIC_ROOT"
  else
    dir="${MUSIC_ROOT}/${rel}"
  fi
  real_dir="$(realpath -m "$dir")"
  [[ "$real_dir" == "$root" || "$real_dir" == "$root"/* ]] || return 1
  [[ -d "$real_dir" ]] || return 1
  printf '%s\n%s\n' "$rel" "$real_dir"
}

browse_track_enrich_json() {
  local line="$1"
  local path liked_json=false
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] && is_liked "$path" && liked_json=true
  jq -c --argjson liked "$liked_json" '. + {liked:$liked}' <<<"$line"
}

browse_track_json() {
  local path="$1"
  browse_track_enrich_json "$(track_list_json "$path")" | jq -c '. + {type:"track"}'
}

browse_track_art_json() {
  local line="$1"
  local path art
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] || {
    browse_track_enrich_json "$line"
    return 0
  }
  art="$(jq -r '.art // ""' <<<"$line")"
  if [[ -n "$art" ]]; then
    browse_track_enrich_json "$line"
    return 0
  fi
  art="$(art_path_cached "$path")"
  [[ -n "$art" ]] || art="$(art_path_resolve "$path")"
  browse_track_enrich_json "$(jq -c --arg art "$art" '.art = $art' <<<"$line")"
}

browse_tracks_cached_lines() {
  local dir="$1"
  local cache="$2"
  jq -r --arg dir "$dir" '
    def child_path($p):
      ($p | ltrimstr($dir + "/")) | test("^[^/]+$");
    [.[] | select(.path | startswith($dir + "/")) | select(child_path(.path)) | . + {type:"track"}]
    | .[] | @json
  ' "$cache"
}

browse_emit_cached_tracks() {
  local dir="$1"
  local cache="$2"
  local -a lines=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    lines+=("$line")
  done < <(browse_tracks_cached_lines "$dir" "$cache")
  [[ ${#lines[@]} -gt 0 ]] || return 1

  local i=0 n=${#lines[@]} batch=24 tmpdir out
  tmpdir="$(mktemp -d)"
  for line in "${lines[@]}"; do
    browse_track_art_json "$line" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  for ((i = 0; i < n; i++)); do
    [[ -f "${tmpdir}/${i}.json" ]] || continue
    cat "${tmpdir}/${i}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
  return 0
}

browse_emit_tracks_parallel() {
  local dir="$1"
  local -a files=()
  local entry f i=0 n batch=16 tmpdir

  while IFS= read -r -d '' entry; do
    is_audio "$entry" || continue
    files+=("$entry")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

  n=${#files[@]}
  [[ "$n" -eq 0 ]] && return 0

  tmpdir="$(mktemp -d)"
  for f in "${files[@]}"; do
    browse_track_json "$f" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  local j
  for ((j = 0; j < n; j++)); do
    [[ -f "${tmpdir}/${j}.json" ]] || continue
    cat "${tmpdir}/${j}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
}

browse_emit_tracks() {
  local rel="$1"
  local dir="$2"
  local genre cache lines

  genre="${rel%%/*}"
  cache="$(tracks_cache_path "$genre")"
  if [[ -n "$genre" && -f "$cache" && -s "$cache" ]]; then
    if browse_emit_cached_tracks "$dir" "$cache"; then
      lines="$(browse_tracks_cached_lines "$dir" "$cache")"
      browse_warm_art_async "$lines"
      return 0
    fi
  fi
  browse_emit_tracks_parallel "$dir"
}

playlist_track_count() {
  local m3u="$1"
  local count=0 line
  [[ -f "$m3u" ]] || { printf '0'; return; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] && count=$((count + 1))
  done <"$m3u"
  printf '%d' "$count"
}

playlist_stars_load() {
  if [[ -f "$PLAYLIST_STARS" ]]; then
    jq -c '.' "$PLAYLIST_STARS" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

playlist_stars_save() {
  local json="$1"
  printf '%s\n' "$json" >"$PLAYLIST_STARS"
}

playlist_stars_prune() {
  local stars json kept=() m3u base
  stars="$(playlist_stars_load)"
  for m3u in "$PLAYLIST_DIR"/*.m3u; do
    [[ -f "$m3u" ]] || continue
    base="$(basename "$m3u" .m3u)"
    if jq -e --arg n "$base" 'index($n) != null' <<<"$stars" >/dev/null 2>&1; then
      kept+=("$base")
    fi
  done
  if ((${#kept[@]} > 0)); then
    json="$(printf '%s\n' "${kept[@]}" | jq -R . | jq -sc .)"
  else
    json='[]'
  fi
  playlist_stars_save "$json"
}

playlist_is_starred() {
  local name="$1"
  jq -e --arg n "$name" 'index($n) != null' <<<"$(playlist_stars_load)" >/dev/null 2>&1
}

playlist_kind() {
  local name="$1"
  case "$name" in
    all|favorites) printf 'system' ;;
    *)
      if [[ "$name" == *-fav ]]; then
        printf 'fav'
      elif [[ -d "${MUSIC_ROOT}/${name}" ]]; then
        printf 'genre'
      else
        printf 'other'
      fi
      ;;
  esac
}

cmd_playlist_star_toggle() {
  local name="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  [[ -n "$name" ]] || { echo "evo-music: playlist name required" >&2; return 1; }
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-music: unknown playlist: $name" >&2; return 1; }
  local stars starred=false
  stars="$(playlist_stars_load)"
  if playlist_is_starred "$name"; then
    stars="$(jq -c --arg n "$name" 'map(select(. != $n))' <<<"$stars")"
    starred=false
  else
    stars="$(jq -c --arg n "$name" '. + [$n] | unique' <<<"$stars")"
    starred=true
  fi
  playlist_stars_save "$stars"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg name "$name" \
      --argjson starred "$starred" \
      --argjson stars "$stars" \
      '{name:$name,starred:$starred,stars:$stars}'
  elif [[ "$starred" == true ]]; then
    printf 'starred %s\n' "$name"
  else
    printf 'unstarred %s\n' "$name"
  fi
}

cmd_playlist_star() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    toggle) cmd_playlist_star_toggle "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-music: unknown playlist star command: $sub" >&2; usage ;;
  esac
}

cmd_browse() {
  local rel="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) rel="$1" ;;
    esac
    shift
  done
  ensure_dirs
  local resolved dir parent name
  resolved="$(browse_resolve "$rel")" || { echo "evo-music: invalid browse path: $rel" >&2; return 1; }
  rel="$(sed -n '1p' <<<"$resolved")"
  dir="$(sed -n '2p' <<<"$resolved")"
  if [[ -z "$rel" ]]; then
    parent=""
  elif [[ "$rel" == */* ]]; then
    parent="${rel%/*}"
  else
    parent=""
  fi
  if [[ "$json" -eq 1 ]]; then
    printf '{'
    printf '"path":"%s",' "$(json_escape "$rel")"
    if [[ -z "$rel" ]]; then
      printf '"parent":null,'
    else
      printf '"parent":"%s",' "$(json_escape "$parent")"
    fi
    printf '"entries":['
    local first=1 entry sub name count
    if [[ -z "$rel" ]]; then
      while IFS= read -r name; do
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        count="$(genre_track_count_cached "$name")"
        printf '{"type":"dir","name":"%s","path":"%s","count":%s}' \
          "$(json_escape "$name")" "$(json_escape "$name")" "$count"
      done < <(list_genres)
    else
      while IFS= read -r -d '' entry; do
        [[ -d "$entry" ]] || continue
        name="$(basename "$entry")"
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '{"type":"dir","name":"%s","path":"%s"}' \
          "$(json_escape "$name")" "$(json_escape "${rel}/${name}")"
      done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
      while IFS= read -r track_line; do
        [[ -n "$track_line" ]] || continue
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '%s' "$track_line"
      done < <(browse_emit_tracks "$rel" "$dir" | sed '/^$/d')
    fi
    printf ']}\n'
  else
    if [[ -z "$rel" ]]; then
      list_genres
    else
      find "$dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) | sort
    fi
  fi
}

cmd_playlist() {
  local name="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  if [[ -z "$name" ]]; then
    playlist_stars_prune
    if [[ "$json" -eq 1 ]]; then
      printf '['
      local first=1 m3u base count kind starred_json
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        base="$(basename "$m3u" .m3u)"
        count="$(playlist_track_count "$m3u")"
        kind="$(playlist_kind "$base")"
        if playlist_is_starred "$base"; then
          starred_json=true
        else
          starred_json=false
        fi
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '{"name":"%s","count":%s,"kind":"%s","starred":%s}' \
          "$(json_escape "$base")" "$count" "$kind" "$starred_json"
      done
      printf ']\n'
    else
      local m3u base
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        basename "$m3u" .m3u
      done | sort
    fi
    return 0
  fi
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-music: unknown playlist: $name" >&2; return 1; }
  if [[ "$json" -eq 1 ]]; then
    printf '['
    local first=1 line
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//$'\r'/}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ -f "$line" ]] || continue
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      track_list_json "$line"
    done <"$list"
    printf ']\n'
  else
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//$'\r'/}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ -f "$line" ]] && printf '%s\n' "$line"
    done <"$list"
  fi
}

cmd_retag() {
  local path="$1"
  local new_genre="$2"
  local json="${3:-}"
  [[ -f "$path" ]] || { echo "evo-music: not a file: $path" >&2; return 1; }
  [[ -n "$new_genre" ]] || { echo "evo-music: genre required" >&2; return 1; }
  [[ -d "${MUSIC_ROOT}/${new_genre}" ]] || { echo "evo-music: unknown genre: $new_genre" >&2; return 1; }

  local old_path="$path" new_path id=""
  if command -v beet >/dev/null 2>&1; then
    id="$(beet_item_id_for_path "$path" || true)"
  fi

  new_path="$(retag_manual "$path" "$new_genre")"
  [[ -f "$new_path" ]] || { echo "evo-music: retag failed" >&2; return 1; }

  if [[ -n "$id" ]]; then
    beet remove -d "id:$id" 2>/dev/null || true
  fi

  if is_liked "$old_path"; then
    likes_init
    jq --arg old "$old_path" --arg new "$new_path" \
      'if has($old) then .[$new] = .[$old] | del(.[$old]) else . end' \
      "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  fi

  cmd_playlists

  local old_genre
  old_genre="$(genre_from_path "$old_path")"
  tracks_cache_invalidate_genre "$old_genre"
  tracks_cache_invalidate_genre "$new_genre"

  if [[ "$json" == --json ]]; then
    jq -n \
      --arg path "$new_path" \
      --arg genre "$new_genre" \
      --arg old_path "$old_path" \
      '{path:$path,genre:$genre,old_path:$old_path}'
  else
    printf 'moved to %s\n' "$new_path"
  fi
}

cmd_favorite_toggle() {
  local path="$1"
  local json="${2:-}"
  [[ -f "$path" ]] || { echo "evo-music: not a file: $path" >&2; return 1; }
  ensure_dirs
  likes_init
  local title artist now liked genre
  title="$(ffprobe_meta "$path" title)"
  artist="$(ffprobe_meta "$path" artist)"
  [[ -z "$title" ]] && title="$(basename "${path%.*}")"
  now="$(date -Iseconds)"
  genre="$(genre_from_path "$path")"
  if is_liked "$path"; then
    liked=false
    jq --arg p "$path" 'del(.[$p])' "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  else
    liked=true
    jq --arg p "$path" --arg title "$title" --arg artist "$artist" --arg at "$now" \
      '.[$p] = {title:$title, artist:$artist, liked_at:$at}' \
      "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  fi
  write_likes_m3u "${PLAYLIST_DIR}/favorites.m3u"
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  [[ -n "$genre" ]] && write_playlist "$genre"
  if [[ "$json" == --json ]]; then
    jq -n --arg path "$path" --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
      '{path:$path,liked:$liked}'
  elif [[ "$liked" == true ]]; then
    printf 'liked\n'
  else
    printf 'unliked\n'
  fi
}

cmd_status() {
  local json="${1:-}"
  ensure_dirs
  local genres=0 tracks=0 g
  while IFS= read -r g; do
    genres=$((genres + 1))
    tracks=$((tracks + $(genre_track_count_cached "$g")))
  done < <(list_genres)
  if [[ "$json" == --json ]]; then
    jq -n --arg root "$MUSIC_ROOT" --argjson genres "$genres" --argjson tracks "$tracks" \
      '{root:$root,genres:$genres,tracks:$tracks}'
  else
    printf 'root: %s\ngenres: %d\ntracks: %d\n' "$MUSIC_ROOT" "$genres" "$tracks"
  fi
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    sync) cmd_sync ;;
    import) cmd_import ;;
    playlists) cmd_playlists "$@" ;;
    rebuild) cmd_rebuild ;;
    build) cmd_build "$@" ;;
    warm) cmd_warm "$@" ;;
    cache) cmd_cache "$@" ;;
    soundcloud) cmd_soundcloud ;;
    job)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        status) cmd_job_status "${1:-}" ;;
        *) usage ;;
      esac
      ;;
    genres) cmd_genres "$@" ;;
    tracks) cmd_tracks "$@" ;;
    browse) cmd_browse "$@" ;;
    playlist)
      if [[ "${1:-}" == "star" ]]; then
        shift
        cmd_playlist_star "$@"
      else
        cmd_playlist "$@"
      fi
      ;;
    player) exec "${EVOSHELL_BIN}/evo-player" "$@" ;;
    retag) cmd_retag "${1:-}" "${2:-}" "${3:-}" ;;
    favorite)
      [[ "${1:-}" == toggle ]] || usage
      shift
      cmd_favorite_toggle "${1:-}" "${2:-}"
      ;;
    status) cmd_status "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "evo-music: unknown command: $cmd" >&2
      usage
      ;;
  esac
}

main "$@"
