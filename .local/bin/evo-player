#!/bin/bash
# Music library + mpv playback for evo.player panel.

set -euo pipefail

EVOSHELL_BIN="${EVOSHELL_BIN:-$HOME/.local/bin}"
# shellcheck source=evo-player-lib.sh
source "${EVOSHELL_BIN}/evo-player-lib.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  evo-player start|load <path> [--folder]|play [playlist|m3u]
  evo-player queue append <path> [<path>...]
  evo-player queue play <start-path> <path> [<path>...]
  evo-player prioritize <path> [<path>...]
  evo-player toggle|next|prev|seek <sec>|shuffle [toggle|on|off]
  evo-player volume set <0-100>|volume <delta>
  evo-player save|open|restore|resume|close|stop|status [--json]
  evo-player sync|import|playlists [--force]|soundcloud
  evo-player build all|quick [--json]
  evo-player cache [--force] [--prune-art] [--json] [genre]
  evo-player job status [--json]
  evo-player genres [--json]
  evo-player tracks <genre> [--json]
  evo-player browse [path] [--json] [--queue]
  evo-player playlist [--json]
  evo-player playlist <name> [--json]
  evo-player playlist star toggle <name> [--json]
  evo-player retag <path> <genre> [--json]
  evo-player favorite toggle <path> [--json]
  evo-player mixes migrate [--dry-run] [--json]
  evo-player art search <track-path> [--json]
  evo-player art set <track-path> <image-path> [--json]
  evo-player art apply <track-path> <url> [--json]
  evo-player art embed [--json]
  evo-player stats [--json]
EOF
  exit 1
}

mpv_ipc() {
  local payload="$1"
  if [[ ! -S "$MPV_SOCKET" ]]; then
    return 1
  fi
  python3 - "$MPV_SOCKET" "$payload" <<'PY'
import json, socket, sys
sock_path, payload = sys.argv[1], sys.argv[2]
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    s.connect(sock_path)
    s.sendall((payload + "\n").encode())
    data = s.recv(65536)
    if data:
        sys.stdout.write(data.decode("utf-8", "replace"))
PY
}

mpv_prop() {
  local name="$1"
  local raw
  raw="$(mpv_ipc "{\"command\":[\"get_property\",\"${name}\"]}")" || return 1
  python3 -c 'import json,sys
data = json.load(sys.stdin).get("data", "")
if isinstance(data, bool):
    print("true" if data else "false")
else:
    print(data)' <<<"$raw" 2>/dev/null
}

mpv_wait_loaded() {
  local want="${1:-}"
  local i=0 path idle
  while [[ $i -lt 80 ]]; do
    path="$(mpv_prop path 2>/dev/null || true)"
    idle="$(mpv_prop idle-active 2>/dev/null || true)"
    if [[ -n "$want" && "$path" == "$want" && "$idle" != "true" ]]; then
      return 0
    fi
    sleep 0.05
    i=$((i + 1))
  done
  return 1
}

cmd_player_start() {
  if mpv_running; then
    return 0
  fi
  local mpris_script=""
  if [[ -f /usr/share/mpv-mpris/mpris.so ]]; then
    mpris_script="--script=/usr/share/mpv-mpris/mpris.so"
  fi
  nohup mpv --no-video --idle=yes --keep-open=yes \
    --input-ipc-server="$MPV_SOCKET" \
    $mpris_script \
    >/dev/null 2>&1 &
  local i=0
  while [[ $i -lt 50 ]]; do
    [[ -S "$MPV_SOCKET" ]] && return 0
    sleep 0.05
    i=$((i + 1))
  done
  echo "evo-player: mpv socket did not start" >&2
  return 1
}

player_save_state() {
  local path="${1:-}"
  local genre="${2:-}"
  local playlist="${3:-}"
  local position="${4:-}"
  ensure_dirs
  if [[ -z "$path" ]]; then
    if mpv_running; then
      path="$(mpv_prop path)" || path=""
      position="$(mpv_prop time-pos)" || position="0"
    else
      [[ -f "$PLAYER_STATE" ]] || printf '{}\n' >"$PLAYER_STATE"
      return 0
    fi
  fi
  [[ -f "$PLAYER_STATE" ]] || printf '{}\n' >"$PLAYER_STATE"
  if [[ -z "$genre" && -n "$path" ]]; then
    genre="$(genre_from_path "$path")"
  fi
  if [[ -z "$playlist" ]]; then
    playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  fi
  jq -n \
    --arg path "${path:-}" \
    --arg genre "${genre:-}" \
    --arg playlist "${playlist:-}" \
    --argjson position "${position:-0}" \
    '{path:$path,genre:$genre,playlist:$playlist,position:$position}' >"$PLAYER_STATE"
}

cmd_player_save() {
  player_save_state
}

cmd_player_stop() {
  cmd_player_close
}

cmd_player_close() {
  ensure_dirs
  if mpv_running; then
    player_save_state
    mpv_ipc '{"command":["quit"]}' >/dev/null 2>&1 || true
    local i=0
    while [[ $i -lt 40 ]]; do
      pgrep -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1 || return 0
      sleep 0.05
      i=$((i + 1))
    done
    pkill -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1 || true
    return 0
  fi
  [[ -f "$PLAYER_STATE" ]] || player_save_state
}

cmd_player_open() {
  local json="${1:-}"
  ensure_dirs
  if mpv_running; then
    local path
    path="$(mpv_prop path 2>/dev/null || true)"
    if [[ -n "$path" && -f "$path" ]]; then
      player_save_state
      if [[ "$json" == --json ]]; then
        cmd_player_status --json
      else
        printf '%s\n' "$path"
      fi
      return 0
    fi
  fi
  if [[ "$json" == --json ]]; then
    player_saved_status_json
  elif [[ -f "$PLAYER_STATE" ]]; then
    jq -r '.path // ""' "$PLAYER_STATE"
  fi
}

cmd_player_restore() {
  local json="${1:-}"
  ensure_dirs
  [[ -f "$PLAYER_STATE" ]] || {
    [[ "$json" == --json ]] && player_saved_status_json
    return 0
  }
  local path pos genre playlist
  path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
  genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  if [[ -z "$path" || ! -f "$path" ]]; then
    [[ "$json" == --json ]] && player_saved_status_json
    return 0
  fi
  cmd_player_start
  local escaped="${path//\\/\\\\}" current=""
  current="$(mpv_prop path 2>/dev/null || true)"
  if [[ "$current" != "$path" ]]; then
    mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"replace\"]}" >/dev/null
    mpv_wait_loaded "$path" || true
  fi
  if [[ -n "$pos" && "$pos" != "0" && "$pos" != "null" ]]; then
    mpv_ipc "{\"command\":[\"seek\",${pos},\"absolute\"]}" >/dev/null
  fi
  mpv_ipc '{"command":["set_property","pause",true]}' >/dev/null
  player_save_state "$path" "$genre" "$playlist" "$pos"
  waveform_ensure_async "$path"
  if [[ "$json" == --json ]]; then
    cmd_player_status --json
  else
    printf '%s\n' "$path"
  fi
}

cmd_player_resume() {
  local json="${1:-}"
  ensure_dirs
  [[ -f "$PLAYER_STATE" ]] || return 0
  local path pos genre playlist
  path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
  genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  [[ -f "$path" ]] || return 0
  cmd_player_start
  local escaped="${path//\\/\\\\}"
  mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"replace\"]}" >/dev/null
  if [[ -n "$pos" && "$pos" != "0" && "$pos" != "null" ]]; then
    mpv_ipc "{\"command\":[\"seek\",${pos},\"absolute\"]}" >/dev/null
  fi
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  player_save_state "$path" "$genre" "$playlist" "$pos"
  if [[ "$json" == --json ]]; then
    jq -n --arg path "$path" --arg genre "$genre" --arg playlist "$playlist" \
      '{path:$path,genre:$genre,playlist:$playlist}'
  else
    printf '%s\n' "$path"
  fi
}

mpv_load_file() {
  local path="$1"
  local mode="${2:-replace}"
  local escaped="${path//\\/\\\\}"
  mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"${mode}\"]}" >/dev/null
}

cmd_player_load() {
  local path="" folder=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --folder) folder=1 ;;
      --json) ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) path="$1" ;;
    esac
    shift
  done
  [[ -n "$path" ]] || usage
  [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
  cmd_player_start
  if [[ "$folder" -eq 1 ]]; then
    local dir f
    local -a files=()
    dir="$(dirname "$path")"
    while IFS= read -r -d '' f; do
      is_audio "$f" && files+=("$f")
    done < <(find "$dir" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    local idx=-1 i
    for i in "${!files[@]}"; do
      if [[ "${files[$i]}" == "$path" ]]; then
        idx=$i
        break
      fi
    done
    [[ "$idx" -ge 0 ]] || { echo "evo-player: track not in folder listing: $path" >&2; return 1; }
    mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
    mpv_load_file "$path" replace
    for ((i = idx + 1; i < ${#files[@]}; i++)); do
      mpv_load_file "${files[$i]}" append
    done
    art_ensure_now "$path"
    for ((i = idx + 1; i < ${#files[@]}; i++)); do
      art_ensure_priority_async "${files[$i]}"
    done
    queue_save "${files[@]}"
  else
    mpv_load_file "$path" replace
    art_ensure_now "$path"
    queue_save "$path"
  fi
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  player_save_state "$path" "$(genre_from_path "$path")" "" "0"
  waveform_ensure_async "$path"
}

cmd_player_prioritize() {
  [[ $# -gt 0 ]] || return 0
  art_prioritize_paths "$@"
}

cmd_player_queue_append() {
  [[ $# -gt 0 ]] || usage
  cmd_player_start
  local path
  for path in "$@"; do
    [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
    mpv_load_file "$path" append
    waveform_ensure_async "$path"
  done
  art_prioritize_paths "$@"
}

cmd_player_queue_play() {
  [[ $# -ge 1 ]] || usage
  local start="$1"
  shift
  local -a paths=()
  local -a queue_paths=()
  local path idx=-1 i j
  if [[ $# -gt 0 ]]; then
    paths=("$@")
  else
    paths=("$start")
  fi
  for i in "${!paths[@]}"; do
    [[ -f "${paths[$i]}" ]] || { echo "evo-player: not a file: ${paths[$i]}" >&2; return 1; }
    if [[ "$idx" -lt 0 && "${paths[$i]}" == "$start" ]]; then
      idx=$i
    fi
  done
  [[ "$idx" -ge 0 ]] || { echo "evo-player: start path not in queue: $start" >&2; return 1; }
  queue_paths=("${paths[@]}")
  paths=()
  for ((j = idx; j < ${#queue_paths[@]}; j++)); do
    paths+=("${queue_paths[$j]}")
  done
  for ((j = 0; j < idx; j++)); do
    paths+=("${queue_paths[$j]}")
  done
  start="${paths[0]}"
  cmd_player_start
  mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"
    if [[ "$i" -eq 0 ]]; then
      mpv_load_file "$path" replace
    else
      mpv_load_file "$path" append
    fi
    waveform_ensure_async "$path"
  done
  local expected=${#paths[@]} count=0 tries=0
  while (( tries < 100 )); do
    count="$(mpv_prop playlist-count 2>/dev/null || echo 0)"
    [[ "${count%.*}" -ge "$expected" ]] && break
    sleep 0.02
    tries=$((tries + 1))
  done
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  art_ensure_now "$start"
  art_prioritize_paths "$start"
  queue_save "${queue_paths[@]}"
  player_save_state "$start" "$(genre_from_path "$start")" "" "0"
}

cmd_player_queue() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    append) cmd_player_queue_append "$@" ;;
    play) cmd_player_queue_play "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown queue command: $sub" >&2; usage ;;
  esac
}

cmd_player_play() {
  local target="${1:-all}"
  cmd_player_start
  local list=""
  if [[ -f "$target" ]]; then
    list="$target"
  elif [[ -f "${PLAYLIST_DIR}/${target}.m3u" ]]; then
    list="${PLAYLIST_DIR}/${target}.m3u"
  elif [[ -f "${PLAYLIST_DIR}/all.m3u" ]]; then
    list="${PLAYLIST_DIR}/all.m3u"
  else
    echo "evo-player: no playlist for: $target" >&2
    return 1
  fi
  mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
  mpv_ipc "{\"command\":[\"loadlist\",\"${list//\\/\\\\}\",\"replace\"]}" >/dev/null
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  jq -n --arg playlist "$target" --arg list "$list" --arg genre "$target" \
    '{playlist:$playlist,list:$list,genre:$genre,path:"",position:0}' >"$PLAYER_STATE"
}

cmd_player_toggle() {
  if ! mpv_running; then
    cmd_player_resume
    return $?
  fi
  local paused
  paused="$(mpv_prop pause)" || return 1
  if [[ "$paused" == "true" ]]; then
    mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  else
    mpv_ipc '{"command":["set_property","pause",true]}' >/dev/null
  fi
}

cmd_player_next() {
  cmd_player_start
  local count
  count="$(mpv_prop playlist-count 2>/dev/null || echo 1)"
  count="${count%.*}"
  if [[ "$count" -gt 1 ]]; then
    mpv_ipc '{"command":["playlist-next","weak"]}' >/dev/null
    player_save_state
    return 0
  fi
  player_queue_advance 1
  player_save_state
}

cmd_player_prev() {
  cmd_player_start
  local count
  count="$(mpv_prop playlist-count 2>/dev/null || echo 1)"
  count="${count%.*}"
  if [[ "$count" -gt 1 ]]; then
    mpv_ipc '{"command":["playlist-prev","weak"]}' >/dev/null
    player_save_state
    return 0
  fi
  player_queue_advance -1
  player_save_state
}

queue_save() {
  ensure_dirs
  local -a paths=("$@")
  : >"$CURRENT_QUEUE"
  local p
  for p in "${paths[@]}"; do
    [[ -f "$p" ]] || continue
    printf '%s\n' "$p" >>"$CURRENT_QUEUE"
  done
}

player_queue_advance() {
  local delta="$1"
  [[ "$delta" == "1" || "$delta" == "-1" ]] || return 1
  local -a paths=()
  local line cur idx=-1 i next
  [[ -f "$CURRENT_QUEUE" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -f "$line" ]] && paths+=("$line")
  done <"$CURRENT_QUEUE"
  ((${#paths[@]})) || return 1
  cur="$(mpv_prop path 2>/dev/null || true)"
  for i in "${!paths[@]}"; do
    if [[ "${paths[$i]}" == "$cur" ]]; then
      idx=$i
      break
    fi
  done
  if [[ "$idx" -lt 0 ]]; then
    idx=0
  fi
  next=$((idx + delta))
  if [[ "$next" -lt 0 || "$next" -ge ${#paths[@]} ]]; then
    return 0
  fi
  cmd_player_queue_play "${paths[$next]}" "${paths[@]}"
}

cmd_player_seek() {
  local sec="$1"
  cmd_player_start
  mpv_ipc "{\"command\":[\"seek\",${sec},\"absolute\"]}" >/dev/null
}

cmd_player_shuffle() {
  local mode="${1:-toggle}"
  cmd_player_start
  if [[ "$mode" == toggle ]]; then
    local cur
    cur="$(mpv_prop shuffle)" || cur="no"
    if [[ "$cur" == "yes" || "$cur" == "true" ]]; then
      mpv_ipc '{"command":["set_property","shuffle",false]}' >/dev/null
    else
      mpv_ipc '{"command":["set_property","shuffle",true]}' >/dev/null
    fi
  else
    mpv_ipc "{\"command\":[\"set_property\",\"shuffle\",$([[ $mode == on ]] && echo true || echo false)]}" >/dev/null
  fi
}

cmd_player_volume() {
  local arg="${1:-0}"
  local value="${2:-}"
  cmd_player_start
  if [[ "$arg" == set ]]; then
    local v="${value:-100}"
    mpv_ipc "{\"command\":[\"set_property\",\"volume\",${v}]}" >/dev/null
    if [[ "${v%.*}" -gt 0 ]]; then
      mpv_ipc '{"command":["set_property","mute",false]}' >/dev/null
    fi
  else
    mpv_ipc "{\"command\":[\"add\",\"volume\",${arg}]}" >/dev/null
    mpv_ipc '{"command":["set_property","mute",false]}' >/dev/null
  fi
}

format_time() {
  local sec="${1%.*}"
  sec="${sec:-0}"
  local h m s
  h=$((sec / 3600))
  m=$(((sec % 3600) / 60))
  s=$((sec % 60))
  if [[ $h -gt 0 ]]; then
    printf '%d:%02d:%02d' "$h" "$m" "$s"
  else
    printf '%d:%02d' "$m" "$s"
  fi
}

mpv_running() {
  [[ -S "$MPV_SOCKET" ]] && pgrep -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1
}

ffprobe_duration() {
  local path="$1"
  ffprobe -v quiet -show_entries format=duration -of default=nw=1:nk=1 "$path" 2>/dev/null | head -1 || printf '0'
}

player_saved_status_json() {
  ensure_dirs
  local path="" pos="0" genre="" playlist=""
  if [[ -f "$PLAYER_STATE" ]]; then
    path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
    pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
    genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
    playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  fi
  local title="" artist="" album="" tag_genre="" year="" dur="0" art="" wf="" liked="false"
  if [[ -n "$path" && -f "$path" ]]; then
    title="$(ffprobe_meta "$path" title)"
    artist="$(ffprobe_meta "$path" artist)"
    tag_genre="$(ffprobe_meta "$path" genre)"
    album="$(ffprobe_meta "$path" album)"
    year="$(ffprobe_year "$path")"
    [[ -z "$title" ]] && title="$(basename "$path")"
    title="${title%.*}"
    dur="$(ffprobe_duration "$path")"
    art="$(art_path_cached "$path")"
    if [[ -z "$art" ]]; then
      art_ensure_now "$path"
      art="$(art_path_cached "$path")"
    fi
    wf="$(waveform_cache_path "$path")"
    waveform_ensure_async "$path"
    is_liked "$path" && liked="true"
  else
    path=""
    pos="0"
    dur="0"
  fi
  [[ -z "$genre" && -n "$tag_genre" ]] && genre="$tag_genre"
  jq -n \
    --arg state "stopped" \
    --arg path "$path" \
    --arg title "$title" \
    --arg artist "$artist" \
    --arg genre "$genre" \
    --arg album "$album" \
    --arg year "$year" \
    --argjson position "${pos:-0}" \
    --argjson duration "${dur:-0}" \
    --argjson volume 100 \
    --arg art "$art" \
    --arg waveform "$wf" \
    --arg playlist "$playlist" \
    --argjson shuffle false \
    --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
    --arg position_label "$(format_time "${pos:-0}")" \
    --arg duration_label "$(format_time "${dur:-0}")" \
    '{state:$state,path:$path,title:$title,artist:$artist,genre:$genre,album:$album,year:$year,position:$position,duration:$duration,volume:$volume,liked:$liked,art:$art,waveform:$waveform,playlist:$playlist,shuffle:$shuffle,position_label:$position_label,duration_label:$duration_label}'
}

cmd_player_status() {
  local json="${1:-}"
  if ! mpv_running; then
    if [[ "$json" == --json ]]; then
      player_saved_status_json
    else
      echo "stopped"
    fi
    return 0
  fi
  local path paused pos dur vol title artist genre album year art wf playlist shuffle state liked
  path="$(mpv_prop path)" || path=""
  paused="$(mpv_prop pause)" || paused="true"
  pos="$(mpv_prop time-pos)" || pos="0"
  dur="$(mpv_prop duration)" || dur="0"
  vol="$(mpv_prop volume)" || vol="100"
  muted="$(mpv_prop mute)" || muted="false"
  [[ "$muted" == "true" ]] && vol="0"
  shuffle="$(mpv_prop shuffle)" || shuffle="false"
  playlist=""
  [[ -f "$PLAYER_STATE" ]] && playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  if [[ "$paused" == "true" ]]; then
    state="paused"
  else
    state="playing"
  fi
  title="" artist="" genre="" album="" year="" liked="false"
  if [[ -n "$path" && -f "$path" ]]; then
    title="$(ffprobe_meta "$path" title)"
    artist="$(ffprobe_meta "$path" artist)"
    genre="$(ffprobe_meta "$path" genre)"
    album="$(ffprobe_meta "$path" album)"
    year="$(ffprobe_year "$path")"
    [[ -z "$title" ]] && title="$(basename "$path")"
    title="${title%.*}"
    art="$(art_path_cached "$path")"
    if [[ -z "$art" ]]; then
      art_ensure_now "$path"
      art="$(art_path_cached "$path")"
    fi
    wf="$(waveform_cache_path "$path")"
    waveform_ensure_async "$path"
    is_liked "$path" && liked="true"
  else
    art="" wf=""
  fi
  if [[ "$json" == --json ]]; then
    jq -n \
      --arg state "$state" \
      --arg path "$path" \
      --arg title "$title" \
      --arg artist "$artist" \
      --arg genre "$genre" \
      --arg album "$album" \
      --arg year "$year" \
      --argjson position "${pos:-0}" \
      --argjson duration "${dur:-0}" \
      --argjson volume "${vol:-100}" \
      --arg art "$art" \
      --arg waveform "$wf" \
      --arg playlist "$playlist" \
      --argjson shuffle "$([[ $shuffle == yes || $shuffle == true ]] && echo true || echo false)" \
      --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
      --arg position_label "$(format_time "${pos:-0}")" \
      --arg duration_label "$(format_time "${dur:-0}")" \
      '{state:$state,path:$path,title:$title,artist:$artist,genre:$genre,album:$album,year:$year,position:$position,duration:$duration,volume:$volume,liked:$liked,art:$art,waveform:$waveform,playlist:$playlist,shuffle:$shuffle,position_label:$position_label,duration_label:$duration_label}'
  else
    printf '%s — %s (%s)\n' "$artist" "$title" "$state"
  fi
}

beet_library_path() {
  local path="$1"
  local abs="$path"
  [[ "$abs" == /* ]] || abs="${MUSIC_ROOT}/${abs}"
  if [[ -f "$abs" ]]; then
    abs="$(realpath "$abs")"
  fi
  local root="${MUSIC_ROOT%/}"
  case "$abs" in
    "$root"/*) printf '%s' "${abs#"$root"/}" ;;
    *) printf '%s' "$(basename "$abs")" ;;
  esac
}

beet_path_query() {
  local path="$1"
  local rel escaped
  rel="$(beet_library_path "$path")"
  escaped="${rel//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  printf 'path:"%s"' "$escaped"
}

beet_item_id_for_path() {
  local path="$1"
  local query id
  query="$(beet_path_query "$path")"
  id="$(beet ls -f '$id' "$query" 2>/dev/null | grep -E '^[0-9]+$' | head -1 || true)"
  [[ -n "$id" ]] || return 1
  printf '%s' "$id"
}

retag_manual() {
  local path="$1"
  local new_genre="$2"
  local dest_dir="${MUSIC_ROOT}/${new_genre}"
  mkdir -p "$dest_dir"

  local base dest tmp stem ext n
  base="$(basename "$path")"
  dest="${dest_dir}/${base}"

  if [[ -e "$dest" ]] && [[ "$(realpath "$dest")" != "$(realpath "$path")" ]]; then
    stem="${base%.*}"
    ext="${base##*.}"
    n=1
    while [[ -e "${dest_dir}/${stem}-${n}.${ext}" ]]; do
      n=$((n + 1))
    done
    dest="${dest_dir}/${stem}-${n}.${ext}"
  fi

  if [[ "$(realpath "$path")" == "$(realpath "$dest")" ]]; then
    printf '%s' "$dest"
    return 0
  fi

  tmp="$(mktemp "${TMPDIR:-/tmp}/evo-music-retag.XXXXXX")"
  if ffmpeg -y -hide_banner -loglevel error -i "$path" -metadata genre="$new_genre" -codec copy "$tmp" 2>/dev/null; then
    mv "$tmp" "$dest"
    rm -f "$path"
  else
    rm -f "$tmp"
    mv "$path" "$dest"
  fi
  printf '%s' "$dest"
}

cmd_sync() {
  ensure_dirs
  local cookies user url
  cookies="$(config_val cookies_from brave)"
  user="$(config_val user seb-day)"
  url="$(config_val likes_url "https://soundcloud.com/${user}/likes")"
  yt-dlp \
    --cookies-from-browser "$cookies" \
    --download-archive "$SYNC_ARCHIVE" \
    -x --audio-format mp3 --embed-metadata --embed-thumbnail \
    -o "${MUSIC_ROOT}/incoming/%(uploader)s - %(title)s.%(ext)s" \
    "$url"
}

cmd_import_impl() {
  if ! command -v beet >/dev/null 2>&1; then
    echo "evo-player: beet not found (run: uv tool install beets)" >&2
    return 1
  fi
  local incoming="${MUSIC_ROOT}/incoming"
  [[ -d "$incoming" ]] || mkdir -p "$incoming"
  local count
  count="$(find "$incoming" -maxdepth 1 -type f | wc -l)"
  if [[ "$count" -eq 0 ]]; then
    echo "evo-player: nothing in incoming/" >&2
    return 0
  fi
  beet import -q "$incoming"
}

cmd_import() {
  run_exclusive_job import "import incoming" cmd_import_impl
}

write_likes_m3u() {
  local out="$1"
  likes_init
  local tmp
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  mv "$tmp" "$out"
}

write_playlist() {
  local genre="${1%-fav}"
  local out="${PLAYLIST_DIR}/${genre}.m3u"
  likes_init
  local tmp count line
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      [[ "$(genre_from_path "$f")" == "$genre" ]] || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    count=$((count + 1))
  done <"$tmp"
  if [[ "$count" -eq 0 ]]; then
    rm -f "$out" "${PLAYLIST_DIR}/${genre}-fav.m3u" "$tmp"
    return 0
  fi
  mv "$tmp" "$out"
  rm -f "${PLAYLIST_DIR}/${genre}-fav.m3u"
}

cmd_playlists() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  likes_init
  echo "evo-player: rebuilding liked-track playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  rm -f "${PLAYLIST_DIR}"/*-fav.m3u
  echo "evo-player: rebuilding track tag caches..." >&2
  if [[ "$force" -eq 1 ]]; then
    cmd_cache --force
  else
    cmd_cache
  fi
}

cmd_rebuild_impl() {
  echo "evo-player: rebuild started at $(date -Iseconds)" >&2
  echo "evo-player: rebuilding playlists and track caches..." >&2
  cmd_playlists --force
  echo "evo-player: rebuild complete at $(date -Iseconds)" >&2
}

cmd_rebuild() {
  run_exclusive_job rebuild "rebuild library" cmd_rebuild_impl
}

warm_collect_paths() {
  local genre="${1:-}"
  local cache g f
  if [[ -n "$genre" ]]; then
    cache="$(tracks_cache_path "$genre")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
      return 0
    fi
    while IFS= read -r -d '' f; do
      is_audio "$f" && printf '%s\n' "$f"
    done < <(find "${MUSIC_ROOT}/${genre}" -type f -print0 2>/dev/null)
    return 0
  fi
  while IFS= read -r g; do
    cache="$(tracks_cache_path "$g")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
    else
      while IFS= read -r -d '' f; do
        is_audio "$f" && printf '%s\n' "$f"
      done < <(find "${MUSIC_ROOT}/${g}" -type f -print0 2>/dev/null)
    fi
  done < <(list_genres)
}

warm_paths_ordered() {
  local genre="${1:-}"
  local tmp liked rest path
  tmp="$(mktemp)"
  liked="$(mktemp)"
  rest="$(mktemp)"
  likes_init
  jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    is_audio "$path" || continue
    if [[ -n "$genre" && "$(genre_from_path "$path")" != "$genre" ]]; then
      continue
    fi
    printf '%s\n' "$path"
  done | sort -u >"$liked"
  warm_collect_paths "$genre" | sort -u >"$rest"
  awk 'FNR==NR {seen[$0]=1; print; next} !seen[$0]' "$liked" "$rest" >"$tmp"
  cat "$liked" "$tmp"
  rm -f "$liked" "$rest" "$tmp"
}

warm_asset_needed() {
  local path="$1"
  local kind="$2"
  case "$kind" in
    art)
      [[ -n "$(art_path_cached "$path")" ]] && return 1
      return 0
      ;;
    waveforms)
      [[ -n "$(waveform_cache_find "$path" 2>/dev/null || true)" ]] && return 1
      return 0
      ;;
  esac
  return 1
}

cmd_warm() {
  local do_art=0 do_wf=0 do_tags=0 json=0 genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --art) do_art=1 ;;
      --waveforms) do_wf=1 ;;
      --tags) do_tags=1 ;;
      --json) json=1 ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  [[ "$do_art" -eq 1 || "$do_wf" -eq 1 || "$do_tags" -eq 1 ]] || {
    do_art=1
    do_wf=1
  }
  ensure_dirs
  if [[ "$do_tags" -eq 1 ]]; then
    if [[ -n "$genre" ]]; then
      cmd_cache "$genre"
    else
      cmd_cache
    fi
  fi

  local -a paths=()
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    paths+=("$path")
  done < <(warm_paths_ordered "$genre")

  local total=${#paths[@]} done=0 art_built=0 wf_built=0 art_skipped=0 wf_skipped=0
  local wf_limit=2 art_limit=4 wf_running=0 art_running=0

  for path in "${paths[@]}"; do
    if [[ "$do_art" -eq 1 ]]; then
      if warm_asset_needed "$path" art; then
        while (( art_running >= art_limit )); do
          wait -n 2>/dev/null || wait
          art_running=$((art_running - 1))
        done
        art_running=$((art_running + 1))
        (
          art_path_for "$path" >/dev/null 2>&1
          exit 0
        ) &
        art_built=$((art_built + 1))
      else
        art_skipped=$((art_skipped + 1))
      fi
    fi
    if [[ "$do_wf" -eq 1 ]]; then
      if warm_asset_needed "$path" waveforms; then
        while (( wf_running >= wf_limit )); do
          wait -n 2>/dev/null || wait
          wf_running=$((wf_running - 1))
        done
        wf_running=$((wf_running + 1))
        (
          waveform_build "$path" >/dev/null 2>&1
          exit 0
        ) &
        wf_built=$((wf_built + 1))
      else
        wf_skipped=$((wf_skipped + 1))
      fi
    fi
    done=$((done + 1))
    if (( done % 25 == 0 || done == total )); then
      echo "evo-player: warming ${done}/${total} (art +${art_built}/-${art_skipped}, waveforms +${wf_built}/-${wf_skipped})" >&2
    fi
  done
  wait

  echo "evo-player: warm complete ${done}/${total}" >&2
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --argjson total "$total" \
      --argjson done "$done" \
      --argjson art_built "$art_built" \
      --argjson wf_built "$wf_built" \
      --argjson art_skipped "$art_skipped" \
      --argjson wf_skipped "$wf_skipped" \
      '{total:$total,done:$done,art_built:$art_built,waveform_built:$wf_built,art_skipped:$art_skipped,waveform_skipped:$wf_skipped}'
  fi
}

cmd_build_impl() {
  local mode="${1:-}"
  echo "evo-player: build ${mode} started at $(date -Iseconds)" >&2
  ensure_dirs
  likes_init
  echo "evo-player: refreshing playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  echo "evo-player: indexing track tags..." >&2
  cmd_cache
  if [[ "$mode" == "all" ]]; then
    echo "evo-player: warming art and waveforms..." >&2
    cmd_warm --art --waveforms
  else
    echo "evo-player: warming art..." >&2
    cmd_warm --art
  fi
  echo "evo-player: pruning duplicate art..." >&2
  art_prune_legacy >/dev/null
  echo "evo-player: build ${mode} complete at $(date -Iseconds)" >&2
}

cmd_build() {
  local mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      all|quick) mode="$1" ;;
      -h|--help|help) usage ;;
      *) usage ;;
    esac
    shift
  done
  [[ -n "$mode" ]] || usage
  run_exclusive_job build "build ${mode}" cmd_build_impl "$mode"
}

cmd_soundcloud_impl() {
  cmd_sync
  cmd_import_impl
  cmd_playlists
}

cmd_soundcloud() {
  run_exclusive_job soundcloud "sync soundcloud" cmd_soundcloud_impl
}

cmd_cache() {
  local force=0 json=0 prune_art=0 genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      --json) json=1 ;;
      --prune-art) prune_art=1 ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  ensure_dirs
  if [[ "$prune_art" -eq 1 ]]; then
    local pruned
    pruned="$(art_prune_legacy)"
    if [[ "$json" -eq 1 ]]; then
      jq -n --argjson pruned "$pruned" '{pruned:$pruned}'
    fi
    return 0
  fi
  local g cache built=0 skipped=0 total=0 count
  cache_one() {
    local name="$1"
    [[ -d "${MUSIC_ROOT}/${name}" ]] || {
      echo "evo-player: unknown genre: ${name}" >&2
      return 1
    }
    total=$((total + 1))
    cache="$(tracks_cache_path "$name")"
    if [[ "$force" -eq 1 ]] || tracks_cache_stale "$name" "$cache"; then
      echo "evo-player: caching ${name}..." >&2
      build_tracks_json "$name" "$force" >/dev/null
      count="$(jq 'length' "$cache" 2>/dev/null || echo 0)"
      [[ -n "$count" ]] || count=0
      echo "evo-player: cached ${name} (${count} tracks)" >&2
      built=$((built + 1))
    else
      echo "evo-player: ${name} cache already fresh" >&2
      skipped=$((skipped + 1))
    fi
  }
  if [[ -n "$genre" ]]; then
    cache_one "$genre"
  else
    while IFS= read -r g; do
      cache_one "$g"
    done < <(list_genres)
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n --argjson built "$built" --argjson skipped "$skipped" --argjson total "$total" \
      '{built:$built,skipped:$skipped,total:$total}'
  else
    echo "evo-player: cached ${built} genre(s), ${skipped} already fresh (${total} total)" >&2
  fi
}

cmd_genres() {
  local json="${1:-}"
  if [[ "$json" == --json ]]; then
    printf '['
    local first=1 g count
    while IFS= read -r g; do
      count="$(genre_track_count_cached "$g")"
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '{"name":"%s","count":%s}' "$(json_escape "$g")" "$count"
    done < <(list_genres)
    printf ']\n'
  else
    list_genres
  fi
}

cmd_tracks() {
  local genre="$1"
  local json="${2:-}"
  local dir="$MUSIC_ROOT/$genre"
  local cache
  [[ -d "$dir" ]] || { echo "evo-player: unknown genre: $genre" >&2; return 1; }
  if [[ "$json" == --json ]]; then
    cache="$(tracks_cache_path "$genre")"
    if tracks_cache_stale "$genre" "$cache"; then
      build_tracks_json "$genre"
    else
      cat "$cache"
    fi
  else
    find "$dir" -maxdepth 1 -type f | sort
  fi
}

browse_resolve() {
  local rel="${1:-}"
  rel="${rel#/}"
  rel="${rel%/}"
  local dir root real_root real_dir
  root="$(realpath -m "$MUSIC_ROOT")"
  if [[ -z "$rel" ]]; then
    dir="$MUSIC_ROOT"
  else
    dir="${MUSIC_ROOT}/${rel}"
  fi
  real_dir="$(realpath -m "$dir")"
  [[ "$real_dir" == "$root" || "$real_dir" == "$root"/* ]] || return 1
  [[ -d "$real_dir" ]] || return 1
  printf '%s\n%s\n' "$rel" "$real_dir"
}

browse_track_enrich_json() {
  local line="$1"
  local path liked_json=false
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] && is_liked "$path" && liked_json=true
  jq -c --argjson liked "$liked_json" '. + {liked:$liked}' <<<"$line"
}

browse_track_json() {
  local path="$1"
  browse_track_enrich_json "$(track_list_json "$path")" | jq -c '. + {type:"track"}'
}

browse_track_art_json() {
  local line="$1"
  local path art
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] || {
    browse_track_enrich_json "$line"
    return 0
  }
  art="$(art_path_cached "$path")"
  browse_track_enrich_json "$(jq -c --arg art "$art" '.art = $art' <<<"$line")"
}

browse_tracks_cached_lines() {
  local dir="$1"
  local cache="$2"
  jq -r --arg dir "$dir" '
    def child_path($p):
      ($p | ltrimstr($dir + "/")) | test("^[^/]+$");
    [.[] | select(.path | startswith($dir + "/")) | select(child_path(.path)) | . + {type:"track"}]
    | .[] | @json
  ' "$cache"
}

browse_emit_cached_tracks() {
  local dir="$1"
  local cache="$2"
  local -a lines=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    lines+=("$line")
  done < <(browse_tracks_cached_lines "$dir" "$cache")
  [[ ${#lines[@]} -gt 0 ]] || return 1

  local i=0 n=${#lines[@]} batch=24 tmpdir out
  tmpdir="$(mktemp -d)"
  for line in "${lines[@]}"; do
    browse_track_art_json "$line" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  for ((i = 0; i < n; i++)); do
    [[ -f "${tmpdir}/${i}.json" ]] || continue
    cat "${tmpdir}/${i}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
  return 0
}

browse_emit_tracks_parallel() {
  local dir="$1"
  local -a files=()
  local entry f i=0 n batch=16 tmpdir

  while IFS= read -r -d '' entry; do
    is_audio "$entry" || continue
    files+=("$entry")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

  n=${#files[@]}
  [[ "$n" -eq 0 ]] && return 0

  tmpdir="$(mktemp -d)"
  for f in "${files[@]}"; do
    browse_track_json "$f" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  local j
  for ((j = 0; j < n; j++)); do
    [[ -f "${tmpdir}/${j}.json" ]] || continue
    cat "${tmpdir}/${j}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
}

browse_emit_tracks() {
  local rel="$1"
  local dir="$2"
  local genre cache lines

  genre="${rel%%/*}"
  cache="$(tracks_cache_path "$genre")"
  if [[ -n "$genre" && -f "$cache" && -s "$cache" ]]; then
    if browse_emit_cached_tracks "$dir" "$cache"; then
      lines="$(browse_tracks_cached_lines "$dir" "$cache")"
      browse_warm_art_async "$lines"
      return 0
    fi
  fi
  browse_emit_tracks_parallel "$dir"
}

playlist_track_count() {
  local m3u="$1"
  local count=0 line
  [[ -f "$m3u" ]] || { printf '0'; return; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] && count=$((count + 1))
  done <"$m3u"
  printf '%d' "$count"
}

playlist_stars_load() {
  if [[ -f "$PLAYLIST_STARS" ]]; then
    jq -c '.' "$PLAYLIST_STARS" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

playlist_stars_save() {
  local json="$1"
  printf '%s\n' "$json" >"$PLAYLIST_STARS"
}

playlist_stars_migrate() {
  [[ -f "$PLAYLIST_STARS" ]] || return 0
  local json
  json="$(jq -c 'map(if endswith("-fav") then .[0:length-4] else . end) | unique' "$PLAYLIST_STARS" 2>/dev/null || printf '[]')"
  playlist_stars_save "$json"
}

playlist_stars_prune() {
  playlist_stars_migrate
  local stars json kept=() m3u base
  stars="$(playlist_stars_load)"
  for m3u in "$PLAYLIST_DIR"/*.m3u; do
    [[ -f "$m3u" ]] || continue
    base="$(basename "$m3u" .m3u)"
    [[ "$base" == favorites ]] && continue
    if jq -e --arg n "$base" 'index($n) != null' <<<"$stars" >/dev/null 2>&1; then
      kept+=("$base")
    fi
  done
  if ((${#kept[@]} > 0)); then
    json="$(printf '%s\n' "${kept[@]}" | jq -R . | jq -sc .)"
  else
    json='[]'
  fi
  playlist_stars_save "$json"
}

playlist_is_starred() {
  local name="$1"
  jq -e --arg n "$name" 'index($n) != null' <<<"$(playlist_stars_load)" >/dev/null 2>&1
}

playlist_kind() {
  local name="$1"
  case "$name" in
    all|favorites) printf 'system' ;;
    *)
      if [[ -d "${MUSIC_ROOT}/${name}" ]]; then
        printf 'fav'
      else
        printf 'other'
      fi
      ;;
  esac
}

playlist_emit_tracks_json() {
  local list="$1"
  local first=1 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] || continue
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    track_list_json "$line"
  done <"$list"
}

cmd_playlist_star_toggle() {
  local name="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  [[ -n "$name" ]] || { echo "evo-player: playlist name required" >&2; return 1; }
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-player: unknown playlist: $name" >&2; return 1; }
  local stars starred=false
  stars="$(playlist_stars_load)"
  if playlist_is_starred "$name"; then
    stars="$(jq -c --arg n "$name" 'map(select(. != $n))' <<<"$stars")"
    starred=false
  else
    stars="$(jq -c --arg n "$name" '. + [$n] | unique' <<<"$stars")"
    starred=true
  fi
  playlist_stars_save "$stars"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg name "$name" \
      --argjson starred "$starred" \
      --argjson stars "$stars" \
      '{name:$name,starred:$starred,stars:$stars}'
  elif [[ "$starred" == true ]]; then
    printf 'starred %s\n' "$name"
  else
    printf 'unstarred %s\n' "$name"
  fi
}

cmd_playlist_star() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    toggle) cmd_playlist_star_toggle "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown playlist star command: $sub" >&2; usage ;;
  esac
}

browse_subdirs() {
  local rel="$1"
  local dir="$2"
  local entry name
  if [[ -z "$rel" ]]; then
    list_genres
    return 0
  fi
  while IFS= read -r -d '' entry; do
    [[ -d "$entry" ]] || continue
    name="$(basename "$entry")"
    skip_dir "$name" && continue
    printf '%s\n' "${rel}/${name}"
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
}

browse_collect_queue_tracks() {
  local rel="${1:-}"
  local resolved dir line had_direct=0 sub_rel
  resolved="$(browse_resolve "$rel")" || return 1
  rel="$(sed -n '1p' <<<"$resolved")"
  dir="$(sed -n '2p' <<<"$resolved")"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    had_direct=1
    printf '%s\n' "$line"
  done < <(browse_emit_tracks "$rel" "$dir" | sed '/^$/d')
  [[ "$had_direct" -eq 1 ]] && return 0
  while IFS= read -r sub_rel; do
    [[ -n "$sub_rel" ]] || continue
    browse_collect_queue_tracks "$sub_rel"
  done < <(browse_subdirs "$rel" "$dir")
}

cmd_browse() {
  local rel="" json=0 queue=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --queue) queue=1 ;;
      *) rel="$1" ;;
    esac
    shift
  done
  ensure_dirs
  local resolved dir parent name
  resolved="$(browse_resolve "$rel")" || { echo "evo-player: invalid browse path: $rel" >&2; return 1; }
  rel="$(sed -n '1p' <<<"$resolved")"
  dir="$(sed -n '2p' <<<"$resolved")"
  if [[ -z "$rel" ]]; then
    parent=""
  elif [[ "$rel" == */* ]]; then
    parent="${rel%/*}"
  else
    parent=""
  fi
  if [[ "$queue" -eq 1 && "$json" -eq 1 ]]; then
    printf '{'
    printf '"path":"%s",' "$(json_escape "$rel")"
    if [[ -z "$rel" ]]; then
      printf '"parent":null,'
    else
      printf '"parent":"%s",' "$(json_escape "$parent")"
    fi
    printf '"tracks":['
    local first=1 track_line
    while IFS= read -r track_line; do
      [[ -n "$track_line" ]] || continue
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '%s' "$track_line"
    done < <(browse_collect_queue_tracks "$rel")
    printf ']}\n'
    return 0
  fi
  if [[ "$json" -eq 1 ]]; then
    printf '{'
    printf '"path":"%s",' "$(json_escape "$rel")"
    if [[ -z "$rel" ]]; then
      printf '"parent":null,'
    else
      printf '"parent":"%s",' "$(json_escape "$parent")"
    fi
    printf '"entries":['
    local first=1 entry sub name count
    if [[ -z "$rel" ]]; then
      while IFS= read -r name; do
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        count="$(genre_track_count_cached "$name")"
        printf '{"type":"dir","name":"%s","path":"%s","count":%s}' \
          "$(json_escape "$name")" "$(json_escape "$name")" "$count"
      done < <(list_genres)
    else
      while IFS= read -r -d '' entry; do
        [[ -d "$entry" ]] || continue
        name="$(basename "$entry")"
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '{"type":"dir","name":"%s","path":"%s"}' \
          "$(json_escape "$name")" "$(json_escape "${rel}/${name}")"
      done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
      while IFS= read -r track_line; do
        [[ -n "$track_line" ]] || continue
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '%s' "$track_line"
      done < <(browse_emit_tracks "$rel" "$dir" | sed '/^$/d')
    fi
    printf ']}\n'
  else
    if [[ -z "$rel" ]]; then
      list_genres
    else
      find "$dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) | sort
    fi
  fi
}

cmd_playlist() {
  local name="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  if [[ -z "$name" ]]; then
    playlist_stars_prune
    if [[ "$json" -eq 1 ]]; then
      printf '['
      local first=1 m3u base count kind starred_json
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        base="$(basename "$m3u" .m3u)"
        [[ "$base" == favorites ]] && continue
        count="$(playlist_track_count "$m3u")"
        kind="$(playlist_kind "$base")"
        if playlist_is_starred "$base"; then
          starred_json=true
        else
          starred_json=false
        fi
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '{"name":"%s","count":%s,"kind":"%s","starred":%s}' \
          "$(json_escape "$base")" "$count" "$kind" "$starred_json"
      done
      printf ']\n'
    else
      local m3u base
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        base="$(basename "$m3u" .m3u)"
        [[ "$base" == favorites ]] && continue
        basename "$m3u" .m3u
      done | sort
    fi
    return 0
  fi
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-player: unknown playlist: $name" >&2; return 1; }
  if [[ "$json" -eq 1 ]]; then
    printf '['
    playlist_emit_tracks_json "$list"
    printf ']\n'
  else
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//$'\r'/}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ -f "$line" ]] && printf '%s\n' "$line"
    done <"$list"
  fi
}

cmd_retag() {
  local path="$1"
  local new_genre="$2"
  local json="${3:-}"
  [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
  [[ -n "$new_genre" ]] || { echo "evo-player: genre required" >&2; return 1; }
  [[ -d "${MUSIC_ROOT}/${new_genre}" ]] || { echo "evo-player: unknown genre: $new_genre" >&2; return 1; }

  local old_path="$path" new_path id=""
  if command -v beet >/dev/null 2>&1; then
    id="$(beet_item_id_for_path "$path" || true)"
  fi

  new_path="$(retag_manual "$path" "$new_genre")"
  [[ -f "$new_path" ]] || { echo "evo-player: retag failed" >&2; return 1; }

  if [[ -n "$id" ]]; then
    beet remove -d "id:$id" 2>/dev/null || true
  fi

  if is_liked "$old_path"; then
    likes_init
    jq --arg old "$old_path" --arg new "$new_path" \
      'if has($old) then .[$new] = .[$old] | del(.[$old]) else . end' \
      "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  fi

  cmd_playlists

  local old_genre
  old_genre="$(genre_from_path "$old_path")"
  tracks_cache_invalidate_genre "$old_genre"
  tracks_cache_invalidate_genre "$new_genre"

  if [[ "$json" == --json ]]; then
    jq -n \
      --arg path "$new_path" \
      --arg genre "$new_genre" \
      --arg old_path "$old_path" \
      '{path:$path,genre:$genre,old_path:$old_path}'
  else
    printf 'moved to %s\n' "$new_path"
  fi
}

mixes_refresh_playlists() {
  local genre
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  shift
  for genre in "$@"; do
    [[ -n "$genre" ]] || continue
    write_playlist "$genre"
    tracks_cache_invalidate_genre "$genre"
  done
  tracks_cache_invalidate_genre "mixes"
}

cmd_mixes_migrate() {
  local dry_run=0 json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --json) json=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  likes_init
  local mixes_dir="${MUSIC_ROOT}/mixes"
  if [[ ! -d "$mixes_dir" ]]; then
    echo "evo-player: mixes directory not found (already migrated)" >&2
    return 0
  fi

  local -a files=()
  local f
  while IFS= read -r -d '' f; do
    is_audio "$f" && files+=("$f")
  done < <(find "$mixes_dir" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "evo-player: no audio files in mixes" >&2
    if [[ $dry_run -eq 0 ]]; then
      rmdir "$mixes_dir" 2>/dev/null || true
      mixes_refresh_playlists
    fi
    return 0
  fi

  local path tag genre status new_path failed=0
  local -a touched_genres=()
  if [[ "$json" -eq 1 ]]; then
    printf '['
  fi
  local first=1
  for path in "${files[@]}"; do
    tag="$(ffprobe_meta "$path" genre)"
    if mixes_override_genre "$path" >/dev/null; then
      genre="$(mixes_override_genre "$path")"
      status="override"
    elif genre="$(genre_tag_to_folder "$tag")"; then
      status="auto"
    else
      echo "evo-player: cannot resolve genre for $(basename "$path") (tag: ${tag:-empty})" >&2
      failed=1
      continue
    fi
    [[ -d "${MUSIC_ROOT}/${genre}" ]] || mkdir -p "${MUSIC_ROOT}/${genre}"

    if [[ "$json" -eq 1 ]]; then
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '{"path":"%s","tag":"%s","genre":"%s","status":"%s"}' \
        "$(json_escape "$path")" "$(json_escape "$tag")" "$(json_escape "$genre")" "$status"
    elif [[ $dry_run -eq 1 ]]; then
      printf '%s -> %s (%s)\n' "$(basename "$path")" "$genre" "$status"
    fi

    if [[ $dry_run -eq 1 ]]; then
      continue
    fi

    likes_add "$path"
    local old_path="$path"
    new_path="$(retag_manual "$path" "$genre")"
    if [[ ! -f "$new_path" ]]; then
      echo "evo-player: retag failed for $(basename "$path")" >&2
      failed=1
      continue
    fi
    if is_liked "$old_path" && [[ "$old_path" != "$new_path" ]]; then
      jq --arg old "$old_path" --arg new "$new_path" \
        'if has($old) then .[$new] = .[$old] | del(.[$old]) else . end' \
        "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
    fi
    touched_genres+=("$genre")
    if [[ $json -eq 0 ]]; then
      printf 'moved %s -> %s\n' "$(basename "$old_path")" "$genre"
    fi
  done
  if [[ "$json" -eq 1 ]]; then
    printf ']\n'
  fi

  if [[ $dry_run -eq 1 ]]; then
    return 0
  fi

  [[ $failed -eq 0 ]] || return 1

  mixes_refresh_playlists "${touched_genres[@]}"

  if [[ -z "$(find "$mixes_dir" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    rmdir "$mixes_dir" 2>/dev/null || true
    echo "evo-player: removed empty mixes directory" >&2
  fi
}

cmd_mixes() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    migrate) cmd_mixes_migrate "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown mixes command: $sub" >&2; usage ;;
  esac
}

cmd_favorite_toggle() {
  local path="$1"
  local json="${2:-}"
  [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
  ensure_dirs
  likes_init
  local title artist now liked genre
  title="$(ffprobe_meta "$path" title)"
  artist="$(ffprobe_meta "$path" artist)"
  [[ -z "$title" ]] && title="$(basename "${path%.*}")"
  now="$(date -Iseconds)"
  genre="$(genre_from_path "$path")"
  if is_liked "$path"; then
    liked=false
    jq --arg p "$path" 'del(.[$p])' "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  else
    liked=true
    jq --arg p "$path" --arg title "$title" --arg artist "$artist" --arg at "$now" \
      '.[$p] = {title:$title, artist:$artist, liked_at:$at}' \
      "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  fi
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  [[ -n "$genre" ]] && write_playlist "$genre"
  if [[ "$json" == --json ]]; then
    jq -n --arg path "$path" --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
      '{path:$path,liked:$liked}'
  elif [[ "$liked" == true ]]; then
    printf 'liked\n'
  else
    printf 'unliked\n'
  fi
}

cmd_art_search() {
  local path="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) path="$1" ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  is_audio "$path" || {
    echo "evo-player: not an audio file: $path" >&2
    return 1
  }
  local artist album title query
  artist="$(ffprobe_meta "$path" artist)"
  album="$(ffprobe_meta "$path" album)"
  title="$(ffprobe_meta "$path" title)"
  query="${artist} ${album}"
  query="${query#"${query%%[![:space:]]*}"}"
  query="${query%"${query##*[![:space:]]}"}"
  [[ -n "$query" ]] || query="${title:-$(basename "$path")}"
  python3 - "$query" "$json" <<'PY'
import json, sys, urllib.parse, urllib.request
query, json_mode = sys.argv[1], sys.argv[2] == "1"
term = urllib.parse.quote(query)
url = f"https://itunes.apple.com/search?term={term}&entity=album&limit=8"
try:
    with urllib.request.urlopen(url, timeout=20) as resp:
        data = json.load(resp)
except Exception as exc:
    print(f"evo-player: art search failed — {exc}", file=sys.stderr)
    sys.exit(1)
results = []
for item in data.get("results", []):
    thumb = item.get("artworkUrl100") or ""
    art = thumb.replace("100x100bb", "600x600bb") if thumb else ""
    if not art:
        continue
    label = f"{item.get('artistName', '').strip()} — {item.get('collectionName', '').strip()}".strip(" —")
    results.append({
        "url": art,
        "thumb": art,
        "label": label,
        "source": "itunes",
    })
payload = {"query": query, "results": results}
if json_mode:
    print(json.dumps(payload, ensure_ascii=False))
else:
    for row in results:
        print(f"{row['label']}\t{row['url']}")
PY
}

cmd_art_set() {
  local path="" image="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"
        elif [[ -z "$image" ]]; then
          image="$1"
        else
          usage
        fi
        ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  [[ -n "$image" && -f "$image" ]] || {
    echo "evo-player: not a file: ${image:-<missing>}" >&2
    return 1
  }
  local art folder content
  art="$(art_install_image "$path" "$image")" || {
    echo "evo-player: could not install art" >&2
    return 1
  }
  folder="$(art_path_folder "$path")"
  content="$(readlink -f "$art" 2>/dev/null || printf '%s' "$art")"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg art "$art" \
      --arg folder "$folder" \
      --arg content "$content" \
      '{art:$art,folder:$folder,content:$content}'
  else
    printf '%s\n' "$art"
  fi
}

cmd_art_apply() {
  local path="" url="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"
        elif [[ -z "$url" ]]; then
          url="$1"
        else
          usage
        fi
        ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  [[ -n "$url" ]] || usage
  local tmp art folder content
  tmp="$(mktemp "${ART_DIR}/.fetch.XXXXXX.jpg")"
  if ! curl -fsSL --max-time 30 -o "$tmp" "$url"; then
    rm -f "$tmp"
    echo "evo-player: could not download art" >&2
    return 1
  fi
  art="$(art_install_image "$path" "$tmp")" || {
    rm -f "$tmp"
    echo "evo-player: could not install art" >&2
    return 1
  }
  rm -f "$tmp"
  folder="$(art_path_folder "$path")"
  content="$(readlink -f "$art" 2>/dev/null || printf '%s' "$art")"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg art "$art" \
      --arg folder "$folder" \
      --arg content "$content" \
      '{art:$art,folder:$folder,content:$content}'
  else
    printf '%s\n' "$art"
  fi
}

cmd_art_embed_impl() {
  echo "evo-player: embed art started at $(date -Iseconds)" >&2
  ensure_dirs
  local -A seen=()
  local path dir art embedded=0 failed=0 folders=0 emb fail
  while IFS= read -r -d '' path; do
    is_audio "$path" || continue
    dir="$(dirname "$path")"
    [[ -n "${seen[$dir]:-}" ]] && continue
    seen["$dir"]=1
    art="$(art_path_folder "$path")"
    [[ -f "$art" ]] || continue
    read -r emb fail < <(art_embed_folder "$dir")
    embedded=$((embedded + emb))
    failed=$((failed + fail))
    folders=$((folders + 1))
    if (( folders % 25 == 0 )); then
      echo "evo-player: embedded art in ${folders} folders (${embedded} tracks, ${failed} failed)" >&2
    fi
  done < <(find "$MUSIC_ROOT" -type f -print0 2>/dev/null)
  echo "evo-player: embed art complete — ${folders} folders, ${embedded} tracks embedded, ${failed} failed" >&2
  printf '%d %d %d' "$folders" "$embedded" "$failed"
}

cmd_art_embed() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      -h|--help|help) usage ;;
      -*) usage ;;
    esac
    shift
  done
  run_exclusive_job art-embed "embed art" cmd_art_embed_impl
}

cmd_art() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    search) cmd_art_search "$@" ;;
    set) cmd_art_set "$@" ;;
    apply) cmd_art_apply "$@" ;;
    embed) cmd_art_embed "$@" ;;
    *) usage ;;
  esac
}

cmd_status() {
  local json="${1:-}"
  ensure_dirs
  local genres=0 tracks=0 g
  while IFS= read -r g; do
    genres=$((genres + 1))
    tracks=$((tracks + $(genre_track_count_cached "$g")))
  done < <(list_genres)
  if [[ "$json" == --json ]]; then
    jq -n --arg root "$MUSIC_ROOT" --argjson genres "$genres" --argjson tracks "$tracks" \
      '{root:$root,genres:$genres,tracks:$tracks}'
  else
    printf 'root: %s\ngenres: %d\ntracks: %d\n' "$MUSIC_ROOT" "$genres" "$tracks"
  fi
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    start) cmd_player_start ;;
    load) cmd_player_load "$@" ;;
    queue) cmd_player_queue "$@" ;;
    prioritize) cmd_player_prioritize "$@" ;;
    play) cmd_player_play "${1:-all}" ;;
    toggle) cmd_player_toggle ;;
    next) cmd_player_next ;;
    prev) cmd_player_prev ;;
    seek) cmd_player_seek "${1:-0}" ;;
    shuffle) cmd_player_shuffle "${1:-toggle}" ;;
    volume) cmd_player_volume "${1:-0}" "${2:-}" ;;
    save) cmd_player_save ;;
    close) cmd_player_close ;;
    stop) cmd_player_stop ;;
    open) cmd_player_open "${1:---json}" ;;
    restore) cmd_player_restore "${1:---json}" ;;
    resume) cmd_player_resume "${1:---json}" ;;
    status) cmd_player_status "${1:---json}" ;;
    sync) cmd_sync ;;
    import) cmd_import ;;
    playlists) cmd_playlists "$@" ;;
    build) cmd_build "$@" ;;
    cache) cmd_cache "$@" ;;
    soundcloud) cmd_soundcloud ;;
    job)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        status) cmd_job_status "${1:-}" ;;
        *) usage ;;
      esac
      ;;
    genres) cmd_genres "$@" ;;
    tracks) cmd_tracks "$@" ;;
    browse) cmd_browse "$@" ;;
    playlist)
      if [[ "${1:-}" == "star" ]]; then
        shift
        cmd_playlist_star "$@"
      else
        cmd_playlist "$@"
      fi
      ;;
    mixes) cmd_mixes "$@" ;;
    retag) cmd_retag "${1:-}" "${2:-}" "${3:-}" ;;
    favorite)
      [[ "${1:-}" == toggle ]] || usage
      shift
      cmd_favorite_toggle "${1:-}" "${2:-}"
      ;;
    stats) cmd_status "$@" ;;
    art) cmd_art "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "evo-player: unknown command: $cmd" >&2
      usage
      ;;
  esac
}

main "$@"
