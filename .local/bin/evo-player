#!/bin/bash
# Music library + mpv playback for evo.player panel.

set -euo pipefail

EVOSHELL_BIN="${EVOSHELL_BIN:-$HOME/.local/bin}"
# shellcheck source=evo-player-lib.sh
source "${EVOSHELL_BIN}/evo-player-lib.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  evo-player start|load <path> [--folder]|play [playlist|m3u]
  evo-player current save <path> [<path>...]
  evo-player current load [--json]
  evo-player current clear
  evo-player queue append <path> [<path>...]
  evo-player queue append-browse <path> [--json]
  evo-player queue play <start-path> <path> [<path>...]
  evo-player queue extend [--json]
  evo-player prioritize <path> [<path>...]
  evo-player toggle|next|prev|seek <sec>|shuffle [toggle|on|off]
  evo-player volume set <0-100>|volume <delta>
  evo-player save|open|restore|resume|close|stop|status [--json]
  evo-player soundcloud [--json]
  evo-player sync [--json]
  evo-player import [--json]
  evo-player playlists [--force]
  evo-player build [--json]
  evo-player warm [<track-path>]
  evo-player sort <folder> [--json]
  evo-player config get [--json]|config set <section.key> <value> [--json]|config pick
  evo-player cache [--force] [--prune-art] [--json] [genre]
  evo-player job status [--json]|job stop [--json]
  evo-player genres [--json]
  evo-player tracks <genre> [--json]
  evo-player browse [path] [--json] [--queue] [--offset N] [--limit N]
  evo-player playlist [--json]
  evo-player playlist <name> [--json] [--offset N] [--limit N]
  evo-player playlist star toggle <name> [--json]
  evo-player favorite toggle <path> [--json]
  evo-player tag set title <path> <value> [--json]
  evo-player mixes migrate [--dry-run] [--json]
  evo-player art search [<track-path>] [--query <text>] [--json]
  evo-player art set <track-path> <image-path> [--album|--track] [--json]
  evo-player art apply <track-path> <url> [--album|--track] [--json]
  evo-player art clear <track-path> [--json]
  evo-player art embed|maintain [--json]
  evo-player art notify-cache <track-path>
  evo-player find [--artist|--genre|--year|--album|--label] <value> [--json]
  evo-player find <query> [--json]
  evo-player scrobble auth|token <token>|nowplaying|submit|recent|touch [--json]
  evo-player stats [--json]
EOF
  exit 1
}

mpv_ipc() {
  local payload="$1"
  if [[ ! -S "$MPV_SOCKET" ]]; then
    return 1
  fi
  python3 - "$MPV_SOCKET" "$payload" <<'PY'
import json, socket, sys
sock_path, payload = sys.argv[1], sys.argv[2]
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    s.connect(sock_path)
    s.sendall((payload + "\n").encode())
    data = s.recv(65536)
    if data:
        sys.stdout.write(data.decode("utf-8", "replace"))
PY
}

mpv_prop() {
  local name="$1"
  local raw
  raw="$(mpv_ipc "{\"command\":[\"get_property\",\"${name}\"]}")" || return 1
  python3 -c 'import json,sys
data = json.load(sys.stdin).get("data", "")
if isinstance(data, bool):
    print("true" if data else "false")
else:
    print(data)' <<<"$raw" 2>/dev/null
}

mpv_wait_loaded() {
  local want="${1:-}"
  local i=0 path idle
  while [[ $i -lt 80 ]]; do
    path="$(mpv_prop path 2>/dev/null || true)"
    idle="$(mpv_prop idle-active 2>/dev/null || true)"
    if [[ -n "$want" && "$path" == "$want" && "$idle" != "true" ]]; then
      return 0
    fi
    sleep 0.05
    i=$((i + 1))
  done
  return 1
}

cmd_player_start() {
  if mpv_running; then
    return 0
  fi
  local mpris_script=""
  if [[ -f /usr/share/mpv-mpris/mpris.so ]]; then
    mpris_script="--script=/usr/share/mpv-mpris/mpris.so"
  fi
  nohup mpv --no-video --idle=yes --keep-open=yes \
    --audio-client-name="$EVO_PLAYER_MPV_CLIENT_NAME" \
    --input-ipc-server="$MPV_SOCKET" \
    $mpris_script \
    >/dev/null 2>&1 &
  local i=0
  while [[ $i -lt 50 ]]; do
    [[ -S "$MPV_SOCKET" ]] && return 0
    sleep 0.05
    i=$((i + 1))
  done
  echo "evo-player: mpv socket did not start" >&2
  return 1
}

player_save_state() {
  local path="${1:-}"
  local genre="${2:-}"
  local playlist="${3:-}"
  local position="${4:-}"
  ensure_dirs
  if [[ -z "$path" ]]; then
    if mpv_running; then
      path="$(mpv_prop path)" || path=""
      position="$(mpv_prop time-pos)" || position="0"
    else
      [[ -f "$PLAYER_STATE" ]] || printf '{}\n' >"$PLAYER_STATE"
      return 0
    fi
  fi
  [[ -f "$PLAYER_STATE" ]] || printf '{}\n' >"$PLAYER_STATE"
  if [[ -z "$genre" && -n "$path" ]]; then
    genre="$(genre_from_path "$path")"
  fi
  if [[ -z "$playlist" ]]; then
    playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  fi
  jq -n \
    --arg path "${path:-}" \
    --arg genre "${genre:-}" \
    --arg playlist "${playlist:-}" \
    --argjson position "${position:-0}" \
    '{path:$path,genre:$genre,playlist:$playlist,position:$position}' >"$PLAYER_STATE"
}

cmd_player_save() {
  player_save_state
}

cmd_player_stop() {
  cmd_player_close
}

cmd_player_close() {
  ensure_dirs
  if mpv_running; then
    player_save_state
    mpv_ipc '{"command":["quit"]}' >/dev/null 2>&1 || true
    local i=0
    while [[ $i -lt 40 ]]; do
      pgrep -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1 || return 0
      sleep 0.05
      i=$((i + 1))
    done
    pkill -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1 || true
    return 0
  fi
  [[ -f "$PLAYER_STATE" ]] || player_save_state
}

cmd_player_open() {
  local json="${1:-}"
  ensure_dirs
  if mpv_running; then
    local path
    path="$(mpv_prop path 2>/dev/null || true)"
    if [[ -n "$path" && -f "$path" ]]; then
      player_save_state
      if [[ "$json" == --json ]]; then
        cmd_player_status --json
      else
        printf '%s\n' "$path"
      fi
      return 0
    fi
  fi
  if [[ "$json" == --json ]]; then
    player_saved_status_json
  elif [[ -f "$PLAYER_STATE" ]]; then
    jq -r '.path // ""' "$PLAYER_STATE"
  fi
}

cmd_player_restore() {
  local json="${1:-}"
  ensure_dirs
  [[ -f "$PLAYER_STATE" ]] || {
    [[ "$json" == --json ]] && player_saved_status_json
    return 0
  }
  local path pos genre playlist
  path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
  genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  if [[ -z "$path" || ! -f "$path" ]]; then
    [[ "$json" == --json ]] && player_saved_status_json
    return 0
  fi
  cmd_player_start
  local escaped="${path//\\/\\\\}" current=""
  current="$(mpv_prop path 2>/dev/null || true)"
  if [[ "$current" != "$path" ]]; then
    mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"replace\"]}" >/dev/null
    mpv_wait_loaded "$path" || true
  fi
  if [[ -n "$pos" && "$pos" != "0" && "$pos" != "null" ]]; then
    mpv_ipc "{\"command\":[\"seek\",${pos},\"absolute\"]}" >/dev/null
  fi
  mpv_ipc '{"command":["set_property","pause",true]}' >/dev/null
  player_save_state "$path" "$genre" "$playlist" "$pos"
  waveform_ensure_async "$path"
  if [[ "$json" == --json ]]; then
    cmd_player_status --json
  else
    printf '%s\n' "$path"
  fi
}

cmd_player_resume() {
  local json="${1:-}"
  ensure_dirs
  [[ -f "$PLAYER_STATE" ]] || return 0
  local path pos genre playlist
  path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
  genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  [[ -f "$path" ]] || return 0
  cmd_player_start
  local escaped="${path//\\/\\\\}"
  mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"replace\"]}" >/dev/null
  if [[ -n "$pos" && "$pos" != "0" && "$pos" != "null" ]]; then
    mpv_ipc "{\"command\":[\"seek\",${pos},\"absolute\"]}" >/dev/null
  fi
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  player_save_state "$path" "$genre" "$playlist" "$pos"
  if [[ "$json" == --json ]]; then
    jq -n --arg path "$path" --arg genre "$genre" --arg playlist "$playlist" \
      '{path:$path,genre:$genre,playlist:$playlist}'
  else
    printf '%s\n' "$path"
  fi
}

mpv_load_file() {
  local path="$1"
  local mode="${2:-replace}"
  local escaped="${path//\\/\\\\}"
  mpv_ipc "{\"command\":[\"loadfile\",\"${escaped}\",\"${mode}\"]}" >/dev/null
}

cmd_player_load() {
  local path="" folder=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --folder) folder=1 ;;
      --json) ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) path="$1" ;;
    esac
    shift
  done
  [[ -n "$path" ]] || usage
  [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
  cmd_player_start
  if [[ "$folder" -eq 1 ]]; then
    local dir f
    local -a files=()
    dir="$(dirname "$path")"
    while IFS= read -r -d '' f; do
      is_audio "$f" && files+=("$f")
    done < <(find "$dir" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    local idx=-1 i
    for i in "${!files[@]}"; do
      if [[ "${files[$i]}" == "$path" ]]; then
        idx=$i
        break
      fi
    done
    [[ "$idx" -ge 0 ]] || { echo "evo-player: track not in folder listing: $path" >&2; return 1; }
    mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
    mpv_load_file "$path" replace
    for ((i = idx + 1; i < ${#files[@]}; i++)); do
      mpv_load_file "${files[$i]}" append
    done
    art_ensure_now "$path"
    for ((i = idx + 1; i < ${#files[@]}; i++)); do
      art_ensure_priority_async "${files[$i]}"
    done
    queue_save "${files[@]}"
  else
    mpv_load_file "$path" replace
    art_ensure_now "$path"
    queue_save "$path"
  fi
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  player_save_state "$path" "$(genre_from_path "$path")" "" "0"
  waveform_ensure_async "$path"
}

cmd_player_prioritize() {
  [[ $# -gt 0 ]] || return 0
  art_prioritize_paths "$@"
}

cmd_player_queue_append_paths() {
  local -a incoming=("$@")
  local -a existing=() merged=() new_paths=()
  local line path
  declare -A seen=()

  if [[ -f "$CURRENT_M3U" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//$'\r'/}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ -f "$line" ]] || continue
      existing+=("$line")
      seen["$line"]=1
    done <"$CURRENT_M3U"
  fi

  merged=("${existing[@]}")
  for path in "${incoming[@]}"; do
    [[ -f "$path" ]] || continue
    is_audio "$path" || continue
    if [[ -z "${seen[$path]:-}" ]]; then
      seen["$path"]=1
      merged+=("$path")
      new_paths+=("$path")
    fi
  done

  ((${#new_paths[@]})) || return 1

  for path in "${new_paths[@]}"; do
    mpv_load_file "$path" append
    waveform_ensure_async "$path"
  done
  art_prioritize_paths "${new_paths[@]}"
  queue_save "${merged[@]}"
  printf '%s\n' "${#new_paths[@]}"
}

cmd_player_queue_append() {
  [[ $# -gt 0 ]] || usage
  cmd_player_start
  cmd_player_queue_append_paths "$@" >/dev/null
}

cmd_player_queue_append_browse() {
  local rel="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) rel="$1" ;;
    esac
    shift
  done
  [[ -n "$rel" ]] || usage
  cmd_player_start
  local -a folder_paths=() path added=0 track_line
  while IFS= read -r track_line; do
    [[ -n "$track_line" ]] || continue
    path="$(jq -r '.path // ""' <<<"$track_line")"
    [[ -n "$path" && -f "$path" ]] || continue
    folder_paths+=("$path")
  done < <(browse_collect_queue_tracks "$rel")
  ((${#folder_paths[@]})) || {
    [[ "$json" -eq 1 ]] && printf '{"added":0,"total":0,"folder":"%s"}\n' "$(json_escape "$rel")"
    return 1
  }
  added="$(cmd_player_queue_append_paths "${folder_paths[@]}")" || added=0
  if [[ "$json" -eq 1 ]]; then
    local total=0 line
    if [[ -f "$CURRENT_M3U" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line//$'\r'/}"
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ -f "$line" ]] && total=$((total + 1))
      done <"$CURRENT_M3U"
    fi
    jq -n \
      --arg folder "$rel" \
      --argjson added "$added" \
      --argjson total "$total" \
      '{folder:$folder,added:$added,total:$total}'
  elif [[ "$added" -gt 0 ]]; then
    printf 'appended %s track(s) from %s\n' "$added" "$rel"
  else
    printf 'no new tracks to append from %s\n' "$rel"
    return 1
  fi
}

cmd_player_queue_play() {
  [[ $# -ge 1 ]] || usage
  local start="$1"
  shift
  local -a paths=()
  local -a queue_paths=()
  local path idx=-1 i j
  if [[ $# -gt 0 ]]; then
    paths=("$@")
  else
    paths=("$start")
  fi
  local -a valid_paths=()
  for path in "${paths[@]}"; do
    [[ -f "$path" ]] && valid_paths+=("$path")
  done
  paths=("${valid_paths[@]}")
  [[ ${#paths[@]} -gt 0 ]] || { echo "evo-player: no playable files in queue" >&2; return 1; }
  for i in "${!paths[@]}"; do
    if [[ "$idx" -lt 0 && "${paths[$i]}" == "$start" ]]; then
      idx=$i
    fi
  done
  [[ "$idx" -ge 0 ]] || start="${paths[0]}"
  [[ "$idx" -ge 0 ]] || idx=0
  queue_paths=("${paths[@]}")
  paths=()
  for ((j = idx; j < ${#queue_paths[@]}; j++)); do
    paths+=("${queue_paths[$j]}")
  done
  for ((j = 0; j < idx; j++)); do
    paths+=("${queue_paths[$j]}")
  done
  start="${paths[0]}"
  cmd_player_start
  mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"
    if [[ "$i" -eq 0 ]]; then
      mpv_load_file "$path" replace
    else
      mpv_load_file "$path" append
    fi
    if (( i < 3 )); then
      waveform_ensure_async "$path"
    fi
  done
  local expected=${#paths[@]} count=0 tries=0
  while (( tries < 100 )); do
    count="$(mpv_prop playlist-count 2>/dev/null || echo 0)"
    [[ "${count%.*}" -ge "$expected" ]] && break
    sleep 0.02
    tries=$((tries + 1))
  done
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  art_ensure_now "$start"
  art_prioritize_paths "$start"
  queue_save "${queue_paths[@]}"
  player_save_state "$start" "$(genre_from_path "$start")" "current" "0"
}

cmd_player_queue() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    append) cmd_player_queue_append "$@" ;;
    append-browse) cmd_player_queue_append_browse "$@" ;;
    play) cmd_player_queue_play "$@" ;;
    extend) cmd_player_queue_extend "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown queue command: $sub" >&2; usage ;;
  esac
}

cmd_player_play() {
  local target="${1:-all}"
  cmd_player_start
  local list=""
  if [[ -f "$target" ]]; then
    list="$target"
  elif [[ -f "${PLAYLIST_DIR}/${target}.m3u" ]]; then
    list="${PLAYLIST_DIR}/${target}.m3u"
  elif [[ -f "${PLAYLIST_DIR}/all.m3u" ]]; then
    list="${PLAYLIST_DIR}/all.m3u"
  else
    echo "evo-player: no playlist for: $target" >&2
    return 1
  fi
  mpv_ipc '{"command":["playlist-clear"]}' >/dev/null || true
  mpv_ipc "{\"command\":[\"loadlist\",\"${list//\\/\\\\}\",\"replace\"]}" >/dev/null
  mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  jq -n --arg playlist "$target" --arg list "$list" --arg genre "$target" \
    '{playlist:$playlist,list:$list,genre:$genre,path:"",position:0}' >"$PLAYER_STATE"
}

cmd_player_toggle() {
  if ! mpv_running; then
    cmd_player_resume
    return $?
  fi
  local paused
  paused="$(mpv_prop pause)" || return 1
  if [[ "$paused" == "true" ]]; then
    mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null
  else
    mpv_ipc '{"command":["set_property","pause",true]}' >/dev/null
  fi
}

cmd_player_next() {
  cmd_player_start
  local count
  count="$(mpv_prop playlist-count 2>/dev/null || echo 1)"
  count="${count%.*}"
  if [[ "$count" -gt 1 ]]; then
    mpv_ipc '{"command":["playlist-next","weak"]}' >/dev/null
    player_save_state
    return 0
  fi
  player_queue_advance 1
  player_save_state
}

cmd_player_prev() {
  cmd_player_start
  local count
  count="$(mpv_prop playlist-count 2>/dev/null || echo 1)"
  count="${count%.*}"
  if [[ "$count" -gt 1 ]]; then
    mpv_ipc '{"command":["playlist-prev","weak"]}' >/dev/null
    player_save_state
    return 0
  fi
  player_queue_advance -1
  player_save_state
}

queue_save() {
  write_current_m3u "$@"
}

write_current_m3u() {
  ensure_dirs
  local -a paths=("$@")
  local tmp p first=1
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    for p in "${paths[@]}"; do
      [[ -f "$p" ]] || continue
      is_audio "$p" || continue
      printf '%s\n' "$p"
    done
  } >"$tmp"
  mv "$tmp" "$CURRENT_M3U"
  {
    printf '['
    first=1
    while IFS= read -r p || [[ -n "$p" ]]; do
      p="${p//$'\r'/}"
      [[ -z "$p" || "$p" == \#* ]] && continue
      [[ -f "$p" ]] || continue
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      track_list_cached_json "$p"
    done <"$CURRENT_M3U"
    printf ']\n'
  } >"${CURRENT_TRACKS_JSON}.tmp" && mv "${CURRENT_TRACKS_JSON}.tmp" "$CURRENT_TRACKS_JSON"
}

current_m3u_clear() {
  rm -f "$CURRENT_M3U" "$CURRENT_TRACKS_JSON"
}

cmd_current_save() {
  write_current_m3u "$@"
}

cmd_current_load() {
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
    esac
    shift
  done
  ensure_dirs
  if [[ ! -f "$CURRENT_M3U" ]]; then
    [[ "$json" -eq 1 ]] && printf '[]\n'
    return 0
  fi
  if [[ "$json" -eq 1 ]]; then
    if [[ -f "$CURRENT_TRACKS_JSON" && "$CURRENT_TRACKS_JSON" -nt "$CURRENT_M3U" ]]; then
      cat "$CURRENT_TRACKS_JSON"
      return 0
    fi
    printf '['
    playlist_emit_tracks_json "$CURRENT_M3U"
    printf ']\n'
    return 0
  fi
  cat "$CURRENT_M3U"
}

cmd_current() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    save) cmd_current_save "$@" ;;
    load) cmd_current_load "$@" ;;
    clear) current_m3u_clear ;;
    -h|--help|help|"") usage ;;
    *) usage ;;
  esac
}

player_queue_advance() {
  local delta="$1"
  [[ "$delta" == "1" || "$delta" == "-1" ]] || return 1
  local -a paths=()
  local line cur idx=-1 i next
  [[ -f "$CURRENT_M3U" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] && paths+=("$line")
  done <"$CURRENT_M3U"
  ((${#paths[@]})) || return 1
  cur="$(mpv_prop path 2>/dev/null || true)"
  for i in "${!paths[@]}"; do
    if [[ "${paths[$i]}" == "$cur" ]]; then
      idx=$i
      break
    fi
  done
  if [[ "$idx" -lt 0 ]]; then
    idx=0
  fi
  next=$((idx + delta))
  if [[ "$next" -lt 0 ]]; then
    return 0
  fi
  if [[ "$next" -ge ${#paths[@]} ]]; then
    if [[ "$delta" == "1" ]] && cmd_player_queue_extend; then
      return 0
    fi
    return 0
  fi
  cmd_player_queue_play "${paths[$next]}" "${paths[@]}"
}

queue_next_sibling_folder() {
  local cur_dir="$1"
  [[ -n "$cur_dir" && -d "$cur_dir" ]] || return 1
  local parent base name d
  parent="$(dirname "$cur_dir")"
  base="$(basename "$cur_dir")"
  [[ "$parent" != "$cur_dir" ]] || return 1
  local -a dirs=()
  while IFS= read -r -d '' d; do
    name="$(basename "$d")"
    skip_dir "$name" && continue
    [[ "$name" == .* ]] && continue
    dirs+=("$d")
  done < <(find "$parent" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
  ((${#dirs[@]})) || return 1
  local idx=-1 i next=0
  for i in "${!dirs[@]}"; do
    if [[ "${dirs[$i]}" == "$cur_dir" ]]; then
      idx=$i
      break
    fi
  done
  if [[ "$idx" -lt 0 ]]; then
    for i in "${!dirs[@]}"; do
      if [[ "$(basename "${dirs[$i]}")" > "$base" ]]; then
        printf '%s' "${dirs[$i]}"
        return 0
      fi
    done
    printf '%s' "${dirs[0]}"
    return 0
  fi
  next=$((idx + 1))
  if [[ "$next" -ge ${#dirs[@]} ]]; then
    next=0
  fi
  printf '%s' "${dirs[$next]}"
}

cmd_player_queue_extend() {
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      *) usage ;;
    esac
    shift
  done
  local -a paths=() new_paths=() all_paths=()
  local line path cur idx=-1 i at_end=0 next_dir
  [[ -f "$CURRENT_M3U" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] && paths+=("$line")
  done <"$CURRENT_M3U"
  ((${#paths[@]})) || return 1
  next_dir="$(queue_next_sibling_folder "$(dirname "${paths[-1]}")")" || return 1
  while IFS= read -r -d '' path; do
    is_audio "$path" && new_paths+=("$path")
  done < <(find "$next_dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
  ((${#new_paths[@]})) || return 1
  cur="$(mpv_prop path 2>/dev/null || true)"
  for i in "${!paths[@]}"; do
    [[ "${paths[$i]}" == "$cur" ]] && idx=$i
  done
  [[ "$idx" -ge 0 && "$idx" -eq $((${#paths[@]} - 1)) ]] && at_end=1
  all_paths=("${paths[@]}" "${new_paths[@]}")
  cmd_player_start
  local wf=0
  for path in "${new_paths[@]}"; do
    mpv_load_file "$path" append
    if (( wf < 3 )); then
      waveform_ensure_async "$path"
      wf=$((wf + 1))
    fi
  done
  queue_save "${all_paths[@]}"
  art_prioritize_paths "${new_paths[0]}"
  if [[ "$at_end" -eq 1 ]]; then
    mpv_ipc '{"command":["playlist-next","weak"]}' >/dev/null || true
    mpv_ipc '{"command":["set_property","pause",false]}' >/dev/null || true
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg folder "$next_dir" \
      --argjson added "${#new_paths[@]}" \
      '{folder:$folder,added:$added}'
  else
    echo "evo-player: extended queue with ${#new_paths[@]} track(s) from $(basename "$next_dir")" >&2
  fi
}

cmd_player_seek() {
  local sec="$1"
  cmd_player_start
  mpv_ipc "{\"command\":[\"seek\",${sec},\"absolute\"]}" >/dev/null
}

cmd_player_shuffle() {
  local mode="${1:-toggle}"
  cmd_player_start
  if [[ "$mode" == toggle ]]; then
    local cur
    cur="$(mpv_prop shuffle)" || cur="no"
    if [[ "$cur" == "yes" || "$cur" == "true" ]]; then
      mpv_ipc '{"command":["set_property","shuffle",false]}' >/dev/null
    else
      mpv_ipc '{"command":["set_property","shuffle",true]}' >/dev/null
    fi
  else
    mpv_ipc "{\"command\":[\"set_property\",\"shuffle\",$([[ $mode == on ]] && echo true || echo false)]}" >/dev/null
  fi
}

cmd_player_volume() {
  local arg="${1:-0}"
  local value="${2:-}"
  cmd_player_start
  if [[ "$arg" == set ]]; then
    local v="${value:-100}"
    mpv_ipc "{\"command\":[\"set_property\",\"volume\",${v}]}" >/dev/null
    if [[ "${v%.*}" -gt 0 ]]; then
      mpv_ipc '{"command":["set_property","mute",false]}' >/dev/null
    fi
  else
    mpv_ipc "{\"command\":[\"add\",\"volume\",${arg}]}" >/dev/null
    mpv_ipc '{"command":["set_property","mute",false]}' >/dev/null
  fi
}

format_time() {
  local sec="${1%.*}"
  sec="${sec:-0}"
  local h m s
  h=$((sec / 3600))
  m=$(((sec % 3600) / 60))
  s=$((sec % 60))
  if [[ $h -gt 0 ]]; then
    printf '%d:%02d:%02d' "$h" "$m" "$s"
  else
    printf '%d:%02d' "$m" "$s"
  fi
}

mpv_running() {
  [[ -S "$MPV_SOCKET" ]] && pgrep -f "input-ipc-server=${MPV_SOCKET}" >/dev/null 2>&1
}

player_saved_status_json() {
  ensure_dirs
  local path="" pos="0" genre="" playlist=""
  if [[ -f "$PLAYER_STATE" ]]; then
    path="$(jq -r '.path // ""' "$PLAYER_STATE" 2>/dev/null || true)"
    pos="$(jq -r '.position // 0' "$PLAYER_STATE" 2>/dev/null || true)"
    genre="$(jq -r '.genre // ""' "$PLAYER_STATE" 2>/dev/null || true)"
    playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  fi
  local title="" artist="" album="" tag_genre="" year="" label="" dur="0" art="" wf="" liked="false" row=""
  if [[ -n "$path" && -f "$path" ]]; then
    row="$(track_list_cached_json "$path")"
    title="$(jq -r '.title // ""' <<<"$row")"
    artist="$(jq -r '.artist // ""' <<<"$row")"
    tag_genre="$(jq -r '.genre // ""' <<<"$row")"
    album="$(jq -r '.album // ""' <<<"$row")"
    year="$(jq -r '.year // ""' <<<"$row")"
    label="$(jq -r '.label // ""' <<<"$row")"
    [[ -z "$title" ]] && title="$(basename "$path")"
    title="${title%.*}"
    dur="$(jq -r '.duration // 0' <<<"$row")"
    [[ "$dur" =~ ^[0-9]+$ ]] || dur="0"
    art="$(jq -r '.art // ""' <<<"$row")"
    [[ -z "$art" ]] && art="$(art_path_cached "$path")"
    wf="$(jq -r '.waveform // ""' <<<"$row")"
    [[ -z "$wf" ]] && wf="$(waveform_cache_path "$path")"
    waveform_ensure_async "$path"
    liked="$(jq -r '.liked // false' <<<"$row")"
    [[ "$liked" == "true" ]] || { is_liked "$path" && liked="true"; }
  else
    path=""
    pos="0"
    dur="0"
  fi
  [[ -z "$genre" && -n "$tag_genre" ]] && genre="$tag_genre"
  jq -n \
    --arg state "stopped" \
    --arg path "$path" \
    --arg title "$title" \
    --arg artist "$artist" \
    --arg genre "$genre" \
    --arg album "$album" \
    --arg year "$year" \
    --arg label "$label" \
    --argjson position "${pos:-0}" \
    --argjson duration "${dur:-0}" \
    --argjson volume 100 \
    --arg art "$art" \
    --arg waveform "$wf" \
    --arg playlist "$playlist" \
    --argjson shuffle false \
    --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
    --arg position_label "$(format_time "${pos:-0}")" \
    --arg duration_label "$(format_time "${dur:-0}")" \
    '{state:$state,path:$path,title:$title,artist:$artist,genre:$genre,album:$album,year:$year,label:$label,position:$position,duration:$duration,volume:$volume,liked:$liked,art:$art,waveform:$waveform,playlist:$playlist,shuffle:$shuffle,position_label:$position_label,duration_label:$duration_label}'
}

cmd_player_status() {
  local json="${1:-}"
  if ! mpv_running; then
    if [[ "$json" == --json ]]; then
      player_saved_status_json
    else
      echo "stopped"
    fi
    return 0
  fi
  local path paused pos dur vol title artist genre album year label art wf playlist shuffle state liked row muted
  path="$(mpv_prop path)" || path=""
  paused="$(mpv_prop pause)" || paused="true"
  pos="$(mpv_prop time-pos)" || pos="0"
  dur="$(mpv_prop duration)" || dur="0"
  vol="$(mpv_prop volume)" || vol="100"
  muted="$(mpv_prop mute)" || muted="false"
  [[ "$muted" == "true" ]] && vol="0"
  shuffle="$(mpv_prop shuffle)" || shuffle="false"
  playlist=""
  [[ -f "$PLAYER_STATE" ]] && playlist="$(jq -r '.playlist // ""' "$PLAYER_STATE" 2>/dev/null || true)"
  if [[ "$paused" == "true" ]]; then
    state="paused"
  else
    state="playing"
  fi
  title="" artist="" genre="" album="" year="" label="" liked="false"
  row=""
  if [[ -n "$path" && -f "$path" ]]; then
    row="$(track_list_cached_json "$path")"
    title="$(jq -r '.title // ""' <<<"$row")"
    artist="$(jq -r '.artist // ""' <<<"$row")"
    genre="$(jq -r '.genre // ""' <<<"$row")"
    album="$(jq -r '.album // ""' <<<"$row")"
    year="$(jq -r '.year // ""' <<<"$row")"
    label="$(jq -r '.label // ""' <<<"$row")"
    [[ -z "$title" ]] && title="$(basename "$path")"
    title="${title%.*}"
    art="$(jq -r '.art // ""' <<<"$row")"
    [[ -z "$art" ]] && art="$(art_path_cached "$path")"
    wf="$(jq -r '.waveform // ""' <<<"$row")"
    [[ -z "$wf" ]] && wf="$(waveform_cache_path "$path")"
    waveform_ensure_async "$path"
    liked="$(jq -r '.liked // false' <<<"$row")"
    [[ "$liked" == "true" ]] || { is_liked "$path" && liked="true"; }
  else
    art="" wf=""
  fi
  if [[ "$json" == --json ]]; then
    jq -n \
      --arg state "$state" \
      --arg path "$path" \
      --arg title "$title" \
      --arg artist "$artist" \
      --arg genre "$genre" \
      --arg album "$album" \
      --arg year "$year" \
      --arg label "$label" \
      --argjson position "${pos:-0}" \
      --argjson duration "${dur:-0}" \
      --argjson volume "${vol:-100}" \
      --arg art "$art" \
      --arg waveform "$wf" \
      --arg playlist "$playlist" \
      --argjson shuffle "$([[ $shuffle == yes || $shuffle == true ]] && echo true || echo false)" \
      --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
      --arg position_label "$(format_time "${pos:-0}")" \
      --arg duration_label "$(format_time "${dur:-0}")" \
      '{state:$state,path:$path,title:$title,artist:$artist,genre:$genre,album:$album,year:$year,label:$label,position:$position,duration:$duration,volume:$volume,liked:$liked,art:$art,waveform:$waveform,playlist:$playlist,shuffle:$shuffle,position_label:$position_label,duration_label:$duration_label}'
  else
    printf '%s — %s (%s)\n' "$artist" "$title" "$state"
  fi
}

cmd_sync_impl() {
  ensure_dirs
  local cookies user url
  cookies="$(config_toml_get soundcloud cookies_from brave)"
  user="$(config_toml_get soundcloud user seb-day)"
  url="$(soundcloud_likes_url)"
  yt-dlp \
    --cookies-from-browser "$cookies" \
    --download-archive "$SYNC_ARCHIVE" \
    -f "ba/b" \
    -x --audio-format mp3 --audio-quality 0 \
    --embed-metadata --embed-thumbnail \
    --convert-thumbnails jpg \
    -o "${MUSIC_ROOT}/.incoming/%(uploader)s - %(title)s.%(ext)s" \
    "$url"
  incoming_normalize_mp3
}

cmd_sync() {
  run_exclusive_job sync "download soundcloud" cmd_sync_impl
}

cmd_soundcloud_impl() {
  cmd_sync_impl
  cmd_import_impl
}

cmd_soundcloud() {
  run_exclusive_job soundcloud "soundcloud" cmd_soundcloud_impl
}

incoming_skip_file() {
  local path="$1"
  local base ext
  base="$(basename "$path")"
  case "$base" in
    *.part|*.ytdl|*.temp.*|*.temp) return 0 ;;
  esac
  ext="${path##*.}"
  ext="${ext,,}"
  case "$ext" in
    part|ytdl|temp|jpg|jpeg|png|webp|gif) return 0 ;;
  esac
  return 1
}

cmd_import_impl() {
  local incoming="${MUSIC_ROOT}/.incoming"
  [[ -d "$incoming" ]] || mkdir -p "$incoming"
  local moved=0 failed=0 f dest
  while IFS= read -r -d '' f; do
    incoming_skip_file "$f" && continue
    is_audio "$f" || continue
    standardize_track_tags "$f" >/dev/null || {
      echo "evo-player: warn: tag standardize failed: $f" >&2
    }
    dest="$(place_track "$f")" || {
      failed=$((failed + 1))
      continue
    }
    moved=$((moved + 1))
  done < <(find "$incoming" -maxdepth 1 -type f -print0 2>/dev/null)
  if [[ "$moved" -eq 0 && "$failed" -eq 0 ]]; then
    echo "evo-player: nothing to import in .incoming/" >&2
    return 0
  fi
  echo "evo-player: imported ${moved} file(s) from .incoming/" >&2
  cmd_playlists
  [[ "$failed" -eq 0 ]]
}

cmd_import() {
  run_exclusive_job import "import incoming" cmd_import_impl
}

cmd_sort_impl() {
  local rel="$1" json="${2:-0}"
  local dir moved=0 failed=0 f dest canon
  rel="${rel#${MUSIC_ROOT}/}"
  rel="${rel#/}"
  dir="${MUSIC_ROOT}/${rel}"
  [[ -d "$dir" ]] || {
    echo "evo-player: not a folder: ${rel:-/}" >&2
    return 1
  }
  while IFS= read -r -d '' f; do
    is_audio "$f" || continue
    canon="$(canonical_track_dest "$f")" || {
      failed=$((failed + 1))
      continue
    }
    if ! paths_equal "$f" "$canon"; then
      dest="$(place_track "$f")" || {
        failed=$((failed + 1))
        continue
      }
      moved=$((moved + 1))
      f="$dest"
    fi
  done < <(sort_folder_collect_audio "$dir")
  if [[ "$json" -eq 1 ]]; then
    jq -n --arg folder "$rel" --argjson moved "$moved" --argjson failed "$failed" \
      '{folder:$folder,moved:$moved,failed:$failed}'
  else
    printf 'sorted %s: moved %d, failed %d\n' "$rel" "$moved" "$failed"
  fi
  [[ "$failed" -eq 0 ]]
}

run_sort_job() {
  local folder="$1"
  local json="$2"
  local rel="${folder#${MUSIC_ROOT}/}"
  rel="${rel#/}"
  local label="sort ${rel:-/}"
  ensure_dirs
  local running
  running="$(library_job_running "$$")"
  if [[ -n "$running" ]]; then
    local running_cmd="${running##* }"
    if [[ "$running_cmd" != "build" ]]; then
      local run_label="$running_cmd"
      case "$running_cmd" in
        build) run_label="build" ;;
        soundcloud) run_label="soundcloud" ;;
        sync) run_label="download soundcloud" ;;
        import) run_label="import incoming" ;;
        sort) run_label="sort" ;;
      esac
      echo "evo-player: busy — ${run_label} already running" >&2
      return 2
    fi
    cmd_sort_impl "$folder" "$json"
    return $?
  fi
  run_exclusive_job sort "$label" cmd_sort_impl "$folder" "$json"
}

cmd_sort() {
  local folder="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) folder="$1" ;;
    esac
    shift
  done
  [[ -n "$folder" ]] || usage
  run_sort_job "$folder" "$json"
}

cmd_config_get() {
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  if [[ "$json" -eq 1 ]]; then
    config_toml_json
  else
    config_toml_json | jq -r '.soundcloud | "user: \(.user)\ncookies_from: \(.cookies_from)"'
  fi
}

cmd_config_set() {
  local key="" value="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$key" ]]; then
          key="$1"
        else
          value="$1"
        fi
        ;;
    esac
    shift
  done
  [[ -n "$key" && -n "$value" ]] || usage
  local section field
  section="${key%%.*}"
  field="${key#*.}"
  [[ "$section" != "$field" && -n "$section" && -n "$field" ]] || {
    echo "evo-player: usage: evo-player config set section.key value" >&2
    return 1
  }
  if [[ "$section" == "paths" && "$field" == "root" ]]; then
    value="${value%/}"
    [[ -d "$value" ]] || {
      echo "evo-player: music library not found: $value" >&2
      return 1
    }
    music_paths_apply "$value"
    mkdir -p "$MUSIC_CACHE"
    config_toml_set "$section" "$field" "$MUSIC_ROOT"
  else
    config_toml_set "$section" "$field" "$value"
  fi
  if [[ "$json" -eq 1 ]]; then
    config_toml_json
  else
    printf 'ok\n'
  fi
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    get) cmd_config_get "$@" ;;
    set) cmd_config_set "$@" ;;
    pick)
      local start_dir selected
      start_dir="$MUSIC_ROOT"
      [[ -d "$start_dir" ]] || start_dir="$HOME"
      selected="$(zenity --file-selection --directory --title="Select music library" --filename="${start_dir}/" 2>/dev/null || true)"
      [[ -n "$selected" ]] || return 0
      cmd_config_set "paths.root" "$selected" --json
      ;;
    -h|--help|help|"") usage ;;
    *) usage ;;
  esac
}

write_likes_m3u() {
  local out="$1"
  likes_init
  local tmp
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  mv "$tmp" "$out"
}

write_playlist() {
  local genre="${1%-fav}"
  local out="${PLAYLIST_DIR}/${genre}.m3u"
  likes_init
  local tmp count line
  tmp="$(mktemp)"
  {
    printf '#EXTM3U\n'
    jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      is_audio "$f" || continue
      [[ "$(genre_from_path "$f")" == "$genre" ]] || continue
      printf '%s\n' "$f"
    done | sort -u
  } >"$tmp"
  count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    count=$((count + 1))
  done <"$tmp"
  if [[ "$count" -eq 0 ]]; then
    rm -f "$out" "${PLAYLIST_DIR}/${genre}-fav.m3u" "$tmp"
    return 0
  fi
  mv "$tmp" "$out"
  rm -f "${PLAYLIST_DIR}/${genre}-fav.m3u"
}

cmd_playlists() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  likes_init
  echo "evo-player: rebuilding liked-track playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  rm -f "${PLAYLIST_DIR}"/*-fav.m3u
  echo "evo-player: rebuilding track tag caches..." >&2
  if [[ "$force" -eq 1 ]]; then
    cmd_cache --force
  else
    cmd_cache
  fi
}

cmd_rebuild_impl() {
  echo "evo-player: rebuild started at $(date -Iseconds)" >&2
  echo "evo-player: rebuilding playlists and track caches..." >&2
  cmd_playlists --force
  echo "evo-player: rebuild complete at $(date -Iseconds)" >&2
}

cmd_rebuild() {
  run_exclusive_job rebuild "rebuild library" cmd_rebuild_impl
}

warm_collect_paths() {
  local genre="${1:-}"
  local cache g f
  if [[ -n "$genre" ]]; then
    cache="$(tracks_cache_path "$genre")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
      return 0
    fi
    while IFS= read -r -d '' f; do
      is_audio "$f" && printf '%s\n' "$f"
    done < <(find "${MUSIC_ROOT}/${genre}" -type f -print0 2>/dev/null)
    return 0
  fi
  while IFS= read -r g; do
    cache="$(tracks_cache_path "$g")"
    if [[ -f "$cache" ]]; then
      jq -r '.[].path' "$cache" 2>/dev/null
    else
      while IFS= read -r -d '' f; do
        is_audio "$f" && printf '%s\n' "$f"
      done < <(find "${MUSIC_ROOT}/${g}" -type f -print0 2>/dev/null)
    fi
  done < <(list_genres)
}

warm_paths_ordered() {
  local genre="${1:-}"
  local tmp liked rest path
  tmp="$(mktemp)"
  liked="$(mktemp)"
  rest="$(mktemp)"
  likes_init
  jq -r 'keys[]' "$LIKES_FILE" 2>/dev/null | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    is_audio "$path" || continue
    if [[ -n "$genre" && "$(genre_from_path "$path")" != "$genre" ]]; then
      continue
    fi
    printf '%s\n' "$path"
  done | sort -u >"$liked"
  warm_collect_paths "$genre" | sort -u >"$rest"
  awk 'FNR==NR {seen[$0]=1; print; next} !seen[$0]' "$liked" "$rest" >"$tmp"
  cat "$liked" "$tmp"
  rm -f "$liked" "$rest" "$tmp"
}

warm_asset_needed() {
  local path="$1"
  local kind="$2"
  case "$kind" in
    art)
      [[ -n "$(art_path_cached "$path")" ]] && return 1
      return 0
      ;;
    waveforms)
      [[ -n "$(waveform_cache_find "$path" 2>/dev/null || true)" ]] && return 1
      return 0
      ;;
  esac
  return 1
}

cmd_warm() {
  local do_art=0 do_wf=0 do_tags=0 json=0 genre="" track_path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --art) do_art=1 ;;
      --waveforms) do_wf=1 ;;
      --tags) do_tags=1 ;;
      --json) json=1 ;;
      -*) usage ;;
      *)
        if [[ -f "$1" ]] && is_audio "$1"; then
          track_path="$1"
        else
          genre="$1"
        fi
        ;;
    esac
    shift
  done
  [[ "$do_art" -eq 1 || "$do_wf" -eq 1 || "$do_tags" -eq 1 ]] || {
    do_art=1
    do_wf=1
  }
  ensure_dirs
  if [[ -n "$track_path" ]]; then
    local art_built=0 wf_built=0
    if [[ "$do_art" -eq 1 ]]; then
      art_path_for "$track_path" >/dev/null 2>&1 && art_built=1
    fi
    if [[ "$do_wf" -eq 1 ]]; then
      waveform_build "$track_path" >/dev/null 2>&1 && wf_built=1
    fi
    if [[ "$json" -eq 1 ]]; then
      jq -n \
        --arg path "$track_path" \
        --argjson art_built "$art_built" \
        --argjson wf_built "$wf_built" \
        '{path:$path,art_built:$art_built,waveform_built:$wf_built}'
    fi
    return 0
  fi
  if [[ "$do_tags" -eq 1 ]]; then
    if [[ -n "$genre" ]]; then
      cmd_cache "$genre"
    else
      cmd_cache
    fi
  fi

  local -a paths=()
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    paths+=("$path")
  done < <(warm_paths_ordered "$genre")

  local total=${#paths[@]} done=0 art_built=0 wf_built=0 art_skipped=0 wf_skipped=0
  local wf_limit=2 art_limit=4 wf_running=0 art_running=0

  for path in "${paths[@]}"; do
    if [[ "$do_art" -eq 1 ]]; then
      if warm_asset_needed "$path" art; then
        while (( art_running >= art_limit )); do
          wait -n 2>/dev/null || wait
          art_running=$((art_running - 1))
        done
        art_running=$((art_running + 1))
        (
          art_path_for "$path" >/dev/null 2>&1
          exit 0
        ) &
        art_built=$((art_built + 1))
      else
        art_skipped=$((art_skipped + 1))
      fi
    fi
    if [[ "$do_wf" -eq 1 ]]; then
      if warm_asset_needed "$path" waveforms; then
        while (( wf_running >= wf_limit )); do
          wait -n 2>/dev/null || wait
          wf_running=$((wf_running - 1))
        done
        wf_running=$((wf_running + 1))
        (
          waveform_build "$path" >/dev/null 2>&1
          exit 0
        ) &
        wf_built=$((wf_built + 1))
      else
        wf_skipped=$((wf_skipped + 1))
      fi
    fi
    done=$((done + 1))
    if (( done % 25 == 0 || done == total )); then
      echo "evo-player: warming ${done}/${total} (art +${art_built}/-${art_skipped}, waveforms +${wf_built}/-${wf_skipped})" >&2
    fi
  done
  wait

  echo "evo-player: warm complete ${done}/${total}" >&2
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --argjson total "$total" \
      --argjson done "$done" \
      --argjson art_built "$art_built" \
      --argjson wf_built "$wf_built" \
      --argjson art_skipped "$art_skipped" \
      --argjson wf_skipped "$wf_skipped" \
      '{total:$total,done:$done,art_built:$art_built,waveform_built:$wf_built,art_skipped:$art_skipped,waveform_skipped:$wf_skipped}'
  fi
}

cmd_build_impl() {
  echo "evo-player: build started at $(date -Iseconds)" >&2
  ensure_dirs
  likes_init
  echo "evo-player: refreshing playlists..." >&2
  local g
  while IFS= read -r g; do
    write_playlist "$g"
  done < <(list_genres)
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  echo "evo-player: indexing track tags..." >&2
  cmd_cache
  echo "evo-player: warming art and waveforms..." >&2
  cmd_warm --art --waveforms
  echo "evo-player: pruning duplicate art..." >&2
  art_prune_legacy >/dev/null
  echo "evo-player: build complete at $(date -Iseconds)" >&2
}

cmd_build() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      all|quick) ;;
      -h|--help|help) usage ;;
      *) usage ;;
    esac
    shift
  done
  run_exclusive_job build "build" cmd_build_impl
}

cmd_cache() {
  local force=0 json=0 prune_art=0 genre=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      --json) json=1 ;;
      --prune-art) prune_art=1 ;;
      -*) usage ;;
      *) genre="$1" ;;
    esac
    shift
  done
  ensure_dirs
  if [[ "$prune_art" -eq 1 ]]; then
    local pruned
    pruned="$(art_prune_legacy)"
    if [[ "$json" -eq 1 ]]; then
      jq -n --argjson pruned "$pruned" '{pruned:$pruned}'
    fi
    return 0
  fi
  local g cache built=0 skipped=0 total=0 count
  cache_one() {
    local name="$1"
    [[ -d "${MUSIC_ROOT}/${name}" ]] || {
      echo "evo-player: unknown genre: ${name}" >&2
      return 1
    }
    total=$((total + 1))
    cache="$(tracks_cache_path "$name")"
    if [[ "$force" -eq 1 ]] || tracks_cache_stale "$name" "$cache"; then
      echo "evo-player: caching ${name}..." >&2
      build_tracks_json "$name" "$force" >/dev/null
      count="$(jq 'length' "$cache" 2>/dev/null || echo 0)"
      [[ -n "$count" ]] || count=0
      echo "evo-player: cached ${name} (${count} tracks)" >&2
      built=$((built + 1))
    else
      echo "evo-player: ${name} cache already fresh" >&2
      skipped=$((skipped + 1))
    fi
  }
  if [[ -n "$genre" ]]; then
    cache_one "$genre"
  else
    while IFS= read -r g; do
      cache_one "$g"
    done < <(list_genres)
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n --argjson built "$built" --argjson skipped "$skipped" --argjson total "$total" \
      '{built:$built,skipped:$skipped,total:$total}'
  else
    echo "evo-player: cached ${built} genre(s), ${skipped} already fresh (${total} total)" >&2
  fi
}

cmd_genres() {
  local json="${1:-}"
  if [[ "$json" == --json ]]; then
    printf '['
    local first=1 g count
    while IFS= read -r g; do
      count="$(genre_track_count_cached "$g")"
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '{"name":"%s","count":%s}' "$(json_escape "$g")" "$count"
    done < <(list_genres)
    printf ']\n'
  else
    list_genres
  fi
}

cmd_tracks() {
  local genre="$1"
  local json="${2:-}"
  local dir="$MUSIC_ROOT/$genre"
  local cache
  [[ -d "$dir" ]] || { echo "evo-player: unknown genre: $genre" >&2; return 1; }
  if [[ "$json" == --json ]]; then
    cache="$(tracks_cache_path "$genre")"
    if tracks_cache_stale "$genre" "$cache"; then
      build_tracks_json "$genre"
    else
      cat "$cache"
    fi
  else
    find "$dir" -maxdepth 1 -type f | sort
  fi
}

browse_resolve() {
  local rel="${1:-}"
  rel="${rel#/}"
  rel="${rel%/}"
  local dir root real_root real_dir
  root="$(realpath -m "$MUSIC_ROOT")"
  if [[ -z "$rel" ]]; then
    dir="$MUSIC_ROOT"
  else
    dir="${MUSIC_ROOT}/${rel}"
  fi
  real_dir="$(realpath -m "$dir")"
  [[ "$real_dir" == "$root" || "$real_dir" == "$root"/* ]] || return 1
  [[ -d "$real_dir" ]] || return 1
  printf '%s\n%s\n' "$rel" "$real_dir"
}

browse_track_enrich_json() {
  local line="$1"
  local path liked_json=false
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] && is_liked "$path" && liked_json=true
  jq -c --argjson liked "$liked_json" '. + {liked:$liked}' <<<"$line"
}

browse_track_json() {
  local path="$1"
  browse_track_enrich_json "$(track_list_cached_json "$path")" | jq -c '. + {type:"track"}'
}

browse_track_art_json() {
  local line="$1"
  local path art
  path="$(jq -r '.path // ""' <<<"$line")"
  [[ -n "$path" && -f "$path" ]] || {
    browse_track_enrich_json "$line"
    return 0
  }
  art="$(art_path_cached "$path")"
  browse_track_enrich_json "$(jq -c --arg art "$art" '.art = $art' <<<"$line")"
}

browse_tracks_cached_lines() {
  local dir="$1"
  local cache="$2"
  jq -r --arg dir "$dir" '
    def child_path($p):
      ($p | ltrimstr($dir + "/")) | test("^[^/]+$");
    [.[] | select(.path | startswith($dir + "/")) | select(child_path(.path)) | . + {type:"track"}]
    | .[] | @json
  ' "$cache"
}

browse_emit_cached_tracks() {
  local dir="$1"
  local cache="$2"
  local -a lines=()
  local line path raw=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    raw=$((raw + 1))
    path="$(jq -r '.path // ""' <<<"$line")"
    [[ -n "$path" && -f "$path" ]] || continue
    lines+=("$line")
  done < <(browse_tracks_cached_lines "$dir" "$cache")
  if (( raw > 0 && ${#lines[@]} < raw )); then
    tracks_cache_prune_missing "$cache" 2>/dev/null || true
  fi
  [[ ${#lines[@]} -gt 0 ]] || return 1

  local i=0 n=${#lines[@]} batch=24 tmpdir out
  tmpdir="$(mktemp -d)"
  for line in "${lines[@]}"; do
    browse_track_art_json "$line" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  for ((i = 0; i < n; i++)); do
    [[ -f "${tmpdir}/${i}.json" ]] || continue
    cat "${tmpdir}/${i}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
  return 0
}

browse_emit_tracks_parallel() {
  local dir="$1"
  local -a files=()
  local entry f i=0 n batch=16 tmpdir

  while IFS= read -r -d '' entry; do
    is_audio "$entry" || continue
    files+=("$entry")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

  n=${#files[@]}
  [[ "$n" -eq 0 ]] && return 0

  tmpdir="$(mktemp -d)"
  for f in "${files[@]}"; do
    browse_track_json "$f" >"${tmpdir}/${i}.json" &
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  local j
  for ((j = 0; j < n; j++)); do
    [[ -f "${tmpdir}/${j}.json" ]] || continue
    cat "${tmpdir}/${j}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
}

browse_emit_tracks_page() {
  local rel="$1" dir="$2" offset="${3:-0}" limit="${4:-50}"
  local genre cache cached=0
  local -a page_items=()
  local total=0 line path i end n batch=24 tmpdir j

  offset="${offset:-0}"
  limit="${limit:-50}"
  genre="${rel%%/*}"
  cache="$(tracks_cache_path "$genre")"
  if [[ -n "$genre" && -f "$cache" && -s "$cache" ]]; then
    cached=1
    local -a lines=()
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      path="$(jq -r '.path // ""' <<<"$line")"
      [[ -n "$path" && -f "$path" ]] || continue
      lines+=("$line")
    done < <(browse_tracks_cached_lines "$dir" "$cache")
    total=${#lines[@]}
    end=$((offset + limit))
    for ((i = offset; i < end && i < total; i++)); do
      page_items+=("${lines[i]}")
    done
  else
    local -a files=()
    local entry
    while IFS= read -r -d '' entry; do
      is_audio "$entry" || continue
      files+=("$entry")
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    total=${#files[@]}
    end=$((offset + limit))
    for ((i = offset; i < end && i < total; i++)); do
      page_items+=("${files[i]}")
    done
  fi

  BROWSE_TRACK_TOTAL="$total"
  [[ ${#page_items[@]} -eq 0 ]] && return 0

  n=${#page_items[@]}
  tmpdir="$(mktemp -d)"
  i=0
  for item in "${page_items[@]}"; do
    if [[ "$cached" -eq 1 ]]; then
      browse_track_art_json "$item" >"${tmpdir}/${i}.json" &
    else
      browse_track_json "$item" >"${tmpdir}/${i}.json" &
    fi
    i=$((i + 1))
    if (( i % batch == 0 )); then
      wait
    fi
  done
  wait
  for ((j = 0; j < n; j++)); do
    [[ -f "${tmpdir}/${j}.json" ]] || continue
    cat "${tmpdir}/${j}.json"
    printf '\n'
  done
  rm -rf "$tmpdir"
  if [[ "$cached" -eq 1 ]]; then
    browse_warm_art_async "$(printf '%s\n' "${page_items[@]}")"
  fi
}

browse_emit_tracks() {
  local rel="$1"
  local dir="$2"
  local genre cache lines

  genre="${rel%%/*}"
  cache="$(tracks_cache_path "$genre")"
  if [[ -n "$genre" && -f "$cache" && -s "$cache" ]]; then
    if browse_emit_cached_tracks "$dir" "$cache"; then
      lines="$(browse_tracks_cached_lines "$dir" "$cache")"
      browse_warm_art_async "$lines"
      return 0
    fi
  fi
  browse_emit_tracks_parallel "$dir"
}

playlist_track_count() {
  local m3u="$1"
  local count=0 line
  [[ -f "$m3u" ]] || { printf '0'; return; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] && count=$((count + 1))
  done <"$m3u"
  printf '%d' "$count"
}

playlist_stars_load() {
  if [[ -f "$PLAYLIST_STARS" ]]; then
    jq -c '.' "$PLAYLIST_STARS" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

playlist_stars_save() {
  local json="$1"
  printf '%s\n' "$json" >"$PLAYLIST_STARS"
}

playlist_stars_migrate() {
  [[ -f "$PLAYLIST_STARS" ]] || return 0
  local json
  json="$(jq -c 'map(if endswith("-fav") then .[0:length-4] else . end) | unique' "$PLAYLIST_STARS" 2>/dev/null || printf '[]')"
  playlist_stars_save "$json"
}

playlist_stars_prune() {
  playlist_stars_migrate
  local stars json kept=() m3u base
  stars="$(playlist_stars_load)"
  for m3u in "$PLAYLIST_DIR"/*.m3u; do
    [[ -f "$m3u" ]] || continue
    base="$(basename "$m3u" .m3u)"
    [[ "$base" == favorites || "$base" == current ]] && continue
    if jq -e --arg n "$base" 'index($n) != null' <<<"$stars" >/dev/null 2>&1; then
      kept+=("$base")
    fi
  done
  if ((${#kept[@]} > 0)); then
    json="$(printf '%s\n' "${kept[@]}" | jq -R . | jq -sc .)"
  else
    json='[]'
  fi
  playlist_stars_save "$json"
}

playlist_is_starred() {
  local name="$1"
  jq -e --arg n "$name" 'index($n) != null' <<<"$(playlist_stars_load)" >/dev/null 2>&1
}

playlist_kind() {
  local name="$1"
  case "$name" in
    all|favorites) printf 'system' ;;
    *)
      if [[ -d "${MUSIC_ROOT}/${name}" ]]; then
        printf 'fav'
      else
        printf 'other'
      fi
      ;;
  esac
}

playlist_emit_tracks_json() {
  local list="$1"
  local first=1 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\r'/}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ -f "$line" ]] || continue
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    track_list_cached_json "$line"
  done <"$list"
}

cmd_playlist_star_toggle() {
  local name="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  [[ -n "$name" ]] || { echo "evo-player: playlist name required" >&2; return 1; }
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-player: unknown playlist: $name" >&2; return 1; }
  local stars starred=false
  stars="$(playlist_stars_load)"
  if playlist_is_starred "$name"; then
    stars="$(jq -c --arg n "$name" 'map(select(. != $n))' <<<"$stars")"
    starred=false
  else
    stars="$(jq -c --arg n "$name" '. + [$n] | unique' <<<"$stars")"
    starred=true
  fi
  playlist_stars_save "$stars"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg name "$name" \
      --argjson starred "$starred" \
      --argjson stars "$stars" \
      '{name:$name,starred:$starred,stars:$stars}'
  elif [[ "$starred" == true ]]; then
    printf 'starred %s\n' "$name"
  else
    printf 'unstarred %s\n' "$name"
  fi
}

cmd_playlist_star() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    toggle) cmd_playlist_star_toggle "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown playlist star command: $sub" >&2; usage ;;
  esac
}

browse_subdirs() {
  local rel="$1"
  local dir="$2"
  local entry name
  if [[ -z "$rel" ]]; then
    list_genres
    return 0
  fi
  while IFS= read -r -d '' entry; do
    [[ -d "$entry" ]] || continue
    name="$(basename "$entry")"
    skip_dir "$name" && continue
    printf '%s\n' "${rel}/${name}"
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
}

browse_collect_queue_tracks() {
  local rel="${1:-}"
  local resolved dir line had_direct=0 sub_rel
  resolved="$(browse_resolve "$rel")" || return 1
  rel="$(sed -n '1p' <<<"$resolved")"
  dir="$(sed -n '2p' <<<"$resolved")"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    had_direct=1
    printf '%s\n' "$line"
  done < <(browse_emit_tracks "$rel" "$dir" | sed '/^$/d')
  [[ "$had_direct" -eq 1 ]] && return 0
  while IFS= read -r sub_rel; do
    [[ -n "$sub_rel" ]] || continue
    browse_collect_queue_tracks "$sub_rel"
  done < <(browse_subdirs "$rel" "$dir")
}

cmd_browse() {
  local rel="" json=0 queue=0 offset="" limit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --queue) queue=1 ;;
      --offset)
        offset="$2"
        shift
        ;;
      --limit)
        limit="$2"
        shift
        ;;
      *) rel="$1" ;;
    esac
    shift
  done
  ensure_dirs
  local resolved dir parent name
  resolved="$(browse_resolve "$rel")" || { echo "evo-player: invalid browse path: $rel" >&2; return 1; }
  rel="$(sed -n '1p' <<<"$resolved")"
  dir="$(sed -n '2p' <<<"$resolved")"
  if [[ -z "$rel" ]]; then
    parent=""
  elif [[ "$rel" == */* ]]; then
    parent="${rel%/*}"
  else
    parent=""
  fi
  if [[ "$queue" -eq 1 && "$json" -eq 1 ]]; then
    printf '{'
    printf '"path":"%s",' "$(json_escape "$rel")"
    if [[ -z "$rel" ]]; then
      printf '"parent":null,'
    else
      printf '"parent":"%s",' "$(json_escape "$parent")"
    fi
    printf '"tracks":['
    local first=1 track_line
    while IFS= read -r track_line; do
      [[ -n "$track_line" ]] || continue
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '%s' "$track_line"
    done < <(browse_collect_queue_tracks "$rel")
    printf ']}\n'
    return 0
  fi
  if [[ "$json" -eq 1 ]]; then
    printf '{'
    printf '"path":"%s",' "$(json_escape "$rel")"
    if [[ -z "$rel" ]]; then
      printf '"parent":null,'
    else
      printf '"parent":"%s",' "$(json_escape "$parent")"
    fi
    printf '"entries":['
    local first=1 entry sub name count
    if [[ -z "$rel" ]]; then
      while IFS= read -r name; do
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        count="$(genre_track_count_cached "$name")"
        printf '{"type":"dir","name":"%s","path":"%s","count":%s}' \
          "$(json_escape "$name")" "$(json_escape "$name")" "$count"
      done < <(list_genres)
      printf ']}\n'
    else
      local track_offset="${offset:-0}"
      local track_limit="${limit:-50}"
      local paginate=0 track_total=0
      [[ -n "$offset" || -n "$limit" ]] && paginate=1
      if [[ "$track_offset" -eq 0 ]]; then
        while IFS= read -r -d '' entry; do
          [[ -d "$entry" ]] || continue
          name="$(basename "$entry")"
          [[ "$first" -eq 1 ]] || printf ','
          first=0
          printf '{"type":"dir","name":"%s","path":"%s"}' \
            "$(json_escape "$name")" "$(json_escape "${rel}/${name}")"
        done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
      fi
      if [[ "$paginate" -eq 1 ]]; then
        local page_tmp
        page_tmp="$(mktemp)"
        browse_emit_tracks_page "$rel" "$dir" "$track_offset" "$track_limit" >"$page_tmp"
        track_total="${BROWSE_TRACK_TOTAL:-0}"
        while IFS= read -r track_line; do
          [[ -n "$track_line" ]] || continue
          [[ "$first" -eq 1 ]] || printf ','
          first=0
          printf '%s' "$track_line"
        done < <(sed '/^$/d' "$page_tmp")
        rm -f "$page_tmp"
        track_total="${BROWSE_TRACK_TOTAL:-0}"
        printf '],"trackTotal":%s,"trackOffset":%s,"trackLimit":%s}\n' \
          "$track_total" "$track_offset" "$track_limit"
      else
        while IFS= read -r track_line; do
          [[ -n "$track_line" ]] || continue
          [[ "$first" -eq 1 ]] || printf ','
          first=0
          printf '%s' "$track_line"
        done < <(browse_emit_tracks "$rel" "$dir" | sed '/^$/d')
        printf ']}\n'
      fi
    fi
  else
    if [[ -z "$rel" ]]; then
      list_genres
    else
      find "$dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) | sort
    fi
  fi
}

cmd_playlist() {
  local name="" json=0 offset="" limit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --offset)
        offset="$2"
        shift
        ;;
      --limit)
        limit="$2"
        shift
        ;;
      *) name="$1" ;;
    esac
    shift
  done
  ensure_dirs
  if [[ -z "$name" ]]; then
    playlist_stars_prune
    if [[ "$json" -eq 1 ]]; then
      printf '['
      local first=1 m3u base count kind starred_json
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        base="$(basename "$m3u" .m3u)"
        [[ "$base" == favorites || "$base" == current ]] && continue
        count="$(playlist_track_count "$m3u")"
        kind="$(playlist_kind "$base")"
        if playlist_is_starred "$base"; then
          starred_json=true
        else
          starred_json=false
        fi
        [[ "$first" -eq 1 ]] || printf ','
        first=0
        printf '{"name":"%s","count":%s,"kind":"%s","starred":%s}' \
          "$(json_escape "$base")" "$count" "$kind" "$starred_json"
      done
      printf ']\n'
    else
      local m3u base
      for m3u in "$PLAYLIST_DIR"/*.m3u; do
        [[ -f "$m3u" ]] || continue
        base="$(basename "$m3u" .m3u)"
        [[ "$base" == favorites || "$base" == current ]] && continue
        basename "$m3u" .m3u
      done | sort
    fi
    return 0
  fi
  local list="${PLAYLIST_DIR}/${name}.m3u"
  [[ -f "$list" ]] || { echo "evo-player: unknown playlist: $name" >&2; return 1; }
  if [[ "$json" -eq 1 ]]; then
    if [[ -n "$offset" || -n "$limit" ]]; then
      playlist_emit_tracks_page "$list" "${offset:-0}" "${limit:-50}"
    else
      printf '['
      playlist_emit_tracks_json "$list"
      printf ']\n'
    fi
  else
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//$'\r'/}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ -f "$line" ]] && printf '%s\n' "$line"
    done <"$list"
  fi
}

mixes_refresh_playlists() {
  local genre
  write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
  rm -f "${PLAYLIST_DIR}/favorites.m3u"
  shift
  for genre in "$@"; do
    [[ -n "$genre" ]] || continue
    write_playlist "$genre"
    tracks_cache_invalidate_genre "$genre"
  done
  tracks_cache_invalidate_genre "mixes"
}

cmd_mixes_migrate() {
  local dry_run=0 json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --json) json=1 ;;
      *) usage ;;
    esac
    shift
  done
  ensure_dirs
  likes_init
  local mixes_dir="${MUSIC_ROOT}/mixes"
  if [[ ! -d "$mixes_dir" ]]; then
    echo "evo-player: mixes directory not found (already migrated)" >&2
    return 0
  fi

  local -a files=()
  local f
  while IFS= read -r -d '' f; do
    is_audio "$f" && files+=("$f")
  done < <(find "$mixes_dir" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "evo-player: no audio files in mixes" >&2
    if [[ $dry_run -eq 0 ]]; then
      rmdir "$mixes_dir" 2>/dev/null || true
      mixes_refresh_playlists
    fi
    return 0
  fi

  local path tag genre status failed=0
  local -a touched_genres=()
  if [[ "$json" -eq 1 ]]; then
    printf '['
  fi
  local first=1
  for path in "${files[@]}"; do
    tag="$(ffprobe_meta "$path" genre)"
    if mixes_override_genre "$path" >/dev/null; then
      genre="$(mixes_override_genre "$path")"
      status="override"
    elif genre="$(genre_tag_to_folder "$tag")"; then
      status="auto"
    else
      echo "evo-player: cannot resolve genre for $(basename "$path") (tag: ${tag:-empty})" >&2
      failed=1
      continue
    fi
    if [[ "$json" -eq 1 ]]; then
      [[ "$first" -eq 1 ]] || printf ','
      first=0
      printf '{"path":"%s","tag":"%s","genre":"%s","status":"%s"}' \
        "$(json_escape "$path")" "$(json_escape "$tag")" "$(json_escape "$genre")" "$status"
    elif [[ $dry_run -eq 1 ]]; then
      printf '%s -> %s (%s)\n' "$(basename "$path")" "$genre" "$status"
    fi

    if [[ $dry_run -eq 1 ]]; then
      continue
    fi

    likes_add "$path"
    if ! tag_set_metadata "$path" genre "$genre"; then
      echo "evo-player: tag update failed for $(basename "$path")" >&2
      failed=1
      continue
    fi
    touched_genres+=("$genre")
    if [[ $json -eq 0 ]]; then
      printf 'tagged %s -> %s\n' "$(basename "$path")" "$genre"
    fi
  done
  if [[ "$json" -eq 1 ]]; then
    printf ']\n'
  fi

  if [[ $dry_run -eq 1 ]]; then
    return 0
  fi

  [[ $failed -eq 0 ]] || return 1

  mixes_refresh_playlists "${touched_genres[@]}"

  if [[ -z "$(find "$mixes_dir" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    rmdir "$mixes_dir" 2>/dev/null || true
    echo "evo-player: removed empty mixes directory" >&2
  fi
}

cmd_mixes() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    migrate) cmd_mixes_migrate "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown mixes command: $sub" >&2; usage ;;
  esac
}

cmd_favorite_toggle() {
  local path="$1"
  local json="${2:-}"
  [[ -f "$path" ]] || { echo "evo-player: not a file: $path" >&2; return 1; }
  ensure_dirs
  likes_init
  local title artist now liked
  now="$(date -Iseconds)"
  title="$(jq -r --arg p "$path" '.[$p].title // empty' "$LIKES_FILE" 2>/dev/null || true)"
  artist="$(jq -r --arg p "$path" '.[$p].artist // empty' "$LIKES_FILE" 2>/dev/null || true)"
  [[ -z "$title" ]] && title="$(basename "${path%.*}")"
  if is_liked "$path"; then
    liked=false
    jq --arg p "$path" 'del(.[$p])' "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  else
    liked=true
    jq --arg p "$path" --arg title "$title" --arg artist "$artist" --arg at "$now" \
      '.[$p] = {title:$title, artist:$artist, liked_at:$at}' \
      "$LIKES_FILE" >"${LIKES_FILE}.tmp" && mv "${LIKES_FILE}.tmp" "$LIKES_FILE"
  fi
  if [[ "$json" == --json ]]; then
    jq -nc --arg path "$path" --argjson liked "$([[ $liked == true ]] && echo true || echo false)" \
      '{path:$path,liked:$liked}'
  elif [[ "$liked" == true ]]; then
    printf 'liked\n'
  else
    printf 'unliked\n'
  fi
}

cmd_art_search() {
  local path="" json=0 query=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --query)
        shift
        query="${1:-}"
        ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) path="$1" ;;
    esac
    shift
  done
  load_evoshell_secrets
  if [[ -n "$query" ]]; then
    local args=(--query "$query")
    [[ "$json" -eq 1 ]] && args+=(--json)
    "${EVOSHELL_BIN}/evo-player-art-search" "${args[@]}"
    return 0
  fi
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  is_audio "$path" || {
    echo "evo-player: not an audio file: $path" >&2
    return 1
  }
  local args=("$path")
  [[ "$json" -eq 1 ]] && args+=(--json)
  "${EVOSHELL_BIN}/evo-player-art-search" "${args[@]}"
}

cmd_art_clear() {
  local path="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) path="$1" ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  local track_art folder
  track_art="$(art_path_legacy "$path")"
  folder="$(art_path_folder "$path")"
  if [[ -n "$track_art" && -f "$track_art" && "$track_art" != "$folder" ]]; then
    rm -f "$track_art"
  elif [[ -n "$folder" && -f "$folder" ]]; then
    rm -f "$folder"
  fi
  folder="$(art_path_folder "$path")"
  if [[ -n "$folder" && -f "$folder" ]]; then
    art_dirty_mark "$path" "track" || true
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n --arg path "$path" '{ok:true,path:$path}'
  else
    printf 'cleared %s\n' "$path"
  fi
}

cmd_find() {
  local mode="search" query="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --artist) mode="artist"; shift; query="$1"; continue ;;
      --genre) mode="genre"; shift; query="$1"; continue ;;
      --year) mode="year"; shift; query="$1"; continue ;;
      --album) mode="album"; shift; query="$1"; continue ;;
      --label) mode="label"; shift; query="$1"; continue ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *) query="$1" ;;
    esac
    shift
  done
  [[ -n "$query" ]] || { echo "evo-player: find query required" >&2; return 1; }
  ensure_dirs
  TRACKS_CACHE_DIR="$TRACKS_CACHE_DIR" MUSIC_ROOT="$MUSIC_ROOT" \
    python3 - "$mode" "$query" "$json" <<'PY'
import glob, json, os, sys

mode, query, json_mode = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
cache_dir = os.environ["TRACKS_CACHE_DIR"]
needle = query.casefold()
out = []
seen = set()

def match(item):
    if mode == "artist":
        return needle in str(item.get("artist") or "").casefold()
    if mode == "album":
        return needle in str(item.get("album") or "").casefold()
    if mode == "label":
        return needle in str(item.get("label") or "").casefold()
    if mode == "genre":
        return needle in str(item.get("genre") or "").casefold()
    if mode == "year":
        return str(item.get("year") or "") == query
    hay = " ".join([
        str(item.get("title") or ""),
        str(item.get("artist") or ""),
        str(item.get("album") or ""),
        str(item.get("genre") or ""),
        str(item.get("year") or ""),
        str(item.get("label") or ""),
    ]).casefold()
    return needle in hay

for cache in sorted(glob.glob(os.path.join(cache_dir, "*.tags.json"))):
    try:
        with open(cache, encoding="utf-8") as fh:
            items = json.load(fh)
    except Exception:
        continue
    if not isinstance(items, list):
        continue
    for item in items:
        path = item.get("path")
        if not path or path in seen:
            continue
        if not match(item):
            continue
        seen.add(path)
        out.append(item)

if json_mode:
    print(json.dumps(out, ensure_ascii=False))
else:
    for item in out:
        print(item.get("path") or "")
PY
}

lastfm_session_save() {
  local session="$1"
  local secrets="${EVOSHELL_SECRETS:-${HOME}/.local/share/evoshell/secrets.env}"
  [[ -n "$session" && -f "$secrets" ]] || return 1
  if grep -q '^LASTFM_SESSION_KEY=' "$secrets" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    sed "s/^LASTFM_SESSION_KEY=.*/LASTFM_SESSION_KEY=${session}/" "$secrets" >"$tmp" && mv "$tmp" "$secrets"
  else
    printf '\nLASTFM_SESSION_KEY=%s\n' "$session" >>"$secrets"
  fi
}

cmd_scrobble() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    auth) cmd_scrobble_auth "$@" ;;
    token) cmd_scrobble_token "$@" ;;
    nowplaying) cmd_scrobble_nowplaying "$@" ;;
    submit) cmd_scrobble_submit "$@" ;;
    recent) cmd_scrobble_recent "$@" ;;
    touch) cmd_scrobble_touch "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown scrobble command: $sub" >&2; usage ;;
  esac
}

cmd_scrobble_auth() {
  load_evoshell_secrets
  local api_key="${LASTFM_API_KEY:-}"
  local secret="${LASTFM_API_SECRET:-}"
  [[ -n "$api_key" && -n "$secret" ]] || {
    echo "evo-player: set LASTFM_API_KEY and LASTFM_API_SECRET in ~/.local/share/evoshell/secrets.env" >&2
    echo "evo-player: create an app at https://www.last.fm/api/account/create (callback: http://localhost)" >&2
    return 1
  }
  if [[ -n "${LASTFM_SESSION_KEY:-}" ]]; then
    echo "evo-player: LASTFM_SESSION_KEY already set in secrets.env"
    return 0
  fi
  local url="https://www.last.fm/api/auth/?api_key=${api_key}&cb=http%3A%2F%2Flocalhost"
  echo "open: $url"
  echo "after approving, copy the token from the redirect URL and run:"
  echo "  evo-player scrobble token <token>"
  command -v xdg-open >/dev/null 2>&1 && xdg-open "$url" >/dev/null 2>&1 || true
}

cmd_scrobble_token() {
  local token="${1:-}"
  load_evoshell_secrets
  local api_key="${LASTFM_API_KEY:-}"
  local secret="${LASTFM_API_SECRET:-}"
  [[ -n "$token" && -n "$api_key" && -n "$secret" ]] || {
    echo "evo-player: usage: evo-player scrobble token <token>" >&2
    return 1
  }
  local session
  session="$(
    python3 - "$api_key" "$secret" "$token" <<'PY'
import hashlib, json, sys, urllib.parse, urllib.request

api_key, secret, token = sys.argv[1:4]
sig = hashlib.md5(
    f"api_key{api_key}methodauth.getSessiontoken{token}{secret}".encode()
).hexdigest()
data = urllib.parse.urlencode({
    "method": "auth.getSession",
    "api_key": api_key,
    "token": token,
    "api_sig": sig,
    "format": "json",
}).encode()
with urllib.request.urlopen("https://ws.audioscrobbler.com/2.0/", data=data, timeout=20) as resp:
    payload = json.load(resp)
session = ((payload.get("session") or {}).get("key") or "")
if not session:
    err = (payload.get("error") or payload.get("message") or "auth failed")
    raise SystemExit(f"evo-player: {err}")
print(session)
PY
  )" || return 1
  lastfm_session_save "$session" || {
    echo "evo-player: got session key but could not write secrets.env" >&2
    echo "$session"
    return 1
  }
  echo "evo-player: saved LASTFM_SESSION_KEY to secrets.env"
}

cmd_scrobble_nowplaying() {
  load_evoshell_secrets
  local path artist title album album_artist duration tags
  path="$(mpv_prop path 2>/dev/null || true)"
  [[ -n "$path" && -f "$path" ]] || return 0
  tags="$(track_tags_read "$path")"
  artist="$(jq -r '.artist // ""' <<<"$tags")"
  title="$(jq -r '.title // ""' <<<"$tags")"
  album="$(jq -r '.album // ""' <<<"$tags")"
  album_artist="$(jq -r '.album_artist // ""' <<<"$tags")"
  duration="$(mpv_prop duration 2>/dev/null || echo 0)"
  [[ -n "$artist" && -n "$title" ]] || return 0
  scrobble_api_call "track.updateNowPlaying" "$artist" "$title" "$album" "$duration" "" "$album_artist" ""
  scrobble_record_entry "$path" "nowplaying"
}

cmd_scrobble_submit() {
  load_evoshell_secrets
  local path artist title album album_artist duration started="" mbid tags pos
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --started)
        started="$2"
        shift 2
        ;;
      *) shift ;;
    esac
  done
  path="$(mpv_prop path 2>/dev/null || true)"
  [[ -n "$path" && -f "$path" ]] || return 0
  tags="$(track_tags_read "$path")"
  artist="$(jq -r '.artist // ""' <<<"$tags")"
  title="$(jq -r '.title // ""' <<<"$tags")"
  album="$(jq -r '.album // ""' <<<"$tags")"
  album_artist="$(jq -r '.album_artist // ""' <<<"$tags")"
  duration="$(mpv_prop duration 2>/dev/null || echo 0)"
  if [[ -z "$started" ]]; then
    pos="$(mpv_prop time-pos 2>/dev/null || echo 0)"
    started="$(($(date +%s) - ${pos%.*}))"
  fi
  [[ -n "$artist" && -n "$title" ]] || return 0
  mbid="$(scrobble_recording_mbid "$artist" "$title" "$album" 2>/dev/null || true)"
  scrobble_api_call "track.scrobble" "$artist" "$title" "$album" "$duration" "$started" "$album_artist" "$mbid" || return 1
  scrobble_record_entry "$path" "submit"
}

cmd_scrobble_touch() {
  local path
  path="$(mpv_prop path 2>/dev/null || true)"
  [[ -n "$path" && -f "$path" ]] || return 0
  scrobble_record_entry "$path" "nowplaying"
}

cmd_scrobble_recent() {
  local json="" limit=12
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --limit)
        limit="${2:-12}"
        shift 2
        ;;
      *) shift ;;
    esac
  done
  local out
  out="$(scrobble_recent_json "$limit")"
  if [[ -n "$json" ]]; then
    printf '%s\n' "$out"
  else
    jq -r '.[] | "\(.artist) — \(.title)"' <<<"$out"
  fi
}

scrobble_api_call() {
  local method="$1" artist="$2" title="$3" album="$4" duration="${5:-0}" timestamp="${6:-}" album_artist="${7:-}" mbid="${8:-}"
  local api_key="${LASTFM_API_KEY:-}"
  local secret="${LASTFM_API_SECRET:-}"
  local session="${LASTFM_SESSION_KEY:-}"
  [[ -n "$api_key" && -n "$secret" && -n "$session" ]] || {
    echo "evo-player: last.fm credentials missing in secrets.env" >&2
    return 1
  }
  python3 - "$method" "$api_key" "$secret" "$session" "$artist" "$title" "$album" "$duration" "$timestamp" "$album_artist" "$mbid" <<'PY'
import hashlib, json, sys, urllib.parse, urllib.request

method, api_key, secret, session, artist, title, album, duration, timestamp, album_artist, mbid = sys.argv[1:12]
params = {
    "method": method,
    "api_key": api_key,
    "sk": session,
    "artist": artist,
    "track": title,
}
if album:
    params["album"] = album
if album_artist and album_artist != artist:
    params["albumArtist"] = album_artist
if duration and float(duration) > 0:
    params["duration"] = str(int(float(duration)))
if timestamp:
    params["timestamp"] = str(int(timestamp))
if mbid:
    params["mbid"] = mbid
if method == "track.scrobble":
    params["chosenByUser"] = "1"
sig_src = "".join(f"{k}{params[k]}" for k in sorted(params)) + secret
params["api_sig"] = hashlib.md5(sig_src.encode()).hexdigest()
params["format"] = "json"
data = urllib.parse.urlencode(params).encode()
req = urllib.request.Request("https://ws.audioscrobbler.com/2.0/", data=data)
try:
    with urllib.request.urlopen(req, timeout=20) as resp:
        body = json.load(resp)
except Exception as exc:
    print(f"evo-player: last.fm request failed: {exc}", file=sys.stderr)
    raise SystemExit(1)
if isinstance(body, dict) and body.get("error"):
    print(f"evo-player: last.fm error {body.get('error')}: {body.get('message', '')}", file=sys.stderr)
    raise SystemExit(1)
if method == "track.scrobble":
    scrobbles = ((body.get("scrobbles") or {}).get("scrobble") or [])
    if isinstance(scrobbles, dict):
        scrobbles = [scrobbles]
    for row in scrobbles:
        if row.get("@attr", {}).get("ignoredMessage"):
            print(f"evo-player: last.fm ignored scrobble: {row['@attr']['ignoredMessage']}", file=sys.stderr)
            raise SystemExit(1)
PY
}

cmd_art_set() {
  local path="" image="" json=0 scope="track"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --album) scope="album" ;;
      --track) scope="track" ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"
        elif [[ -z "$image" ]]; then
          image="$1"
        else
          usage
        fi
        ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  [[ -n "$image" && -f "$image" ]] || {
    echo "evo-player: not a file: ${image:-<missing>}" >&2
    return 1
  }
  local art track_art folder content
  art="$(art_install_image "$path" "$image" "$scope")" || {
    echo "evo-player: could not install art" >&2
    return 1
  }
  track_art="$(art_path_legacy "$path")"
  folder="$(art_path_folder "$path")"
  content="$(readlink -f "$art" 2>/dev/null || printf '%s' "$art")"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg art "$art" \
      --arg track "$track_art" \
      --arg folder "$folder" \
      --arg content "$content" \
      --arg scope "$scope" \
      '{art:$art,track:$track,folder:$folder,content:$content,scope:$scope}'
  else
    printf '%s\n' "$art"
  fi
}

cmd_art_apply() {
  local path="" url="" json=0 scope="track"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      --album) scope="album" ;;
      --track) scope="track" ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"
        elif [[ -z "$url" ]]; then
          url="$1"
        else
          usage
        fi
        ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  [[ -n "$url" ]] || usage
  local tmp art track_art folder content
  tmp="$(mktemp "${ART_DIR}/.fetch.XXXXXX.jpg")"
  if ! curl -fsSL --max-time 30 -o "$tmp" "$url"; then
    rm -f "$tmp"
    echo "evo-player: could not download art" >&2
    return 1
  fi
  art="$(art_install_image "$path" "$tmp" "$scope")" || {
    rm -f "$tmp"
    echo "evo-player: could not install art" >&2
    return 1
  }
  rm -f "$tmp"
  track_art="$(art_path_legacy "$path")"
  folder="$(art_path_folder "$path")"
  content="$(readlink -f "$art" 2>/dev/null || printf '%s' "$art")"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg art "$art" \
      --arg track "$track_art" \
      --arg folder "$folder" \
      --arg content "$content" \
      --arg scope "$scope" \
      '{art:$art,track:$track,folder:$folder,content:$content,scope:$scope}'
  else
    printf '%s\n' "$art"
  fi
}

cmd_art_embed_impl() {
  echo "evo-player: embed art started at $(date -Iseconds)" >&2
  ensure_dirs
  local snapshot dirs_json tracks_json dir_count=0 track_count=0
  local row key at art status emb fail skip
  local embedded=0 failed=0 skipped=0 folders=0 tracks=0
  snapshot="$(art_dirty_snapshot)"
  dirs_json="$(jq -c '.dirs // {}' <<<"$snapshot")"
  tracks_json="$(jq -c '.tracks // {}' <<<"$snapshot")"
  dir_count="$(jq 'length' <<<"$dirs_json")"
  track_count="$(jq 'length' <<<"$tracks_json")"
  echo "evo-player: ${dir_count} dirty folder(s), ${track_count} dirty track(s)" >&2
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    key="$(jq -r '.key // ""' <<<"$row")"
    at="$(jq -r '.at // ""' <<<"$row")"
    [[ -n "$key" && -d "$key" ]] || {
      art_dirty_clear_if dirs "$key" "$at"
      continue
    }
    read -r emb fail skip < <(art_embed_folder "$key")
    embedded=$((embedded + emb))
    failed=$((failed + fail))
    skipped=$((skipped + skip))
    folders=$((folders + 1))
    if [[ "$fail" -eq 0 ]]; then
      art_dirty_clear_if dirs "$key" "$at"
    fi
    echo "evo-player: art folder ${folders}/${dir_count} (${embedded} embedded, ${skipped} unchanged, ${failed} failed)" >&2
  done < <(jq -c 'to_entries[] | {key:.key, at:(.value.at // "")}' <<<"$dirs_json")
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    key="$(jq -r '.key // ""' <<<"$row")"
    at="$(jq -r '.at // ""' <<<"$row")"
    [[ -n "$key" && -f "$key" ]] || {
      art_dirty_clear_if tracks "$key" "$at"
      continue
    }
    is_audio "$key" || {
      art_dirty_clear_if tracks "$key" "$at"
      continue
    }
    art="$(art_path_cached "$key")"
    if [[ -z "$art" || ! -f "$art" ]]; then
      art_dirty_clear_if tracks "$key" "$at"
      continue
    fi
    status=0
    art_embed_audio "$key" "$art" || status=$?
    tracks=$((tracks + 1))
    if [[ "$status" -eq 0 ]]; then
      embedded=$((embedded + 1))
      art_dirty_clear_if tracks "$key" "$at"
    elif [[ "$status" -eq 2 ]]; then
      skipped=$((skipped + 1))
      art_dirty_clear_if tracks "$key" "$at"
    else
      failed=$((failed + 1))
    fi
  done < <(jq -c 'to_entries[] | {key:.key, at:(.value.at // "")}' <<<"$tracks_json")
  echo "evo-player: embed art complete — ${folders} folders, ${tracks} tracks, ${embedded} embedded, ${skipped} unchanged, ${failed} failed" >&2
}

cmd_art_maintain_impl() {
  echo "evo-player: fix art started at $(date -Iseconds)" >&2
  ensure_dirs
  cmd_art_embed_impl
  echo "evo-player: fix art complete at $(date -Iseconds)" >&2
}

cmd_art_maintain() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      -h|--help|help) usage ;;
      -*) usage ;;
    esac
    shift
  done
  run_exclusive_job art-maintain "fix art" cmd_art_maintain_impl
}

cmd_art_embed() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) ;;
      -h|--help|help) usage ;;
      -*) usage ;;
    esac
    shift
  done
  run_exclusive_job art-embed "embed art" cmd_art_embed_impl
}

cmd_art_notify_cache() {
  local path="${1:-}"
  [[ -f "$path" ]] || {
    echo "evo-player: not a file: ${path:-<missing>}" >&2
    return 1
  }
  art_notify_cache "$path"
}

cmd_art() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    search) cmd_art_search "$@" ;;
    set) cmd_art_set "$@" ;;
    apply) cmd_art_apply "$@" ;;
    clear) cmd_art_clear "$@" ;;
    embed) cmd_art_embed "$@" ;;
    maintain) cmd_art_maintain "$@" ;;
    notify-cache) cmd_art_notify_cache "$@" ;;
    *) usage ;;
  esac
}

cmd_status() {
  local json="${1:-}"
  ensure_dirs
  local genres=0 tracks=0 g
  while IFS= read -r g; do
    genres=$((genres + 1))
    tracks=$((tracks + $(genre_track_count_cached "$g")))
  done < <(list_genres)
  if [[ "$json" == --json ]]; then
    jq -n --arg root "$MUSIC_ROOT" --argjson genres "$genres" --argjson tracks "$tracks" \
      '{root:$root,genres:$genres,tracks:$tracks}'
  else
    printf 'root: %s\ngenres: %d\ntracks: %d\n' "$MUSIC_ROOT" "$genres" "$tracks"
  fi
}

queue_relocate_path() {
  local old="$1" new="$2"
  [[ -f "$CURRENT_M3U" ]] || return 0
  if ! grep -qxF "$old" "$CURRENT_M3U" 2>/dev/null; then
    return 0
  fi
  local -a paths=()
  local p
  while IFS= read -r p || [[ -n "$p" ]]; do
    p="${p//$'\r'/}"
    [[ -z "$p" || "$p" == \#* ]] && continue
    if [[ "$p" == "$old" ]]; then
      p="$new"
    fi
    paths+=("$p")
  done <"$CURRENT_M3U"
  queue_save "${paths[@]}"
}

cmd_tag_set_title() {
  local path="" value="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1 ;;
      -h|--help|help) usage ;;
      -*) usage ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"
        else
          value="$1"
        fi
        ;;
    esac
    shift
  done
  [[ -n "$path" && -f "$path" && -n "$value" ]] || {
    echo "evo-player: tag set title requires path and value" >&2
    return 1
  }
  ensure_dirs
  local old_path="$path" new_path="" renamed=0 playing=0 pos=0 paused=false cur="" genre=""
  if mpv_running; then
    cur="$(mpv_prop path 2>/dev/null || true)"
    if paths_equal "$cur" "$old_path"; then
      playing=1
      pos="$(mpv_prop time-pos 2>/dev/null || echo 0)"
      paused="$(mpv_prop pause 2>/dev/null || echo false)"
    fi
  fi
  new_path="$(track_set_title "$path" "$value")" || {
    echo "evo-player: could not set title for $(basename "$path")" >&2
    return 1
  }
  paths_equal "$old_path" "$new_path" || renamed=1
  if [[ "$playing" -eq 1 ]]; then
    mpv_load_file "$new_path" replace
    mpv_ipc "{\"command\":[\"seek\",${pos},\"absolute\"]}" >/dev/null
    [[ "$paused" == "true" ]] && mpv_ipc '{"command":["set_property","pause",true]}' >/dev/null
  fi
  queue_relocate_path "$old_path" "$new_path"
  player_save_state "$new_path"
  if is_liked "$new_path"; then
    write_likes_m3u "${PLAYLIST_DIR}/all.m3u"
    genre="$(genre_from_path "$new_path")"
    [[ -n "$genre" ]] && write_playlist "$genre"
  fi
  value="$(ffprobe_meta "$new_path" title)"
  [[ -z "$value" ]] && value="$(basename "${new_path%.*}")"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
      --arg path "$new_path" \
      --arg title "$value" \
      --argjson ok true \
      --argjson renamed "$([[ $renamed -eq 1 ]] && echo true || echo false)" \
      '{ok:$ok,path:$path,title:$title,renamed:$renamed}'
  else
    printf '%s\n' "$new_path"
  fi
}

cmd_tag_set() {
  local field="${1:-}"
  shift || true
  case "$field" in
    title) cmd_tag_set_title "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown tag field: $field" >&2; usage ;;
  esac
}

cmd_tag() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    set) cmd_tag_set "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "evo-player: unknown tag command: $sub" >&2; usage ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    start) cmd_player_start ;;
    load) cmd_player_load "$@" ;;
    queue) cmd_player_queue "$@" ;;
    current) cmd_current "$@" ;;
    prioritize) cmd_player_prioritize "$@" ;;
    play) cmd_player_play "${1:-all}" ;;
    toggle) cmd_player_toggle ;;
    next) cmd_player_next ;;
    prev) cmd_player_prev ;;
    seek) cmd_player_seek "${1:-0}" ;;
    shuffle) cmd_player_shuffle "${1:-toggle}" ;;
    volume) cmd_player_volume "${1:-0}" "${2:-}" ;;
    save) cmd_player_save ;;
    close) cmd_player_close ;;
    stop) cmd_player_stop ;;
    open) cmd_player_open "${1:---json}" ;;
    restore) cmd_player_restore "${1:---json}" ;;
    resume) cmd_player_resume "${1:---json}" ;;
    status) cmd_player_status "${1:---json}" ;;
    soundcloud) cmd_soundcloud ;;
    sync) cmd_sync ;;
    import) cmd_import ;;
    playlists) cmd_playlists "$@" ;;
    build) cmd_build "$@" ;;
    warm) cmd_warm "$@" ;;
    sort) cmd_sort "$@" ;;
    config) cmd_config "$@" ;;
    cache) cmd_cache "$@" ;;
    job)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        status) cmd_job_status "${1:-}" ;;
        stop) cmd_job_stop "${1:-}" ;;
        *) usage ;;
      esac
      ;;
    genres) cmd_genres "$@" ;;
    tracks) cmd_tracks "$@" ;;
    browse) cmd_browse "$@" ;;
    playlist)
      if [[ "${1:-}" == "star" ]]; then
        shift
        cmd_playlist_star "$@"
      else
        cmd_playlist "$@"
      fi
      ;;
    mixes) cmd_mixes "$@" ;;
    favorite)
      [[ "${1:-}" == toggle ]] || usage
      shift
      cmd_favorite_toggle "${1:-}" "${2:-}"
      ;;
    tag) cmd_tag "$@" ;;
    stats) cmd_status "$@" ;;
    art) cmd_art "$@" ;;
    find) cmd_find "$@" ;;
    scrobble) cmd_scrobble "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "evo-player: unknown command: $cmd" >&2
      usage
      ;;
  esac
}

main "$@"
