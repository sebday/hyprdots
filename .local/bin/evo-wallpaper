#!/usr/bin/env bash
# Cycle or set wallpaper through evoshell background plugin.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IPC="${SCRIPT_DIR}/evo-ipc"

cmd="${1:-next}"

case "$cmd" in
    next|prev)
        exec "$IPC" evo.wallpaper "$cmd"
        ;;
    set)
        [[ -n "${2:-}" ]] && exec "$IPC" evo.wallpaper set "$2"
        exit 1
        ;;
    *)
        echo "Usage: $0 [next|prev|set <path>]" >&2
        exit 1
        ;;
esac
