#!/usr/bin/env bash
# Toggle evo.panel.player dashboard (tiled on HDMI-A-1 via hypr rules + evo-panel-hypr).

set -euo pipefail

IPC="${HOME}/.local/bin/evo-ipc shell"
HYPR_PIN="${HOME}/.local/bin/evo-panel-hypr"

usage() {
	cat >&2 <<'EOF'
usage: evo-panel-player show|hide|toggle|visible
EOF
	exit 1
}

find_windows() {
	hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.title == "evo.panel.player") | .address'
}

has_window() {
	[[ -n "$(find_windows | head -1)" ]]
}

pin_player() {
	"$HYPR_PIN" pin-player >/dev/null 2>&1 || true
}

cmd_show() {
	$IPC summon evo.panel.player >/dev/null 2>&1 || true
	pin_player
}

cmd_hide() {
	$IPC hide evo.panel.player >/dev/null 2>&1 || true
}

cmd_toggle() {
	$IPC toggle evo.panel.player >/dev/null 2>&1 || true
	pin_player
}

cmd_visible() {
	if has_window; then
		exit 0
	fi
	exit 1
}

cmd="${1:-}"
case "$cmd" in
show) cmd_show ;;
hide) cmd_hide ;;
toggle) cmd_toggle ;;
visible) cmd_visible ;;
-h | --help | help | "") usage ;;
*)
	echo "evo-panel-player: unknown command: $cmd" >&2
	usage
	;;
esac
