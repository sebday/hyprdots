#!/usr/bin/env python3
"""Move vinyl release folders into catalog-code label subfolders."""

from __future__ import annotations

import argparse
import re
import shutil
import sys
from collections import Counter
from pathlib import Path

DEFAULT_ROOT = Path("/mnt/external/music/dubstep/vinyl")


def is_release_folder(name: str) -> bool:
    if name.startswith("medi-"):
        return True
    if name.startswith("whitelabel-"):
        return True
    if name == "dubstep_collection_9":
        return True
    return bool(re.match(r"^[a-z]+\d", name))


def get_label(name: str) -> str | None:
    if name.startswith("medi-"):
        return "medi"
    if name.startswith("whitelabel-"):
        return "whitelabel"
    if name == "dubstep_collection_9":
        return "_misc"
    match = re.match(r"^([a-z]+)\d", name)
    return match.group(1) if match else None


def collect_moves(root: Path) -> tuple[list[tuple[Path, Path]], list[str], list[str]]:
    entries = sorted(p for p in root.iterdir() if p.is_dir())

    moves: list[tuple[Path, Path]] = []
    unmapped: list[str] = []
    skipped: list[str] = []

    for entry in entries:
        if not is_release_folder(entry.name):
            continue

        label = get_label(entry.name)
        if not label:
            unmapped.append(entry.name)
            continue

        dest = root / label / entry.name
        if dest.exists():
            skipped.append(f"{entry.name} -> {label}/ (destination exists)")
            continue
        if entry.resolve() == dest.resolve():
            skipped.append(f"{entry.name} -> {label}/ (already in place)")
            continue

        moves.append((entry, dest))

    return moves, unmapped, skipped


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Organize vinyl release folders into catalog-code label folders."
    )
    parser.add_argument(
        "root",
        nargs="?",
        default=str(DEFAULT_ROOT),
        help=f"vinyl root directory (default: {DEFAULT_ROOT})",
    )
    parser.add_argument(
        "--execute",
        action="store_true",
        help="create label folders and move releases (default is dry-run)",
    )
    args = parser.parse_args()

    root = Path(args.root)
    if not root.is_dir():
        print(f"error: not a directory: {root}", file=sys.stderr)
        return 1

    moves, unmapped, skipped = collect_moves(root)

    if unmapped:
        print("error: could not determine label for:", file=sys.stderr)
        for name in unmapped:
            print(f"  {name}", file=sys.stderr)
        return 1

    labels = sorted({dest.parent.name for _, dest in moves})
    label_counts = Counter(dest.parent.name for _, dest in moves)

    print(f"root: {root}")
    print(f"mode: {'execute' if args.execute else 'dry-run'}")
    print(f"label folders to use/create: {len(labels)}")
    print(f"releases to move: {len(moves)}")
    print(f"skipped: {len(skipped)}")
    print()

    for src, dest in moves:
        print(f"  {src.name} -> {dest.parent.name}/")

    if skipped:
        print()
        print("skipped:")
        for line in skipped:
            print(f"  {line}")

    print()
    print("label summary:")
    for label in sorted(label_counts):
        print(f"  {label}/: {label_counts[label]}")

    if not args.execute:
        print()
        print("dry-run complete; re-run with --execute to apply")
        return 0

    for label in labels:
        (root / label).mkdir(parents=True, exist_ok=True)

    moved = 0
    for src, dest in moves:
        shutil.move(str(src), str(dest))
        moved += 1

    print()
    print(f"moved {moved} release folders into {len(labels)} label folders")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
