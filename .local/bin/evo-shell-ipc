#!/usr/bin/env bash
# IPC wrapper for the running evo-shell Quickshell instance.

set -euo pipefail

if ! command -v quickshell >/dev/null 2>&1; then
    echo "quickshell is not installed. Install with: sudo pacman -S quickshell" >&2
    exit 1
fi

target="${1:-shell}"
method="${2:-ping}"
arg1="${3:-}"
arg2="${4:-}"

case "$target" in
background) target="evo.background" ;;
idle) target="evo.idle" ;;
lock) target="evo.lock" ;;
esac

# Direct plugin IPC (e.g. evo.audio stepUp)
if [[ "$target" != "shell" ]]; then
    if [[ -n "$arg2" ]]; then
        quickshell ipc -c evo-shell call "$target" "$method" "$arg1" "$arg2"
    elif [[ -n "$arg1" ]]; then
        quickshell ipc -c evo-shell call "$target" "$method" "$arg1"
    else
        quickshell ipc -c evo-shell call "$target" "$method"
    fi
    exit 0
fi

# toggle/summon always need a payloadJson argument (use "" when omitted)
if [[ "$method" == "toggle" || "$method" == "summon" ]]; then
    quickshell ipc -c evo-shell call "$target" "$method" "$arg1" "${arg2:-}"
    exit 0
fi

if [[ -n "$arg2" ]]; then
    quickshell ipc -c evo-shell call "$target" "$method" "$arg1" "$arg2"
elif [[ -n "$arg1" ]]; then
    quickshell ipc -c evo-shell call "$target" "$method" "$arg1"
else
    quickshell ipc -c evo-shell call "$target" "$method"
fi
