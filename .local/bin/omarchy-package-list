#!/usr/bin/env bash
# Explicitly installed pacman packages for terminal display.

set -euo pipefail

CATEGORY_ORDER=$'Omarchy\nHyprland & desktop\nTerminal & CLI\nFonts\nMedia\nFiles & storage\nNetwork & security\nApplications\nDevelopment\nSystem & boot\nPacman & tools\nLibraries\nOther'

categorize_package() {
  local name="$1"
  local groups="${2:-}"
  local desc="${3:-}"
  local lower="${name,,}"
  local dlower="${desc,,}"

  case " $groups " in
    *" fcitx5-im "*) printf '%s' "Hyprland & desktop"; return ;;
    *" gnome "*) printf '%s' "Files & storage"; return ;;
    *" nerd-fonts "*) printf '%s' "Fonts"; return ;;
    *" qt6 "*) printf '%s' "Libraries"; return ;;
    *" python-build-backend "*) printf '%s' "Development"; return ;;
    *" tesseract-data "*) printf '%s' "Libraries"; return ;;
  esac

  case "$lower" in
    omarchy|omarchy-*|aether|asdcontrol|cliamp|herdr|omacalc|omacut|omawrite|omasnap|tobi-try|ttfx|usage|uwsm)
      printf '%s' "Omarchy"; return ;;
    hypr*|quickshell|grim|slurp|gpu-screen-recorder|wl-clipboard|wtype|fcitx5|fcitx5-*|gnome-themes-extra|yaru-icon-theme|ddcutil|bolt|power-profiles-daemon|xdg-desktop-portal*|xdg-terminal-exec)
      printf '%s' "Hyprland & desktop"; return ;;
    foot|starship|tmux|fzf|bat|eza|ripgrep|fd|less|man-db|tldr|bash-completion)
      printf '%s' "Terminal & CLI"; return ;;
    noto-fonts|noto-fonts-*|ttf-*|woff2-font-awesome)
      printf '%s' "Fonts"; return ;;
    pipewire|pipewire-*|wireplumber|libpulse|alsa-utils|pamixer|mpv|mpv-*|imagemagick|imv|ffmpegthumbnailer|gst-plugin-pipewire|yt-dlp)
      printf '%s' "Media"; return ;;
    nautilus|nautilus-*|gnome-disk-utility|udiskie|gvfs-*|btrfs-progs|dosfstools|exfatprogs|ntfs-3g|gocryptfs|sushi)
      printf '%s' "Files & storage"; return ;;
    networkmanager|ufw|inetutils|wireless-regdb|nss-mdns|darkhttpd|pass|gnome-keyring|whois)
      printf '%s' "Network & security"; return ;;
    brave-bin|obsidian|insync|evince)
      printf '%s' "Applications"; return ;;
    git|mise-bin|lazygit|clang|llvm|ruby|lua51|luarocks|tree-sitter-cli|python-*|dotnet-runtime|qemu-*)
      printf '%s' "Development"; return ;;
    base|base-devel|sudo|linux|linux-firmware|mkinitcpio|limine|efibootmgr|intel-ucode|kernel-modules-hook|sddm|zram-generator|vulkan-*)
      printf '%s' "System & boot"; return ;;
    pacman-contrib|yay|expac|jq|btop|fastfetch|inxi|plocate|tzupdate|qrencode|zbar|socat|inotify-tools|dua-cli)
      printf '%s' "Pacman & tools"; return ;;
    mariadb-libs|postgresql-libs|libvips|libyaml|qt6-imageformats|tesseract|tesseract-*)
      printf '%s' "Libraries"; return ;;
  esac

  if [[ "$dlower" == *font* || "$dlower" == *typeface* ]]; then
    printf '%s' "Fonts"; return
  fi
  if [[ "$dlower" == *wayland* || "$dlower" == *compositor* || "$dlower" == *hyprland* ]]; then
    printf '%s' "Hyprland & desktop"; return
  fi
  if [[ "$dlower" == *sound* || "$dlower" == *audio* || "$dlower" == *pipewire* || "$dlower" == *alsa* ]]; then
    printf '%s' "Media"; return
  fi
  if [[ "$dlower" == *terminal* || "$dlower" == *shell* || "$dlower" == *"command-line"* ]]; then
    printf '%s' "Terminal & CLI"; return
  fi
  if [[ "$dlower" == *filesystem* || "$dlower" == *"file manager"* || "$dlower" == *storage* ]]; then
    printf '%s' "Files & storage"; return
  fi
  if [[ "$dlower" == *network* || "$dlower" == *firewall* || "$dlower" == *dns* ]]; then
    printf '%s' "Network & security"; return
  fi
  if [[ "$dlower" == *library* || "$dlower" == *headers* ]]; then
    printf '%s' "Libraries"; return
  fi
  if [[ "$dlower" == *kernel* || "$dlower" == *boot* || "$dlower" == *firmware* ]]; then
    printf '%s' "System & boot"; return
  fi
  if [[ "$dlower" == *pacman* || "$dlower" == *"package manager"* ]]; then
    printf '%s' "Pacman & tools"; return
  fi
  if [[ "$dlower" == *compiler* || "$dlower" == *development* || "$dlower" == *sdk* ]]; then
    printf '%s' "Development"; return
  fi

  printf '%s' "Other"
}

build_category_reference() {
  local pkg version groups desc category

  if command -v expac >/dev/null 2>&1; then
    while IFS=$'\t' read -r pkg version groups desc; do
      [[ -n "$pkg" ]] || continue
      category="$(categorize_package "$pkg" "$groups" "$desc")"
      printf '%s\t%s\n' "$category" "$pkg"
    done < <(expac -Q '%n\t%v\t%G\t%d' $(pacman -Qqe 2>/dev/null) 2>/dev/null || true)
    return
  fi

  while read -r pkg; do
    [[ -n "$pkg" ]] || continue
    category="$(categorize_package "$pkg" "" "")"
    printf '%s\t%s\n' "$category" "$pkg"
  done < <(pacman -Qqe 2>/dev/null || true)
}

emit_error_json() {
  local msg="$1"
  jq -cn \
    --arg error "$msg" \
    '{
      ok: false,
      error: $error,
      summary: { explicit: 0, foreign: 0 },
      categories: []
    }'
}

collect_breakdown_json() {
  if ! command -v pacman >/dev/null 2>&1; then
    emit_error_json "pacman not available"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    emit_error_json "jq not available"
    return 0
  fi

  local explicit_tsv foreign_lines reference_tsv
  if command -v expac >/dev/null 2>&1; then
    explicit_tsv="$(expac -Q '%n\t%v' $(pacman -Qqe 2>/dev/null) 2>/dev/null || true)"
  else
    explicit_tsv="$(pacman -Qqe 2>/dev/null | while read -r pkg; do
      line="$(pacman -Q "$pkg" 2>/dev/null || true)"
      [[ -n $line ]] || continue
      printf '%s\t%s\n' "${line%% *}" "${line#* }"
    done)"
  fi
  foreign_lines="$(pacman -Qqm 2>/dev/null || true)"
  reference_tsv="$(build_category_reference)"

  local categories_json
  categories_json="$(jq -Rn \
    --arg ref "$reference_tsv" \
    --arg explicit "$explicit_tsv" \
    --arg foreign "$foreign_lines" \
    --arg order "$CATEGORY_ORDER" \
    '
    ($ref | split("\n") | map(select(length > 0) | split("\t")) | map({cat: .[0], pkg: .[1]})) as $refs
    | ($foreign | split("\n") | map(select(length > 0))) as $foreignSet
    | ($explicit | split("\n") | map(select(length > 0) | split("\t")) | map({name: .[0], version: (.[1] // "")})) as $pkgs
    | ($order | split("\n") | map(select(length > 0))) as $preferredOrder
    | ($refs | map(.cat) | reduce .[] as $c ([]; if index($c) then . else . + [$c] end)) as $seenCats
    | ($preferredOrder + ($seenCats - $preferredOrder) + ["Other"]) as $catOrder
    | ($pkgs | map(
        . as $p
        | (($refs | map(select(.pkg == $p.name)) | if length > 0 then .[0].cat else "Other" end)) as $cat
        | { category: $cat, package: $p }
      )) as $assigned
    | (
        $catOrder
        | map(
            . as $catName
            | {
                name: $catName,
                packages: [
                  $assigned[]
                  | select(.category == $catName)
                  | .package as $pkg
                  | $pkg + {
                      source: (if ($foreignSet | index($pkg.name)) then "aur" else "repo" end)
                    }
                ]
                | sort_by(.name)
              }
          )
        | map(select(.packages | length > 0))
      )
    ')"

  jq -cn \
    --arg explicit "$explicit_tsv" \
    --argjson categories "$categories_json" \
    '
    ($explicit | split("\n") | map(select(length > 0))) as $explicitList
    | {
        ok: true,
        error: "",
        summary: {
          explicit: ($explicitList | length),
          foreign: ($categories | map(.packages[]) | map(select(.source == "aur")) | length)
        },
        categories: $categories
      }
    '
}

print_category_section() {
  local title="$1"
  local count="$2"
  local json="$3"

  [[ "$count" -gt 0 ]] || return 0

  printf '\n%s (%s)\n' "$title" "$count"
  jq -r '.[] | "\(.name)\t\(.version // "")\t\(.source // "repo")"' <<<"$json" | while IFS=$'\t' read -r name version source; do
    local suffix=""
    [[ "$source" == "aur" ]] && suffix="  AUR"
    if [[ ${#name} -gt 36 ]]; then
      printf '  %-36s %s%s\n' "${name:0:35}…" "$version" "$suffix"
    else
      printf '  %-36s %s%s\n' "$name" "$version" "$suffix"
    fi
  done
}

show_breakdown() {
  local data
  data="$(collect_breakdown_json)"

  if [[ "$(jq -r '.ok' <<<"$data")" != "true" ]]; then
    echo "Could not load packages: $(jq -r '.error' <<<"$data")" >&2
    return 1
  fi

  local explicit foreign
  explicit="$(jq -r '.summary.explicit' <<<"$data")"
  foreign="$(jq -r '.summary.foreign' <<<"$data")"

  printf 'Explicitly installed (%s)\n' "$explicit"
  if (( foreign > 0 )); then
    printf '  %s from AUR\n' "$foreign"
  fi

  while IFS= read -r cat_json; do
    local name count
    name="$(jq -r '.name' <<<"$cat_json")"
    count="$(jq -r '.packages | length' <<<"$cat_json")"
    print_category_section "$name" "$count" "$(jq -c '.packages' <<<"$cat_json")"
  done < <(jq -c '.categories[]' <<<"$data")

  printf '\n'
}

usage() {
  cat >&2 <<'EOF'
usage:
  omarchy-package-list show
  omarchy-package-list breakdown
EOF
  exit 2
}

case "${1:-}" in
show) show_breakdown ;;
breakdown) collect_breakdown_json ;;
*) usage ;;
esac
